digraph BetaRegisterFlow {
  rankdir=LR;
  graph [fontname="Consolas", nodesep=0.5, ranksep=0.9];
  node [shape=record, fontname="Consolas", fontsize=10];
  edge [fontname="Consolas", fontsize=9];
  entry [shape=oval, label="ENTRY"];
  stop [shape=oval, label="STOP"];
  s1 [label="State 1 [entry] | #1 epoch-start: local r_v1_1 = allocUpvalue() | #2 version-define: local r_v2_1 = 0 | #3 effect-write: upvalueValues[r_v1_1] = r_v2_1 \| reads r_v1_1,r_v2_1 | #4 version-define: local r_v2_2 = createClosure1(10, \{ r_v1_1 \}) \| reads r_v1_1 | #5 epoch-start: local r_v3_1 = r_v2_2 \| reads r_v2_2 | #6 epoch-start: local r_v4_1 = false | #7 epoch-start: local r_v5_1 = r_v3_1(r_v4_1) \| reads r_v3_1,r_v4_1 | #8 state-transition: state = r_v5_1 and 2 or 3 \| reads r_v5_1 | #9 version-define: local r_v6_1 = r_v5_1 \| reads r_v5_1 | #10 epoch-start: local r_v7_1 = args"];
  s2 [label="State 2 | #1 epoch-mutate: r_v5_1 = ReturnVal | #2 epoch-start: local r_v8_1 = true | #3 epoch-start: local r_v4_2 = r_v3_1(r_v8_1) \| reads r_v3_1,r_v8_1 | #4 state-transition: state = r_v4_2 and 4 or 5 \| reads r_v4_2 | #5 version-define: local r_v6_2 = r_v4_2 \| reads r_v4_2"];
  s3 [label="State 3 | #1 epoch-start: local r_v4_3 = true | #2 epoch-mutate: r_v5_1 = r_v3_1(r_v4_3) \| reads r_v3_1,r_v4_3 | #3 version-define: local r_v6_3 = r_v5_1 \| reads r_v5_1 | #4 state-transition: state = 2"];
  s4 [label="State 4 | #1 epoch-start: local r_v8_2 = false | #2 epoch-mutate: r_v4_2 = r_v3_1(r_v8_2) \| reads r_v3_1,r_v8_2 | #3 version-define: local r_v6_4 = r_v4_2 \| reads r_v4_2 | #4 state-transition: state = 5"];
  s5 [label="State 5 | #1 epoch-start: local r_v9_1 = false | #2 epoch-start: local r_v8_3 = r_v3_1(r_v9_1) \| reads r_v3_1,r_v9_1 | #3 state-transition: state = r_v8_3 and 6 or 7 \| reads r_v8_3 | #4 epoch-mutate: r_v4_2 = ReturnVal | #5 version-define: local r_v6_5 = r_v8_3 \| reads r_v8_3"];
  s6 [label="State 6 | #1 state-transition: state = ReturnVal and 8 or 9"];
  s7 [label="State 7 | #1 epoch-start: local r_v9_2 = upvalueValues[r_v1_1] \| reads r_v1_1 | #2 epoch-start: local r_v10_1 = 5 | #3 epoch-start: local r_v8_4 = r_v9_2 == r_v10_1 \| reads r_v9_2,r_v10_1 | #4 version-define: local r_v6_6 = r_v8_4 \| reads r_v8_4 | #5 state-transition: state = 6"];
  s8 [label="State 8 | #1 version-define: local r_v6_7 = \"print\" | #2 version-define: local r_v2_3 = _env[r_v6_7] \| reads r_v6_7 | #3 epoch-start: local r_v9_3 = upvalueValues[r_v1_1] \| reads r_v1_1 | #4 epoch-start: local r_v8_5 = \"if-or\" | #5 version-define: local r_v6_8 = r_v2_3(r_v8_5, r_v5_1, r_v4_2, r_v9_3) \| reads r_v2_3,r_v8_5,r_v5_1,r_v4_2,r_v9_3 | #6 state-transition: state = 9"];
  s9 [label="State 9 | #1 version-define: local r_v6_9 = \"print\" | #2 version-define: local r_v2_4 = _env[r_v6_9] \| reads r_v6_9 | #3 epoch-start: local r_v9_4 = upvalueValues[r_v1_1] \| reads r_v1_1 | #4 epoch-start: local r_v8_6 = \"done\" | #5 version-define: local r_v6_10 = r_v2_4(r_v8_6, r_v5_1, r_v4_2, r_v9_4) \| reads r_v2_4,r_v8_6,r_v5_1,r_v4_2,r_v9_4 | #6 epoch-mutate: r_v1_1 = releaseUpvalue(r_v1_1) \| reads r_v1_1 | #7 epoch-kill: r_v3_1 = nil | #8 epoch-kill: r_v4_2 = nil | #9 epoch-kill: r_v5_1 = nil | #10 return-payload: ReturnVal = \{\} | #11 state-transition: state = nil"];
  s10 [label="State 10 [entry] | #1 version-define: local r_v6_11 = upvalueValues[upvalues[1]] | #2 epoch-start: local r_v7_2 = args[1] | #3 epoch-start: local r_v1_2 = 1 | #4 version-define: local r_v2_5 = r_v6_11 + r_v1_2 \| reads r_v6_11,r_v1_2 | #5 effect-write: upvalueValues[upvalues[1]] = r_v2_5 \| reads r_v2_5 | #6 return-payload: ReturnVal = \{ r_v7_2 \} \| reads r_v7_2 | #7 state-transition: state = nil"];
  entry -> s1;
  entry -> s10;
  s1 -> s2 [label="true"];
  s1 -> s3 [label="false"];
  s2 -> s4 [label="true"];
  s2 -> s5 [label="false"];
  s3 -> s2;
  s4 -> s5;
  s5 -> s6 [label="true"];
  s5 -> s7 [label="false"];
  s6 -> s8 [label="true"];
  s6 -> s9 [label="false"];
  s7 -> s6;
  s8 -> s9;
  s9 -> stop;
  s10 -> stop;
  subgraph cluster_epochs {
    label="Proven register epochs";
    style=dashed;
    life0 [shape=ellipse, label="r3 =\> r_v1_1"];
    life0 -> s1 [style=dashed, label="start/read/read"];
    life0 -> s7 [style=dashed, label="read"];
    life0 -> s8 [style=dashed, label="read"];
    life0 -> s9 [style=dashed, label="read/read/mutate"];
    life1 [shape=ellipse, label="r3 =\> r_v1_2"];
    life1 -> s10 [style=dashed, label="start/read"];
    life2 [shape=ellipse, label="r1 =\> r_v3_1"];
    life2 -> s1 [style=dashed, label="start/read"];
    life2 -> s2 [style=dashed, label="read"];
    life2 -> s3 [style=dashed, label="read"];
    life2 -> s4 [style=dashed, label="read"];
    life2 -> s5 [style=dashed, label="read"];
    life2 -> s9 [style=dashed, label="kill"];
    life3 [shape=ellipse, label="r8 =\> r_v4_1"];
    life3 -> s1 [style=dashed, label="start/read"];
    life4 [shape=ellipse, label="r8 =\> r_v4_2"];
    life4 -> s2 [style=dashed, label="start/read/read"];
    life4 -> s4 [style=dashed, label="mutate/read"];
    life4 -> s5 [style=dashed, label="mutate"];
    life4 -> s8 [style=dashed, label="read"];
    life4 -> s9 [style=dashed, label="read/kill"];
    life5 [shape=ellipse, label="r8 =\> r_v4_3"];
    life5 -> s3 [style=dashed, label="start/read"];
    life6 [shape=ellipse, label="r7 =\> r_v5_1"];
    life6 -> s1 [style=dashed, label="start/read/read"];
    life6 -> s2 [style=dashed, label="mutate"];
    life6 -> s3 [style=dashed, label="mutate/read"];
    life6 -> s8 [style=dashed, label="read"];
    life6 -> s9 [style=dashed, label="read/kill"];
    life7 [shape=ellipse, label="r2 =\> r_v7_1"];
    life7 -> s1 [style=dashed, label="start"];
    life8 [shape=ellipse, label="r2 =\> r_v7_2"];
    life8 -> s10 [style=dashed, label="start/read"];
    life9 [shape=ellipse, label="r6 =\> r_v8_1"];
    life9 -> s2 [style=dashed, label="start/read"];
    life10 [shape=ellipse, label="r6 =\> r_v8_2"];
    life10 -> s4 [style=dashed, label="start/read"];
    life11 [shape=ellipse, label="r6 =\> r_v8_3"];
    life11 -> s5 [style=dashed, label="start/read/read"];
    life12 [shape=ellipse, label="r6 =\> r_v8_4"];
    life12 -> s7 [style=dashed, label="start/read"];
    life13 [shape=ellipse, label="r6 =\> r_v8_5"];
    life13 -> s8 [style=dashed, label="start/read"];
    life14 [shape=ellipse, label="r6 =\> r_v8_6"];
    life14 -> s9 [style=dashed, label="start/read"];
    life15 [shape=ellipse, label="r5 =\> r_v9_1"];
    life15 -> s5 [style=dashed, label="start/read"];
    life16 [shape=ellipse, label="r5 =\> r_v9_2"];
    life16 -> s7 [style=dashed, label="start/read"];
    life17 [shape=ellipse, label="r5 =\> r_v9_3"];
    life17 -> s8 [style=dashed, label="start/read"];
    life18 [shape=ellipse, label="r5 =\> r_v9_4"];
    life18 -> s9 [style=dashed, label="start/read"];
    life19 [shape=ellipse, label="r4 =\> r_v10_1"];
    life19 -> s7 [style=dashed, label="start/read"];
  }
}