script-source,123,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\control\\loop-storage.js,"use strict";\n\nconst { isIdentifier\x2C isSingleAssignment\x2C isVmRegisterName } = require("../ast");\n\nfunction transitionTargets(transition) {\n    if (transition?.kind === "jump") return [transition.target];\n    if (transition?.kind === "branch") return [transition.onTrue\x2C transition.onFalse];\n    return [];\n}\n\nfunction nodeReadsName(node\x2C name) {\n    if (!node || typeof node !== "object") return false;\n    if (isIdentifier(node\x2C name)) return true;\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) {\n            if (value.some(item => nodeReadsName(item\x2C name))) return true;\n        } else if (value && typeof value === "object" && nodeReadsName(value\x2C name)) {\n            return true;\n        }\n    }\n    return false;\n}\n\nfunction statementReadsName(statement\x2C name) {\n    if (!statement || typeof statement !== "object") return false;\n    if (statement.type === "AssignmentStatement") {\n        for (const rhs of statement.init || []) if (nodeReadsName(rhs\x2C name)) return true;\n        for (const dest of statement.variables || []) {\n            if (dest?.type === "IndexExpression" && nodeReadsName(dest\x2C name)) return true;\n        }\n        return false;\n    }\n    return nodeReadsName(statement\x2C name);\n}\n\nfunction valueMayBeReadBeforeOverwriteFrom(graph\x2C blockId\x2C name\x2C visiting = new Set()) {\n    if (visiting.has(blockId)) return false;\n    const block = graph.blocks.get(blockId);\n    if (!block) return false;\n    const nextVisiting = new Set(visiting);\n    nextVisiting.add(blockId);\n    for (let i = 0; i < block.body.length; i++) {\n        if (i === block.transitionIndex) continue;\n        const statement = block.body[i];\n        if (statementReadsName(statement\x2C name)) return true;\n        if (statement?.type === "AssignmentStatement" &&\n            (statement.variables || []).some(dest => isIdentifier(dest\x2C name))) return false;\n    }\n    if (block.transition?.kind === "branch" && block.transition.conditionRegister === name) return true;\n    for (const target of transitionTargets(block.transition)) {\n        if (valueMayBeReadBeforeOverwriteFrom(graph\x2C target\x2C name\x2C nextVisiting)) return true;\n    }\n    return false;\n}\n\nfunction candidateLoopCarriedRegisters(graph\x2C matches) {\n    const candidates = new Set();\n    const starts = new Map();\n    const evidence = new Map();\n    for (const match of matches) {\n        const preheader = graph.blocks.get(match.preheaderId);\n        if (!preheader) continue;\n        const preheaderDefinitions = new Map();\n        for (let i = 0; i < preheader.transitionIndex; i++) {\n            const statement = preheader.body[i];\n            if (!isSingleAssignment(statement) || !isIdentifier(statement.variables[0])) continue;\n            const name = statement.variables[0].name;\n            // Nil can be a real source initializer for a loop-carried binding.\n            // Ownership is proved below from a loop write plus an observed live\n            // incoming value\x2C so do not discard nil definitions up front.\n            if (!isVmRegisterName(name)) continue;\n            preheaderDefinitions.set(name\x2C i);\n        }\n        for (const [name\x2C definitionIndex] of preheaderDefinitions) {\n            let hasLoopWrite = false;\n            let readsInitialBeforeOverwrite = false;\n            const seen = new Set();\n            const queue = [{ id: match.headerId\x2C live: true }];\n            while (queue.length) {\n                const cursor = queue.shift();\n                const key = cursor.id + ":" + (cursor.live ? "1" : "0");\n                if (seen.has(key)) continue;\n                seen.add(key);\n                const block = graph.blocks.get(cursor.id);\n                if (!block) continue;\n                let live = cursor.live;\n                for (let i = 0; i < block.body.length; i++) {\n                    if (i === block.transitionIndex) continue;\n                    const statement = block.body[i];\n                    if (live && statementReadsName(statement\x2C name)) readsInitialBeforeOverwrite = true;\n                    if (isSingleAssignment(statement) && isIdentifier(statement.variables[0]\x2C name)) {\n                        if (statement.init[0]?.type !== "NilLiteral") hasLoopWrite = true;\n                        live = false;\n                    }\n                }\n                if (live && block.transition?.kind === "branch" && block.transition.conditionRegister === name) readsInitialBeforeOverwrite = true;\n                for (const target of transitionTargets(block.transition)) {\n                    if (!match.coreIds.has(target)) {\n                        // A loop-carried source value may be observed only after the\n                        // loop exits (for example a nil-initialized "best match"\n                        // updated conditionally in the body). If this exact incoming\n                        // epoch reaches an exit-side read before overwrite\x2C that is\n                        // source-storage evidence just like an in-loop read.\n                        if (live && valueMayBeReadBeforeOverwriteFrom(graph\x2C target\x2C name)) {\n                            readsInitialBeforeOverwrite = true;\n                        }\n                        continue;\n                    }\n                    if (target === match.headerId) continue;\n                    queue.push({ id: target\x2C live });\n                }\n            }\n            if (hasLoopWrite && readsInitialBeforeOverwrite) {\n                candidates.add(name);\n                if (!starts.has(name)) starts.set(name\x2C new Set());\n                starts.get(name).add(match.preheaderId + ":" + definitionIndex);\n                if (!evidence.has(name)) evidence.set(name\x2C []);\n                evidence.get(name).push({ blockId: match.preheaderId\x2C statement: preheader.body[definitionIndex] });\n            }\n        }\n    }\n    return { registers: candidates\x2C starts\x2C evidence };\n}\n\nfunction remapLoopCarriedStarts(candidate\x2C leaves) {\n    if (!candidate || !(leaves instanceof Map)) return { registers: new Set()\x2C starts: new Map()\x2C evidence: new Map() };\n    const registers = new Set();\n    const starts = new Map();\n    const evidence = candidate.evidence instanceof Map ? candidate.evidence : new Map();\n    for (const [name\x2C items] of evidence) {\n        const mapped = new Set();\n        for (const item of items || []) {\n            const body = leaves.get(item.blockId);\n            if (!Array.isArray(body)) continue;\n            const index = body.indexOf(item.statement);\n            if (index >= 0) mapped.add(item.blockId + ":" + index);\n        }\n        if (!mapped.size) continue;\n        registers.add(name);\n        starts.set(name\x2C mapped);\n    }\n    return { registers\x2C starts\x2C evidence };\n}\n\nmodule.exports = { candidateLoopCarriedRegisters\x2C remapLoopCarriedStarts };\n
