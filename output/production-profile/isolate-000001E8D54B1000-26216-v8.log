urn ctx.upvalueCellIdentities.get(name) ?? null;\x0d\n}\x0d\nfunction bindUpvalueCellIdentity(ctx\x2C identity\x2C display\x2C env) {\x0d\n    if (!isUpvalueCellIdentity(identity) || typeof display !== "string") return false;\x0d\n    env.set(upvalueCellIdentityBindingKey(ctx\x2C identity)\x2C display);\x0d\n    return true;\x0d\n}\x0d\nfunction pathUpvalueCellBinding(ctx\x2C name\x2C env) {\x0d\n    const value = env.get(pathUpvalueCellKey(ctx\x2C name));\x0d\n    if (typeof value === "string") return value !== ctx.pathUpvalueCellUnbound ? value : null;\x0d\n    if (isUpvalueCellIdentity(value)) {\x0d\n        const binding = env.get(upvalueCellIdentityBindingKey(ctx\x2C value));\x0d\n        return typeof binding === "string" ? binding : null;\x0d\n    }\x0d\n    return null;\x0d\n}\x0d\nfunction upvalueCellBinding(ctx\x2C name\x2C env) {\x0d\n    if (hasPathUpvalueCell(ctx\x2C name\x2C env)) return pathUpvalueCellBinding(ctx\x2C name\x2C env);\x0d\n    const identity = ctx.upvalueCellIdentities.get(name);\x0d\n    if (isUpvalueCellIdentity(identity)) {\x0d\n        const binding = env.get(upvalueCellIdentityBindingKey(ctx\x2C identity));\x0d\n        if (typeof binding === "string") return binding;\x0d\n    }\x0d\n    return ctx.upvalueCellBindings.get(name) ?? null;\x0d\n}\x0d\n\x0d\nfunction deferredClosureValue(ctx\x2C call\x2C env) {\x0d\n    if (call?.type !== "CallExpression" || !isIdentifier(call.base) || !/^createClosure\\d*$/.test(call.base.name)) return null;\x0d\n    const args = call.arguments || [];\x0d\n    if (args.length !== 2 || args[0]?.type !== "NumericLiteral" || args[1]?.type !== "TableConstructorExpression") return null;\x0d\n    const captureRefs = [];\x0d\n    for (const field of args[1].fields || []) {\x0d\n        if (field?.type !== "TableValue") return null;\x0d\n        if (isIdentifier(field.value)) {\x0d\n            const bound = upvalueCellBinding(ctx\x2C field.value.name\x2C env);\x0d\n            if (typeof bound === "string") {