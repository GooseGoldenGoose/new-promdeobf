script-source,125,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\control\\repeat.js,"use strict";\n\nconst { isIdentifier\x2C isSingleAssignment\x2C isPrimitiveLiteral } = require("../ast");\nconst { createStateGraph } = require("../cfg");\nconst { extractNormalizedStateLeaves } = require("../normalize");\nconst { matchMultiStateLogicalLocals } = require("../structured/solver");\nconst { candidateLoopCarriedRegisters\x2C remapLoopCarriedStarts } = require("./loop-storage");\n\nfunction transitionTargets(transition) {\n    if (transition?.kind === "jump") return [transition.target];\n    if (transition?.kind === "branch") return [transition.onTrue\x2C transition.onFalse];\n    return [];\n}\n\nfunction stronglyConnectedComponents(graph) {\n    let nextIndex = 0;\n    const index = new Map()\x2C low = new Map()\x2C stack = []\x2C onStack = new Set()\x2C out = [];\n    function visit(id) {\n        index.set(id\x2C nextIndex); low.set(id\x2C nextIndex); nextIndex++;\n        stack.push(id); onStack.add(id);\n        for (const next of graph.successors.get(id) || []) {\n            if (!graph.reachable.has(next)) continue;\n            if (!index.has(next)) { visit(next); low.set(id\x2C Math.min(low.get(id)\x2C low.get(next))); }\n            else if (onStack.has(next)) low.set(id\x2C Math.min(low.get(id)\x2C index.get(next)));\n        }\n        if (low.get(id) !== index.get(id)) return;\n        const component = [];\n        while (stack.length) {\n            const current = stack.pop(); onStack.delete(current); component.push(current);\n            if (current === id) break;\n        }\n        out.push(component);\n    }\n    for (const id of graph.reachable) if (!index.has(id)) visit(id);\n    return out;\n}\n\nfunction primitiveKey(node) {\n    if (!isPrimitiveLiteral(node)) return null;\n    if (node.type === "NilLiteral") return "nil";\n    if (node.type === "StringLiteral") return `StringLiteral:${String(node.raw ?? node.value ?? "")}`;\n    if (node.type === "NumericLiteral") return `NumericLiteral:${String(node.raw ?? node.value)}`;\n    return `${node.type}:${JSON.stringify(node.value)}`;\n}\n\nfunction mergeFree(...sets) {\n    const out = new Set();\n    for (const set of sets) for (const value of set || []) out.add(value);\n    return out;\n}\n\nfunction canonicalNode(node\x2C env\x2C blockedFree = new Set()) {\n    const primitive = primitiveKey(node);\n    if (primitive !== null) return { text: primitive\x2C free: new Set() };\n    if (isIdentifier(node)) {\n        if (blockedFree.has(node.name) || !env.has(node.name)) return { text: `free:${node.name}`\x2C free: new Set([node.name]) };\n        const value = env.get(node.name);\n        return { text: value.text\x2C free: new Set(value.free) };\n    }\n    if (node?.type === "IndexExpression") {\n        const base = canonicalNode(node.base\x2C env\x2C blockedFree)\x2C key = canonicalNode(node.index\x2C env\x2C blockedFree);\n        if (!base || !key) return null;\n        return { text: `idx(${base.text}\x2C${key.text})`\x2C free: mergeFree(base.free\x2C key.free) };\n    }\n    if (node?.type === "CallExpression") {\n        const base = canonicalNode(node.base\x2C env\x2C blockedFree);\n        if (!base) return null;\n        const args = []\x2C frees = [base.free];\n        for (const arg of node.arguments || []) {\n            const value = canonicalNode(arg\x2C env\x2C blockedFree);\n            if (!value) return null;\n            args.push(value.text); frees.push(value.free);\n        }\n        return { text: `call(${base.text};${args.join("\x2C")})`\x2C free: mergeFree(...frees) };\n    }\n    if (node?.type === "UnaryExpression") {\n        const arg = canonicalNode(node.argument\x2C env\x2C blockedFree);\n        return arg ? { text: `un(${node.operator}\x2C${arg.text})`\x2C free: new Set(arg.free) } : null;\n    }\n    if ((node?.type === "BinaryExpression" || node?.type === "LogicalExpression") && typeof node.operator === "string") {\n        const left = canonicalNode(node.left\x2C env\x2C blockedFree)\x2C right = canonicalNode(node.right\x2C env\x2C blockedFree);\n        if (!left || !right) return null;\n        return { text: `bin(${node.operator}\x2C${left.text}\x2C${right.text})`\x2C free: mergeFree(left.free\x2C right.free) };\n    }\n    if (node?.type === "TableConstructorExpression") {\n        const values = []\x2C frees = [];\n        for (const field of node.fields || []) {\n            if (field?.type !== "TableValue") return null;\n            const value = canonicalNode(field.value\x2C env\x2C blockedFree);\n            if (!value) return null;\n            values.push(value.text); frees.push(value.free);\n        }\n        return { text: `table(${values.join("\x2C")})`\x2C free: mergeFree(...frees) };\n    }\n    return null;\n}\n\nfunction evaluateRegisterAssignments(block\x2C blockedFree = new Set()) {\n    const env = new Map()\x2C records = [];\n    for (let i = 0; i < block.transitionIndex; i++) {\n        const statement = block.body[i];\n        if (!isSingleAssignment(statement) || !isIdentifier(statement.variables[0])) continue;\n        const value = canonicalNode(statement.init[0]\x2C env\x2C blockedFree);\n        if (!value) continue;\n        const name = statement.variables[0].name;\n        env.set(name\x2C value);\n        records.push({ index: i\x2C name\x2C value\x2C statement });\n    }\n    return { env\x2C records };\n}\n\nfunction identifiersRead(node\x2C out = new Set()) {\n    if (!node || typeof node !== "object") return out;\n    if (isIdentifier(node)) { out.add(node.name); return out; }\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc") continue;\n        if (Array.isArray(value)) for (const item of value) identifiersRead(item\x2C out);\n        else if (value && typeof value === "object") identifiersRead(value\x2C out);\n    }\n    return out;\n}\n\nfunction dependencySlice(block\x2C resultIndex\x2C blockedFree) {\n    const result = block.body[resultIndex];\n    if (!isSingleAssignment(result) || !isIdentifier(result.variables[0])) return null;\n    const selected = new Set([resultIndex]);\n    const needed = identifiersRead(result.init[0]);\n    for (const name of blockedFree) needed.delete(name);\n    for (let i = resultIndex - 1; i >= 0; i--) {\n        const statement = block.body[i];\n        if (!isSingleAssignment(statement) || !isIdentifier(statement.variables[0])) continue;\n        const dest = statement.variables[0].name;\n        if (!needed.has(dest) || blockedFree.has(dest)) continue;\n        selected.add(i); needed.delete(dest);\n        for (const name of identifiersRead(statement.init[0])) if (!blockedFree.has(name)) needed.add(name);\n    }\n    // Remaining names are external roots (_env\x2C args\x2C source storage\x2C captures).\n    return selected;\n}\n\nfunction canonicalCompilerExpression(node\x2C latestDefinitions) {\n    if (node === null || node === undefined) return node;\n    if (Array.isArray(node)) return node.map(item => canonicalCompilerExpression(item\x2C latestDefinitions));\n    if (typeof node !== "object") return node;\n    if (node.type === "Identifier") {\n        const definition = latestDefinitions.get(node.name);\n        return { type: "Identifier"\x2C binding: definition === undefined ? "external:" + node.name : "definition:" + definition };\n    }\n    if (node.type === "StringLiteral") return { type: "StringLiteral"\x2C raw: String(node.raw ?? node.value ?? "") };\n    const output = {};\n    for (const key of Object.keys(node).sort()) {\n        if (key === "loc" || key === "range" || key === "raw" || key === "comments" || key === "tokens" || key === "isLocal") continue;\n        output[key] = canonicalCompilerExpression(node[key]\x2C latestDefinitions);\n    }\n    return output;\n}\n\nfunction statementOperation(statement) {\n    if (!isSingleAssignment(statement) || !isIdentifier(statement.variables[0])) return null;\n    return { statement\x2C target: statement.variables[0].name\x2C rhs: statement.init[0] };\n}\n\nfunction collectDefinitionRefs(value\x2C output = new Set()) {\n    if (Array.isArray(value)) { for (const child of value) collectDefinitionRefs(child\x2C output); return output; }\n    if (!value || typeof value !== "object") return output;\n    if (value.type === "Identifier" && typeof value.binding === "string" && value.binding.startsWith("definition:")) {\n        const n = Number(value.binding.slice(11));\n        if (Number.isInteger(n)) output.add(n);\n    }\n    for (const child of Object.values(value)) collectDefinitionRefs(child\x2C output);\n    return output;\n}\n\nfunction buildStatementPattern(operations) {\n    const definitions = new Map()\x2C nodes = [];\n    for (let index = 0; index < operations.length; index++) {\n        const op = operations[index];\n        const canonical = canonicalCompilerExpression(op.rhs\x2C definitions);\n        const dependencies = collectDefinitionRefs(canonical);\n        nodes.push({ index\x2C expression: JSON.stringify(canonical)\x2C dependencies });\n        definitions.set(op.target\x2C index);\n    }\n    return nodes;\n}\n\nfunction findUniqueStatementSubsequence(operations\x2C pattern) {\n    if (!pattern.length) return null;\n    const patternNodes = buildStatementPattern(pattern);\n    const candidates = new Map();\n    function visit(searchStart\x2C matched\x2C selectedIndices\x2C selectedDefinitions) {\n        if (candidates.size > 1) return;\n        if (matched.size === patternNodes.length) {\n            const selected = new Set(selectedIndices);\n            const liveSelected = new Set();\n            const everSelected = new Set();\n            for (let index = 0; index < operations.length; index++) {\n                const operation = operations[index];\n                const reads = identifiersRead(operation.rhs);\n                if (selected.has(index)) {\n                    // A selected dependency must still come from the selected epoch;\n                    // an intervening unselected overwrite invalidates this match.\n                    for (const name of reads) {\n                        if (everSelected.has(name) && !liveSelected.has(name)) return;\n                    }\n                    liveSelected.add(operation.target);\n                    everSelected.add(operation.target);\n                    continue;\n                }\n                // Only reads reached by a currently-live selected definition are\n                // dependent on the duplicated condition. Earlier reads belong to\n                // older physical-register epochs and are unrelated.\n                for (const name of liveSelected) if (reads.has(name)) return;\n                liveSelected.delete(operation.target);\n            }\n            candidates.set(selectedIndices.join("\x2C")\x2C [...selectedIndices]);\n            return;\n        }\n        const ready = patternNodes.filter(node => !matched.has(node.index) && [...node.dependencies].every(dep => matched.has(dep)));\n        if (!ready.length) return;\n        const remaining = patternNodes.length - matched.size;\n        for (let operationIndex = searchStart; operationIndex <= operations.length - remaining; operationIndex++) {\n            const op = operations[operationIndex];\n            const candidateExpression = JSON.stringify(canonicalCompilerExpression(op.rhs\x2C selectedDefinitions));\n            for (const node of ready) {\n                if (candidateExpression !== node.expression) continue;\n                const nextMatched = new Set(matched); nextMatched.add(node.index);\n                const nextDefinitions = new Map(selectedDefinitions); nextDefinitions.set(op.target\x2C node.index);\n                visit(operationIndex + 1\x2C nextMatched\x2C [...selectedIndices\x2C operationIndex]\x2C nextDefinitions);\n                if (candidates.size > 1) return;\n            }\n        }\n    }\n    visit(0\x2C new Set()\x2C []\x2C new Map());\n    if (candidates.size !== 1) return null;\n    const indices = [...candidates.values()][0];\n    return { indices\x2C selected: new Set(indices) };\n}\n\nfunction collectAcyclicRegionToExit(graph\x2C entryId\x2C exitId\x2C forbidden = new Set()) {\n    if (entryId === exitId || forbidden.has(entryId) || !graph.blocks.has(entryId)) return null;\n    const ids = new Set()\x2C visiting = new Set();\n    let invalid = false;\n    function visit(id) {\n        if (invalid || id === exitId || ids.has(id)) return;\n        if (forbidden.has(id) || visiting.has(id)) { invalid = true; return; }\n        const block = graph.blocks.get(id);\n        if (!block) { invalid = true; return; }\n        const targets = transitionTargets(block.transition);\n        if (!targets.length) { invalid = true; return; }\n        visiting.add(id);\n        for (const target of targets) {\n            if (target === exitId) continue;\n            if (!graph.blocks.has(target)) { invalid = true; break; }\n            visit(target);\n            if (invalid) break;\n        }\n        visiting.delete(id);\n        ids.add(id);\n    }\n    visit(entryId);\n    if (invalid || !ids.size) return null;\n    const exitPreds = graph.predecessors.get(exitId) || [];\n    if (!exitPreds.length || exitPreds.some(id => !ids.has(id))) return null;\n    for (const id of ids) {\n        if (id === entryId) continue;\n        for (const pred of graph.predecessors.get(id) || []) if (!ids.has(pred)) return null;\n    }\n    return { ids };\n}\n\nfunction topologicalRegionOrder(graph\x2C ids\x2C entryId) {\n    const indegree = new Map([...ids].map(id => [id\x2C 0]));\n    for (const id of ids) for (const next of graph.successors.get(id) || []) if (ids.has(next)) indegree.set(next\x2C indegree.get(next) + 1);\n    if (indegree.get(entryId) !== 0) return null;\n    const queue = [entryId]\x2C order = [];\n    for (let cursor = 0; cursor < queue.length; cursor++) {\n        const id = queue[cursor]; order.push(id);\n        for (const next of graph.successors.get(id) || []) {\n            if (!ids.has(next)) continue;\n            indegree.set(next\x2C indegree.get(next) - 1);\n            if (indegree.get(next) === 0) queue.push(next);\n        }\n    }\n    return order.length === ids.size ? order : null;\n}\n\nfunction regionOperations(graph\x2C ids\x2C entryId\x2C options = {}) {\n    const order = topologicalRegionOrder(graph\x2C ids\x2C entryId);\n    if (!order) return null;\n    const operations = [];\n    const entryExtras = new Set();\n    for (const id of order) {\n        const block = graph.blocks.get(id);\n        for (let index = 0; index < block.body.length; index++) {\n            if (index === block.transitionIndex) continue;\n            const op = statementOperation(block.body[index]);\n            if (!op) {\n                if (options.allowEntryExtras === true && id === entryId) {\n                    entryExtras.add(`${id}:${index}`);\n                    continue;\n                }\n                return null;\n            }\n            operations.push({ ...op\x2C blockId: id\x2C bodyIndex: index });\n        }\n    }\n    return { operations\x2C entryExtras };\n}\n\nfunction statementReadsName(statement\x2C name) {\n    if (!statement || typeof statement !== "object" || typeof name !== "string") return false;\n    for (const rhs of statement.init || []) if (identifiersRead(rhs).has(name)) return true;\n    for (const dest of statement.variables || []) {\n        if (dest?.type === "IndexExpression" && identifiersRead(dest).has(name)) return true;\n    }\n    return false;\n}\n\nfunction dispatcherPositionTransport(graph\x2C regionIds\x2C exitBlockId\x2C stateName) {\n    if (!graph || !(regionIds instanceof Set) || typeof stateName !== "string") return { ignored: new Set() };\n    const allowed = new Set(regionIds);\n    if (Number.isInteger(exitBlockId) && graph.blocks.has(exitBlockId)) allowed.add(exitBlockId);\n    const ignored = new Set();\n    const keyOf = (blockId\x2C bodyIndex) => `${blockId}:${bodyIndex}`;\n\n    function proveRoundTrip(saveBlockId\x2C saveIndex\x2C tempName) {\n        const memo = new Map()\x2C visiting = new Set();\n        function visit(blockId\x2C startIndex) {\n            const memoKey = `${blockId}:${startIndex}`;\n            if (memo.has(memoKey)) return memo.get(memoKey);\n            if (visiting.has(memoKey)) return null;\n            visiting.add(memoKey);\n            const block = graph.blocks.get(blockId);\n            if (!block || !allowed.has(blockId)) { visiting.delete(memoKey); memo.set(memoKey\x2C null); return null; }\n            for (let index = startIndex; index < block.body.length; index++) {\n                const statement = block.body[index];\n                if (isSingleAssignment(statement\x2C stateName) && isIdentifier(statement.init[0]\x2C tempName)) {\n                    const result = new Set([keyOf(blockId\x2C index)]);\n                    visiting.delete(memoKey); memo.set(memoKey\x2C result); return result;\n                }\n                if (isSingleAssignment(statement) && isIdentifier(statement.variables[0]\x2C tempName)) {\n                    visiting.delete(memoKey); memo.set(memoKey\x2C null); return null;\n                }\n                if (statementReadsName(statement\x2C tempName)) {\n                    visiting.delete(memoKey); memo.set(memoKey\x2C null); return null;\n                }\n            }\n            const targets = graph.successors.get(blockId) || [];\n            if (!targets.length) { visiting.delete(memoKey); memo.set(memoKey\x2C null); return null; }\n            const restores = new Set();\n            for (const target of targets) {\n                if (!allowed.has(target)) { visiting.delete(memoKey); memo.set(memoKey\x2C null); return null; }\n                const result = visit(target\x2C 0);\n                if (!(result instanceof Set) || !result.size) { visiting.delete(memoKey); memo.set(memoKey\x2C null); return null; }\n                for (const value of result) restores.add(value);\n            }\n            visiting.delete(memoKey); memo.set(memoKey\x2C restores); return restores;\n        }\n        return visit(saveBlockId\x2C saveIndex + 1);\n    }\n\n    for (const blockId of regionIds) {\n        const block = graph.blocks.get(blockId);\n        if (!block) continue;\n        for (let index = 0; index < block.body.length; index++) {\n            if (index === block.transitionIndex) continue;\n            const statement = block.body[index];\n            if (!isSingleAssignment(statement) || !isIdentifier(statement.variables[0]) ||\n                statement.variables[0].name === stateName || !isIdentifier(statement.init[0]\x2C stateName)) continue;\n            const tempName = statement.variables[0].name;\n            const restores = proveRoundTrip(blockId\x2C index\x2C tempName);\n            if (!(restores instanceof Set) || !restores.size) continue;\n            ignored.add(keyOf(blockId\x2C index));\n            for (const restore of restores) ignored.add(restore);\n        }\n    }\n    return { ignored };\n}\n\nfunction normalizeConditionOperations(graph\x2C regionIds\x2C entryId\x2C exitBlockId\x2C stateName\x2C options = {}) {\n    const region = regionOperations(graph\x2C regionIds\x2C entryId\x2C options);\n    if (!region) return null;\n    const transport = dispatcherPositionTransport(graph\x2C regionIds\x2C exitBlockId\x2C stateName);\n    return {\n        operations: region.operations.filter(operation => !transport.ignored.has(`${operation.blockId}:${operation.bodyIndex}`))\x2C\n        ignored: transport.ignored\x2C\n        entryExtras: region.entryExtras\x2C\n    };\n}\n\nfunction findRealRepeatConditionRegion(graph\x2C coreIds\x2C bodyId\x2C decisionId) {\n    const decision = graph.blocks.get(decisionId);\n    if (!decision || decision.transition?.kind !== "branch") return null;\n    for (let index = 0; index < decision.transitionIndex; index++) {\n        const statement = decision.body[index];\n        if (isSingleAssignment(statement\x2C decision.transition.conditionRegister)) return null;\n    }\n    const stateAssignment = decision.body[decision.transitionIndex];\n    const stateName = isSingleAssignment(stateAssignment) && isIdentifier(stateAssignment.variables[0])\n        ? stateAssignment.variables[0].name : null;\n    if (!stateName) return null;\n    const candidates = [];\n    const forbidden = new Set([bodyId]);\n    for (const id of coreIds) {\n        if (id === bodyId || id === decisionId) continue;\n        const region = collectAcyclicRegionToExit(graph\x2C id\x2C decisionId\x2C forbidden);\n        if (!region || [...region.ids].some(member => !coreIds.has(member))) continue;\n        const incoming = graph.predecessors.get(id) || [];\n        if (!incoming.some(pred => coreIds.has(pred) && !region.ids.has(pred))) continue;\n        const normalized = normalizeConditionOperations(graph\x2C region.ids\x2C id\x2C decisionId\x2C stateName);\n        if (!normalized?.operations?.length) continue;\n        candidates.push({ entryId: id\x2C ids: region.ids\x2C operations: normalized.operations\x2C ignored: normalized.ignored\x2C stateName });\n    }\n    candidates.sort((a\x2C b) => b.ids.size - a.ids.size);\n    if (!candidates.length) return null;\n    if (candidates.length > 1 && candidates[0].ids.size === candidates[1].ids.size) return null;\n    return candidates[0];\n}\n\nfunction findDuplicatedConditionRegion(graph\x2C realRegion\x2C directPreheaderId\x2C excludedIds) {\n    const matches = [];\n    for (const id of graph.reachable) {\n        if (excludedIds.has(id) || id === directPreheaderId) continue;\n        const region = collectAcyclicRegionToExit(graph\x2C id\x2C directPreheaderId\x2C excludedIds);\n        if (!region) continue;\n        const normalized = normalizeConditionOperations(graph\x2C region.ids\x2C id\x2C directPreheaderId\x2C realRegion.stateName\x2C { allowEntryExtras: true });\n        const operations = normalized?.operations;\n        if (!operations || operations.length < realRegion.operations.length) continue;\n        const match = findUniqueStatementSubsequence(operations\x2C realRegion.operations);\n        if (!match) continue;\n        const selectedByBlock = new Map();\n        for (const index of match.indices) {\n            const op = operations[index];\n            if (!selectedByBlock.has(op.blockId)) selectedByBlock.set(op.blockId\x2C new Set());\n            selectedByBlock.get(op.blockId).add(op.bodyIndex);\n        }\n        const ignored = normalized.ignored || new Set();\n        let safe = true;\n        for (const member of region.ids) {\n            if (member === id) continue;\n            const block = graph.blocks.get(member);\n            const selected = selectedByBlock.get(member) || new Set();\n            for (let bodyIndex = 0; bodyIndex < block.body.length; bodyIndex++) {\n                if (bodyIndex === block.transitionIndex || ignored.has(`${member}:${bodyIndex}`)) continue;\n                if (!selected.has(bodyIndex)) { safe = false; break; }\n            }\n            if (!safe) break;\n        }\n        if (!safe) continue;\n        const entry = graph.blocks.get(id);\n        const selectedEntry = selectedByBlock.get(id) || new Set();\n        const entryExtras = normalized.entryExtras || new Set();\n        if (entryExtras.size) {\n            const selectedIndices = [...selectedEntry];\n            if (!selectedIndices.length) continue;\n            const firstSelected = Math.min(...selectedIndices);\n            let prefixOnly = true;\n            for (const key of entryExtras) {\n                const bodyIndex = Number(String(key).split(":").pop());\n                if (!Number.isInteger(bodyIndex) || bodyIndex >= firstSelected) { prefixOnly = false; break; }\n            }\n            if (!prefixOnly) continue;\n        }\n        const retainedStatements = [];\n        for (let bodyIndex = 0; bodyIndex < entry.body.length; bodyIndex++) {\n            if (bodyIndex === entry.transitionIndex || selectedEntry.has(bodyIndex) || ignored.has(`${id}:${bodyIndex}`)) continue;\n            retainedStatements.push(entry.body[bodyIndex]);\n        }\n        matches.push({\n            entryId: id\x2C\n            ids: region.ids\x2C\n            retainedStatements\x2C\n            removedStatementCount: match.indices.length + ignored.size\x2C\n        });\n    }\n    return matches.length === 1 ? matches[0] : null;\n}\nfunction removeDuplicateConditionFromPreheader(graph\x2C preheaderId\x2C decisionId) {\n    const preheader = graph.blocks.get(preheaderId)\x2C decision = graph.blocks.get(decisionId);\n    if (!preheader || !decision || decision.transition?.kind !== "branch") return null;\n    const real = evaluateRegisterAssignments(decision);\n    const condition = real.env.get(decision.transition.conditionRegister);\n    if (!condition) return null;\n    const pre = evaluateRegisterAssignments(preheader\x2C condition.free);\n    const candidates = pre.records.filter(record => record.value.text === condition.text);\n    if (candidates.length !== 1) return null;\n    const slice = dependencySlice(preheader\x2C candidates[0].index\x2C condition.free);\n    if (!slice || !slice.size) return null;\n    const retained = preheader.body.filter((_\x2C index) => index === preheader.transitionIndex || !slice.has(index));\n    return { retainedBody: retained\x2C condition\x2C removedStatementCount: slice.size };\n}\n\nfunction cloneLeaves(leaves) {\n    return new Map([...leaves].map(([id\x2C body]) => [id\x2C [...body]]));\n}\n\nfunction numericLiteral(value) { return { type: "NumericLiteral"\x2C value\x2C raw: String(value) }; }\nfunction syntheticJump(stateName\x2C targetId) {\n    return { type: "AssignmentStatement"\x2C var