script-source,92,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\solve.js,"use strict";\x0d\n\x0d\nconst { findVmFunction } = require("../vm-state");\x0d\nconst { findVmReturnRegister } = require("../vm-register-names");\x0d\nconst { isIdentifier } = require("./ast");\x0d\nconst {\x0d\n    extractNormalizedStateLeaves\x2C\x0d\n    findStateWhile\x2C\x0d\n    normalizeRegisterOverflowGraph\x2C\x0d\n    unwrapSingleStateLeaf\x2C\x0d\n} = require("./normalize");\x0d\nconst { matchClosureEntryProgram } = require("./closures");\x0d\nconst { matchDirectGlobalCallLeaf } = require("./direct-calls");\x0d\nconst { matchLocalRegisterProgram } = require("./linear/solver");\x0d\nconst { flattenLogicalRootLeaf } = require("./logical");\x0d\nconst { matchMultiStateLogicalLocals } = require("./structured/solver");\x0d\nconst { matchCompilerStructuredLoopProgram } = require("./control/loops");\x0d\nconst { failure\x2C unsupportedMultiState } = require("./diagnostics");\x0d\n\x0d\nfunction recoverClosure(ctx) {\x0d\n    const program = matchClosureEntryProgram(ctx.source\x2C ctx.stateWhile\x2C ctx.stateName\x2C ctx.returnName\x2C ctx.closureDiagnostics);\x0d\n    if (!program) return null;\x0d\n    return {\x0d\n        applied: true\x2C\x0d\n        mode: "fresh-closure-entry"\x2C\x0d\n        source: program.source\x2C\x0d\n        stateCount: program.stateCount\x2C\x0d\n        statementCount: program.statementCount\x2C\x0d\n        branchCount: 0\x2C\x0d\n        localCount: program.localCount\x2C\x0d\n        closureCount: program.closureCount\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction recoverLoops(ctx) {\x0d\n    const program = matchCompilerStructuredLoopProgram(ctx.source\x2C ctx.stateWhile\x2C ctx.stateName\x2C ctx.returnName);\x0d\n    if (!program) return null;\x0d\n    let mode = "fresh-structured-loops";\x0d\n    if (program.numericForLoopCount > 0 && program.whileLoopCount === 0 && program.repeatLoopCount === 0 && program.genericForLoopCount === 0) mode = "fresh-numeric-for";\x0d\n    else if (program.genericForLoopCount > 0 && program.whileLoopCount === 0 && program.repeatLoopCount === 0 && program.numericForLoopCount === 0) mode = "fresh-generic-for";\x0d\n    else if (program.repeatLoopCount > 0 && program.whileLoopCount === 0 && program.numericForLoopCount === 0 && program.genericForLoopCount === 0) mode = "fresh-repeat";\x0d\n    else if (program.whileLoopCount > 0 && program.repeatLoopCount === 0 && program.numericForLoopCount === 0 && program.genericForLoopCount === 0) mode = "fresh-while";\x0d\n    return {\x0d\n        applied: true\x2C\x0d\n        mode\x2C\x0d\n        source: program.source\x2C\x0d\n        stateCount: program.stateCount\x2C\x0d\n        statementCount: program.statementCount\x2C\x0d\n        branchCount: program.stateCount - 1\x2C\x0d\n        localCount: program.localCount\x2C\x0d\n        loopCount: program.loopCount\x2C\x0d\n        whileLoopCount: program.whileLoopCount\x2C\x0d\n        repeatLoopCount: program.repeatLoopCount\x2C\x0d\n        numericForLoopCount: program.numericForLoopCount\x2C\x0d\n        genericForLoopCount: program.genericForLoopCount\x2C\x0d\n        removedCompilerConditionStatementCount: program.removedCompilerConditionStatementCount\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction recoverFlattenedLogical(ctx) {\x0d\n    const leaves = ctx.logicalLeaves;\x0d\n    if (!leaves || leaves.size <= 1 || !leaves.has(1)) return null;\x0d\n    const flattened = flattenLogicalRootLeaf(leaves\x2C 1\x2C ctx.stateName\x2C ctx.returnName);\x0d\n    if (!flattened || flattened.consumed.size !== leaves.size) return null;\x0d\n    const program = matchLocalRegisterProgram(ctx.source\x2C flattened.leaf\x2C ctx.stateName\x2C ctx.returnName);\x0d\n    if (!program) return null;\x0d\n    return {\x0d\n        applied: true\x2C\x0d\n        mode: "fresh-multistate-logical"\x2C\x0d\n        source: program.source\x2C\x0d\n        stateCount: leaves.size\x2C\x0d\n        statementCount: program.statementCount\x2C\x0d\n        branchCount: leaves.size - 1\x2C\x0d\n        localCount: program.localCount\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction recoverStructuredLogical(ctx) {\x0d\n    const program = matchMultiStateLogicalLocals(ctx.source\x2C ctx.stateWhile\x2C ctx.stateName\x2C ctx.returnName);\x0d\n    if (!program) return null;\x0d\n    return {\x0d\n        applied: true\x2C\x0d\n        mode: "fresh-multistate-logical"\x2C\x0d\n        source: program.source\x2C\x0d\n        stateCount: program.stateCount\x2C\x0d\n        statementCount: program.statementCount\x2C\x0d\n        branchCount: program.stateCount - 1\x2C\x0d\n        localCount: program.localCount\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction recoverConditional(ctx) {\x0d\n    const program = matchMultiStateLogicalLocals(ctx.source\x2C ctx.stateWhile\x2C ctx.stateName\x2C ctx.returnName\x2C { allowConditionalIf: true });\x0d\n    if (!program) return null;\x0d\n    return {\x0d\n        applied: true\x2C\x0d\n        mode: "fresh-simple-if"\x2C\x0d\n        source: program.source\x2C\x0d\n        stateCount: program.stateCount\x2C\x0d\n        statementCount: program.statementCount\x2C\x0d\n        branchCount: 1\x2C\x0d\n        localCount: program.localCount\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction recoverLinear(ctx) {\x0d\n    const program = matchLocalRegisterProgram(ctx.source\x2C ctx.leaf\x2C ctx.stateName\x2C ctx.returnName);\x0d\n    return program && { applied: true\x2C mode: "fresh-register-locals"\x2C source: program.source\x2C stateCount: 1\x2C statementCount: program.statementCount\x2C branchCount: 0\x2C localCount: program.localCount };\x0d\n}\x0d\n\x0d\nfunction recoverDirectCalls(ctx) {\x0d\n    const calls = matchDirectGlobalCallLeaf(ctx.source\x2C ctx.leaf\x2C ctx.stateName\x2C ctx.returnName);\x0d\n    return calls && {\x0d\n        applied: true\x2C\x0d\n        mode: "fresh-direct-global-call"\x2C\x0d\n        source: calls.source\x2C\x0d\n        stateCount: 1\x2C\x0d\n        statementCount: calls.callCount\x2C\x0d\n        branchCount: 0\x2C\x0d\n        globalName: calls.globalName\x2C\x0d\n        argumentCount: calls.argumentCount\x2C\x0d\n        callCount: calls.callCount\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction recoverCallResults(ctx) {\x0d\n    const program = matchLocalRegisterProgram(ctx.source\x2C ctx.leaf\x2C ctx.stateName\x2C ctx.returnName\x2C { allowNoLocals: true });\x0d\n    return program && { applied: true\x2C mode: "fresh-call-results"\x2C source: program.source\x2C stateCount: 1\x2C statementCount: program.statementCount\x2C branchCount: 0\x2C localCount: program.localCount };\x0d\n}\x0d\n\x0d\nconst MULTI_STATE_RECOVERERS = [recoverClosure\x2C recoverLoops\x2C recoverFlattenedLogical\x2C recoverStructuredLogical\x2C recoverConditional];\x0d\nconst LINEAR_RECOVERERS = [recoverLinear\x2C recoverDirectCalls\x2C recoverCallResults];\x0d\n\x0d\nfunction solveFreshSource(source\x2C ast) {\x0d\n    if (typeof source !== "string" || !ast) return failure("Fresh beta CF requires normal output source and AST");\x0d\n    const vm = findVmFunction(ast);\x0d\n    if (!vm) return failure("Fresh beta CF: no semantically named vm function");\x0d\n    const overflow = normalizeRegisterOverflowGraph(vm.functionNode);\x0d\n    if (overflow.unsupported > 0) return failure("Fresh beta CF: dynamic RegisterOverflow index is unsupported");\x0d\n    const stateParam = (vm.functionNode.parameters || [])[0];\x0d\n    if (!isIdentifier(stateParam)) return failure("Fresh beta CF: VM state parameter is not an identifier");\x0d\n    const stateName = stateParam.name;\x0d\n    const returnName = findVmReturnRegister(vm.functionNode)?.name || null;\x0d\n    const stateWhile = findStateWhile(vm.functionNode\x2C stateName);\x0d\n    if (!stateWhile) return failure("Fresh beta CF: no while <state> dispatcher");\x0d\n\x0d\n    const ctx = {\x0d\n        source\x2C stateWhile\x2C stateName\x2C returnName\x2C\x0d\n        closureDiagnostics: {}\x2C\x0d\n        logicalLeaves: extractNormalizedStateLeaves(stateWhile\x2C stateName)\x2C\x0d\n    };\x0d\n    for (const recover of MULTI_STATE_RECOVERERS) {\x0d\n        const result = recover(ctx);\x0d\n        if (result) return result;\x0d\n    }\x0d\n\x0d\n    const leaf = unwrapSingleStateLeaf(stateWhile\x2C stateName);\x0d\n    if (!leaf) {\x0d\n        return unsupportedMultiState(ctx.logicalLeaves?.size || 0\x2C ctx.closureDiagnostics);\x0d\n    }\x0d\n    ctx.leaf = leaf;\x0d\n    for (const recover of LINEAR_RECOVERERS) {\x0d\n        const result = recover(ctx);\x0d\n        if (result) return result;\x0d\n    }\x0d\n    return failure("Fresh beta CF: one-state leaf is not a proven direct global-call/register-local program");\x0d\n}\x0d\n\x0d\nfunction solveBetaControlFlow(sourceOrAst\x2C astOrBeta) {\x0d\n    if (typeof sourceOrAst === "string") return solveFreshSource(sourceOrAst\x2C astOrBeta);\x0d\n    return failure("Fresh beta CF no longer consumes beta register-version analysis; pass normal output source + AST");\x0d\n}\x0d\n\x0d\nmodule.exports = { solveBetaControlFlow\x2C solveFreshSource };\x0d\n
