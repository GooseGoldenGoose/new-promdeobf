\n        if (isIdentifier(node)) {\x0d\n            const value = env.get(node.name);\x0d\n            if (value?.kind === "captured-closure") {\x0d\n                if (typeof options.renderCapturedCall !== "function") return null;\x0d\n                const captureNames = new Map();\x0d\n                for (let i = 0; i < value.captureRefs.length; i++) {\x0d\n                    const ref = value.captureRefs[i];\x0d\n                    const captureName = typeof ref === "string" ? ref : localCells.get(ref.localCell);\x0d\n                    if (typeof captureName !== "string") return null;\x0d\n                    captureNames.set(i + 1\x2C captureName);\x0d\n                }\x0d\n                return options.renderCapturedCall(value.call\x2C captureNames);\x0d\n            }\x0d\n            return typeof value === "string" ? value : null;\x0d\n        }\x0d\n        if (node?.type === "IndexExpression") {\x0d\n            if (isIdentifier(node.base\x2C "upvalueValues") && isIdentifier(node.index)) {\x0d\n                const localName = localCells.get(node.index.name);\x0d\n                return typeof localName === "string" ? localName : null;\x0d\n            }\x0d\n            if (isIdentifier(node.base\x2C "upvalueValues") && node.index?.type === "IndexExpression" &&\x0d\n                isIdentifier(node.index.base\x2C "upvalues") && node.index.index?.type === "NumericLiteral" &&\x0d\n                options.captureNames instanceof Map) {\x0d\n                const slot = Number(node.index.index.value);\x0d\n                if (!Number.isInteger(slot) || slot < 1) return null;\x0d\n                return options.captureNames.get(slot) ?? null;\x0d\n            }\x0d\n            if (isIdentifier(node.base\x2C "args") && node.index?.type === "NumericLiteral") {\x0d\n                const index = Number(node.index.value);\x0d\n                if (!Number.isInteger(index) || index < 1) return null;\x0d\n                while (paramNames.length < index) paramNames.push(allocateClosureBindingName());\x0d\n                return paramNames[index - 1];\x0d\n            }\x0d\n            if (!isIdentifier(node.base) || !isIdentifier(node.index)) return null;\x0d\n            const key = env.get(node.index.name);\x0d\n            if (key == null) return null;\x0d\n            if (node.base.name === "_env") {\x0d\n                const globalName = /^"[A-Za-z_][A-Za-z0-9_]*"$/.test(key) ? key.slice(1\x2C -1) : null;\x0d\n                return globalName && isLuaIdentifier(globalName) ? globalName : `_env[${key}]`;\x0d\n            }\x0d\n            const base = env.get(node.base.name);\x0d\n            if (base == null) return null;\x0d\n            const member = /^"[A-Za-z_][A-Za-z0-9_]*"$/.test(key) ? key.slice(1\x2C -1) : null;\x0d\n            return member && isLuaIdentifier(member) ? `${base}.${member}` : `${base}[${key}]`;\x0d\n        }\x0d\n        if (node?.type === "UnaryExpression") {\x0d\n            const argument = resolveNode(node.argument);\x0d\n            return renderUnary(node.operator\x2C argument);\x0d\n        }\x0d\n        if ((node?.type === "BinaryExpression" || node?.type === "LogicalExpression") && node.operator) {\x0d\n            const left = resolveNode(node.left);\x0d\n            const right = resolveNode(node.right);\x0d\n            if (left == null || right == null) return null;\x0d\n            return `(${left} ${node.operator} ${right})`;\x0d\n        }\x0d\n        if (node?.type === "CallExpression" && isIdentifier(node.base)) {\n            const rawVarargIndex = compilerVarargSelectIndex(node);\n            if (rawVarargIndex !== null && rawVarargIndex === compilerVarargFirstIndex) {\n                sawVarargs = true;\n                return "...";\n            }\x0d\n            if (node.base.name === "unpack" && (node.arguments || []).length === 1 && isIdentifier(node.arguments[0])) {\x0d\n                const packed = envMeta.get(node.arguments[0].name);\x0d\n                if (packed?.kind === "return-pack") return packed.call;\x0d\n                if (packed?.kind === "vararg-pack") { sawVarargs = true; return "..."; }\x0d\n            }\x0d\n            if (typeof options.renderSpecialCall === "function") {\x0d\n                const special = options.renderSpecialCall(node);\x0d\n                if (special != null) return special;\x0d\n            }\x0d\n            const base = env.get(node.base.name);\x0d\n            if (base == null) return null;\x0d\n            const args = [];\x0d\n            for (const arg of node.arguments || []) {\x0d\n                const value = resolveNode(arg);\x0d\n                if (value == null) return null;\x0d\n                args.push(value);\x0d\n            }\x0d\n            const member = envMeta.get(node.base.name);\x0d\n            if (member?.kind === "member" && args.length > 0 && args[0] === member.base) {\x0d\n                return `${member.base}:${member.member}(${args.slice(1).join("\x2C ")})`;\x0d\n            }\x0d\n            return renderCallable(base\x2C args);\x0d\n        }\x0d\n        return null;\x0d\n    }\x0d\n\x0d\n    for (let index = 0; index < leaf.length; index++) {\x0d\n        const statement = leaf[index];\x0d\n        if (!isSingleAssignment(statement)) return null;\x0d\n        const dest = statement.variables[0];\x0d\n        const rhs = statement.init[0];\x0d\n\x0d\n        if (dest?.type === "IndexExpression" && isIdentifier(dest.base\x2C "upvalueValues")) {\x0d\n            if (isIdentifier(dest.index)) {\x0d\n                const cell = env.get(dest.index.name);\x0d\n                if (cell?.kind !== "upvalue-cell") return null;\x0d\n                const value = resolveNode(rhs);\x0d\n                if (typeof value !== "string") return null;\x0d\n                const existingName = localCells.get(dest.index.name);\x0d\n                if (typeof existingName === "string") {\x0d\n                    body.push(`${existingName} = ${value}`);\x0d\n                    continue;\x0d\n                }\x0d\n                const capturedParameterInit = rhs?.type === "IndexExpression" &&\x0d\n                    isIdentifier(rhs.base\x2C "args") && rhs.index?.type === "NumericLiteral";\x0d\n                if (capturedParameterInit) {\x0d\n                    if (!isLuaIdentifier(value)) return null;\x0d\n                    localCells.set(dest.index.name\x2C value);\x0d\n                    continue;\x0d\n                }\x0d\n                const localName = allocateClosureBindingName();\x0d\n                localCells.set(dest.index.name\x2C localName);\x0d\n                body.push(`local ${localName} = ${value}`);\x0d\n                continue;\x0d\n            }\x0d\n            if (dest.index?.type === "IndexExpression" && isIdentifier(dest.index.base\x2C "upvalues") &&\x0d\n                dest.index.index?.type === "NumericLiteral" && options.captureNames instanceof Map) {\x0d\n                const slot = Number(dest.index.index.value);\x0d\n                if (!Number.isInteger(slot) || slot < 1) return null;\x0d\n                const captureName = options.captureNames.get(slot);\x0d\n                const value = resolveNode(rhs);\x0d\n                if (typeof captureName !== "string" || typeof value !== "string") return null;\x0d\n                body.push(captureName + " = " + value);\x0d\n                continue;\x0d\n            }\x0d\n            return null;\x0d\n        }\x0d\n\x0d\n        if (dest?.type === "IndexExpression" && isIdentifier(dest.base) && isIdentifier(dest.index)) {\x0d\n            const key = resolveNode(dest.index);\x0d\n            const value = resolveNode(rhs);\x0d\n            if (typeof key !== "string" || typeof value !== "string") return null;\x0d\n            const fieldName = /^"[A-Za-z_][A-Za-z0-9_]*"$/.test(key) ? key.slice(1\x2C -1) : null;\x0d\n            if (dest.base.name === "_env") {\x0d\n                if (!fieldName || !isLuaIdentifier(fieldName)) return null;\x0d\n                body.push(`${fieldName} = ${value}`);\x0d\n                continue;\x0d\n            }\x0d\n            const base = resolveNode(dest.base);\x0d\n            const baseMeta = envMeta.get(dest.base.name);\x0d\n            const stableBase = baseMeta?.kind === "table" || baseMeta?.kind === "member" || baseMeta?.kind === "stable-ref";\x0d\n            if (typeof base !== "string" || !stableBase) return null;\x0d\n            const target = fieldName && isLuaIdentifier(fieldName) ? `${base}.${fieldName}` : `${base}[${key}]`;\x0d\n            body.push(`${target} = ${value}`);\x0d\n            continue;\x0d\n        }\x0d\n        if (!isIdentifier(dest)) return null;\x0d\n        const name = dest.name;\x0d\n\x0d\n        if (name === stateName && rhs?.type === "NilLiteral") {\n            // The dispatcher stops after this block\x2C but later statements in the\n            // same block still observe the assigned nil value. Do not retain the\n            // previous state payload (commonly a just-created closure) across\n            // this overwrite.\n            env.set(stateName\x2C "nil");\n            envMeta.delete(stateName);\n            sawStop = true;\n            continue;\n        }\x0d\n        if (name === returnName && rhs?.type === "TableConstructorExpression") {\x0d\n            const values = [];\x0d\n            for (const field of rhs.fields || []) {\x0d\n                if (field?.type !== "TableValue") return null;\x0d\n                const value = resolveNode(field.value);\x0d\n                if (value == null) return null;\x0d\n                values.push(value);\x0d\n            }\x0d\n            const fields = rhs.fields || [];\x0d\n            const isSingleCallPack = fields.length === 1 && fields[0]?.type === "TableValue" && fields[0].value?.type === "CallExpression";\x0d\n            if (isSingleCallPack && valueUsedBeforeOverwrite(index\x2C returnName)) {\x0d\n                env.set(returnName\x2C values[0]);\x0d\n                envMeta.set(returnName\x2C { kind: "return-pack"\x2C call: values[0] });\x0d\n                continue;\x0d\n            }\x0d\n            if (values.length > 0) body.push(`return ${values.join("\x2C ")}`);\x0d\n            sawReturn = true;\x0d\n            continue;\x0d\n        }\x0d\n        if (rhs?.type === "NilLiteral" && name !== stateName && name !== returnName) {\n            // Nil can be semantic source data or dead compiler cleanup. Preserve\n            // the exact nil definition only when it reaches a read before the\n            // next overwrite; otherwise dropping it is safe compiler cleanup.\n            if (valueUsedBeforeOverwrite(index\x2C name)) env.set(name\x2C "nil");\n            else env.delete(name);\n            envMeta.delete(name);\n            continue;\n        }\x0d\n\x0d\n        if (rhs?.type === "CallExpression" && isIdentifier(rhs.base\x2C "allocUpvalue") && (rhs.arguments || []).length === 0) {\x0d\n            env.set(name\x2C { kind: "upvalue-cell" });\x0d\n            continue;\x0d\n        }\x0d\n\x0d\n        if (rhs?.type === "CallExpression" && isIdentifier(rhs.base) && /^createClosure\\d*$/.test(rhs.base.name)) {\x0d\n            const args = rhs.arguments || [];\x0d\n            const fields = args[1]?.type === "TableConstructorExpression" ? args[1].fields || [] : [];\x0d\n            if (fields.length > 0) {\x0d\n                const captureRefs = [];\x0d\n                for (const field of fields) {\x0d\n                    if (field?.type !== "TableValue") return null;\x0d\n                    if (isIdentifier(field.value)) {\x0d\n                        const cell = env.get(field.value.name);\x0d\n                        if (cell?.kind !== "upvalue-cell") return null;\x0d\n                        const captureName = localCells.get(field.value.name);\x0d\n                        captureRefs.push(captureName ?? { localCell: field.value.name });\x0d\n                        continue;\x0d\n                    }\x0d\n                    if (field.value?.type === "IndexExpression" && isIdentifier(field.value.base\x2C "upvalues") && field.value.index?.type === "NumericLiteral" && options.captureNames instanceof Map) {\x0d\n                        const slot = Number(field.value.index.value);\x0d\n                        const captureName = options.captureNames.get(slot);\x0d\n                        if (typeof captureName !== "string") return null;\x0d\n                        captureRefs.push(captureName);\x0d\n                        continue;\x0d\n                    }\x0d\n                    return null;\x0d\n                }\x0d\n                env.set(name\x2C { kind: "captured-closure"\x2C call: rhs\x2C captureRefs });\x0d\n                continue;\x0d\n            }\x0d\n        }\x0d\n\x0d\n        if (rhs?.type === "IndexExpression" && isIdentifier(rhs.base\x2C "_env") && isIdentifier(rhs.index) && !env.has(rhs.index.name)) {\x0d\n            const next = leaf[index + 1];\x0d\n            if (isSingleAssignment(next\x2C rhs.index.name)) {\x0d\n                const globalName = decodeJsonStringLiteral(next.init[0]);\x0d\n                if (globalName && isLuaIdentifier(globalName)) {\x0d\n                    env.set(name\x2C globalName);\x0d\n                    continue;\x0d\n                }\x0d\n            }\x0d\n        }\x0d\n\x0d\n        // A captured closure may be created before the compiler writes the\x0d\n        // first value into one of its freshly allocated cells. Prometheus can\x0d\n        // then hand that closure through state/ReturnVal into an ordinary TEMP.\x0d\n        // Preserve the deferred closure object across that compiler transport;\x0d\n        // resolve it only at its first semantic use\x2C after the cell binding has\x0d\n        // been initialized. This is not a source alias promotion.\x0d\n        if (isIdentifier(rhs) && (rhs.name === stateName || rhs.name === returnName)) {\x0d\n            const deferredClosure = env.get(rhs.name);\x0d\n            if (deferredClosure?.kind === "captured-closure") {\x0d\n                env.set(name\x2C deferredClosure);\x0d\n                envMeta.delete(name);\x0d\n                continue;\x0d\n            }\x0d\n        }\x0d\n\x0d\n        let member = null;\x0d\n        if (rhs?.type === "IndexExpression" && isIdentifier(rhs.base) && isIdentifier(rhs.index) && rhs.base.name !== "_env") {\x0d\n            const key = env.get(rhs.index.name);\x0d\n            const baseValue = env.get(rhs.base.name);\x0d\n            const memberName = typeof key === "string" && /^"[A-Za-z_][A-Za-z0-9_]*"$/.test(key) ? key.slice(1\x2C -1) : null;\x0d\n            if (typeof baseValue === "string" && memberName && isLuaIdentifier(memberName)) member = { kind: "member"\x2C base: baseValue\x2C member: memberName };\x0d\n        }\x0d\n        const value = resolveNode(rhs);\x0d\n        if (value == null) return null;\x0d\n        const inheritedTableMeta = isIdentifier(rhs) ? envMeta.get(rhs.name) : null;\x0d\n        const needsTableIdentity = valueUsedAsIndexWriteBaseBeforeOverwrite(index\x2C name) && (\x0d\n            rhs?.type === "TableConstructorExpression" ||\x0d\n            (inheritedTableMeta?.kind === "table" && !isLuaIdentifier(value))\x0d\n        );\x0d\n        if (needsTableIdentity) {\x0d\n            // A table TEMP that becomes an index-write base has observable identity.\x0d\n            // Materialize this exact epoch once so the mutation and later reads refer\x0d\n            // to the same table instead of re-rendering independent constructors.\x0d\n            // Follow compiler aliases too: state/ReturnVal may temporarily carry the\x0d\n            // constructor before the ordinary register used for the field write.\x0d\n            const displayName = allocateClosureBindingName();\x0d\n            body.push(`local ${displayName} = ${value}`);\x0d\n            env.set(name\x2C displayName);\x0d\n            envMeta.set(name\x2C { kind: "table" });\x0d\n            continue;\x0d\n        }\x0d\n        if (rhs?.type === "CallExpression" && !valueUsedBeforeOverwrite(index\x2C name)) body.push(value);\x0d\n        env.set(name\x2C value);\x0d\n        const fields = rhs?.type === "TableConstructorExpression" ? (rhs.fields || []) : [];\x0d\n        if (fields.length === 1 && fields[0]?.type === "TableValue" && fields[0].value?.type === "CallExpression") {\x0d\n            const call = resolveNode(fields[0].value);\x0d\n            if (typeof call !== "string") return null;\x0d\n            envMeta.set(name\x2C call === "..." ? { kind: "vararg-pack" } : { kind: "return-pack"\x2C call });\x0d\n        } else if (member) {\x0d\n            envMeta.set(name\x2C member);\x0d\n        } else if (rhs?.type === "TableConstructorExpression") {\x0d\n            envMeta.set(name\x2C { kind: "table" });\x0d\n        } else if (rhs?.type === "IndexExpression" && (\x0d\n            (isIdentifier(rhs.base\x2C "args") && rhs.index?.type === "NumericLiteral") ||\x0d\n            isIdentifier(rhs.base\x2C "upvalueValues")\x0d\n        )) {\x0d\n            envMeta.set(name\x2C { kind: "stable-ref" });\x0d\n        } else if (isIdentifier(rhs) && envMeta.has(rhs.name)) {\x0d\n            envMeta.set(name\x2C envMeta.get(rhs.name));\x0d\n        } else {\x0d\n            envMeta.delete(name);\x0d\n        }\x0d\n    }\x0d\n\x0d\n    if (!sawReturn || !sawStop) return null;\x0d\n    const lines = body.length ? body.map(line => line.split("\\n").map(part => `    ${part}`).join("\\n")).join("\\n") : "";\x0d\n    const params = [...paramNames];\x0d\n    if (sawVarargs) params.push("...");\x0d\n    return `function(${params.join("\x2C ")})${lines ? `\\n${lines}\\n` : ""}end`;\x0d\n}\x0d\n\x0d\nfunction matchClosureEntryProgram(source\x2C stateWhile\x2C stateName\x2C returnName\x2C diagnostics = null) {\x0d\n    const extractedLeaves = extractNormalizedStateLeaves(stateWhile\x2C stateName);\x0d\n    if (!extractedLeaves || extractedLeaves.size < 2 || !extractedLeaves.has(1)) return null;\x0d\n    const leaves = extractedLeaves;\x0d\n    const consumedEntries = new Set();\x0d\n    const renderedClosureEntries = new Set();\x0d\n    const renderingEntries = new Set();\x0d\n    const renderedClosureCache = new Map();\x0d\n\x0d\n    function restoreConsumedEntries(stateSnapshot\x2C closureSnapshot) {\x0d\n        for (const id of [...consumedEntries]) if (!stateSnapshot.has(id)) consumedEntries.delete(id);\x0d\n        for (const id of [...renderedClosureEntries]) if (!closureSnapshot.has(id)) renderedClosureEntries.delete(id);\x0d\n        for (const id of [...renderedClosureCache.keys()]) if (!renderedClosureEntries.has(id)) renderedClosureCache.delete(id);\x0d\n    }\x0d\n\x0d\n    function captureSignature(fields\x2C captureNames) {\x0d\n        if (captureNames === null) return fields.length === 0 ? "[]" : null;\x0d\n        if (!(captureNames instanceof Map) || fields.length !== captureNames.size) return null;\x0d\n        const names = [];\x0d\n        for (let slot = 1; slot <= fields.length; slot++) {\x0d\n            const name = captureNames.get(slot);\x0d\n            if (typeof name !== "string") return null;\x0d\n            names.push(name);\x0d\n        }\x0d\n        return JSON.stringify(names);\x0d\n    }\x0d\n\x0d\n    function renderClosureCall(call\x2C captureNames = null) {\x0d\n        if (call?.type !== "CallExpression" || !isIdentifier(call.base) || !/^createClosure\\d*$/.test(call.base.name)) return null;\x0d\n        const args = call.arguments || [];\x0d\n        if (args.length !== 2 || args[0]?.type !== "NumericLiteral" || args[1]?.type !== "TableConstructorExpression") return null;\x0d\n        const fields = args[1].fields || [];\x0d\n        const signature = captureSignature(fields\x2C captureNames);\x0d\n        if (signature === null) return null;\x0d\n        const entryId = Number(args[0].value);\x0d\n        if (!Number.isInteger(entryId) || entryId === 1 || renderingEntries.has(entryId)) return null;\x0d\n        const cached = renderedClosureCache.get(entryId);\x0d\n        if (cached) {\x0d\n            if (!consumedEntries.has(entryId) || !renderedClosureEntries.has(entryId) || cached.signature !== signature) return null;\x0d\n            return cached.source;\x0d\n        }\x0d\n        if (consumedEntries.has(entryId)) return null;\x0d\n        const childLeaf = leaves.get(entryId);\x0d\n        if (!childLeaf) return null;\x0d\n\x0d\n        const snapshot = new Set(consumedEntries);\x0d\n        const closureSnapshot = new Set(renderedClosureEntries);\x0d\n        renderingEntries.add(entryId);\x0d\n        let rendered = renderSimpleClosureLeaf(source\x2C childLeaf\x2C stateName\x2C returnName\x2C {\x0d\n            renderSpecialCall: renderClosureCall\x2C\x0d\n            renderCapturedCall: renderClosureCall\x2C\x0d\n            captureNames: captureNames instanceof Map ? captureNames : undefined\x2C\x0d\n        });\x0d\n        if (rendered) {\x0d\n            consumedEntries.add(entryId);\x0d\n            renderedClosureEntries.add(entryId);\x0d\n            renderingEntries.delete(entryId);\x0d\n            renderedClosureCache.set(entryId\x2C { signature\x2C source: rendered });\x0d\n            return rendered;\x0d\n        }\x0d\n\x0d\n        restoreConsumedEntries(snapshot\x2C closureSnapshot);\x0d\n        const childOptions = {\x0d\n            allowConditionalIf: true\x2C\x0d\n            allowLogicalOnlyStructured: true\x2C\n            allowStraightLineStructured: true\x2C\n            normalizedLeaves: leaves\x2C\x0d\n            rootReachableOnly: true\x2C\x0d\n            entryId\x2C\x0d\n            captureNames: captureNames instanceof Map ? captureNames : undefined\x2C\x0d\n            renderAsFunction: true\x2C\x0d\n            renderSpecialCall: renderClosureCall\x2C\x0d\n            renderCapturedCall: renderClosureCall\x2C\x0d\n        };\x0d\n        const loopStructured = matchCompilerStructuredLoopProgram(source\x2C stateWhile\x2C stateName\x2C returnName\x2C childOptions);\x0d\n        if (loopStructured) {\x0d\n            const childStates = loopStructured.reachableStateIds || [];\x0d\n            const overlaps = childStates.some(id => snapshot.has(id));\x0d\n            if (!overlaps && childStates.includes(entryId)) {\x0d\n                for (const id of childStates) consumedEntries.add(id);\x0d\n                renderedClosureEntries.add(entryId);\x0d\n                renderingEntries.delete(entryId);\x0d\n                renderedClosureCache.set(entryId\x2C { signature\x2C source: loopStructured.source });\x0d\n                return loopStructured.source;\x0d\n            }\x0d\n        }\x0d\n\x0d\n        restoreConsumedEntries(snapshot\x2C closureSnapshot);\x0d\n        const structured = matchMultiStateLogicalLocals(source\x2C stateWhile\x2C stateName\x2C returnName\x2C childOptions);\x0d\n        if (structured) {\x0d\n            const childStates = structured.reachableStateIds || [];\x0d\n            const overlaps = childStates.some(id => snapshot.has(id));\x0d\n            if (!overlaps && childStates.includes(entryId)) {\x0d\n                for (const id of childStates) consumedEntries.add(id);\x0d\n                renderedClosureEntries.add(entryId);\x0d\n                renderingEntries.delete(entryId);\x0d\n                renderedClosureCache.set(entryId\x2C { signature\x2C source: structured.source });\x0d\n                return structured.source;\x0d\n            }\x0d\n        }\x0d\n\x0d\n        restoreConsumedEntries(snapshot\x2C closureSnapshot);\x0d\n        renderingEntries.delete(entryId);\x0d\n        return null;\x0d\n    }\x0d\n\x0d\n    // Root CFGs that contain both a proven while region and child closures\x0d\n    // must use the same transactional closure renderer as child-entry while\x0d\n    // recovery. Otherwise createClosureN calls inside the loop body are seen\x0d\n    // as ordinary calls and the while path fails before child states can be\x0d\n    // consumed. Keep this attempt isolated so a failed loop proof cannot\x0d\n    // contaminate the ordinary structured/legacy closure paths below.\x0d\n    const rootSnapshot = new Set(consumedEntries);\x0d\n    const rootClosureSnapshot = new Set(renderedClosureEntries);\x0d\n    const loopProgram = matchCompilerStructuredLoopProgram(source\x2C stateWhile\x2C stateName\x2C returnName\x2C {\x0d\n        allowConditionalIf: true\x2C\x0d\n        normalizedLeaves: leaves\x2C\x0d\n        rootReachableOnly: true\x2C\x0d\n        renderSpecialCall: renderClosureCall\x2C\x0d\n        renderCapturedCall: renderClosureCall\x2C\x0d\n    });\x0d\n    if (loopProgram && consumedEntries.size > 0) {\x0d\n        const accounted = new Set([...(loopProgram.reachableStateIds || [])\x2C ...consumedEntries]);\x0d\n        if (accounted.size === leaves.size && [...leaves.keys()].every(id => accounted.has(id))) {\x0d\n            return { ...loopProgram\x2C stateCount: leaves.size\x2C closureCount: renderedClosureEntries.size };\x0d\n        }\x0d\n    }\x0d\n    restoreConsumedEntries(rootSnapshot\x2C rootClosureSnapshot);\x0d\n\x0d\n    // Mixed root CFGs may contain logical-value regions feeding real\x0d\n    // if/elseif/else branches. Recover them with the structural multi-state\x0d\n    // solver instead of requiring the whole closure root to flatten into one\x0d\n    // logical leaf. Only root-reachable states participate in its lifetime\x0d\n    // proof; createClosureN calls render/consume separate child entries.\x0d\n    const structuredProgram = matchMultiStateLogicalLocals(source\x2C stateWhile\x2C stateName\x2C returnName\x2C {\x0d\n        allowConditionalIf: true\x2C\x0d\n        allowLogicalOnlyStructured: true\x2C\n        allowStraightLineStructured: true\x2C\n        normalizedLeaves: leaves\x2C\x0d\n        rootReachableOnly: true\x2C\x0d\n        renderSpecialCall: renderClosureCall\x2C\x0d\n        renderCapturedCall: renderClosureCall\x2C\x0d\n    });\x0d\n    if (structuredProgram && consumedEntries.size > 0) {\x0d\n        const accounted = new Set([...(structuredProgram.reachableStateIds || [])\x2C ...consumedEntries]);\x0d\n        if (accounted.size === leaves.size && [...leaves.keys()].every(id => accounted.has(id))) {\x0d\n            return { ...structuredProgram\x2C stateCount: leaves.size\x2C closureCount: renderedClosureEntries.size };\x0d\n        }\x0d\n    }\x0d\n\x0d\n    // Legacy closure path remains for roots that are entirely reducible to a\x0d\n    // flattened logical/register-local leaf\x2C including existing capture cases.\x0d\n    consumedEntries.clear();\x0d\n    renderedClosureEntries.clear();\x0d\n    renderedClosureCache.clear();\x0d\n    const rootDiagnostics = {};\x0d\n    const flattenedRoot = flattenLogicalRootLeaf(leaves\x2C 1\x2C stateName\x2C returnName\x2C rootDiagnostics);\x0d\n    for (const id of (flattenedRoot ? flattenedRoot.consumed : [1])) consumedEntries.add(id);\x0d\n    const root = flattenedRoot?.leaf || leaves.get(1);\x0d\n    const rootProgramDiagnostics = {};\x0d\n    const program = matchLocalRegisterProgram(source\x2C root\x2C stateName\x2C returnName\x2C { renderSpecialCall: renderClosureCall\x2C renderCapturedCall: renderClosureCall\x2C diagnostics: rootProgramDiagnostics\x2C allowNoLocals: true });\x0d\n    if (!program) {\x0d\n        if (diagnostics && !diagnostics.reason) {\x0d\n            diagnostics.reason = flattenedRoot ? "flattened root is not a proven register-local program" : (rootDiagnostics.reason || "root is not a proven register-local program");\x0d\n            diagnostics.state = rootDiagnostics.state || 1;\x0d\n            diagnostics.statementIndex = rootProgramDiagnostics.statementIndex;\x0d\n            diagnostics.statement = rootProgramDiagnostics.statement;\x0d\n        }\x0d\n        return null;\x0d\n    }\x0d\n    const rootStateCount = flattenedRoot ? flattenedRoot.consumed.size : 1;\x0d\n    if (consumedEntries.size === rootStateCount) { if (diagnostics) diagnostics.reason = "root recovered but no child closure entry was consumed"; return null; }\x0d\n    if (consumedEntries.size !== leaves.size) {\x0d\n        if (diagnostics) { diagnostics.reason = "not all normalized state leaves were consumed"; diagnostics.unconsumed = [...leaves.keys()].filter(id => !consumedEntries.has(id)); }\x0d\n        return null;\x0d\n    }\x0d\n    return { ...program\x2C stateCount: leaves.size\x2C closureCount: renderedClosureEntries.size };\x0d\n}\x0d\n\x0d\nmodule.exports = { renderSimpleClosureLeaf\x2C matchClosureEntryProgram };\x0d\n
