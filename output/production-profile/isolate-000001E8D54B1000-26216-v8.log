script-source,113,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\structured\\context.js,"use strict";\x0d\n\x0d\nconst { isEmptyTable\x2C isIdentifier\x2C isLuaIdentifier\x2C isPrimitiveLiteral\x2C isSingleAssignment\x2C isVmRegisterName\x2C renderTableFields\x2C renderUnary\x2C sourceOf } = require("../ast");\x0d\nconst { createStateGraph } = require("../cfg");\x0d\nconst { extractNormalizedStateLeaves } = require("../normalize");\x0d\nconst { reduceCompilerLogicalStateGraph } = require("../logical");\x0d\nconst { inferCompilerVarargFirstIndex } = require("../varargs");\x0d\n\x0d\nfunction createStructuredContext(source\x2C stateWhile\x2C stateName\x2C returnName\x2C options = {}) {\x0d\n    const allowConditionalIf = options.allowConditionalIf === true;\x0d\n    const rootReachableOnly = options.rootReachableOnly === true;\x0d\n    const entryId = Number.isInteger(options.entryId) ? options.entryId : 1;\x0d\n    const captureNames = options.captureNames instanceof Map ? options.captureNames : null;\x0d\n    const renderAsFunction = options.renderAsFunction === true;\x0d\n    const originalLeaves = options.normalizedLeaves instanceof Map\x0d\n        ? new Map([...options.normalizedLeaves].map(([id\x2C body]) => [id\x2C [...body]]))\x0d\n        : extractNormalizedStateLeaves(stateWhile\x2C stateName);\x0d\n    if (!originalLeaves || originalLeaves.size < 2 || !originalLeaves.has(entryId)) return null;\x0d\n    const varargFirstIndex = renderAsFunction ? inferCompilerVarargFirstIndex(originalLeaves.get(entryId) || []) : null;\x0d\n    const logicalReduction = allowConditionalIf\x0d\n        ? reduceCompilerLogicalStateGraph(originalLeaves\x2C entryId\x2C stateName\x2C returnName)\x0d\n        : { leaves: originalLeaves\x2C originalReachableStateIds: new Set(originalLeaves.keys()) };\x0d\n    const leaves = logicalReduction.leaves;\x0d\n\x0d\n    const graph = createStateGraph(leaves\x2C entryId\x2C stateName\x2C { reachableOnly: rootReachableOnly });\x0d\n    if (!graph) return null;\x0d\n    const { blocks\x2C successors\x2C predecessors\x2C reachable } = graph;\x0d\n    if (!rootReachableOnly && reachable.size !== blocks.size) return null;\x0d\n\x0d\n    // Lifetime/storage proof belongs to one VM invocation root. Child closure\x0d\n    // entry states reuse the same physical register names but execute in a\x0d\n    // separate invocation\x2C so unreachable child states must never contribute\x0d\n    // cleanup/definition evidence to the root program.\x0d\n    const cleanupRegs = new Set();\x0d\n    for (const id of reachable) {\x0d\n        const body = blocks.get(id)?.body || [];\x0d\n        for (const statement of body) {\x0d\n            if (!isSingleAssignment(statement)) continue;\x0d\n            const dest = statement.variables[0];\x0d\n            const rhs = statement.init[0];\x0d\n            if (isIdentifier(dest) && dest.name !== stateName && dest.name !== returnName && rhs?.type === "NilLiteral") cleanupRegs.add(dest.name);\x0d\n        }\x0d\n    }\x0d\n    if (!cleanupRegs.size && !allowConditionalIf) return null;\x0d\n\x0d\n    const nonNilDefinitionCount = new Map([...cleanupRegs].map(name => [name\x2C 0]));\x0d\n    for (const id of reachable) {\x0d\n        const body = blocks.get(id)?.body || [];\x0d\n        for (const statement of body) {\x0d\n            if (!isSingleAssignment(statement)) continue;\x0d\n            const dest = statement.variables[0];\x0d\n            const rhs = statement.init[0];\x0d\n            if (isIdentifier(dest) && cleanupRegs.has(dest.name) && rhs?.type !== "NilLiteral") {\x0d\n                nonNilDefinitionCount.set(dest.name\x2C nonNilDefinitionCount.get(dest.name) + 1);\x0d\n            }\x0d\n        }\x0d\n    }\x0d\n    const accumulatorRegs = new Set([...cleanupRegs].filter(name => nonNilDefinitionCount.get(name) > 1));\x0d\n\x0d\n    const indegree = new Map();\x0d\n    for (const id of reachable) indegree.set(id\x2C (predecessors.get(id) || []).filter(p => reachable.has(p)).length);\x0d\n    const processingQueue = [entryId];\x0d\n    const incoming = new Map([[entryId\x2C [{ env: new Map()\x2C markers: []\x2C effects: [] }]]]);\x0d\n    const processed = new Set();\x0d\n    const locals = new Set();\x0d\n    const localNames = new Map();\x0d\n    const terminalLiveLocals = new Set();\x0d\n    // Branch-local source bindings are path-scoped. Their generated source\x0d\n    // names live in the candidate environment instead of the global physical-\x0d\n    // register local map\x2C so sibling CFG paths may safely reuse one VM register.\x0d\n    const pathLocalBindingNames = new Set();\x0d\n    // Candidate-local owner identity is separate from rendered value identity.\x0d\n    // Compiler aliases may resolve to the same source display but must never be\x0d\n    // allowed to mutate that binding merely because their rendered strings match.\x0d\n    const pathLocalOwnerPrefix = "\\0freshPathLocalOwner:";\x0d\n    const deadJoinTempPrefix = "\\0freshDeadJoinTemp:";\x0d\n    // Root-local upvalue cells are compiler binding-identity transport. Keep\x0d\n    // their recovered source bindings separate from ordinary VM register\x0d\n    // locals so captured aliases can be rendered across conditional states.\x0d\n    const upvalueCells = new Set();\x0d\n    const upvalueCellBindings = new Map();\x0d\n    // Physical cell registers are reusable compiler storage. Give each allocUpvalue\x0d\n    // epoch its own identity so deferred closures capture cell identity instead\x0d\n    // of a physical register name. Candidate envs hold the binding evidence.\x0d\n    const upvalueCellIdentities = new Map();\x0d\n    const upvalueCellIdentityBindingPrefix = "\\0freshUpvalueCellBinding:";\x0d\n    let nextUpvalueCellIdentity = 1;\x0d\n    const upvalueAliasPrefix = "\\0freshUpvalueAlias:";\x0d\n    // Upvalue cells allocated inside a structured branch/loop are path-local\x0d\n    // compiler transport