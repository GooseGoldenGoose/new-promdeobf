C name) {\x0d\n        for (let probe = beforeIndex - 1; probe >= 0; probe--) {\x0d\n            const prior = decodeVmStatement(ctx.leaf[probe]);\x0d\n            if (prior?.kind === "register-write" && prior.targetName === name) return probe;\x0d\n        }\x0d\n        return -1;\x0d\n    }\x0d\n    function assignmentBarrier(registers = []) {\x0d\n        let barrier = 0;\x0d\n        for (const reg of registers) {\x0d\n            if (typeof reg === "string") barrier = Math.max(barrier\x2C ctx.deferredLocalBarriers.get(reg) || 0);\x0d\n        }\x0d\n        return barrier;\x0d\n    }\x0d\n    function flushAssignmentEffect() {\x0d\n        if (!pendingAssignmentEffect) return;\x0d\n        const items = pendingAssignmentEffect.items;\x0d\n        const line = items.length === 1\x0d\n            ? `${items[0].target} = ${items[0].value}`\x0d\n            : `${items.map(item => item.target).join("\x2C ")} = ${items.map(item => item.value).join("\x2C ")}`;\x0d\n        if (pendingAssignmentEffect.afterPackOrder > 0) {\x0d\n            ctx.deferredSourceLines.push({ line\x2C afterPackOrder: pendingAssignmentEffect.afterPackOrder });\x0d\n        } else {\x0d\n            ctx.out.splice(pendingAssignmentEffect.insertAt\x2C 0\x2C line);\x0d\n        }\x0d\n        pendingAssignmentEffect = null;\x0d\n    }\x0d\n    function queueAssignmentEffect(index\x2C target\x2C value\x2C carrierName\x2C dependencyRegs = []) {\x0d\n        if (typeof target !== "string" || typeof value !== "string") return false;\x0d\n        const item = { index\x2C target\x2C value\x2C carrierName: typeof carrierName === "string" ? carrierName : null };\x0d\n        const afterPackOrder = assignmentBarrier(dependencyRegs);\x0d\n        if (!pendingAssignmentEffect) {\x0d\n            pendingAssignmentEffect = { firstIndex: index\x2C insertAt: ctx.out.length\x2C afterPackOrder\x2C items: [item] };\x0d\n            return true;\x0d\n        }\x0d\n        const rhsDef = item.carrierName === null ? -1 : lastRegisterWriteBefore(index\x2C item.carrierName);\x0d\n        if (rhsDef < 0 || rhsDef >= pendingAssignmentEffect.firstIndex) {\x0d\n            flushAssignmentEffect();\x0d\n            pendingAssignmentEffect = { firstIndex: index\x2C insertAt: ctx.out.length\x2C afterPackOrder\x2C items: [item] };\x0d\n            return true;\x0d\n        }\x0d\n        pendingAssignmentEffect.afterPackOrder = Math.max(pendingAssignmentEffect.afterPackOrder\x2C afterPackOrder);\x0d\n        pendingAssignmentEffect.items.push(item);\x0d\n        return true;\x0d\n    }\x0d\n    for (let index = 0; index < ctx.leaf.length; index++) {\x0d\n        const statement = ctx.leaf[index];\x0d\n        if (ctx.options.diagnostics) { ctx.options.diagnostics.statementIndex = index; ctx.options.diagnostics.statement = sourceOf(ctx.source\x2C statement) || statement?.type || "unknown"; }\x0d\n        const op = decodeVmStatement(statement);\x0d\n        if (!op) return null;\x0d\n        const dest = op.destination\x2C rhs = op.value;\x0d\n        predeclareNilReads(ctx\x2C rhs\x2C index);\x0d\n        if (op.kind === "index-write" && isIdentifier(dest.base\x2C "upvalueValues") && isIdentifier(dest.index)) {\x0d\n            if (!ctx.upvalueCells.has(dest.index.name)) return null;\x0d\n            const deferredTemp = ctx.deferredUpvalueClosureStores.get(dest.index.name);\x0d\n            if (deferredTemp != null) {\x0d\n                if (!isIdentifier(rhs\x2C deferredTemp) || typeof ctx.upvalueCells.get(dest.index.name) !== "string") return null;\x0d\n                ctx.deferredUpvalueClosureStores.delete(dest.index.name);\x0d\n                continue;\x0d\n            }\x0d\n            const value = renderRhs(ctx\x2C rhs);\x0d\n            if (typeof value !== "string" || typeof ctx.upvalueCells.get(dest.index.name) === "string") return null;\x0d\n            const displayName = `v${++ctx.valueLocalCount}`;\x0d\n            ctx.upvalueCells.set(dest.index.name\x2C displayName);\x0d\n            ctx.out.push(`local ${displayName} = ${value}`);\x0d\n            ctx.declaredCount++;\x0d\n            continue;\x0d\n        }\x0d\n        if (op.kind === "index-write") {\x0d\n            if (!isIdentifier(dest.base) || !isIdentifier(dest.index)) return null;\x0d\n            const key = renderRhs(ctx\x2C dest.index);\x0d\n            const value = renderRhs(ctx\x2C rhs);\x0d\n            if (typeof key !== "string" || typeof value !== "string") return null;\x0d\n            const baseName = dest.base.name;\x0d\n            const base = baseName === "_env" ? null : renderRhs(ctx\x2C dest.base);\x0d\n            const baseMeta = baseName === "_env" ? null : ctx.exprMeta.get(baseName);\x0d\n            const stableBase = baseName === "_env" || ctx.locals.has(baseName) || ctx.exprKinds.get(baseName) === "table" || baseMeta?.kind === "member";\x0d\n            const decoded = renderOrdinaryIndexWrite({ baseName\x2C renderedBase: base\x2C renderedKey: key\x2C renderedValue: value\x2C stableBase });\x0d\n            if (!decoded) return null;\x0d\n            const assignmentTarget = decoded.line.slice(0\x2C decoded.line.lastIndexOf(" = "));\x0d\n            if (isIdentifier(rhs) && queueAssignmentEffect(index\x2C assignmentTarget\x2C value\x2C rhs.name\x2C [baseName\x2C rhs.name])) continue;\x0d\n            flushAssignmentEffect();\x0d\n            if (decoded.kind === "global-write") ctx.out.push(decoded.line);\x0d\n            else emitSourceLine(ctx\x2C decoded.line\x2C [baseName]);\x0d\n            continue;\x0d\n        }\x0d\n        if (op.kind !== "register-write") return null;\x0d\n        const name = op.targetName;\x0d\n        const isPackIndex = rhs?.type === "IndexExpression" && isIdentifier(rhs.base) && ctx.exprKinds.get(rhs.base.name) === "return-pack" && rhs.index?.type === "NumericLiteral";\x0d\n        const isPackSlotCopy = isIdentifier(rhs) && ctx.exprKinds.get(rhs.name) === "pack-slot";\x0d\n        const returnPackFields = rhs?.type === "TableConstructorExpression" ? (rhs.fields || []) : [];\x0d\n        const isReturnPackCreation = returnPackFields.length === 1 && returnPackFields[0]?.type === "TableValue" && returnPackFields[0].value?.type === "CallExpression" && !isSourcePackedTableConstructor(ctx\x2C rhs);\x0d\n        const isDeferredStorageCopy = isIdentifier(rhs) && ctx.deferredStorageCopies.get(name) === rhs.name;\x0d\n        const isDeferredTerminalClosureCopy = isIdentifier(rhs) && ctx.deferredTerminalClosureCopies.get(name) === rhs.name;\x0d\n        const isDeferredTerminalUnusedCopy = isIdentifier(rhs) && ctx.deferredTerminalUnusedCopies.get(name) === rhs.name;\x0d\n        const isDeadRegisterCopy = isIdentifier(rhs) && name !== ctx.stateName && name !== ctx.returnName && !ctx.cleanupRegs.has(name) && hasOnlyDeadCopyUses(ctx\x2C index\x2C name);\x0d\n        const isKnownUpvalueRead = rhs?.type === "IndexExpression" && isIdentifier(rhs.base\x2C "upvalueValues") && isIdentifier(rhs.index) && typeof ctx.upvalueCells.get(rhs.index.name) === "string";\x0d\n        const isStableGlobalLoad = ctx.pendingPacks.size > 0 && isVmRegisterName(name) && rhs?.type === "IndexExpression" && isIdentifier(rhs.base\x2C "_env") && isIdentifier(rhs.index) && typeof ctx.expr.get(rhs.index.name) === "string" && !rhsDependsOnPendingPack(ctx\x2C rhs.index);\x0d\n        const isBorrowedStateGlobalLoadBeforePackSlot = ctx.pendingPacks.size > 0 && name === ctx.stateName && rhs?.type === "IndexExpression" && isIdentifier(rhs.base\x2C "_env") && isIdentifier(rhs.index) && typeof ctx.expr.get(rhs.index.name) === "string" && !rhsDependsOnPendingPack(ctx\x2C rhs.index) && hasFuturePendingPackSlotBeforeStateTouch(ctx\x2C index);\x0d\n        const rhsCallKind = callKind(rhs);\x0d\n        const isUpvalueAllocation = rhsCallKind === "alloc-upvalue" && (rhs.arguments || []).length === 0 && name !== ctx.stateName && name !== ctx.returnName && !ctx.upvalueCells.has(name);\x0d\n        const releaseArgs = rhsCallKind === "release-upvalue" ? (rhs.arguments || []) : null;\x0d\n        const isKnownUpvalueRelease = releaseArgs?.length === 1 && isIdentifier(releaseArgs[0]\x2C name) && name !== ctx.stateName && name !== ctx.returnName && ctx.upvalueCells.has(name);\x0d\n        const isCallExpression = rhsCallKind !== null;\x0d\n        const isClosureCreation = rhsCallKind === "closure";\x0d\n        const cleanupFutureLocal = isCallExpression ? findFutureCleanupCopy(ctx\x2C index\x2C name) : null;\x0d\n        const terminalClosureFutureLocal = isClosureCreation && !cleanupFutureLocal ? findFutureTerminalClosureCopy(ctx\x2C index\x2C name) : null;\x0d\n        const upvalueClosureFutureCell = isClosureCreation && !cleanupFutureLocal && !terminalClosureFutureLocal ? findFutureUpvalueClosureStore(ctx\x2C index\x2C name) : null;\x0d\n        const terminalUnusedFutureLocal = !cleanupFutureLocal && !terminalClosureFutureLocal && !upvalueClosureFutureCell ? findFutureTerminalUnusedCopy(ctx\x2C index\x2C name) : null;\x0d\n        const callFutureLocal = cleanupFutureLocal || terminalClosureFutureLocal || terminalUnusedFutureLocal;\x0d\n        const terminalUnusedValueFutureLocal = !isCallExpression && !isPackIndex && !isPackSlotCopy && isPurePendingTempRhs(ctx\x2C rhs) && !isReturnPackCreation ? findFutureTerminalUnusedCopy(ctx\x2C index\x2C name) : null;\x0d\n        const directTerminalUnusedValue = !isCallExpression && !isPackIndex && !isPackSlotCopy && !terminalUnusedValueFutureLocal && isVmRegisterName(name) && !ctx.cleanupRegs.has(name) && isPurePendingTempRhs(ctx\x2C rhs) && !isReturnPackCreation && isTerminalUnreadEpoch(ctx\x2C index\x2C name);\x0d\n        const isTerminalUsedTransportAlias = isVmRegisterName(name) && !ctx.cleanupRegs.has(name) && !ctx.locals.has(name) && isIdentifier(rhs) &&\x0d\n            (rhs.name === ctx.stateName || rhs.name === ctx.returnName) && !isPackSlotCopy && isTerminalStableUsedEpoch(ctx\x2C index\x2C name);\x0d\n        const terminalUsedAliasPackBarrier = isTerminalUsedTransportAlias && ctx.pendingPacks.size ? Math.max(...[...ctx.pendingPacks.values()].map(pack => pack.order)) : 0;\x0d\n        const isDeferredTerminalUsedAlias = isTerminalUsedTransportAlias && terminalUsedAliasPackBarrier > 0;\x0d\n        const callResultIsDiscarded = isCallExpression && hasOnlyDeadCopyUses(ctx\x2C index\x2C name);\x0d\n        const callPackBarrier = isCallExpression && ctx.pendingPacks.size ? Math.max(...[...ctx.pendingPacks.values()].map(pack => pack.order)) : 0;\x0d\n        const hasTrackedPackBarrier = callPackBarrier > 0;\x0d\n        const isClosureTableOperand = isClosureCreation && isUniqueFutureTableOperand(ctx\x2C index\x2C name);\x0d\n        const callUsesPendingPackSourceLocal = isCallExpression && rhsUsesPendingPackSourceLocal(ctx\x2C rhs);\x0d\n        const isDeferredClosureCreation = isClosureCreation && !callUsesPendingPackSourceLocal && (!!callFutureLocal || !!upvalueClosureFutureCell || isClosureTableOperand) && hasTrackedPackBarrier;\x0d\n        const isDeferredOrdinaryCall = isCallExpression && !isClosureCreation && !callUsesPendingPackSourceLocal && hasTrackedPackBarrier && (!!callFutureLocal || callResultIsDiscarded);\x0d\n        const terminalUnusedValuePackBarrier = terminalUnusedValueFutureLocal && ctx.pendingPacks.size ? Math.max(...[...ctx.pendingPacks.values()].map(pack => pack.order)) : 0;\x0d\n        const isDeferredTerminalUnusedValue = !!terminalUnusedValueFutureLocal && terminalUnusedValuePackBarrier > 0;\x0d\n        // Table ctx.source-storage ownership is independent of pending return packs.\x0d\n        // A pending pack only changes when the recovered source line may be emitted.\x0d\n        const liveTableFutureLocal = findFutureLiveTableCopy(ctx\x2C index\x2C name\x2C rhs);\x0d\n        const isLiveTableHandoff = !!liveTableFutureLocal;\x0d\n        const isDeadPureTemp = ctx.pendingPacks.size > 0 && !isLiveTableHandoff && isDeadPurePendingTemp(ctx\x2C index\x2