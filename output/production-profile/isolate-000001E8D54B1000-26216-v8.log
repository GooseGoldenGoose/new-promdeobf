ateLoopCarriedRegisters(graph\x2C matches)\x2C transformed);\n    return {\n        leaves: transformed\x2C\n        matches\x2C\n        repeatBranchIds\x2C\n        repeatBodyStarts\x2C\n        loopControlByBlockId\x2C\n        loopCarriedStorageRegs: loopCarried.registers\x2C\n        loopCarriedStorageStarts: loopCarried.starts\x2C\n    };\n}\n\nfunction matchCompilerRepeatConditionRegion(leaves\x2C entryId\x2C stateName) {\n    const collapsed = collapseCompilerRepeatLoops(leaves\x2C entryId\x2C stateName\x2C null);\n    return collapsed?.matches?.length === 1 ? collapsed.matches[0] : null;\n}\n\nfunction removeDuplicatedRepeatConditionRegions(leaves\x2C entryId\x2C stateName) {\n    const collapsed = collapseCompilerRepeatLoops(leaves\x2C entryId\x2C stateName\x2C null);\n    if (!collapsed) return null;\n    return {\n        leaves: collapsed.leaves\x2C\n        removedRegionCount: collapsed.matches.length\x2C\n        removedStateCount: 0\x2C\n        removedStatementCount: collapsed.matches.reduce((n\x2C match) => n + match.duplicate.removedStatementCount\x2C 0)\x2C\n    };\n}\n\nfunction matchCompilerRepeatProgram(source\x2C stateWhile\x2C stateName\x2C returnName\x2C options = {}) {\n    const originalLeaves = extractNormalizedStateLeaves(stateWhile\x2C stateName);\n    if (!originalLeaves || originalLeaves.size < 4) return null;\n    const entryId = Number.isInteger(options.entryId) ? options.entryId : 1;\n    const originalGraph = createStateGraph(originalLeaves\x2C entryId\x2C stateName);\n    if (!originalGraph) return null;\n    const collapsed = collapseCompilerRepeatLoops(originalLeaves\x2C entryId\x2C stateName\x2C returnName);\n    if (!collapsed) return null;\n    const program = matchMultiStateLogicalLocals(source\x2C stateWhile\x2C stateName\x2C returnName\x2C {\n        ...options\x2C\n        allowConditionalIf: true\x2C\n        normalizedLeaves: collapsed.leaves\x2C\n        repeatBranchIds: collapsed.repeatBranchIds\x2C\n        repeatB