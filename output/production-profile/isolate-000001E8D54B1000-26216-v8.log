script-source,127,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\control\\numeric-for.js,"use strict";\x0d\n\x0d\nconst { isIdentifier\x2C isSingleAssignment\x2C isVmRegisterName } = require("../ast");\x0d\nconst { createStateGraph } = require("../cfg");\x0d\nconst { collectBreakRegion\x2C collectMixedAbruptRegion\x2C collectTerminalReturnRegion\x2C findNaturalLoops\x2C loopsAreNestedOrDisjoint } = require("./while");\x0d\n\x0d\nfunction numericLiteral(value) {\x0d\n    return { type: "NumericLiteral"\x2C value\x2C raw: String(value) };\x0d\n}\x0d\n\x0d\n\x0d\nfunction identifier(name) {\x0d\n    return { type: "Identifier"\x2C name };\x0d\n}\x0d\n\x0d\nfunction syntheticAssignment(name\x2C value) {\x0d\n    return {\x0d\n        type: "AssignmentStatement"\x2C\x0d\n        variables: [identifier(name)]\x2C\x0d\n        init: [value]\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction syntheticJump(stateName\x2C targetId) {\x0d\n    return syntheticAssignment(stateName\x2C numericLiteral(targetId));\x0d\n}\x0d\n\x0d\nfunction syntheticBranch(stateName\x2C conditionName\x2C onTrue\x2C onFalse) {\x0d\n    return syntheticAssignment(stateName\x2C {\x0d\n        type: "LogicalExpression"\x2C\x0d\n        operator: "or"\x2C\x0d\n        left: {\x0d\n            type: "LogicalExpression"\x2C\x0d\n            operator: "and"\x2C\x0d\n            left: identifier(conditionName)\x2C\x0d\n            right: numericLiteral(onTrue)\x2C\x0d\n        }\x2C\x0d\n        right: numericLiteral(onFalse)\x2C\x0d\n    });\x0d\n}\x0d\n\x0d\nfunction cloneLeaves(leaves) {\x0d\n    return new Map([...leaves].map(([id\x2C body]) => [id\x2C [...body]]));\x0d\n}\x0d\n\x0d\nfunction nearestDefinition(body\x2C beforeIndex\x2C name) {\x0d\n    for (let i = beforeIndex - 1; i >= 0; i--) {\x0d\n        const statement = body[i];\x0d\n        if (!isSingleAssignment(statement) || !isIdentifier(statement.variables[0]\x2C name)) continue;\x0d\n        return { index: i\x2C statement\x2C rhs: statement.init[0] };\x0d\n    }\x0d\n    return null;\x0d\n}\x0d\n\x0d\nfunction identifierOperands(node) {\x0d\n    if (!node || !isIdentifier(node.left) || !isIdentifier(node.right)) return null;\x0d\n    return [node.left.name\x2C node.right.name];\x0d\n}\x0d\n\x0d\nfunction classifyAndValue(body\x2C beforeIndex\x2C name) {\x0d\n    const andDef = nearestDefinition(body\x2C beforeIndex\x2C name);\x0d\n    if (!andDef || andDef.rhs?.type !== "LogicalExpression" || andDef.rhs.operator !== "and") return null;\x0d\n    const operands = identifierOperands(andDef.rhs);\x0d\n    if (!operands) return null;\x0d\n\x0d\n    let comparison = null;\x0d\n    let polarity = null;\x0d\n    const matched = new Set([andDef.index]);\x0d\n\x0d\n    for (const operandName of operands) {\x0d\n        const def = nearestDefinition(body\x2C andDef.index\x2C operandName);\x0d\n        const rhs = def?.rhs;\x0d\n        if (rhs?.type === "BinaryExpression" && (rhs.operator === "<=" || rhs.operator === ">=") &&\x0d\n            isIdentifier(rhs.left) && isIdentifier(rhs.right)) {\x0d\n            if (comparison) return null;\x0d\n            comparison = {\x0d\n                operator: rhs.operator\x2C\x0d\n                currentReg: rhs.left.name\x2C\x0d\n                finalReg: rhs.right.name\x2C\x0d\n            };\x0d\n            matched.add(def.index);\x0d\n            continue;\x0d\n        }\x0d\n        if (rhs?.type === "UnaryExpression" && rhs.operator === "not" && isIdentifier(rhs.argument)) {\x0d\n            if (polarity) return null;\x0d\n            polarity = { kind: "not"\x2C negFlagReg: rhs.argument.name };\x0d\n            matched.add(def.index);\x0d\n            continue;\x0d\n        }\x0d\n        // The compiler's negative-step flag is defined in the preheader and\x0d\n        // remains live through the check block. It therefore has no reaching\x0d\n        // definition inside this block.\x0d\n        if (def) return null;\x0d\n        if (polarity) return null;\x0d\n        polarity = { kind: "direct"\x2C negFlagReg: operandName };\x0d\n    }\x0d\n\x0d\n    if (!comparison || !polarity) return null;\x0d\n    if (comparison.operator === "<=" && polarity.kind !== "not") return null;\x0d\n    if (comparison.operator === ">=" && polarity.kind !== "direct") return null;\x0d\n    return {\x0d\n        kind: comparison.operator === "<=" ? "nonnegative" : "negative"\x2C\x0d\n        currentReg: comparison.currentReg\x2C\x0d\n        finalReg: comparison.finalReg\x2C\x0d\n        negFlagReg: polarity.negFlagReg\x2C\x0d\n        matched\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction matchRawCompilerNumericForCheck(body\x2C stateName\x2C checkId) {\x0d\n    if (!Array.isArray(body) || body.length < 8) return null;\x0d\n    const stateWrites = [];\x0d\n    for (let i = 0; i < body.length; i++) {\x0d\n        if (isSingleAssignment(body[i]\x2C stateName)) stateWrites.push(i);\x0d\n    }\x0d\n    if (stateWrites.length !== 2) return null;\x0d\n    const firstStateIndex = stateWrites[0];\x0d\n    const finalStateIndex = stateWrites[1];\x0d\n    if (finalStateIndex !== body.length - 1) return null;\x0d\n\x0d\n    const firstState = body[firstStateIndex].init[0];\x0d\n    if (firstState?.type !== "LogicalExpression" || firstState.operator !== "and" ||\x0d\n        !isIdentifier(firstState.left) || !isIdentifier(firstState.right)) return null;\x0d\n    const conditionReg = firstState.left.name;\x0d\n    const bodyTargetReg = firstState.right.name;\x0d\n\x0d\n    const finalState = body[finalStateIndex].init[0];\x0d\n    if (finalState?.type !== "LogicalExpression" || finalState.operator !== "or" ||\x0d\n        !isIdentifier(finalState.left\x2C stateName) || !isIdentifier(finalState.right)) return null;\x0d\n    const exitTargetReg = finalState.right.name;\x0d\n\x0d\n    const bodyTargetDef = nearestDefinition(body\x2C firstStateIndex\x2C bodyTargetReg);\x0d\n    const exitTargetDef = nearestDefinition(body\x2C finalStateIndex\x2C exitTargetReg);\x0d\n    if (!bodyTargetDef || bodyTargetDef.rhs?.type !== "NumericLiteral" ||\x0d\n        !exitTargetDef || exitTargetDef.rhs?.type !== "NumericLiteral") return null;\x0d\n    const bodyId = Number(bodyTargetDef.rhs.value);\x0d\n    const exitId = Number(exitTargetDef.rhs.value);\x0d\n    if (!Number.isInteger(bodyId) || !Number.isInteger(exitId) || bodyId === exitId) return null;\x0d\n\x0d\n    const orDef = nearestDefinition(body\x2C firstStateIndex\x2C conditionReg);\x0d\n    if (!orDef || orDef.rhs?.type !== "LogicalExpression" || orDef.rhs.operator !== "or") return null;\x0d\n    const orOperands = identifierOperands(orDef.rhs);\x0d\n    if (!orOperands) return null;\x0d\n    const leftAnd = classifyAndValue(body\x2C orDef.index\x2C orOperands[0]);\x0d\n    const rightAnd = classifyAndValue(body\x2C orDef.index\x2C orOperands[1]);\x0d\n    if (!leftAnd || !rightAnd || leftAnd.kind === rightAnd.kind) return null;\x0d\n    const nonnegative = leftAnd.kind === "nonnegative" ? leftAnd : rightAnd;\x0d\n    const negative = leftAnd.kind === "negative" ? leftAnd : rightAnd;\x0d\n    if (nonnegative.currentReg !== negative.currentReg || nonnegative.finalReg !== negative.finalReg ||\x0d\n        nonnegative.negFlagReg !== negative.negFlagReg) return null;\x0d\n\x0d\n    const currentReg = nonnegative.currentReg;\x0d\n    const finalReg = nonnegative.finalReg;\x0d\n    const negFlagReg = nonnegative.negFlagReg;\x0d\n    const currentAdd = nearestDefinition(body\x2C Math.min(...[...nonnegative.matched\x2C ...negative.matched])\x2C currentReg) ||\x0d\n        nearestDefinition(body\x2C orDef.index\x2C currentReg);\x0d\n    if (!currentAdd || currentAdd.rhs?.type !== "BinaryExpression" || currentAdd.rhs.operator !== "+" ||\x0d\n        !isIdentifier(currentAdd.rhs.left\x2C currentReg) || !isIdentifier(currentAdd.rhs.right)) return null;\x0d\n    const incrementReg = currentAdd.rhs.right.name;\x0d\n\x0d\n    const matched = new Set([\x0d\n        firstStateIndex\x2C\x0d\n        finalStateIndex\x2C\x0d\n        bodyTargetDef.index\x2C\x0d\n        exitTargetDef.index\x2C\x0d\n        orDef.index\x2C\x0d\n        currentAdd.index\x2C\x0d\n        ...nonnegative.matched\x2C\x0d\n        ...negative.matched\x2C\x0d\n    ]);\x0d\n    if (matched.size !== body.length || [...matched].some(index => index < 0 || index >= body.length)) return null;\x0d\n\x0d\n    return {\x0d\n        checkId\x2C\x0d\n        bodyId\x2C\x0d\n        exitId\x2C\x0d\n        conditionReg\x2C\x0d\n        currentReg\x2C\x0d\n        finalReg\x2C\x0d\n        incrementReg\x2C\x0d\n        negFlagReg\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction canonicalizeCompilerNumericForChecks(leaves\x2C stateName) {\x0d\n    if (!(leaves instanceof Map) || typeof stateName !== "string") return null;\x0d\n    const signatures = new Map();\x0d\n    for (const [id\x2C body] of leaves) {\x0d\n        const match = matchRawCompilerNumericForCheck(body\x2C stateName\x2C id);\x0d\n        if (!match) continue;\x0d\n        if (!leaves.has(match.bodyId) || !leaves.has(match.exitId)) return null;\x0d\n        const conditionName = `__fresh_numeric_for_${id}_condition`;\x0d\n        match.conditionName = conditionName;\x0d\n        signatures.set(id\x2C match);\x0d\n        leaves.set(id\x2C [\x0d\n            syntheticAssignment(conditionName\x2C identifier(`__fresh_numeric_for_${id}_final`))\x2C\x0d\n            syntheticBranch(stateName\x2C conditionName\x2C match.bodyId\x2C match.exitId)\x2C\x0d\n        ]);\x0d\n    }\x0d\n    return signatures;\x0d\n}\x0d\n\x0d\nfunction matchPreheaderSetup(block\x2C raw) {\x0d\n    if (!block || block.transition?.kind !== "jump" || block.transition.target !== raw.checkId) return null;\x0d\n    const before = block.transitionIndex;\x0d\n    const currentDef = nearestDefinition(block.body\x2C before\x2C raw.currentReg);\x0d\n    if (!currentDef || currentDef.rhs?.type !== "BinaryExpression" || currentDef.rhs.operator !== "-" ||\x0d\n        !isIdentifier(currentDef.rhs.left) || !isIdentifier(currentDef.rhs.right\x2C raw.incrementReg)) return null;\x0d\n    const initialSourceReg = currentDef.rhs.left.name;\x0d\n\x0d\n    const negDef = nearestDefinition(block.body\x2C before\x2C raw.negFlagReg);\x0d\n    if (!negDef || negDef.rhs?.type !== "BinaryExpression" || negDef.rhs.operator !== "<" ||\x0d\n        !isIdentifier(negDef.rhs.left\x2C raw.incrementReg) || !isIdentifier(negDef.rhs.right)) return null;\x0d\n    const zeroReg = negDef.rhs.right.name;\x0d\n    const zeroDef = nearestDefinition(block.body\x2C negDef.index\x2C zeroReg);\x0d\n    if (!zeroDef || zeroDef.rhs?.type !== "NumericLiteral" || Number(zeroDef.rhs.value) !== 0) return null;\x0d\n\x0d\n    const incrementDef = nearestDefinition(block.body\x2C negDef.index\x2C raw.incrementReg);\x0d\n    if (!incrementDef || !isIdentifier(incrementDef.rhs)) return null;\x0d\n    const incrementSourceReg = incrementDef.rhs.name;\x0d\n\x0d\n    const finalDef = nearestDefinition(block.body\x2C before\x2C raw.finalReg);\x0d\n    if (!finalDef || !isIdentifier(finalDef.rhs)) return null;\x0d\n    const finalSourceReg = finalDef.rhs.name;\x0d\n\x0d\n    const setupStatements = new Set([\x0d\n        currentDef.statement\x2C\x0d\n        negDef.statement\x2C\x0d\n        zeroDef.statement\x2C\x0d\n        incrementDef.statement\x2C\x0d\n        finalDef.statement\x2C\x0d\n    ]);\x0d\n    if (setupStatements.size !== 5) return null;\x0d\n\x0d\n    const prefix = `__fresh_numeric_for_${raw.checkId}`;\x0d\n    return {\x0d\n        currentDef\x2C\x0d\n        negDef\x2C\x0d\n        zeroDef\x2C\x0d\n        incrementDef\x2C\x0d\n        finalDef\x2C\x0d\n        setupStatements\x2C\x0d\n        initialSourceReg\x2C\x0d\n        finalSourceReg\x2C\x0d\n        incrementSourceReg\x2C\x0d\n        initialCapture: `${prefix}_initial`\x2C\x0d\n        finalCapture: `${prefix}_final`\x2C\x0d\n        stepCapture: `${prefix}_step`\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction transitionTargets(transition) {\x0d\n    if (transition?.kind === "jump") return [transition.target];\x0d\n    if (transition?.kind === "branch") return [transition.onTrue\x2C transition.onFalse];\x0d\n    return [];\x0d\n}\x0d\n\x0d\nfunction nodeReadsName(node\x2C name) {\x0d\n    if (!node || typeof node !== "object") return false;\x0d\n    if (isIdentifier(node\x2C name)) return true;\x0d\n    for (const [key\x2C value] of Object.entries(node)) {\x0d\n        if (key === "range" || key === "loc" || key === "variables") continue;\x0d\n        if (Array.isArray(value)) {\x0d\n            if (value.some(item => nodeReadsName(item\x2C name))) return true;\x0d\n        } else if (value && typeof value === "object" && nodeReadsName(value\x2C name)) return true;\x0d\n    }\x0d\n    return false;\x0d\n}\x0d\n\x0d\n\x0d\nfunction isAllocUpvalueCall(node) {\x0d\n    return node?.type === "CallExpression" && isIdentifier(node.base\x2C "allocUpvalue") && (node.arguments || []).length === 0;\x0d\n}\x0d\n\x0d\nfunction isReleaseUpvalueCallFor(statement\x2C cellReg) {\x0d\n    if (!isSingleAssignment(statement\x2C cellReg)) return false;\x0d\n    const rhs = statement.init[0];\x0d\n    return rhs?.type === "CallExpression" && isIdentifier(rhs.base\x2C "releaseUpvalue") &&\x0d\n        (rhs.arguments || []).length === 1 && isIdentifier(rhs.arguments[0]\x2C cellReg);\x0d\n}\x0d\n\x0d\nfunction isCapturedCellWriteFrom(statement\x2C cellReg\x2C valueReg) {\x0d\n    if (statement?.type !== "AssignmentStatement" || (statement.variables || []).length !== 1 || (statement.init || []).length !== 1) return false;\x0d\n    const dest = statement.variables[0];\x0d\n    return dest?.type === "IndexExpression" && isIdentifier(dest.base\x2C "upvalueValues") &&\x0d\n        isIdentifier(dest.index\x2C cellReg) && isIdentifier(statement.init[0]\x2C valueReg);\x0d\n}\x0d\n\x0d\nfunction closureCapturesCell(statement\x2C cellReg) {\x0d\n    if (!isSingleAssignment(statement)) return false;\x0d\n    const rhs = statement.init[0];\x0d\n    if (rhs?.type !== "CallExpression" || !isIdentifier(rhs.base) || !/^createClosure\\d*$/.test(rhs.base.name)) return false;\x0d\n    const args = rhs.arguments || [];\x0d\n    if (args.length !== 2 || args[1]?.type !== "TableConstructorExpression") return false;\x0d\n    return (args[1].fields || []).some(field => field?.type === "TableValue" && isIdentifier(field.value\x2C cellReg));\x0d\n}\x0d\n\x0d\nfunction matchLoopVariableHandoff(graph\x2C loopInfo\x2C raw) {\x0d\n    const body = graph.blocks.get(raw.bodyId);\x0d\n    if (!body) return null;\x0d\n    const handoffs = [];\x0d\n    for (let i = 0; i < body.transitionIndex; i++) {\x0d\n        const statement = body.body[i];\x0d\n        if (!isSingleAssignment(statement) || !isIdentifier(statement.variables[0]) || !isIdentifier(statement.init[0]\x2C raw.currentReg)) continue;\x0d\n        const loopVarReg = statement.variables[0].name;\x0d\n        if (!isVmRegisterName(loopVarReg) || loopVarReg === raw.currentReg) continue;\x0d\n        handoffs.push({ kind: "register"\x2C statement\x2C index: i\x2C loopVarReg\x2C loopVarCellReg: null\x2C bookkeepingStatements: new Set([statement]) });\x0d\n    }\x0d\n    if (handoffs.length > 1) return null;\x0d\n    if (handoffs.length === 1) {\x0d\n        const handoff = handoffs[0];\x0d\n        let cleanupCount = 0;\x0d\n        for (const id of loopInfo.coreIds) {\x0d\n            const block = graph.blocks.get(id);\x0d\n            if (!block) return null;\x0d\n            for (let i = 0; i < block.body.length; i++) {\x0d\n                if (i === block.transitionIndex) continue;\x0d\n                const statement = block.body[i];\x0d\n                if (statement === handoff.statement) continue;\x0d\n                if (isSingleAssignment(statement\x2C handoff.loopVarReg) && statement.init[0]?.type === "NilLiteral") {\x0d\n                    handoff.bookkeepingStatements.add(statement);\x0d\n                    cleanupCount++;\x0d\n                    continue;\x0d\n                }\x0d\n                if (nodeReadsName(statement\x2C raw.currentReg)) return null;\x0d\n            }\x0d\n        }\x0d\n        if (cleanupCount < 1) return null;\x0d\n        return handoff;\x0d\n    }\x0d\n\x0d\n    // Captured numeric-for variables are lowered directly into a fresh upvalue\x0d\n    // cell for each iteration instead of receiving an ordinary VAR-register\x0d\n    // handoff. Prove the exact alloc -> current-value cell write -> closure\x0d\n    // capture -> release bookkeeping before treating the cell as the source\x0d\n    // loop-variable binding.\x0d\n    const capturedCandidates = [];\x0d\n    for (let initIndex = 0; initIndex < body.transitionIndex; initIndex++) {\x0d\n        const initStatement = body.body[initIndex];\x0d\n        const dest = initStatement?.variables?.[0];\x0d\n        if (dest?.type !== "IndexExpression" || !isIdentifier(dest.base\x2C "upvalueValues") || !isIdentifier(dest.index) ||\x0d\n            !isIdentifier(initStatement.init?.[0]\x2C raw.currentReg)) continue;\x0d\n        const cellReg = dest.index.name;\x0d\n        let allocStatement = null;\x0d\n        let captureCount = 0;\x0d\n        for (let i = 0; i < body.transitionIndex; i++) {\x0d\n            const statement = body.body[i];\x0d\n            if (i < initIndex && isSingleAssignment(statement\x2C cellReg) && isAllocUpvalueCall(statement.init[0])) allocStatement = statement;\x0d\n            if (closureCapturesCell(statement\x2C cellReg)) captureCount++;\x0d\n        }\x0d\n        if (!allocStatement || captureCount < 1) continue;\x0d\n        const bookkeepingStatements = new Set([allocStatement\x2C initStatement]);\x0d\n        let releaseCount = 0;\x0d\n        let invalidCurrentRead = false;\x0d\n        for (const id of loopInfo.coreIds) {\x0d\n            const blockInfo = graph.blocks.get(id);\x0d\n            if (!blockInfo) return null;\x0d\n            for (let i = 0; i < blockInfo.body.length; i++) {\x0d\n                if (i === blockInfo.transitionIndex) continue;\x0d\n                const statement = blockInfo.body[i];\x0d\n                if (statement === initStatement) continue;\x0d\n                if (isReleaseUpvalueCallFor(statement\x2C cellReg)) {\x0d\n                    bookkeepingStatements.add(statement);\x0d\n                    releaseCount++;\x0d\n                    continue;\x0d\n                }\x0d\n                if (nodeReadsName(statement\x2C raw.currentReg)) invalidCurrentRead = true;\x0d\n            }\x0d\n        }\x0d\n        if (invalidCurrentRead || releaseCount < 1) continue;\x0d\n        capturedCandidates.push({\x0d\n            kind: "captured-cell"\x2C\x0d\n            statement: initStatement\x2C\x0d\n            index: initIndex\x2C\x0d\n            loopVarReg: null\x2C\x0d\n            loopVarCellReg: cellReg\x2C\x0d\n            bookkeepingStatements\x2C\x0d\n        });\x0d\n    }\x0d\n    return capturedCandidates.length === 1 ? capturedCandidates[0] : null;\x0d\n}\x0d\n\x0d\nfunction matchCompilerNumericForNaturalLoop(graph\x2C loopInfo\x2C raw\x2C returnName = null) {\x0d\n    if (!graph || !loopInfo?.coreIds?.size || !raw || loopInfo.headerId !== raw.checkId) return null;\x0d\n    const coreIds = loopInfo.coreIds;\x0d\n    if (!coreIds.has(raw.bodyId) || coreIds.has(raw.exitId)) return null;\x0d\n    const header = graph.blocks.get(raw.checkId);\x0d\n    if (!header || header.transition?.kind !== "branch" ||\x0d\n        header.transition.onTrue !== raw.bodyId || header.transition.onFalse !== raw.exitId) return null;\x0d\n\x0d\n    const outsideHeaderPreds = (graph.predecessors.get(raw.checkId) || []).filter(id => graph.reachable.has(id) && !coreIds.has(id));\x0d\n    if (outsideHeaderPreds.length !== 1) return null;\x0d\n    const preheaderId = outsideHeaderPreds[0];\x0d\n    const preheader = graph.blocks.get(preheaderId);\x0d\n    const setup = matchPreheaderSetup(preheader\x2C raw);\x0d\n    if (!setup) return null;\x0d\n\x0d\n    const breakRegionIds = new Set();\x0d\n    const breakTerminalIds = new Set();\x0d\n    const terminalReturnRegionIds = new Set();\x0d\n    for (const id of coreIds) {\x0d\n        const block = graph.blocks.get(id);\x0d\n        if (!block) return null;\x0d\n        for (const target of transitionTargets(block.transition)) {\x0d\n            if (coreIds.has(target)) continue;\x0d\n            if (id === raw.checkId && target === raw.exitId) continue;\x0d\n            const breakRegion = collectBreakRegion(graph\x2C target\x2C coreIds\x2C raw.exitId);\x0d\n            if (breakRegion) {\x0d\n                for (const member of breakRegion.ids) breakRegionIds.add(member);\x0d\n                for (const terminal of breakRegion.terminalIds) breakTerminalIds.add(terminal);\x0d\n                continue;\x0d\n            }\x0d\n            const returnRegion = collectTerminalReturnRegion(graph\x2C target\x2C coreIds\x2C returnName\x2C raw.exitId);\x0d\n            if (returnRegion) {\x0d\n                for (const member of returnRegion.ids) terminalReturnRegionIds.add(member);\x0d\n                continue;\x0d\n            }\x0d\n            const mixedAbruptRegion = collectMixedAbruptRegion(graph\x2C target\x2C coreIds\x2C raw.exitId\x2C returnName);\x0d\n            if (!mixedAbruptRegion) return null;\x0d\n            for (const member of mixedAbruptRegion.ids) breakRegionIds.add(member);\x0d\n            for (const terminal of mixedAbruptRegion.breakTerminalIds) breakTerminalIds.add(terminal);\x0d\n            for (const terminal of mixedAbruptRegion.returnTerminalIds) terminalReturnRegionIds.add(terminal);\x0d\n        }\x0d\n    }\x0d\n\x0d\n    const handoff = matchLoopVariableHandoff(graph\x2C loopInfo\x2C raw);\n    if (!handoff) return null;\n\n    // The compiler may reuse the future source loop-variable register as the\n    // TEMP that evaluates the numeric-for initial expression. If that exact\n    // TEMP feeds only current = initial - step before the loop\x2C keep evaluation\n    // at its original statement position and remove the transport epoch.\n    let initialTransportDef = null;\n    if (handoff.loopVarReg && setup.initialSourceReg === handoff.loopVarReg) {\n        const def = nearestDefinition(preheader.body\x2C setup.currentDef.index\x2C setup.initialSourceReg);\n        if (!def || setup.setupStatements.has(def.statement)) return null;\n        for (let i = def.index + 1; i < setup.currentDef.index; i++) {\n            if (nodeReadsName(preheader.body[i]\x2C setup.initialSourceReg)) return null;\n        }\n        initialTransportDef = def;\n    }\n\n    return {\n        ...raw\x2C\n        ...setup\x2C\x0d\n        coreIds\x2C\x0d\n        breakRegionIds\x2C\x0d\n        breakTerminalIds\x2C\x0d\n        terminalReturnRegionIds\x2C\x0d\n        preheaderId\x2C\x0d\n        headerId: raw.checkId\x2C\x0d\n        decisionId: raw.checkId\x2C\x0d\n        backedgeSources: new Set(loopInfo.backedgeSources)\x2C\x0d\n        continueIds: new Set(loopInfo.backedgeSources)\x2C\x0d\n        loopVarReg: handoff.loopVarReg\x2C\n        loopVarCellReg: handoff.loopVarCellReg\x2C\n        initialTransportDef\x2C\x0d\n        loopVarHandoffStatement: handoff.statement\x2C\x0d\n        loopVarBookkeepingStatements: handoff.bookkeepingStatements\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction rewriteJumpTarget(leaves\x2C graph\x2C blockId\x2C targetId) {\x0d\n    const block = graph.blocks.get(blockId);\x0d\n    const body = leaves.get(blockId);\x0d\n    if (!block || !body || block.transition?.kind !== "jump" || block.transitionIndex < 0 || block.transitionIndex >= body.length) return false;\x0d\n    const original = body[block.transitionIndex];\x0d\n    if (!isSingleAssignment(original) || !isIdentifier(original.variables[0])) return false;\x0d\n    const next = [...body];\x0d\n    next[block.transitionIndex] = syntheticJump(original.variables[0].name\x2C targetId);\x0d\n    leaves.set(blockId\x2C next);\x0d\n    return true;\x0d\n}\x0d\n\x0d\nfunction applyCompilerNumericForMatch(transformed\x2C graph\x2C match\x2C stateName\x2C bodyJoinId\x2C metadata) {\x0d\n    if (!(transformed instanceof Map) || !graph || !match || !metadata || !Number.isInteger(bodyJoinId)) return false;\x0d\n    const {\x0d\n        numericForBranchIds\x2C\x0d\n        numericForMetaByBranchId\x2C\x0d\n        numericForBodyStarts\x2C\x0d\n        loopBodyJoinIds\x2C\x0d\n        loopBackedgeCountsByJoin\x2C\x0d\n        loopControlByBlockId\x2C\x0d\n    } = metadata;\x0d\n    if (!(numericForBranchIds instanceof Set) || !(numericForMetaByBranchId instanceof Map) ||\x0d\n        !(numericForBodyStarts instanceof Map) || !(loopBodyJoinIds instanceof Set) ||\x0d\n        !(loopBackedgeCountsByJoin instanceof Map) || !(loopControlByBlockId instanceof Map)) return false;\x0d\n\x0d\n    const preheaderBody = transformed.get(match.preheaderId);\x0d\n    if (!Array.isArray(preheaderBody)) return false;\x0d\n    const nextPreheader = [];\x0d\n    for (const statement of preheaderBody) {\n        if (match.initialTransportDef && statement === match.initialTransportDef.statement) {\n            nextPreheader.push(syntheticAssignment(match.initialCapture\x2C match.initialTransportDef.rhs));\n            continue;\n        }\n        if (statement === match.finalDef.statement) {\x0d\n            nextPreheader.push(syntheticAssignment(match.finalCapture\x2C identifier(match.finalSourceReg)));\x0d\n            continue;\x0d\n        }\x0d\n        if (statement === match.incrementDef.statement) {\x0d\n            nextPreheader.push(syntheticAssignment(match.stepCapture\x2C identifier(match.incrementSourceReg)));\x0d\n            continue;\x0d\n        }\x0d\n        if (statement === match.currentDef.statement) {\n            if (!match.initialTransportDef) {\n                nextPreheader.push(syntheticAssignment(match.initialCapture\x2C identifier(match.initialSourceReg)));\n            }\n            continue;\n        }\x0d\n        if (statement === match.zeroDef.statement || statement === match.negDef.statement) continue;\x0d\n        nextPreheader.push(statement);\x0d\n    }\x0d\n    transformed.set(match.preheaderId\x2C nextPreheader);\x0d\n\x0d\n    const body = transformed.get(match.bodyId);\x0d\n    if (!Array.isArray(body) || !body.includes(match.loopVarHandoffStatement) ||\x0d\n        !(match.loopVarBookkeepingStatements instanceof Set)) return false;\x0d\n\x0d\n    // Rewrite backedges while the graph's transition indexes still refer to\x0d\n    // the unmodified loop-body arrays. Remove the compiler loop-variable\x0d\n    // handoff only after those control edges are rewritten.\x0d\n    for (const source of match.backedgeSources) {\x0d\n        if (!rewriteJumpTarget(transformed\x2C graph\x2C source\x2C bodyJoinId)) return false;\x0d\n        loopControlByBlockId.set(source\x2C "continue");\x0d\n    }\x0d\n    for (const source of match.breakTerminalIds || []) {\x0d\n        if (!rewriteJumpTarget(transformed\x2C graph\x2C source\x2C bodyJoinId)) return false;\x0d\n        loopControlByBlockId.set(source\x2C "break");\x0d\n    }\x0d\n    // Remove only the proven source-loop-variable compiler bookkeeping. For a\x0d\n    // captured loop variable this includes its per-iteration cell allocation\x2C\x0d\n    // current-value initialization\x2C and release(s); the closure capture itself\x0d\n    // remains and resolves through the seeded source binding at body entry.\x0d\n    const cleanupBlockIds = new Set([\x0d\n        ...match.coreIds\x2C\x0d\n        ...(match.breakRegionIds || [])\x2C\x0d\n        ...(match.terminalReturnRegionIds || [])\x2C\x0d\n    ]);\x0d\n    for (const blockId of cleanupBlockIds) {\x0d\n        const blockBody = transformed.get(blockId);\x0d\n        if (!Array.isArray(blockBody)) continue;\x0d\n        transformed.set(blockId\x2C blockBody.filter(statement => !match.loopVarBookkeepingStatements.has(statement)));\x0d\n    }\x0d\n    transformed.set(bodyJoinId\x2C [syntheticJump(stateName\x2C match.exitId)]);\x0d\n\x0d\n    match.bodyJoinId = bodyJoinId;\x0d\n    loopBodyJoinIds.add(bodyJoinId);\x0d\n    loopBackedgeCountsByJoin.set(bodyJoinId\x2C match.backedgeSources.size);\x0d\n    numericForBranchIds.add(match.decisionId);\x0d\n    numericForMetaByBranchId.set(match.decisionId\x2C match);\x0d\n    numericForBodyStarts.set(match.bodyId\x2C match);\x0d\n    return true;\x0d\n}\x0d\n\x0d\nfunction collapseCompilerNumericForLoops(leaves\x2C entryId\x2C stateName\x2C returnName = null) {\x0d\n    if (!(leaves instanceof Map) || !Number.isInteger(entryId) || typeof stateName !== "string") return null;\x0d\n    const transformed = cloneLeaves(leaves);\x0d\n    const signatures = canonicalizeCompilerNumericForChecks(transformed\x2C stateName);\x0d\n    if (!signatures || signatures.size === 0) return null;\x0d\n    const graph = createStateGraph(transformed\x2C entryId\x2C stateName);\x0d\n    if (!graph) return null;\x0d\n    const natural = findNaturalLoops(graph);\x0d\n    if (!natural || !natural.loops.length || !loopsAreNestedOrDisjoint(natural.loops)) return null;\x0d\n\x0d\n    const matches = [];\x0d\n    for (const loopInfo of natural.loops) {\x0d\n        const raw = signatures.get(loopInfo.headerId);\x0d\n        if (!raw) return null;\x0d\n        const match = matchCompilerNumericForNaturalLoop(graph\x2C loopInfo\x2C raw\x2C returnName);\x0d\n        if (!match) return null;\x0d\n        matches.push(match);\x0d\n    }\x0d\n\x0d\n    const numericForBranchIds = new Set();\x0d\n    const numericForMetaByBranchId = new Map();\x0d\n    const numericForBodyStarts = new Map();\x0d\n    const loopBodyJoinIds = new Set();\x0d\n    const loopBackedgeCountsByJoin = new Map();\x0d\n    const loopControlByBlockId = new Map();\x0d\n    let nextSyntheticId = -1;\x0d\n    while (transformed.has(nextSyntheticId)) nextSyntheticId--;\x0d\n    for (const match of [...matches].sort((a\x2C b) => a.coreIds.size - b.coreIds.size)) {\x0d\n        const bodyJoinId = nextSyntheticId--;\x0d\n        if (!applyCompilerNumericForMatch(transformed\x2C graph\x2C match\x2C stateName\x2C bodyJoinId\x2C {\x0d\n            numericForBranchIds\x2C\x0d\n            numericForMetaByBranchId\x2C\x0d\n            numericForBodyStarts\x2C\x0d\n            loopBodyJoinIds\x2C\x0d\n            loopBackedgeCountsByJoin\x2C\x0d\n            loopControlByBlockId\x2C\x0d\n        })) return null;\x0d\n    }\x0d\n    return {\x0d\n        leaves: transformed\x2C\x0d\n        matches\x2C\x0d\n        numericForBranchIds\x2C\x0d\n        numericForMetaByBranchId\x2C\x0d\n        numericForBodyStarts\x2C\x0d\n        loopBodyJoinIds\x2C\x0d\n        loopBackedgeCountsByJoin\x2C\x0d\n        loopControlByBlockId\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n    applyCompilerNumericForMatch\x2C\x0d\n    canonicalizeCompilerNumericForChecks\x2C\x0d\n    collapseCompilerNumericForLoops\x2C\x0d\n    matchCompilerNumericForNaturalLoop\x2C\x0d\n    matchRawCompilerNumericForCheck\x2C\x0d\n};\x0d\n
