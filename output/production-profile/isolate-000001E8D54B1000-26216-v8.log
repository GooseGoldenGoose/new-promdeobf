script-source,122,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\control\\loops.js,"use strict";\x0d\n\x0d\nconst { createStateGraph } = require("../cfg");\x0d\nconst { extractNormalizedStateLeaves } = require("../normalize");\x0d\nconst { reduceCompilerLogicalStateGraph } = require("../logical");\x0d\nconst { matchMultiStateLogicalLocals } = require("../structured/solver");\x0d\nconst { candidateLoopCarriedRegisters\x2C remapLoopCarriedStarts } = require("./loop-storage");\x0d\nconst {\x0d\n    applyCompilerWhileMatch\x2C\x0d\n    findNaturalLoops\x2C\x0d\n    loopsAreNestedOrDisjoint\x2C\x0d\n    matchCompilerWhileConditionRegion\x2C\x0d\n} = require("./while");\x0d\nconst { applyCompilerRepeatMatch\x2C matchCompilerRepeatNaturalLoop\x2C applyCompilerTerminalRepeatMatches\x2C matchCompilerTerminalRepeatPreheaders } = require("./repeat");\x0d\nconst { applyCompilerGenericForMatch\x2C matchCompilerGenericForNaturalLoop } = require("./generic-for");\x0d\nconst {\x0d\n    applyCompilerNumericForMatch\x2C\x0d\n    canonicalizeCompilerNumericForChecks\x2C\x0d\n    matchCompilerNumericForNaturalLoop\x2C\x0d\n} = require("./numeric-for");\x0d\n\x0d\nfunction cloneLeaves(leaves) {\x0d\n    return new Map([...leaves].map(([id\x2C body]) => [id\x2C [...body]]));\x0d\n}\x0d\n\x0d\nfunction mergeSet(target\x2C source) {\x0d\n    for (const value of source || []) target.add(value);\x0d\n}\x0d\n\x0d\nfunction mergeEvidence(target\x2C source\x2C excluded = null) {\x0d\n    if (!(source instanceof Map)) return;\x0d\n    for (const [key\x2C items] of source) {\x0d\n        if (excluded instanceof Set && excluded.has(key)) continue;\x0d\n        if (!target.has(key)) target.set(key\x2C []);\x0d\n        target.get(key).push(...items);\x0d\n    }\x0d\n}\x0d\n\x0d\nfunction nextSyntheticBelow(leaves\x2C current) {\x0d\n    let id = current;\x0d\n    while (leaves.has(id)) id--;\x0d\n    return id;\x0d\n}\x0d\n\x0d\nfunction collapseCompilerStructuredLoops(leaves\x2C entryId\x2C stateName\x2C returnName = null) {\x0d\n    if (!(leaves instanceof Map) || !Number.isInteger(entryId) || typeof stateName !== "string") return null;\x0d\n    let transformed = cloneLeaves(leaves);\x0d\n\x0d\n    const loopBranchIds = new Set();\x0d\n    const loopBodyJoinIds = new Set();\x0d\n    const loopBackedgeCountsByJoin = new Map();\x0d\n    const repeatBranchIds = new Set();\x0d\n    const repeatBodyStarts = new Map();\x0d\n    const terminalRepeatBodyStarts = new Map();\x0d\n    const numericForBranchIds = new Set();\x0d\n    const numericForMetaByBranchId = new Map();\x0d\n    const numericForBodyStarts = new Map();\x0d\n    const genericForBranchIds = new Set();\x0d\n    const genericForMetaByBranchId = new Map();\x0d\n    const genericForBodyStarts = new Map();\x0d\n    const loopControlByBlockId = new Map();\x0d\n    const loopCarriedEvidence = new Map();\x0d\n    const matches = [];\x0d\n    let whileLoopCount = 0;\x0d\n    let repeatLoopCount = 0;\x0d\n    let numericForLoopCount = 0;\x0d\n    let genericForLoopCount = 0;\x0d\n    let removedCompilerConditionStatementCount = 0;\x0d\n    let nextSyntheticId = nextSyntheticBelow(transformed\x2C -1);\x0d\n    let rounds = 0;\x0d\n\x0d\n    // Numeric-for uses Prometheus' split `state = cond and body; state = state or final`\x0d\n    // transition. Canonicalize the exact proven compiler check template before any\x0d\n    // generic logical classification so its two-step state transfer is not mistaken\x0d\n    // for another control-flow shape.\x0d\n    const numericForSignatures = canonicalizeCompilerNumericForChecks(transformed\x2C stateName);\x0d\n    if (!numericForSignatures) return null;\x0d\n\x0d\n    // Terminal-repeat proof runs on the compiler graph after numeric-only state\x0d\n    // canonicalization but before generic lazy logical reduction. This preserves the\x0d\n    // terminal-repeat signature without allowing unreduced numeric checks to mimic it.\x0d\n    {\x0d\n        const initialGraph = createStateGraph(transformed\x2C entryId\x2C stateName);\x0d\n        if (!initialGraph) return null;\x0d\n        const terminalRepeatMatches = matchCompilerTerminalRepeatPreheaders(initialGraph\x2C stateName\x2C returnName);\x0d\n        if (terminalRepeatMatches.length) {\x0d\n            if (!applyCompilerTerminalRepeatMatches(transformed\x2C terminalRepeatMatches\x2C { terminalRepeatBodyStarts })) return null;\x0d\n            for (const match of terminalRepeatMatches) matches.push({ type: "repeat-terminal"\x2C match });\x0d\n            repeatLoopCount += terminalRepeatMatches.length;\x0d\n        }\x0d\n    }\x0d\n\x0d\n    // Reduce only compiler-proven lazy value regions after the specialized proofs\x0d\n    // above\x2C so while/repeat natural-loop classification sees one condition decision.\x0d\n    transformed = reduceCompilerLogicalStateGraph(transformed\x2C entryId\x2C stateName\x2C returnName).leaves;\x0d\n\x0d\n    while (true) {\x0d\n        if (rounds++ > leaves.size * 3 + 16) return null;\x0d\n        const graph = createStateGraph(transformed\x2C entryId\x2C stateName);\x0d\n        if (!graph) return null;\x0d\n        const natural = findNaturalLoops(graph);\x0d\n        if (!natural) return null;\x0d\n        if (!natural.loops.length) break;\x0d\n        if (!loopsAreNestedOrDisjoint(natural.loops)) return null;\x0d\n\x0d\n        const ordered = [...natural.loops].sort((a\x2C b) => a.coreIds.size - b.coreIds.size || a.headerId - b.headerId);\x0d\n        let applied = false;\x0d\n        for (const loopInfo of ordered) {\x0d\n            const numericRaw = numericForSignatures.get(loopInfo.headerId);\x0d\n            if (numericRaw) {\x0d\n                const numericMatch = matchCompilerNumericForNaturalLoop(graph\x2C loopInfo\x2C numericRaw\x2C returnName);\x0d\n                if (!numericMatch) continue;\x0d\n                const carried = candidateLoopCarriedRegisters(graph\x2C [numericMatch]);\x0d\n                mergeEvidence(loopCarriedEvidence\x2C carried.evidence\x2C new Set([\x0d\n                    numericMatch.currentReg\x2C\x0d\n                    numericMatch.finalReg\x2C\x0d\n                    numericMatch.incrementReg\x2C\x0d\n                    numericMatch.negFlagReg\x2C\x0d\n                    numericMatch.loopVarReg\x2C\x0d\n                    numericMatch.loopVarCellReg\x2C\x0d\n                ].filter(Boolean)));\x0d\n                const bodyJoinId = nextSyntheticId;\x0d\n                nextSyntheticId = nextSyntheticBelow(transformed\x2C bodyJoinId - 1);\x0d\n                if (!applyCompilerNumericForMatch(transformed\x2C graph\x2C numericMatch\x2C stateName\x2C bodyJoinId\x2C {\x0d\n                    numericForBranchIds\x2C\x0d\n                    numericForMetaByBranchId\x2C\x0d\n                    numericForBodyStarts\x2C\x0d\n                    loopBodyJoinIds\x2C\x0d\n                    loopBackedgeCountsByJoin\x2C\x0d\n                    loopControlByBlockId\x2C\x0d\n                })) return null;\x0d\n                matches.push({ type: "numeric-for"\x2C match: numericMatch });\x0d\n                numericForLoopCount++;\x0d\n                applied = true;\x0d\n                break;\x0d\n            }\x0d\n\x0d\n            const genericMatch = matchCompilerGenericForNaturalLoop(graph\x2C loopInfo\x2C returnName);\x0d\n            if (genericMatch) {\x0d\n                const carried = candidateLoopCarriedRegisters(graph\x2C [genericMatch]);\x0d\n                mergeEvidence(loopCarriedEvidence\x2C carried.evidence\x2C new Set([\x0d\n                    genericMatch.iteratorReg\x2C\x0d\n                    genericMatch.invariantReg\x2C\x0d\n                    genericMatch.controlReg\x2C\x0d\n                    ...genericMatch.loopVarRegs\x2C\x0d\n                ]));\x0d\n                const bodyJoinId = nextSyntheticId;\x0d\n                nextSyntheticId = nextSyntheticBelow(transformed\x2C bodyJoinId - 1);\x0d\n                if (!applyCompilerGenericForMatch(transformed\x2C graph\x2C genericMatch\x2C stateName\x2C bodyJoinId\x2C {\x0d\n                    genericForBranchIds\x2C\x0d\n                    genericForMetaByBranchId\x2C\x0d\n                    genericForBodyStarts\x2C\x0d\n                    loopBodyJoinIds\x2C\x0d\n                    loopBackedgeCountsByJoin\x2C\x0d\n                    loopControlByBlockId\x2C\x0d\n                })) return null;\x0d\n                matches.push({ type: "generic-for"\x2C match: genericMatch });\x0d\n                genericForLoopCount++;\x0d\n                applied = true;\x0d\n                break;\x0d\n            }\x0d\n\x0d\n            const repeatMatch = matchCompilerRepeatNaturalLoop(graph\x2C loopInfo\x2C returnName);\x0d\n            if (repeatMatch) {\x0d\n                repeatMatch.headerId = repeatMatch.bodyId;\x0d\n                const carried = candidateLoopCarriedRegisters(graph\x2C [repeatMatch]);\x0d\n                mergeEvidence(loopCarriedEvidence\x2C carried.evidence);\x0d\n                const joinId = nextSyntheticId;\x0d\n                nextSyntheticId = nextSyntheticBelow(transformed\x2C joinId - 1);\x0d\n                const repeatId = `repeat:${repeatLoopCount + 1}:${repeatMatch.bodyId}:${repeatMatch.decisionId}`;\x0d\n                if (!applyCompilerRepeatMatch(transformed\x2C graph\x2C repeatMatch\x2C stateName\x2C joinId\x2C repeatId\x2C {\x0d\n                    repeatBranchIds\x2C repeatBodyStarts\x2C loopControlByBlockId\x2C\x0d\n                })) return null;\x0d\n                matches.push({ type: "repeat"\x2C match: repeatMatch });\x0d\n                repeatLoopCount++;\x0d\n                removedCompilerConditionStatementCount += repeatMatch.duplicate?.removedStatementCount || 0;\x0d\n                applied = true;\x0d\n                break;\x0d\n            }\x0d\n\x0d\n            const whileMatch = matchCompilerWhileConditionRegion(graph\x2C loopInfo\x2C natural.dominators\x2C returnName);\x0d\n            if (whileMatch) {\x0d\n                const carried = candidateLoopCarriedRegisters(graph\x2C [whileMatch]);\x0d\n                mergeEvidence(loopCarriedEvidence\x2C carried.evidence);\x0d\n                const bodyJoinId = nextSyntheticId;\x0d\n                nextSyntheticId = nextSyntheticBelow(transformed\x2C bodyJoinId - 1);\x0d\n                if (!applyCompilerWhileMatch(transformed\x2C graph\x2C whileMatch\x2C stateName\x2C bodyJoinId\x2C {\x0d\n                    loopBranchIds\x2C loopBodyJoinIds\x2C loopBackedgeCountsByJoin\x2C controlByBlockId: loopControlByBlockId\x2C\x0d\n                })) return null;\x0d\n                matches.push({ type: "while"\x2C match: whileMatch });\x0d\n                whileLoopCount++;\x0d\n                applied = true;\x0d\n                break;\x0d\n            }\x0d\n        }\x0d\n        if (!applied) return null;\x0d\n    }\x0d\n\x0d\n    if (!matches.length) return null;\x0d\n    const remappedCarried = remapLoopCarriedStarts({ evidence: loopCarriedEvidence }\x2C transformed);\x0d\n    return {\x0d\n        leaves: transformed\x2C\x0d\n        matches\x2C\x0d\n        loopCount: matches.length\x2C\x0d\n        whileLoopCount\x2C\x0d\n        repeatLoopCount\x2C\x0d\n        numericForLoopCount\x2C\x0d\n        genericForLoopCount\x2C\x0d\n        removedCompilerConditionStatementCount\x2C\x0d\n        loopBranchIds\x2C\x0d\n        loopBodyJoinIds\x2C\x0d\n        loopBackedgeCountsByJoin\x2C\x0d\n        repeatBranchIds\x2C\x0d\n        repeatBodyStarts\x2C\x0d\n        terminalRepeatBodyStarts\x2C\x0d\n        numericForBranchIds\x2C\x0d\n        numericForMetaByBranchId\x2C\x0d\n        numericForBodyStarts\x2C\x0d\n        genericForBranchIds\x2C\x0d\n        genericForMetaByBranchId\x2C\x0d\n        genericForBodyStarts\x2C\x0d\n        loopControlByBlockId\x2C\x0d\n        loopCarriedStorageRegs: remappedCarried.registers\x2C\x0d\n        loopCarriedStorageStarts: remappedCarried.starts\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction matchCompilerStructuredLoopProgram(source\x2C stateWhile\x2C stateName\x2C returnName\x2C options = {}) {\x0d\n    const suppliedLeaves = options.normalizedLeaves;\x0d\n    const originalLeaves = suppliedLeaves instanceof Map\x0d\n        ? cloneLeaves(suppliedLeaves)\x0d\n        : extractNormalizedStateLeaves(stateWhile\x2C stateName);\x0d\n    if (!originalLeaves || originalLeaves.size < 4) return null;\x0d\n    const entryId = Number.isInteger(options.entryId) ? options.entryId : 1;\x0d\n    const originalGraphLeaves = cloneLeaves(originalLeaves);\x0d\n    if (!canonicalizeCompilerNumericForChecks(originalGraphLeaves\x2C stateName)) return null;\x0d\n    const originalGraph = createStateGraph(originalGraphLeaves\x2C entryId\x2C stateName);\x0d\n    if (!originalGraph) return null;\x0d\n    const collapsed = collapseCompilerStructuredLoops(originalLeaves\x2C entryId\x2C stateName\x2C returnName);\x0d\n    if (!collapsed) return null;\x0d\n    const structuredLeaves = collapsed.leaves;\x0d\n    // Terminal-repeat recovery exists specifically for the Prometheus shape where\x0d\n    // an all-terminal body suppresses the bottom-check edge and leaves dead final\x0d\n    // states outside the root-reachable region. Once that terminal-repeat proof has\x0d\n    // succeeded\x2C render only the proven root-reachable invocation states. Other loop\x0d\n    // shapes retain the stricter all-block accounting unless their caller explicitly\x0d\n    // requested root-reachable recovery (for example transactional closure recovery).\x0d\n    const terminalRepeatProven = collapsed.matches.some(item => item?.type === "repeat-terminal");\x0d\n    const structuredRootReachableOnly = options.rootReachableOnly === true || terminalRepeatProven;\x0d\n    const program = matchMultiStateLogicalLocals(source\x2C stateWhile\x2C stateName\x2C returnName\x2C {\x0d\n        ...options\x2C\x0d\n        allowConditionalIf: true\x2C\x0d\n        rootReachableOnly: structuredRootReachableOnly\x2C\x0d\n        normalizedLeaves: structuredLeaves\x2C\x0d\n        loopBranchIds: collapsed.loopBranchIds\x2C\x0d\n        loopBodyJoinIds: collapsed.loopBodyJoinIds\x2C\x0d\n        loopBackedgeCountsByJoin: collapsed.loopBackedgeCountsByJoin\x2C\x0d\n        repeatBranchIds: collapsed.repeatBranchIds\x2C\x0d\n        repeatBodyStarts: collapsed.repeatBodyStarts\x2C\x0d\n        terminalRepeatBodyStarts: collapsed.terminalRepeatBodyStarts\x2C\x0d\n        numericForBranchIds: collapsed.numericForBranchIds\x2C\x0d\n        numericForMetaByBranchId: collapsed.numericForMetaByBranchId\x2C\x0d\n        numericForBodyStarts: collapsed.numericForBodyStarts\x2C\x0d\n        genericForBranchIds: collapsed.genericForBranchIds\x2C\x0d\n        genericForMetaByBranchId: collapsed.genericForMetaByBranchId\x2C\x0d\n        genericForBodyStarts: collapsed.genericForBodyStarts\x2C\x0d\n        loopControlByBlockId: collapsed.loopControlByBlockId\x2C\x0d\n        forcedPersistentStorageRegs: collapsed.loopCarriedStorageRegs\x2C\x0d\n        forcedPersistentStorageStarts: collapsed.loopCarriedStorageStarts\x2C\x0d\n        suppressFutureWriteCallArgumentPromotion: true\x2C\x0d\n    });\x0d\n    if (!program) return null;\x0d\n    return {\x0d\n        ...program\x2C\x0d\n        stateCount: originalGraph.reachable.size\x2C\x0d\n        reachableStateIds: [...originalGraph.reachable]\x2C\x0d\n        loopCount: collapsed.loopCount\x2C\x0d\n        whileLoopCount: collapsed.whileLoopCount\x2C\x0d\n        repeatLoopCount: collapsed.repeatLoopCount\x2C\x0d\n        numericForLoopCount: collapsed.numericForLoopCount\x2C\x0d\n        genericForLoopCount: collapsed.genericForLoopCount\x2C\x0d\n        removedCompilerConditionStatementCount: collapsed.removedCompilerConditionStatementCount\x2C\x0d\n        loopMatches: collapsed.matches\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nmodule.exports = { collapseCompilerStructuredLoops\x2C matchCompilerStructuredLoopProgram };\x0d\n
