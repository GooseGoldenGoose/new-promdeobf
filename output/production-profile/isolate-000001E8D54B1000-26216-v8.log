fects\x2C name\x2C deferred\x2C false);\x0d\n                        if (installed === null) return null;\x0d\n                        effects = installed;\x0d\n                    } else {\x0d\n                        env.set(name\x2C deferred);\x0d\n                    }\x0d\n                    continue;\x0d\n                }\x0d\n                // Borrowed state/temp writes may be dead before overwrite; only allow\x0d\n                // an immediate same-register overwrite inside this block.\x0d\n                const next = block.body[i + 1];\x0d\n                if (name !== ctx.stateName && !hasActiveLocal(ctx\x2C name\x2C env) && isSingleAssignment(next\x2C name)) continue;\x0d\n                return null;\x0d\n            }\x0d\n\x0d\n            // Source-storage ownership is epoch-local. A source binding may\x0d\n            // end either at its compiler nil cleanup or because the function\x0d\n            // returns before that cleanup executes. Later writes after either\x0d\n            // boundary belong to a new physical-register epoch.\x0d\n            const storageEpochEnd = cleanupOrTerminalEpoch(ctx\x2C id\x2C i\x2C name);\x0d\n            // Source ownership is epoch-local: an unused source local is still source.\x0d\n            // If this exact definition reaches compiler nil cleanup before any non-nil\x0d\n            // rewrite on every path\x2C Prometheus has promoted this value into VAR storage.\x0d\n            const stableStorageEpoch = ctx.allowConditionalIf && ctx.cleanupRegs.has(name) && !ctx.locals.has(name) &&\x0d\n                storageEpochEnd.valid && storageEpochEnd.sawCleanup;\x0d\n            // A semantic nil initializer may be the source VAR itself and reach function\x0d\n            // termination without a later compiler cleanup. Prove that case from the exact\x0d\n            // epoch: it must dominate from the root path\x2C be observed later\x2C remain stable\x0d\n            // through all uses\x2C and never be overwritten. This is storage proof\x2C not a\x0d\n            // special case for any register/state/layout.\x0d\n            const terminalStableNilEpoch = ctx.allowConditionalIf && markers.length === 0 &&\x0d\n                rhs?.type === "NilLiteral" && semanticNilDefinition && !ctx.locals.has(name) &&\x0d\n                terminalStableUsedEpoch(ctx\x2C id\x2C i\x2C name) && !hasFutureNonNilWrite(ctx\x2C id\x2C i\x2C name);\x0d\n            const conditionalUpdatedEpoch = ctx.allowConditionalIf && markers.length === 0 &&\x0d\n                !ctx.locals.has(name) ? conditionalUpdatedStorageEpoch(ctx\x2C id\x2C i\x2C name) : null;\x0d\n            // A storage binding that survives a conditional join must already\x0d\n            // exist before entering that conditional. If the same physical\x0d\n            // register is written on a branch before any active binding exists\x2C\x0d\n            // that write belongs to an earlier/later TEMP epoch\x2C not to this\x0d\n            // persistent source lifetime. Only a marker-free definition may\x0d\n            // start the persistent binding; stable branch-local epochs retain\x0d\n            // their separate path-scoped proof.\x0d\n            const forcedPersistentStarts = ctx.options?.forcedPersistentStorageStarts;\x0d\n            const forcedPersistentRegs = ctx.options?.forcedPersistentStorageRegs;\x0d\n            const provenLoopPreheaderStart = forcedPersistentStarts instanceof Map &&\x0d\n                forcedPersistentStarts.get(name) instanceof Set &&\x0d\n                forcedPersistentStarts.get(name).has(id + ":" + i);\x0d\n            const isForcedLoopStorage = forcedPersistentRegs instanceof Set && forcedPersistentRegs.has(name);\x0d\n            const startsPersistentStorage = ctx.persistentStorageRegs.has(name) &&\x0d\n                (provenLoopPreheaderStart || (!isForcedLoopStorage && markers.length === 0));\x0d\n            if ((startsPersistentStorage || stableStorageEpoch || terminalStableNilEpoch || conditionalUpdatedEpoch?.proven) && !hasActiveLocal(ctx\x2C name\x2C env)) {\x0d\n                const display = allocateValueDisplay(ctx);\x0d\n                const declaration = `local ${display} = ${value}`;\x0d\n                if (markers.length !== 0) {\x0d\n                    ctx.pathLocalBindingNames.add(display);\x0d\n                    env.set(pathLocalOwnerKey(ctx\x2C name)\x2C display);\x0d\n                    effects = [...effects\x2C declaration];\x0d\n                } else {\x0d\n                    ctx.localNames.set(name\x2C display);\x0d\n                    ctx.locals.add(name);\x0d\n                    if (terminalStableNilEpoch || conditionalUpdatedEpoch?.terminalLive) ctx.terminalLiveLocals.add(name);\x0d\n                    ctx.out.push(declaration);\x0d\n                }\x0d\n                env.set(name\x2C display);\x0d\n                continue;\x0d\n            }\x0d\n\x0d\n            // Some compiler TEMPs hold an object/index result that must remain\x0d\n            // stable across later key/value evaluation before a field write.\x0d\n            // Materialize that exact epoch at its original definition point\x2C\x0d\n            // but do not classify the physical register as a source local.\x0d\n            if (!hasActiveLocal(ctx\x2C name\x2C env) && valueMayBeIndexWriteBaseAfter(ctx\x2C id\x2C i\x2C name)) {\x0d\n                // A TEMP alias to an already-proven captured/source binding does not\x0d\n                // need new storage. Preserve its owner provenance so mutation renders\x0d\n                // directly against the existing source object instead of inventing an\x0d\n                // alias local. Only explicit alias identity qualifies here.\x0d\n                if (typeof inheritedUpvalueAlias === "string" && value === inheritedUpvalueAlias) {\x0d\n                    env.set(name\x2C value);\x0d\n                    env.set(upvalueAliasKey(ctx\x2C name)\x2C inheritedUpvalueAlias);\x0d\n                    continue;\x0d\n                }\x0d\n                const display = allocateValueDisplay(ctx);\x0d\n                const declaration = `local ${display} = ${value}`;\x0d\n                if (markers.length !== 0) effects = [...effects\x2C declaration];\x0d\n                else ctx.out.push(declaration);\x0d\n                env.set(name\x2C display);\x0d\n                env.set(mutationBaseOwnerKey(name)\x2C display);\x0d\n                continue;\x0d\n            }\x0d\n\x0d\n            if (ctx.cleanupRegs.has(name) && !ctx.accumulatorRegs.has(name) && !hasActiveLocal(ctx\x2C name\x2C env) && isIdentifier(rhs) && rhs.name !== name) {\x0d\n                const display = allocateValueDisplay(ctx);\x0d\n                const declaration = `local ${display} = ${value}`;\x0d\n                if (markers.length !== 0) {\x0d\n                    if (!ctx.allowConditionalIf) return null;\x0d\n                    ctx.pathLocalBindingNames.add(display);\x0d\n                    env.set(pathLocalOwnerKey(ctx\x2C name)\x2C display);\x0d\n                    effects = [...effects\x2C declaration];\x0d\n                } else {\x0d\n                    ctx.localNames.set(name\x2C display);\x0d\n                    ctx.locals.add(name);\x0d\n                    ctx.out.push(declaration);\x0d\n                }\x0d\n                env.set(name\x2C display);\x0d\n            } else if (isPendingDeferredLocalValue(env.get(name))) {\x0d\n                // A source closure local exists but its capture dependencies are not\x0d\n                // renderable yet. Do not turn a later write into an assignment to an\x0d\n                // internal owner token; unresolved semantic use is ambiguous.\x0d\n                return null;\x0d\n            } else if (hasActiveLocal(ctx\x2C name\x2C env)) {\x0d\n                const line = `${activeLocalDisplay(ctx\x2C name\x2C env)} = ${value}`;\x0d\n                if (markers.length !== 0) {\x0d\n                    if (!ctx.allowConditionalIf) return null;\x0d\n                    effects = [...effects\x2C line];\x0d\n                } else {\x0d\n                    ctx.out.push(line);\x0d\n                }\x0d\n                env.set(name\x2C activeLocalDisplay(ctx\x2C name\x2C env));\x0d\n            } else {\x0d\n                env.set(name\x2C value);\x0d\n                if (typeof inheritedUpvalueAlias === "string" && value === inheritedUpvalueAlias) {\x0d\n                    env.set(upvalueAliasKey(ctx\x2C name)\x2C inheritedUpvalueAlias);\x0d\n                }\x0d\n            }\x0d\n        }\x0d\n\x0d\n        effects = flushReadyStructuredPacks(ctx\x2C env\x2C markers\x2C effects\x2C true);\x0d\n        if (effects === null) return null;\x0d\n        for (const value of env.values()) {\x0d\n            if (structuredPackId(ctx\x2C value) || structuredPackSlot(ctx\x2C value)) return null;\x0d\n        }\x0d\n\x0d\n        const loopControlMap = ctx.options?.loopControlByBlockId;\x0d\n        const loopControl = loopControlMap instanceof Map ? loopControlMap.get(id) : null;\x0d\n        if (loopControl !== null && loopControl !== undefined) {\x0d\n            if ((loopControl !== "break" && loopControl !== "continue") || block.transition.kind !== "jump") return null;\x0d\n            effects = [...effects\x2C loopControl];\x0d\n        }\x0d\n\x0d\n        ctx.processed.add(id);\x0d\n        effects = flushReadyPendingDeferredLocals(ctx\x2C env\x2C markers\x2C effects);\x0d\n        const tr = block.transition;\x0d\n        const sends = [];\x0d\n        if (tr.kind === "stop") {\x0d\n            if (terminalReturnLine === null) return null;\x0d\n            let terminalCandidate = {\x0d\n                env: new Map(env)\x2C\x0d\n                markers: [...markers]\x2C\x0d\n                effects: [...effects\x2C terminalReturnLine]\x2C\x0d\n                terminal: true\x2C\x0d\n            };\x0d\n            terminalCandidate = foldTerminalRepeatScopes(ctx\x2C terminalCandidate);\x0d\n            if (!terminalCandidate) return null;\x0d\n            ctx.terminalCandidates.push(terminalCandidate);\x0d\n            if (!collapseTerminalCandidates(ctx)) return null;\x0d\n        } else if (tr.kind === "jump") sends.push({ target: tr.target\x2C env\x2C markers\x2C effects });\x0d\n        else if (tr.kind === "branch") {\x0d\n            const condition = resolveId(ctx\x2C tr.conditionRegister\x2C env);\x0d\n            if (condition == null) return null;\x0d\n            const effectCount = effects.length;\x0d\n            sends.push({ target: tr.onTrue\x2C env\x2C markers: [...markers\x2C { condition\x2C truth: true\x2C effectCount\x2C branchId: id }]\x2C effects });\x0d\n            sends.push({ target: tr.onFalse\x2C env\x2C markers: [...markers\x2C { condition\x2C truth: false\x2C effectCount\x2C branchId: id }]\x2C effects });\x0d\n        }\x0d\n        for (const send of sends) {\x0d\n            if (!ctx.incoming.has(send.target)) ctx.incoming.set(send.target\x2C []);\x0d\n            ctx.incoming.get(send.target).push({\x0d\n                env: new Map(send.env)\x2C\x0d\n                markers: [...(send.markers || [])]\x2C\x0d\n                effects: [...(send.effects || [])]\x2C\x0d\n            });\x0d\n            ctx.indegree.set(send.target\x2C ctx.indegree.get(send.target) - 1);\x0d\n            if (ctx.indegree.get(send.target) === 0) ctx.processingQueue.push(send.target);\x0d\n        }\x0d\n    }\x0d\n\x0d\n    if (!collapseTerminalCandidates(ctx)) return null;\x0d\n    if (ctx.terminalCandidates.length !== 1 || (ctx.terminalCandidates[0].markers || []).length !== 0) return null;\x0d\n    const terminalEffects = [...(ctx.terminalCandidates[0].effects || [])];\x0d\n    // Compiler fallthrough and an explicit empty return share the same final VM\x0d\n    // bookkeeping.  At root terminal scope a trailing bare return is therefore\x0d\n    // not provably source-authored; omit only that final redundant marker.\x0d\n    if (terminalEffects[terminalEffects.length - 1] === "return") terminalEffects.pop();\x0d\n    for (const effect of terminalEffects) ctx.out.push(effect);\x0d\n    for (const name of ctx.terminalLiveLocals) {\x0d\n        ctx.locals.delete(name);\x0d\n        ctx.localNames.delete(name);\x0d\n    }\x0d\n    if (ctx.processed.size !== ctx.reachable.size || ctx.locals.size !== 0 || ctx.out.length === 0) return null;\x0d\n    const logicalReductionApplied = ctx.logicalReduction.originalReachableStateIds.size > ctx.reachable.size;\x0d\n    const provenLoopControl =\x0d\n        (ctx.options?.loopBranchIds instanceof Set && ctx.options.loopBranchIds.size > 0) ||\x0d\n        (ctx.options?.repeatBranchIds instanceof Set && ctx.options.repeatBranchIds.size > 0) ||\x0d\n        (ctx.options?.terminalRepeatBodyStarts instanceof Map && ctx.options.terminalRepeatBodyStarts.size > 0) ||\x0d\n        (ctx.options?.numericForBranchIds instanceof Set && ctx.options.numericForBranchIds.size > 0) ||\x0d\n        (ctx.options?.genericForBranchIds instanceof Set && ctx.options.genericForBranchIds.size > 0);\x0d\n    if (ctx.allowConditionalIf && ctx.conditionalIfCount < 1 && !provenLoopControl &&\x0d\n        ctx.options?.allowStraightLineStructured !== true &&\x0d\n        !(ctx.options?.allowLogicalOnlyStructured === true && logicalReductionApplied)) {\x0d\n        if (!ctx.out.some(line => /^if\\s/.test(line) || /^while\\s/.test(line))) return null;\x0d\n        ctx.conditionalIfCount = 1;\x0d\n    }\x0d\n    let outputSource = renderProgram(ctx.out);\x0d\n    if (ctx.renderAsFunction) {\x0d\n        const params = [...ctx.parameterNames];\x0d\n        if (ctx.sawVarargs) params.push("...");\x0d\n        outputSource = renderFunction(params\x2C ctx.out);\x0d\n    }\x0d\n    return {\x0d\n        source: outputSource\x2C\x0d\n        statementCount: ctx.out.length\x2C\x0d\n        localCount: ctx.valueCount + ctx.tableCount\x2C\x0d\n        stateCount: ctx.rootReachableOnly ? ctx.logicalReduction.originalReachableStateIds.size : ctx.originalLeaves.size\x2C\x0d\n        reachableStateIds: [...ctx.logicalReduction.originalReachableStateIds]\x2C\x0d\n        conditionalIfCount: ctx.conditionalIfCount\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nmodule.exports = { matchMultiStateLogicalLocals };\x0d\n
