script-source,121,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\structured\\terminal.js,"use strict";\x0d\n\x0d\nconst { indentConditionalEffect } = require("./branches");\x0d\nfunction markersSharePrefix(ctx\x2C aMarkers\x2C bMarkers\x2C length) {\x0d\n    if (aMarkers.length < length || bMarkers.length < length) return false;\x0d\n    for (let i = 0; i < length; i++) {\x0d\n        const a = aMarkers[i]\x2C b = bMarkers[i];\x0d\n        if (!a || !b || a.condition !== b.condition || a.truth !== b.truth || a.effectCount !== b.effectCount || a.branchId !== b.branchId) return false;\x0d\n    }\x0d\n    return true;\x0d\n}\x0d\n\x0d\nfunction terminalSiblingMatch(ctx\x2C a\x2C b) {\x0d\n    const am = a.markers || []\x2C bm = b.markers || [];\x0d\n    if (am.length === 0 || am.length !== bm.length || !markersSharePrefix(ctx\x2C am\x2C bm\x2C am.length - 1)) return null;\x0d\n    const al = am[am.length - 1]\x2C bl = bm[bm.length - 1];\x0d\n    if (!al || !bl || al.condition !== bl.condition || al.truth === bl.truth || al.effectCount !== bl.effectCount || al.branchId !== bl.branchId) return null;\x0d\n    const effectPrefix = al.effectCount;\x0d\n    const ae = a.effects || []\x2C be = b.effects || [];\x0d\n    if (!Number.isInteger(effectPrefix) || effectPrefix > ae.length || effectPrefix > be.length) return null;\x0d\n    for (let i = 0; i < effectPrefix; i++) if (ae[i] !== be[i]) return null;\x0d\n    return { al\x2C bl\x2C effectPrefix };\x0d\n}\x0d\n\x0d\nfunction guardLine(ctx\x2C condition\x2C truth\x2C bodyEffects) {\x0d\n    if (!Array.isArray(bodyEffects) || bodyEffects.length === 0) return null;\x0d\n    const body = bodyEffects.map(line => indentConditionalEffect(ctx\x2C line)).join("\\n");\x0d\n    if (truth) return `if ${condition} then\\n${body}\\nend`;\x0d\n    // Preserve a compiler-proven false/else arm instead of inverting the\x0d\n    // condition. Fresh CF is source recovery\x2C so an else-only source branch\x0d\n    // remains `if cond then else ... end`.\x0d\n    return `if ${condition} then\\nelse\\n${body}\\nend`;\x0d\n}\x0d\n\x0d\nfunction foldTerminalRepeatScopes(ctx\x2C candidate) {\x0d\n    if (!candidate) return null;\x0d\n    const current = {\x0d\n        env: new Map(candidate.env)\x2C\x0d\n        markers: [...(candidate.markers || [])]\x2C\x0d\n        effects: [...(candidate.effects || [])]\x2C\x0d\n        terminal: candidate.terminal === true\x2C\x0d\n    };\x0d\n    while (current.markers.length > 0) {\x0d\n        const marker = current.markers[current.markers.length - 1];\x0d\n        if (marker?.kind !== "terminal-repeat-scope") break;\x0d\n        if (typeof marker.condition !== "string" || !Number.isInteger(marker.effectCount) || marker.effectCount < 0 || marker.effectCount > current.effects.length) return null;\x0d\n        const bodyEffects = current.effects.slice(marker.effectCount);\x0d\n        if (!bodyEffects.length) return null;\x0d\n        const body = bodyEffects.map(line => indentConditionalEffect(ctx\x2C line)).join("\\n");\x0d\n        const structured = `repeat\\n${body}\\nuntil ${marker.condition}`;\x0d\n        current.effects = [...current.effects.slice(0\x2C marker.effectCount)\x2C structured];\x0d\n        current.markers.pop();\x0d\n    }\x0d\n    return current;\x0d\n}\x0d\n\x0d\nfunction collapseTerminalCandidates(ctx) {\x0d\n    let changed = true;\x0d\n    while (changed) {\x0d\n        changed = false;\x0d\n        outer: for (let i = 0; i < ctx.terminalCandidates.length; i++) {\x0d\n            for (let j = i + 1; j < ctx.terminalCandidates.length; j++) {\x0d\n                const a = ctx.terminalCandidates[i]\x2C b = ctx.terminalCandidates[j];\x0d\n                const match = terminalSiblingMatch(ctx\x2C a\x2C b);\x0d\n                if (!match) continue;\x0d\n                const trueCandidate = match.al.truth ? a : b;\x0d\n                const falseCandidate = match.al.truth ? b : a;\x0d\n                const guard = guardLine(ctx\x2C match.al.condition\x2C true\x2C (trueCandidate.effects || []).slice(match.effectPrefix));\x0d\n                if (!guard) return false;\x0d\n                let merged = {\x0d\n                    env: new Map(falseCandidate.env)\x2C\x0d\n                    markers: (falseCandidate.markers || []).slice(0\x2C -1)\x2C\x0d\n                    effects: [\x0d\n                        ...(falseCandidate.effects || []).slice(0\x2C match.effectPrefix)\x2C\x0d\n                        guard\x2C\x0d\n                        ...(falseCandidate.effects || []).slice(match.effectPrefix)\x2C\x0d\n                    ]\x2C\x0d\n                    terminal: true\x2C\x0d\n                };\x0d\n                merged = foldTerminalRepeatScopes(ctx\x2C merged);\x0d\n                if (!merged) return false;\x0d\n                ctx.terminalCandidates.splice(j\x2C 1);\x0d\n                ctx.terminalCandidates.splice(i\x2C 1\x2C merged);\x0d\n                changed = true;\x0d\n                break outer;\x0d\n            }\x0d\n        }\x0d\n    }\x0d\n    return true;\x0d\n}\x0d\n\x0d\nfunction foldTerminalGuards(ctx\x2C candidate) {\x0d\n    let current = {\x0d\n        env: new Map(candidate.env)\x2C\x0d\n        markers: [...(candidate.markers || [])]\x2C\x0d\n        effects: [...(candidate.effects || [])]\x2C\x0d\n    };\x0d\n    while (current.markers.length > 0) {\x0d\n        let matchIndex = -1;\x0d\n        let match = null;\x0d\n        for (let i = 0; i < ctx.terminalCandidates.length; i++) {\x0d\n            const terminal = ctx.terminalCandidates[i];\x0d\n            const candidateMatch = terminalSiblingMatch(ctx\x2C current\x2C terminal);\x0d\n            if (!candidateMatch) continue;\x0d\n            matchIndex = i;\x0d\n            match = candidateMatch;\x0d\n            break;\x0d\n        }\x0d\n        if (matchIndex < 0) break;\x0d\n        const terminal = ctx.terminalCandidates[matchIndex];\x0d\n        const terminalMarker = terminal.markers[terminal.markers.length - 1];\x0d\n        const guard = guardLine(ctx\x2C terminalMarker.condition\x2C terminalMarker.truth\x2C (terminal.effects || []).slice(match.effectPrefix));\x0d\n        if (!guard) return null;\x0d\n        const prefixEffects = current.effects.slice(0\x2C match.effectPrefix);\x0d\n        current = {\x0d\n            env: new Map(current.env)\x2C\x0d\n            markers: current.markers.slice(0\x2C -1)\x2C\x0d\n            effects: [...prefixEffects\x2C guard\x2C ...current.effects.slice(match.effectPrefix)]\x2C\x0d\n        };\x0d\n        ctx.terminalCandidates.splice(matchIndex\x2C 1);\x0d\n        if (!collapseTerminalCandidates(ctx)) return null;\x0d\n    }\x0d\n    return current;\x0d\n}\x0d\n\x0d\nmodule.exports = { markersSharePrefix\x2C terminalSiblingMatch\x2C guardLine\x2C foldTerminalRepeatScopes\x2C collapseTerminalCandidates\x2C foldTerminalGuards };\x0d\n
