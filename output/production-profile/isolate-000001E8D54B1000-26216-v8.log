script-source,102,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\linear\\context.js,"use strict";\n\nconst { isIdentifier\x2C isSingleAssignment } = require("../ast");\n\nfunction createLinearContext(source\x2C leaf\x2C stateName\x2C returnName\x2C options = {}) {\n    const INIT_READ = 1;\n    const INDEX_DEST_READ = 2;\n    const WRITE = 4;\n    const NIL_WRITE = 8;\n    function collectIdentifierUses(node\x2C out) {\n        if (!node || typeof node !== "object") return;\n        if (isIdentifier(node)) {\n            out.add(node.name);\n            return;\n        }\n        for (const [key\x2C value] of Object.entries(node)) {\n            if (key === "range" || key === "loc" || key === "variables") continue;\n            if (Array.isArray(value)) {\n                for (const item of value) collectIdentifierUses(item\x2C out);\n            } else if (value && typeof value === "object") collectIdentifierUses(value\x2C out);\n        }\n    }\n    const futureEvents = new Map();\n    function addFutureEvent(name\x2C index\x2C flags) {\n        let events = futureEvents.get(name);\n        if (!events) futureEvents.set(name\x2C events = []);\n        const last = events[events.length - 1];\n        if (last?.index === index) last.flags |= flags;\n        else events.push({ index\x2C flags });\n    }\n    function findNextFutureEvent(name\x2C startIndex\x2C mask) {\n        const events = futureEvents.get(name);\n        if (!events) return null;\n        let low = 0\x2C high = events.length;\n        while (low < high) {\n            const middle = (low + high) >>> 1;\n            if (events[middle].index <= startIndex) low = middle + 1;\n            else high = middle;\n        }\n        for (let index = low; index < events.length; index++) {\n            if ((events[index].flags & mask) !== 0) return events[index];\n        }\n        return null;\n    }\n\n    function isDeadNilWrite(index\x2C name) {\n        const next = findNextFutureEvent(name\x2C index\x2C INIT_READ | INDEX_DEST_READ | WRITE);\n        if (next === null) return true;\n        return (next.flags & (INIT_READ | INDEX_DEST_READ)) === 0 && (next.flags & WRITE) !== 0;\n    }\n\n    const cleanupRegs = new Set();\n    const nonNilDefinitionCount = new Map();\n    const nilDefinitionCount = new Map();\n    const firstNilDefinitionIndex = new Map();\n    for (let scanIndex = 0; scanIndex < leaf.length; scanIndex++) {\n        const statement = leaf[scanIndex];\n        const initUses = new Set();\n        collectIdentifierUses(statement?.init\x2C initUses);\n        for (const name of initUses) addFutureEvent(name\x2C scanIndex\x2C INIT_READ);\n        if (!isSingleAssignment(statement)) continue;\n        const dest = statement.variables[0];\n        const rhs = statement.init[0];\n        if (dest?.type === "IndexExpression") {\n            const destinationUses = new Set();\n            collectIdentifierUses(dest\x2C destinationUses);\n            for (const name of destinationUses) addFutureEvent(name\x2C scanIndex\x2C INDEX_DEST_READ);\n        }\n        if (isIdentifier(dest)) addFutureEvent(dest.name\x2C scanIndex\x2C WRITE | (rhs?.type === "NilLiteral" ? NIL_WRITE : 0));\n        if (!isIdentifier(dest) || dest.name === stateName || dest.name === returnName) continue;\n        if (rhs?.type === "NilLiteral") {\n            cleanupRegs.add(dest.name);\n            nilDefinitionCount.set(dest.name\x2C (nilDefinitionCount.get(dest.name) || 0) + 1);\n            if (!firstNilDefinitionIndex.has(dest.name)) firstNilDefinitionIndex.set(dest.name\x2C scanIndex);\n        } else {\n            nonNilDefinitionCount.set(dest.name\x2C (nonNilDefinitionCount.get(dest.name) || 0) + 1);\n        }\n    }\n    // Prometheus may compile a local initializer into an ordinary TEMP register\n    // and then promote that exact physical register into VAR ownership. Its\n    // copyRegisters(varReg\x2C exprReg) emits nothing when both ids are equal\x2C so\n    // the VM contains no explicit TEMP -> VAR handoff. Recover only the\n    // unambiguous no-reassignment shape: a direct non-copy definition whose\n    // very next write to that physical register is its nil lifetime cleanup.\n    // A plain TEMP free never emits that cleanup\x2C while an already-active VAR\n    // cannot be selected by allocRegister(false) for this direct definition.\n    const directPromotionStartIndices = new Set();\n    const directPromotionStartsByRegister = new Map();\n    for (let scanIndex = 0; scanIndex < leaf.length; scanIndex++) {\n        const statement = leaf[scanIndex];\n        if (!isSingleAssignment(statement)) continue;\n        const dest = statement.variables[0];\n        const rhs = statement.init[0];\n        if (!isIdentifier(dest) || !cleanupRegs.has(dest.name) || rhs?.type === "NilLiteral" || isIdentifier(rhs)) continue;\n        const nextWrite = findNextFutureEvent(dest.name\x2C scanIndex\x2C WRITE);\n        if (!nextWrite || (nextWrite.flags & NIL_WRITE) === 0) continue;\n        const cleanup = leaf[nextWrite.index];\n        if (!isSingleAssignment(cleanup\x2C dest.name) || cleanup.init[0]?.type !== "NilLiteral" || !isDeadNilWrite(nextWrite.index\x2C dest.name)) continue;\n        directPromotionStartIndices.add(scanIndex);\n        let starts = directPromotionStartsByRegister.get(dest.name);\n        if (!starts) directPromotionStartsByRegister.set(dest.name\x2C starts = []);\n        starts.push(scanIndex);\n    }\n    function hasFutureDirectPromotionStart(startIndex\x2C name) {\n        const starts = directPromotionStartsByRegister.get(name);\n        if (!starts) return false;\n        for (const index of starts) if (index > startIndex) return true;\n        return false;\n    }\n\n    if (cleanupRegs.size === 0 && options.allowNoLocals !== true) return null;\n\n    const expr = new Map()\x2C exprKinds = new Map()\x2C exprMeta = new Map();\n    const locals = new Set()\x2C localNames = new Map()\x2C out = [];\n    let declaredCount = 0\x2C valueLocalCount = 0\x2C tableLocalCount = 0\x2C nextPackOrder = 0;\n    const pendingPacks = new Map()\x2C packCreationOrder = new Map();\n    let sawReturnReset = false\x2C sawStop = false;\n    let terminalReturnLine = null;\n    const consumedPackRegs = new Set();\n    const upvalueCells = new Map();\n    const predeclaredNilLocals = new Set();\n    const deferredStorageCopies = new Map();\n    const deferredTerminalClosureCopies = new Map();\n    const deferredTerminalUnusedCopies = new Map();\n    const deferredUpvalueClosureStores = new Map();\n    const deferredLiveTableCopies = new Map();\n    const terminalClosureLocals = new Set();\n    const terminalUnusedLocals = new Set();\n    const terminalAliasLocals = new Set();\n    const terminalTableLocals = new Set();\n    const terminalNilLocals = new Set();\n    const plainTableLocals = new Set();\n    const deferredSourceLines = [];\n    const deferredLocalBarriers = new Map();\n    return {\n        source\x2C leaf\x2C stateName\x2C returnName\x2C options\x2C\n        INIT_READ\x2C INDEX_DEST_READ\x2C WRITE\x2C NIL_WRITE\x2C\n        findNextFutureEvent\x2C hasFutureDirectPromotionStart\x2C isDeadNilWrite\x2C\n        futureEvents\x2C cleanupRegs\x2C nonNilDefinitionCount\x2C nilDefinitionCount\x2C firstNilDefinitionIndex\x2C\n        directPromotionStartIndices\x2C directPromotionStartsByRegister\x2C\n        expr\x2C exprKinds\x2C exprMeta\x2C locals\x2C localNames\x2C out\x2C\n        declaredCount\x2C valueLocalCount\x2C tableLocalCount\x2C nextPackOrder\x2C\n        pendingPacks\x2C packCreationOrder\x2C sawReturnReset\x2C sawStop\x2C terminalReturnLine\x2C\n        consumedPackRegs\x2C upvalueCells\x2C predeclaredNilLocals\x2C\n        deferredStorageCopies\x2C deferredTerminalClosureCopies\x2C deferredTerminalUnusedCopies\x2C\n        deferredUpvalueClosureStores\x2C deferredLiveTableCopies\x2C\n        terminalClosureLocals\x2C terminalUnusedLocals\x2C terminalAliasLocals\x2C\n        terminalTableLocals\x2C terminalNilLocals\x2C plainTableLocals\x2C\n        deferredSourceLines\x2C deferredLocalBarriers\x2C\n    };\n}\n\nmodule.exports = { createLinearContext };\n
