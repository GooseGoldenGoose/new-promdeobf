    // at function terminal instead; keep it live through terminal rendering.\x0d\n    const persistentStorageRegs = new Set();\x0d\n    const forcedPersistentStorageRegs = options.forcedPersistentStorageRegs instanceof Set\x0d\n        ? options.forcedPersistentStorageRegs : null;\x0d\n    if (forcedPersistentStorageRegs) {\x0d\n        for (const name of forcedPersistentStorageRegs) {\x0d\n            if (cleanupRegs.has(name) && accumulatorRegs.has(name)) {\x0d\n                persistentStorageRegs.add(name);\x0d\n            } else if (!cleanupRegs.has(name)) {\x0d\n                persistentStorageRegs.add(name);\x0d\n                terminalLiveLocals.add(name);\x0d\n            }\x0d\n        }\x0d\n    }\x0d\n    const out = [];\x0d\n    const terminalCandidates = [];\x0d\n    const parameterNames = [];\x0d\n    const reservedBindingNames = new Set();\x0d\n    if (captureNames) {\x0d\n        for (const value of captureNames.values()) if (typeof value === "string" && isLuaIdentifier(value)) reservedBindingNames.add(value);\x0d\n    }\x0d\n    let nextValueSuffix = 1;\x0d\n    let nextTableSuffix = 1;\x0d\n    let valueCount = 0;\x0d\n    let tableCount = 0;\x0d\n    let conditionalIfCount = 0;\x0d\n    let lastRootConditionalJoinId = null;\x0d\n    let sawVarargs = false;\x0d\n\x0d\n    const eventualCleanupCache = new Map();\x0d\n    // A call-result temporary can be overwritten on the same block or on a\x0d\n    // later CFG path.  Unlike pure compiler copies\x2C the call itself is a\x0d\n    // source-level side effect and must not disappear merely because its\x0d\n    // return value is dead.  Keep this query path-aware so a call is emitted\x0d\n    // only when every path discards the value before any read.\x0d\n    const valueReadAfterCache = new Map();\x0d\n    const futureNonNilWriteCache = new Map();\x0d\n    const cleanupPathCache = new Map();\x0d\n    // Exact start-site cache for source bindings whose incoming value survives one\x0d\n    // bran