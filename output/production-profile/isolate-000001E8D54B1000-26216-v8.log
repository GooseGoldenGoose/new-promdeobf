script-source,103,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\linear\\lifetime.js,"use strict";\n\nconst { isIdentifier\x2C isSingleAssignment\x2C isPrimitiveLiteral\x2C isEmptyTable\x2C isVmRegisterName\x2C sourceOf\x2C renderTableFields\x2C renderUnary\x2C isLuaIdentifier } = require("../ast");\nfunction nodeUsesIdentifier(ctx\x2C node\x2C name) {\n    if (!node || typeof node !== "object") return false;\n    if (isIdentifier(node\x2C name)) return true;\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) {\n            if (value.some(item => nodeUsesIdentifier(ctx\x2C item\x2C name))) return true;\n        } else if (value && typeof value === "object" && nodeUsesIdentifier(ctx\x2C value\x2C name)) return true;\n    }\n    return false;\n}\n\nfunction valueUsedBeforeOverwrite(ctx\x2C startIndex\x2C name) {\n    const event = ctx.findNextFutureEvent(name\x2C startIndex\x2C ctx.INIT_READ | ctx.WRITE);\n    return event !== null && (event.flags & ctx.INIT_READ) !== 0;\n}\n\nfunction hasLaterNilAssignment(ctx\x2C startIndex\x2C name) {\n    return ctx.findNextFutureEvent(name\x2C startIndex\x2C ctx.NIL_WRITE) !== null;\n}\n\nfunction hasOnlyDeadCopyUses(ctx\x2C startIndex\x2C name\x2C seen = new Set()) {\n    if (seen.has(name)) return false;\n    const nextSeen = new Set(seen);\n    nextSeen.add(name);\n    for (let cursor = startIndex + 1; cursor < ctx.leaf.length; cursor++) {\n        const statement = ctx.leaf[cursor];\n        if (!isSingleAssignment(statement)) {\n            if (nodeUsesIdentifier(ctx\x2C statement?.init\x2C name)) return false;\n            continue;\n        }\n        const dest = statement.variables[0];\n        const value = statement.init[0];\n        const rhsUses = nodeUsesIdentifier(ctx\x2C value\x2C name) || (dest?.type === "IndexExpression" && nodeUsesIdentifier(ctx\x2C dest\x2C name));\n        if (rhsUses) {\n            if (!isIdentifier(value\x2C name) || !isIdentifier(dest) || dest.name === name || ctx.cleanupRegs.has(dest.name) || !hasOnlyDeadCopyUses(ctx\x2C cursor\x2C dest.name\x2C nextSeen)) return false;\n            continue;\n        }\n        if (isIdentifier(dest\x2C name)) return true;\n    }\n    return true;\n}\n\nfunction isTerminalUnreadEpoch(ctx\x2C startIndex\x2C name) {\n    return ctx.findNextFutureEvent(name\x2C startIndex\x2C ctx.INIT_READ | ctx.INDEX_DEST_READ | ctx.WRITE) === null;\n}\n\nfunction nodeUsesAsCallBase(ctx\x2C node\x2C name) {\n    if (!node || typeof node !== "object") return false;\n    if (node.type === "CallExpression" && isIdentifier(node.base\x2C name)) return true;\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) {\n            if (value.some(item => nodeUsesAsCallBase(ctx\x2C item\x2C name))) return true;\n        } else if (value && typeof value === "object" && nodeUsesAsCallBase(ctx\x2C value\x2C name)) return true;\n    }\n    return false;\n}\n\nfunction isTerminalStableUsedEpoch(ctx\x2C startIndex\x2C name) {\n    let useCount = 0;\n    let firstUseIndex = -1;\n    let soleUseIsCallBase = false;\n    let soleUseIsLogical = false;\n    for (let cursor = startIndex + 1; cursor < ctx.leaf.length; cursor++) {\n        const statement = ctx.leaf[cursor];\n        if (!isSingleAssignment(statement)) {\n            if (nodeUsesIdentifier(ctx\x2C statement?.init\x2C name)) {\n                useCount++;\n                if (firstUseIndex < 0) firstUseIndex = cursor;\n            }\n            continue;\n        }\n        const dest = statement.variables[0];\n        const rhs = statement.init[0];\n        if (isIdentifier(dest\x2C name)) return false;\n        if (isIdentifier(dest\x2C ctx.stateName) && isIdentifier(rhs\x2C name)) return false;\n        if (nodeUsesIdentifier(ctx\x2C rhs\x2C name) || (dest?.type === "IndexExpression" && nodeUsesIdentifier(ctx\x2C dest\x2C name))) {\n            useCount++;\n            if (firstUseIndex < 0) {\n                firstUseIndex = cursor;\n                soleUseIsCallBase = nodeUsesAsCallBase(ctx\x2C rhs\x2C name);\n                soleUseIsLogical = rhs?.type === "LogicalExpression" && nodeUsesIdentifier(ctx\x2C rhs\x2C name);\n            }\n        }\n    }\n    // One-use callables and immediately-consumed operands are compiler TEMP shapes too.\n    // A terminal ctx.source alias needs either repeated use\x2C or one delayed non-call use.\n    return useCount > 1 || (useCount === 1 && firstUseIndex > startIndex + 1 && !soleUseIsCallBase && !soleUseIsLogical);\n}\n\nfunction findFutureTerminalUnusedCopy(ctx\x2C startIndex\x2C tempReg) {\n    const event = ctx.findNextFutureEvent(tempReg\x2C startIndex\x2C ctx.INIT_READ | ctx.INDEX_DEST_READ | ctx.WRITE);\n    if (!event) return null;\n    const statement = ctx.leaf[event.index];\n    if (!isSingleAssignment(statement)) return null;\n    const dest = statement.variables[0];\n    const rhs = statement.init[0];\n    if (!isIdentifier(dest) || !isIdentifier(rhs\x2C tempReg) || !isVmRegisterName(dest.name) || ctx.cleanupRegs.has(dest.name)) return null;\n    return isTerminalUnreadEpoch(ctx\x2C event.index\x2C dest.name) ? dest.name : null;\n}\n\nfunction findFutureTerminalClosureCopy(ctx\x2C startIndex\x2C tempReg) {\n    const event = ctx.findNextFutureEvent(tempReg\x2C startIndex\x2C ctx.INIT_READ | ctx.INDEX_DEST_READ | ctx.WRITE);\n    if (!event) return null;\n    const statement = ctx.leaf[event.index];\n    if (!isSingleAssignment(statement)) return null;\n    const dest = statement.variables[0];\n    const rhs = statement.init[0];\n    if (!isIdentifier(dest) || !isIdentifier(rhs\x2C tempReg) || dest.name === ctx.stateName || dest.name === ctx.returnName || ctx.cleanupRegs.has(dest.name)) return null;\n    const laterEvents = ctx.futureEvents.get(dest.name) || [];\n    let sawUse = false;\n    for (const later of laterEvents) {\n        if (later.index <= event.index) continue;\n        if ((later.flags & (ctx.INIT_READ | ctx.INDEX_DEST_READ)) !== 0) sawUse = true;\n        if ((later.flags & ctx.WRITE) !== 0) return null;\n    }\n    return sawUse ? dest.name : null;\n}\n\nfunction findFutureUpvalueClosureStore(ctx\x2C startIndex\x2C tempReg) {\n    const event = ctx.findNextFutureEvent(tempReg\x2C startIndex\x2C ctx.INIT_READ | ctx.INDEX_DEST_READ | ctx.WRITE);\n    if (!event) return null;\n    const statement = ctx.leaf[event.index];\n    if (!isSingleAssignment(statement)) return null;\n    const dest = statement.variables[0];\n    const rhs = statement.init[0];\n    if (dest?.type !== "IndexExpression" || !isIdentifier(dest.base\x2C "upvalueValues") || !isIdentifier(dest.index) || !isIdentifier(rhs\x2C tempReg)) return null;\n    return ctx.upvalueCells.has(dest.index.name) && ctx.upvalueCells.get(dest.index.name) === null ? dest.index.name : null;\n}\n\nfunction isPurePendingTempRhs(ctx\x2C rhs) {\n    if (!rhs || typeof rhs !== "object") return false;\n    if (rhs.type === "CallExpression" || rhs.type === "IndexExpression" || rhs.type === "FunctionDeclaration" || rhs.type === "FunctionExpression") return false;\n    if (isPrimitiveLiteral(rhs) || isEmptyTable(rhs) || isIdentifier(rhs)) return true;\n    if (rhs.type === "UnaryExpression") return isPurePendingTempRhs(ctx\x2C rhs.argument);\n    if (rhs.type === "BinaryExpression" || rhs.type === "LogicalExpression") return isPurePendingTempRhs(ctx\x2C rhs.left) && isPurePendingTempRhs(ctx\x2C rhs.right);\n    if (rhs.type === "TableConstructorExpression") {\n        for (const field of rhs.fields || []) {\n            if (field?.type === "TableValue") { if (!isPurePendingTempRhs(ctx\x2C field.value)) return false; continue; }\n            if (field?.type === "TableKey") { if (!isPurePendingTempRhs(ctx\x2C field.key) || !isPurePendingTempRhs(ctx\x2C field.value)) return false; continue; }\n            if (field?.type === "TableKeyString") { if (!isPurePendingTempRhs(ctx\x2C field.value)) return false; continue; }\n            return false;\n        }\n        return true;\n    }\n    return false;\n}\n\nfunction rhsDependsOnPendingPack(ctx\x2C node) {\n    if (!node || typeof node !== "object") return false;\n    if (isIdentifier(node)) {\n        if (ctx.exprKinds.get(node.name) === "return-pack" && ctx.pendingPacks.has(node.name)) return true;\n        if (ctx.exprKinds.get(node.name) === "pack-slot") {\n            const meta = ctx.exprMeta.get(node.name);\n            if (meta?.packReg && ctx.pendingPacks.has(meta.packReg)) return true;\n        }\n        return false;\n    }\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) {\n            if (value.some(item => rhsDependsOnPendingPack(ctx\x2C item))) return true;\n        } else if (value && typeof value === "object" && rhsDependsOnPendingPack(ctx\x2C value)) return true;\n    }\n    return false;\n}\n\nfunction rhsUsesPendingPackSourceLocal(ctx\x2C node) {\n    if (!node || typeof node !== "object") return false;\n    if (isIdentifier(node) && ctx.exprKinds.get(node.name) === "pack-slot") {\n        const meta = ctx.exprMeta.get(node.name);\n        const pendingPack = meta?.packReg ? ctx.pendingPacks.get(meta.packReg) : null;\n        const slotInfo = pendingPack && meta ? pendingPack.slots.get(meta.slot) : null;\n        return !!(slotInfo?.localReg && ctx.locals.has(slotInfo.localReg));\n    }\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) {\n            if (value.some(item => rhsUsesPendingPackSourceLocal(ctx\x2C item))) return true;\n        } else if (value && typeof value === "object" && rhsUsesPendingPackSourceLocal(ctx\x2C value)) return true;\n    }\n    return false;\n}\n\nfunction hasFuturePendingPackSlotBeforeStateTouch(ctx\x2C startIndex) {\n    if (ctx.pendingPacks.size !== 1) return false;\n    const pendingPack = [...ctx.pendingPacks.values()][0];\n    for (let cursor = startIndex + 1; cursor < ctx.leaf.length; cursor++) {\n        const statement = ctx.leaf[cursor];\n        if (!isSingleAssignment(statement)) {\n            if (nodeUsesIdentifier(ctx\x2C statement?.init\x2C ctx.stateName)) return false;\n            continue;\n        }\n        const dest = statement.variables[0];\n        const rhs = statement.init[0];\n        if (isIdentifier(dest\x2C ctx.stateName) || nodeUsesIdentifier(ctx\x2C rhs\x2C ctx.stateName) ||\n            (dest?.type === "IndexExpression" && nodeUsesIdentifier(ctx\x2C dest\x2C ctx.stateName))) return false;\n        if (rhs?.type === "IndexExpression" && isIdentifier(rhs.base\x2C pendingPack.packReg) &&\n            rhs.index?.type === "NumericLiteral") {\n            const slot = Number(rhs.index.value);\n            return Number.isInteger(slot) && slot > 0 && !pendingPack.slots.has(slot);\n        }\n        if (isIdentifier(dest\x2C pendingPack.packReg)) return false;\n    }\n    return false;\n}\n\nfunction isDeadPurePendingTemp(ctx\x2C index\x2C name\x2C rhs) {\n    if (!isPurePendingTempRhs(ctx\x2C rhs)) return false;\n    if (rhsDependsOnPendingPack(ctx\x2C rhs)) return false;\n    return hasOnlyDeadCopyUses(ctx\x2C index\x2C name);\n}\n\nfunction hasFutureReassignedLocalUse(ctx\x2C startIndex\x2C name) {\n    for (let cursor = startIndex + 1; cursor < ctx.leaf.length; cursor++) {\n        const statement = ctx.leaf[cursor];\n        if (!isSingleAssignment(statement)) {\n            if (nodeUsesIdentifier(ctx\x2C statement?.init\x2C name)) return true;\n            continue;\n        }\n        const dest = statement.variables[0];\n        const value = statement.init[0];\n        if (nodeUsesIdentifier(ctx\x2C value\x2C name) || (dest?.type === "IndexExpression" && nodeUsesIdentifier(ctx\x2C dest\x2C name))) return true;\n        if (isIdentifier(dest\x2C name)) {\n            if (!isIdentifier(value) || value.name === name) return false;\n        }\n    }\n    return false;\n}\n\nfunction findFutureLiveTableCopy(ctx\x2C startIndex\x2C tempReg\x2C rhs) {\n    if (rhs?.type !== "TableConstructorExpression" || !isPurePendingTempRhs(ctx\x2C rhs)) return null;\n    if (rhsDependsOnPendingPack(ctx\x2C rhs)) return null;\n    for (let cursor = startIndex + 1; cursor < ctx.leaf.length; cursor++) {\n        const statement = ctx.leaf[cursor];\n        if (!isSingleAssignment(statement)) {\n            if (nodeUsesIdentifier(ctx\x2C statement?.init\x2C tempReg)) return null;\n            continue;\n        }\n        const dest = statement.variables[0];\n        const value = statement.init[0];\n        if (isIdentifier(dest) && isIdentifier(value\x2C tempReg)) {\n            for (let probe = startIndex + 1; probe < cursor; probe++) {\n                const between = ctx.leaf[probe];\n                if (nodeUsesIdentifier(ctx\x2C between?.init\x2C dest.name)) return null;\n                const betweenDest = isSingleAssignment(between) ? between.variables[0] : null;\n                if (betweenDest?.type === "IndexExpression" && nodeUsesIdentifier(ctx\x2C betweenDest\x2C dest.name)) return null;\n            }\n            if (ctx.locals.has(dest.name)) return dest.name;\n            if (dest.name !== ctx.stateName && dest.name !== ctx.returnName && !ctx.cleanupRegs.has(dest.name) &&\n                (valueUsedBeforeOverwrite(ctx\x2C cursor\x2C dest.name) || hasFutureReassignedLocalUse(ctx\x2C cursor\x2C dest.name))) return dest.name;\n            return null;\n        }\n        if (nodeUsesIdentifier(ctx\x2C value\x2C tempReg) || (dest?.type === "IndexExpression" && nodeUsesIdentifier(ctx\x2C dest\x2C tempReg))) return null;\n        if (isIdentifier(dest\x2C tempReg)) return null;\n    }\n    return null;\n}\n\nfunction isDeadPlainTableIndexRead(ctx\x2C index\x2C name\x2C rhs) {\n    if (rhs?.type !== "IndexExpression" || !isIdentifier(rhs.base) || !ctx.plainTableLocals.has(rhs.base.name)) return false;\n    if (rhsDependsOnPendingPack(ctx\x2C rhs)) return false;\n    return hasOnlyDeadCopyUses(ctx\x2C index\x2C name);\n}\n\nfunction countIdentifierUses(ctx\x2C node\x2C name) {\n    if (!node || typeof node !== "object") return 0;\n    if (isIdentifier(node\x2C name)) return 1;\n    let count = 0;\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) for (const item of value) count += countIdentifierUses(ctx\x2C item\x2C name);\n        else if (value && typeof value === "object") count += countIdentifierUses(ctx\x2C value\x2C name);\n    }\n    return count;\n}\n\nfunction isUniqueFutureTableOperand(ctx\x2C startIndex\x2C tempReg) {\n    for (let cursor = startIndex + 1; cursor < ctx.leaf.length; cursor++) {\n        const statement = ctx.leaf[cursor];\n        if (!isSingleAssignment(statement)) {\n            if (nodeUsesIdentifier(ctx\x2C statement?.init\x2C tempReg)) return false;\n            continue;\n        }\n        const dest = statement.variables[0];\n        const rhs = statement.init[0];\n        const uses = countIdentifierUses(ctx\x2C rhs\x2C tempReg) + ((dest?.type === "IndexExpression") ? countIdentifierUses(ctx\x2C dest\x2C tempReg) : 0);\n        if (uses > 0) return rhs?.type === "TableConstructorExpression" && uses === 1;\n        if (isIdentifier(dest\x2C tempReg)) return false;\n    }\n    return false;\n}\n\nfunction isPlainTableMethodLoad(ctx\x2C index\x2C name\x2C rhs) {\n    if (rhs?.type !== "IndexExpression" || !isIdentifier(rhs.base) || !ctx.plainTableLocals.has(rhs.base.name)) return false;\n    const next = ctx.leaf[index + 1];\n    if (!isSingleAssignment(ne