tion renderNormalizedBlock(source\x2C block\x2C stateName\x2C stateMap\x2C indent) {\x0d\n    if (!block?.body?.length) return `${indent}${stateName} = nil`;\x0d\n    const termEdits = collectTerminatorEdits(block\x2C stateName\x2C stateMap);\x0d\n    const relocateStop = isSingleCanonicalStopStatement(block\x2C stateName);\x0d\n    const stopIndex = relocateStop ? block.terminator.statementIndex : -1;\x0d\n    const lines = [];\x0d\n\x0d\n    for (let i = 0; i < block.body.length; i++) {\x0d\n        if (i === stopIndex) continue;\x0d\n        const statement = block.body[i];\x0d\n        const edits = collectClosureEntryEdits(statement\x2C stateMap\x2C []).concat(termEdits);\x0d\n        const raw = sourceOf(source\x2C statement);\x0d\n        const patched = applyRangeEdits(raw\x2C statement.range[0]\x2C edits);\x0d\n        lines.push(indentText(patched\x2C indent));\x0d\n    }\x0d\n\x0d\n    // A proven canonical stop is compiler control-flow scaffolding. Recover its\x0d\n    // semantic value directly and place it at the actual end of the state body.\x0d\n    if (relocateStop) lines.push(`${indent}${stateName} = nil`);\x0d\n    return lines.join("\\n");\x0d\n}\x0d\n\x0d\n\x0d\nfunction renderStateTree(lines\x2C source\x2C stateName\x2C group\x2C stateMap\x2C start\x2C end\x2C indent) {\x0d\n    if (start === end) {\x0d\n        const item = group.items[start];\x0d\n        const entryComment = item.oldId === group.entryOldId\x0d\n            ? ` -- entry ${group.entryOldId} -> ${item.newId}`\x0d\n            : "";\x0d\n        lines.push(`${indent}if ${stateName} == ${item.newId} then${entryComment}`);\x0d\n        lines.push(renderNormalizedBlock(source\x2C item.block\x2C stateName\x2C stateMap\x2C indent + "    "));\x0d\n        lines.push(`${indent}end`);\x0d\n        return;\x0d\n    }\x0d\n\x0d\n    const mid = Math.floor((start + end) / 2);\x0d\n    const boundary = group.items[mid].newId;\x0d\n    lines.push(`${indent}if ${stateName} <= ${boundary} then