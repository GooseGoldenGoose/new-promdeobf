term = block.terminator;\x0d\n        if (!term || !["jump"\x2C "branch"\x2C "stop"].includes(term.kind)) return false;\x0d\n        if (term?.kind === "jump" && !layout.stateMap.has(term.target)) return false;\x0d\n        if (term?.kind === "branch" &&\x0d\n            (!layout.stateMap.has(term.onTrue) || !layout.stateMap.has(term.onFalse))) return false;\x0d\n    }\x0d\n    return layout.groups.every(group => group.entryNewId !== null);\x0d\n}\x0d\n\x0d\nfunction renderNormalizedDispatcher(source\x2C stateWhile\x2C stateName\x2C layout) {\x0d\n    const indent = lineIndentAt(source\x2C stateWhile.range[0]);\x0d\n    const bodyIndent = indent + "    ";\x0d\n    const lines = [`while ${stateName} do`];\x0d\n    renderGroupTree(lines\x2C source\x2C stateName\x2C layout.groups\x2C layout.stateMap\x2C 0\x2C layout.groups.length - 1\x2C bodyIndent);\x0d\n    lines.push(`${indent}end`);\x0d\n    return lines.join("\\n");\x0d\n}\x0d\n\x0d\nfunction applyClosureEntryEditsOutsideDispatcher(source\x2C ast\x2C stateWhile\x2C stateMap\x2C replacement) {\x0d\n    const edits = collectClosureEntryEdits(ast\x2C stateMap\x2C []);\x0d\n    const prefix = applyRangeEdits(source.slice(0\x2C stateWhile.range[0])\x2C 0\x2C\x0d\n        edits.filter(edit => edit.end <= stateWhile.range[0]));\x0d\n    const suffix = applyRangeEdits(source.slice(stateWhile.range[1])\x2C stateWhile.range[1]\x2C\x0d\n        edits.filter(edit => edit.start >= stateWhile.range[1]));\x0d\n    return prefix + replacement + suffix;\x0d\n}\x0d\nfunction recoverVmStateGraph(source\x2C ast) {\x0d\n    const vm = findVmFunction(ast);\x0d\n    if (!vm) return { source\x2C found: false\x2C reason: "No semantically named vm function was found" };\x0d\n\x0d\n    const stateParam = (vm.functionNode.parameters || [])[0];\x0d\n    if (!isIdentifier(stateParam)) return { source\x2C found: false\x2C reason: "VM state parameter is not an identifier" };\x0d\n    const stateName = stateParam.name;\x0d\n\x0d\n    const stateW