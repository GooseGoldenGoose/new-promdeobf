script-source,100,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\cfg.js,"use strict";\x0d\n\x0d\nconst { isSingleAssignment } = require("./ast");\x0d\nconst { decodeLogicalStateTransition } = require("./normalize");\x0d\n\x0d\nfunction transitionOfBody(body\x2C stateName) {\x0d\n    for (let index = (body || []).length - 1; index >= 0; index--) {\x0d\n        if (!isSingleAssignment(body[index]\x2C stateName)) continue;\x0d\n        const rhs = body[index].init[0];\x0d\n        if (rhs?.type === "NilLiteral") return { index\x2C kind: "stop" };\x0d\n        if (rhs?.type === "NumericLiteral" && Number.isInteger(Number(rhs.value))) {\x0d\n            return { index\x2C kind: "jump"\x2C target: Number(rhs.value) };\x0d\n        }\x0d\n        const branch = decodeLogicalStateTransition(rhs);\x0d\n        if (branch) return { index\x2C kind: "branch"\x2C ...branch };\x0d\n    }\x0d\n    return null;\x0d\n}\x0d\n\x0d\nfunction transitionTargets(transition) {\x0d\n    if (transition?.kind === "jump") return [transition.target];\x0d\n    if (transition?.kind === "branch") return [transition.onTrue\x2C transition.onFalse];\x0d\n    return [];\x0d\n}\x0d\n\x0d\nfunction createStateGraph(leaves\x2C entryId\x2C stateName\x2C options = {}) {\x0d\n    if (!(leaves instanceof Map) || !leaves.has(entryId)) return null;\x0d\n    const strictTargets = options.strictTargets !== false;\x0d\n    const reachableOnly = options.reachableOnly === true;\x0d\n    const blocks = new Map();\x0d\n\x0d\n    if (reachableOnly) {\x0d\n        // Child-closure recovery shares one normalized leaf map with its parent\x0d\n        // invocation. Parse only states reachable from this invocation entry so\x0d\n        // unrelated parent/sibling compiler shapes cannot invalidate its CFG.\x0d\n        const queue = [entryId];\x0d\n        while (queue.length) {\x0d\n            const id = queue.shift();\x0d\n            if (blocks.has(id)) continue;\x0d\n            const body = leaves.get(id);\x0d\n            if (!body) {\x0d\n                if (strictTargets) return null;\x0d\n                continue;\x0d\n            }\x0d\n            const transition = transitionOfBody(body\x2C stateName);\x0d\n            if (!transition) return null;\x0d\n            blocks.set(id\x2C { id\x2C body\x2C transitionIndex: transition.index\x2C transition });\x0d\n            for (const target of transitionTargets(transition)) {\x0d\n                if (!leaves.has(target)) {\x0d\n                    if (strictTargets) return null;\x0d\n                    continue;\x0d\n                }\x0d\n                if (!blocks.has(target)) queue.push(target);\x0d\n            }\x0d\n        }\x0d\n    } else {\x0d\n        for (const [id\x2C body] of leaves) {\x0d\n            const transition = transitionOfBody(body\x2C stateName);\x0d\n            if (!transition) return null;\x0d\n            blocks.set(id\x2C { id\x2C body\x2C transitionIndex: transition.index\x2C transition });\x0d\n        }\x0d\n    }\x0d\n\x0d\n    const successors = new Map([...blocks.keys()].map(id => [id\x2C []]));\x0d\n    const predecessors = new Map([...blocks.keys()].map(id => [id\x2C []]));\x0d\n    for (const [id\x2C block] of blocks) {\x0d\n        for (const target of transitionTargets(block.transition)) {\x0d\n            if (!blocks.has(target)) {\x0d\n                if (strictTargets && !reachableOnly) return null;\x0d\n                continue;\x0d\n            }\x0d\n            successors.get(id).push(target);\x0d\n            predecessors.get(target).push(id);\x0d\n        }\x0d\n    }\x0d\n\x0d\n    const reachable = reachableOnly ? new Set(blocks.keys()) : reachableFrom(entryId\x2C successors\x2C blocks);\x0d\n    return { entryId\x2C blocks\x2C successors\x2C predecessors\x2C reachable };\x0d\n}\x0d\n\x0d\nfunction reachableFrom(start\x2C successors\x2C blocks = null) {\x0d\n    const reachable = new Set();\x0d\n    const queue = [start];\x0d\n    while (queue.length) {\x0d\n        const id = queue.shift();\x0d\n        if (reachable.has(id) || (blocks && !blocks.has(id))) continue;\x0d\n        reachable.add(id);\x0d\n        for (const next of successors.get(id) || []) queue.push(next);\x0d\n    }\x0d\n    return reachable;\x0d\n}\x0d\n\x0d\nfunction canReach(graph\x2C start\x2C target) {\x0d\n    if (start === target) return true;\x0d\n    const seen = new Set();\x0d\n    const queue = [start];\x0d\n    while (queue.length) {\x0d\n        const id = queue.shift();\x0d\n        if (seen.has(id)) continue;\x0d\n        seen.add(id);\x0d\n        for (const next of graph.successors.get(id) || []) {\x0d\n            if (next === target) return true;\x0d\n            if (!seen.has(next)) queue.push(next);\x0d\n        }\x0d\n    }\x0d\n    return false;\x0d\n}\x0d\n\x0d\nfunction hasLinearPath(graph\x2C fromId\x2C toId) {\x0d\n    if (!Number.isInteger(fromId) || !Number.isInteger(toId)) return false;\x0d\n    let current = fromId;\x0d\n    const seen = new Set();\x0d\n    while (true) {\x0d\n        if (current === toId) return true;\x0d\n        if (seen.has(current)) return false;\x0d\n        seen.add(current);\x0d\n        const next = graph.successors.get(current) || [];\x0d\n        if (next.length !== 1) return false;\x0d\n        current = next[0];\x0d\n    }\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n    canReach\x2C\x0d\n    createStateGraph\x2C\x0d\n    hasLinearPath\x2C\x0d\n    reachableFrom\x2C\x0d\n    transitionOfBody\x2C\x0d\n    transitionTargets\x2C\x0d\n};\x0d\n
