script-source,126,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\control\\generic-for.js,"use strict";\n\nconst { isIdentifier\x2C isLuaIdentifier\x2C isSingleAssignment\x2C isVmRegisterName } = require("../ast");\nconst { createStateGraph } = require("../cfg");\nconst {\n    collectBreakRegion\x2C\n    collectMixedAbruptRegion\x2C\n    collectTerminalReturnRegion\x2C\n    findNaturalLoops\x2C\n    loopsAreNestedOrDisjoint\x2C\n} = require("./while");\n\nfunction identifier(name) {\n    return { type: "Identifier"\x2C name };\n}\n\nfunction numericLiteral(value) {\n    return { type: "NumericLiteral"\x2C value\x2C raw: String(value) };\n}\n\nfunction syntheticAssignment(name\x2C value) {\n    return {\n        type: "AssignmentStatement"\x2C\n        variables: [identifier(name)]\x2C\n        init: [value]\x2C\n    };\n}\n\nfunction syntheticJump(stateName\x2C targetId) {\n    return syntheticAssignment(stateName\x2C numericLiteral(targetId));\n}\n\nfunction syntheticBranch(stateName\x2C conditionName\x2C onTrue\x2C onFalse) {\n    return syntheticAssignment(stateName\x2C {\n        type: "LogicalExpression"\x2C\n        operator: "or"\x2C\n        left: {\n            type: "LogicalExpression"\x2C\n            operator: "and"\x2C\n            left: identifier(conditionName)\x2C\n            right: numericLiteral(onTrue)\x2C\n        }\x2C\n        right: numericLiteral(onFalse)\x2C\n    });\n}\n\nfunction cloneLeaves(leaves) {\n    return new Map([...leaves].map(([id\x2C body]) => [id\x2C [...body]]));\n}\n\nfunction transitionTargets(transition) {\n    if (transition?.kind === "jump") return [transition.target];\n    if (transition?.kind === "branch") return [transition.onTrue\x2C transition.onFalse];\n    return [];\n}\n\nfunction statementWritesName(statement\x2C name) {\n    if (statement?.type !== "AssignmentStatement") return false;\n    return (statement.variables || []).some(variable => isIdentifier(variable\x2C name));\n}\n\nfunction nodeReadsName(node\x2C name) {\n    if (!node || typeof node !== "object") return false;\n    if (isIdentifier(node\x2C name)) return true;\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) {\n            if (value.some(item => nodeReadsName(item\x2C name))) return true;\n        } else if (value && typeof value === "object" && nodeReadsName(value\x2C name)) {\n            return true;\n        }\n    }\n    return false;\n}\n\nfunction collectIdentifierReads(node\x2C out = new Set()) {\n    if (!node || typeof node !== "object") return out;\n    if (isIdentifier(node)) { out.add(node.name); return out; }\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) {\n            for (const item of value) collectIdentifierReads(item\x2C out);\n        } else if (value && typeof value === "object") {\n            collectIdentifierReads(value\x2C out);\n        }\n    }\n    return out;\n}\n\nfunction statementReadsName(statement\x2C name) {\n    if (!statement || typeof statement !== "object") return false;\n    if (statement.type === "AssignmentStatement") {\n        for (const rhs of statement.init || []) if (nodeReadsName(rhs\x2C name)) return true;\n        for (const dest of statement.variables || []) {\n            if (dest?.type === "IndexExpression" && nodeReadsName(dest\x2C name)) return true;\n        }\n        return false;\n    }\n    return nodeReadsName(statement\x2C name);\n}\n\nfunction nearestDefinition(body\x2C beforeIndex\x2C name) {\n    for (let i = beforeIndex - 1; i >= 0; i--) {\n        const statement = body[i];\n        if (!statementWritesName(statement\x2C name)) continue;\n        if (!isSingleAssignment(statement\x2C name)) return { index: i\x2C statement\x2C ambiguous: true };\n        return { index: i\x2C statement\x2C rhs: statement.init[0]\x2C ambiguous: false };\n    }\n    return null;\n}\n\nfunction collectCleanupRegs(graph) {\n    const cleanup = new Set();\n    for (const id of graph.reachable) {\n        const block = graph.blocks.get(id);\n        for (const statement of block?.body || []) {\n            if (!isSingleAssignment(statement) || statement.init[0]?.type !== "NilLiteral") continue;\n            const dest = statement.variables[0];\n            if (isIdentifier(dest) && isVmRegisterName(dest.name)) cleanup.add(dest.name);\n        }\n    }\n    return cleanup;\n}\n\nfunction literalString(node) {\n    if (node?.type !== "StringLiteral") return null;\n    if (typeof node.value === "string") return node.value;\n    if (typeof node.raw !== "string") return null;\n    try {\n        const parsed = JSON.parse(node.raw);\n        return typeof parsed === "string" ? parsed : null;\n    } catch {\n        return null;\n    }\n}\n\nfunction makeTracer(body\x2C boundaryRegs\x2C forcedTraceRegs) {\n    const memo = new Map();\n\n    function external(name) {\n        return { kind: "expr"\x2C expression: identifier(name)\x2C consumed: new Set()\x2C rootIndex: -1 };\n    }\n\n    function mergeConsumed(...values) {\n        const out = new Set();\n        for (const value of values) for (const index of value?.consumed || []) out.add(index);\n        return out;\n    }\n\n    function traceReg(name\x2C beforeIndex\x2C stack = new Set()) {\n        const memoKey = `${name}:${beforeIndex}`;\n        if (memo.has(memoKey)) return memo.get(memoKey);\n        if (stack.has(memoKey)) return null;\n        if (boundaryRegs.has(name) && !forcedTraceRegs.has(name)) return external(name);\n        const def = nearestDefinition(body\x2C beforeIndex\x2C name);\n        if (!def) return external(name);\n        if (def.ambiguous) return null;\n        const nextStack = new Set(stack);\n        nextStack.add(memoKey);\n        const value = traceNode(def.rhs\x2C def.index\x2C nextStack);\n        if (!value) return null;\n        value.consumed.add(def.index);\n        value.rootIndex = Math.max(value.rootIndex ?? -1\x2C def.index);\n        if (value.kind === "pack" && typeof value.packKey !== "string") value.packKey = `${name}@${def.index}`;\n        memo.set(memoKey\x2C value);\n        return value;\n    }\n\n    function traceMethodCall(node\x2C beforeIndex\x2C stack) {\n        if (!isIdentifier(node?.base) || (node.arguments || []).length < 1 || !isIdentifier(node.arguments[0])) return null;\n        const calleeDef = nearestDefinition(body\x2C beforeIndex\x2C node.base.name);\n        if (!calleeDef || calleeDef.ambiguous || calleeDef.rhs?.type !== "IndexExpression" ||\n            !isIdentifier(calleeDef.rhs.base\x2C node.arguments[0].name)) return null;\n        const keyNode = calleeDef.rhs.index;\n        let memberName = null;\n        const consumed = new Set([calleeDef.index]);\n        if (keyNode?.type === "StringLiteral") {\n            memberName = literalString(keyNode);\n        } else if (isIdentifier(keyNode)) {\n            const keyValue = traceReg(keyNode.name\x2C calleeDef.index\x2C stack);\n            if (!keyValue || keyValue.kind !== "expr" || keyValue.expression?.type !== "StringLiteral") return null;\n            memberName = literalString(keyValue.expression);\n            for (const index of keyValue.consumed) consumed.add(index);\n        }\n        if (!isLuaIdentifier(memberName)) return null;\n        const receiver = traceReg(node.arguments[0].name\x2C calleeDef.index\x2C stack);\n        if (!receiver || receiver.kind !== "expr") return null;\n        for (const index of receiver.consumed) consumed.add(index);\n        const args = [];\n        for (const arg of (node.arguments || []).slice(1)) {\n            const value = traceNode(arg\x2C beforeIndex\x2C stack);\n            if (!value || value.kind !== "expr") return null;\n            args.push(value.expression);\n            for (const index of value.consumed) consumed.add(index);\n        }\n        return {\n            kind: "expr"\x2C\n            expression: {\n                type: "FreshGenericMethodCallExpression"\x2C\n                receiver: receiver.expression\x2C\n                member: memberName\x2C\n                arguments: args\x2C\n            }\x2C\n            consumed\x2C\n            rootIndex: Math.max(calleeDef.index\x2C receiver.rootIndex ?? -1)\x2C\n        };\n    }\n\n    function traceNode(node\x2C beforeIndex\x2C stack) {\n        if (!node || typeof node !== "object") return null;\n        if (["StringLiteral"\x2C "NumericLiteral"\x2C "BooleanLiteral"\x2C "NilLiteral"].includes(node.type)) {\n            return { kind: "expr"\x2C expression: node\x2C consumed: new Set()\x2C rootIndex: -1 };\n        }\n        if (isIdentifier(node)) return traceReg(node.name\x2C beforeIndex\x2C stack);\n        if (node.type === "UnaryExpression") {\n            const argument = traceNode(node.argument\x2C beforeIndex\x2C stack);\n            if (!argument || argument.kind !== "expr") return null;\n            return {\n                kind: "expr"\x2C\n                expression: { ...node\x2C argument: argument.expression }\x2C\n                consumed: mergeConsumed(argument)\x2C\n                rootIndex: argument.rootIndex ?? -1\x2C\n            };\n        }\n        if (node.type === "BinaryExpression" || node.type === "LogicalExpression") {\n            const left = traceNode(node.left\x2C beforeIndex\x2C stack);\n            const right = traceNode(node.right\x2C beforeIndex\x2C stack);\n            if (!left || !right || left.kind !== "expr" || right.kind !== "expr") return null;\n            return {\n                kind: "expr"\x2C\n                expression: { ...node\x2C left: left.expression\x2C right: right.expression\x2C freshCompilerLogical: node.type === "LogicalExpression" ? true : node.freshCompilerLogical }\x2C\n                consumed: mergeConsumed(left\x2C right)\x2C\n                rootIndex: Math.max(left.rootIndex ?? -1\x2C right.rootIndex ?? -1)\x2C\n            };\n        }\n        if (node.type === "TableConstructorExpression") {\n            const fields = node.fields || [];\n            if (fields.length === 1 && fields[0]?.type === "TableValue" && fields[0].value?.type === "CallExpression") {\n                const call = traceNode(fields[0].value\x2C beforeIndex\x2C stack);\n                if (!call || call.kind !== "expr") return null;\n                return { kind: "pack"\x2C expression: call.expression\x2C consumed: mergeConsumed(call)\x2C rootIndex: call.rootIndex ?? -1 };\n            }\n            const nextFields = [];\n            const parts = [];\n            for (const field of fields) {\n                if (field?.type === "TableValue") {\n                    const value = traceNode(field.value\x2C beforeIndex\x2C stack);\n                    if (!value || value.kind !== "expr") return null;\n                    nextFields.push({ ...field\x2C value: value.expression });\n                    parts.push(value);\n                } else if (field?.type === "TableKey") {\n                    const key = traceNode(field.key\x2C beforeIndex\x2C stack);\n                    const value = traceNode(field.value\x2C beforeIndex\x2C stack);\n                    if (!key || !value || key.kind !== "expr" || value.kind !== "expr") return null;\n                    nextFields.push({ ...field\x2C key: key.expression\x2C value: value.expression });\n                    parts.push(key\x2C value);\n                } else return null;\n            }\n            return {\n                kind: "expr"\x2C\n                expression: { ...node\x2C fields: nextFields }\x2C\n                consumed: mergeConsumed(...parts)\x2C\n                rootIndex: Math.max(-1\x2C ...parts.map(part => part.rootIndex ?? -1))\x2C\n            };\n        }\n        if (node.type === "IndexExpression") {\n            const base = traceNode(node.base\x2C beforeIndex\x2C stack);\n            if (!base) return null;\n            if (base.kind === "pack" && node.index?.type === "NumericLiteral") {\n                const slot = Number(node.index.value);\n                if (!Number.isInteger(slot) || slot < 1) return null;\n                return {\n                    kind: "slot"\x2C\n                    pack: base\x2C\n                    slot\x2C\n                    consumed: mergeConsumed(base)\x2C\n                    rootIndex: base.rootIndex ?? -1\x2C\n                };\n            }\n            if (base.kind !== "expr") return null;\n            const index = traceNode(node.index\x2C beforeIndex\x2C stack);\n            if (!index || index.kind !== "expr") return null;\n            return {\n                kind: "expr"\x2C\n                expression: { ...node\x2C base: base.expression\x2C index: index.expression }\x2C\n                consumed: mergeConsumed(base\x2C index)\x2C\n                rootIndex: Math.max(base.rootIndex ?? -1\x2C index.rootIndex ?? -1)\x2C\n            };\n        }\n        if (node.type === "CallExpression") {\n            if (isIdentifier(node.base\x2C "unpack") && (node.arguments || []).length === 1 && isIdentifier(node.arguments[0])) {\n                const packed = traceReg(node.arguments[0].name\x2C beforeIndex\x2C stack);\n                if (packed?.kind === "pack") {\n                    return {\n                        kind: "expr"\x2C\n                        expression: packed.expression\x2C\n                        consumed: mergeConsumed(packed)\x2C\n                        rootIndex: packed.rootIndex ?? -1\x2C\n                    };\n                }\n            }\n            const method = traceMethodCall(node\x2C beforeIndex\x2C stack);\n            if (method) return method;\n            const base = traceNode(node.base\x2C beforeIndex\x2C stack);\n            if (!base || base.kind !== "expr") return null;\n            const args = [];\n            const parts = [base];\n            for (const arg of node.arguments || []) {\n                const value = traceNode(arg\x2C beforeIndex\x2C stack);\n                if (!value || value.kind !== "expr") return null;\n                args.push(value.expression);\n                parts.push(value);\n            }\n            return {\n                kind: "expr"\x2C\n                expression: { ...node\x2C base: base.expression\x2C arguments: args }\x2C\n                consumed: mergeConsumed(...parts)\x2C\n                rootIndex: Math.max(...parts.map(part => part.rootIndex ?? -1))\x2C\n            };\n        }\n        return null;\n    }\n\n    return { traceReg };\n}\n\nfunction samePackSlot(value\x2C pack\x2C slot) {\n    return value?.kind === "slot" && typeof value.pack?.packKey === "string" &&\n        value.pack.packKey === pack?.packKey && value.slot === slot;\n}\n\nfunction inferHeaderExpressions(iteratorValue\x2C invariantValue\x2C controlValue) {\n    if (!iteratorValue || !invariantValue || !controlValue) return null;\n    if (iteratorValue.kind === "slot" && iteratorValue.slot === 1) {\n        const pack = iteratorValue.pack;\n        if (samePackSlot(invariantValue\x2C pack\x2C 2) && samePackSlot(controlValue\x2C pack\x2C 3)) {\n            return [{ expression: pack.expression\x2C values: [iteratorValue\x2C invariantValue\x2C controlValue] }];\n        }\n    }\n    if (invariantValue.kind === "slot" && invariantValue.slot === 1) {\n        const pack = invariantValue.pack;\n        if (samePackSlot(controlValue\x2C pack\x2C 2) && iteratorValue.kind === "expr") {\n            return [\n                { expression: iteratorValue.expression\x2C values: [iteratorValue] }\x2C\n                { expression: pack.expression\x2C values: [invariantValue\x2C controlValue] }\x2C\n            ];\n        }\n    }\n    if (iteratorValue.kind !== "expr" || invariantValue.kind !== "expr" || controlValue.kind !== "expr") return null;\n    if (controlValue.expression?.type === "NilLiteral") {\n        return [\n            { expression: iteratorValue.expression\x2C values: [iteratorValue] }\x2C\n            { expression: invariantValue.expression\x2C values: [invariantValue\x2C controlValue] }\x2C\n        ];\n    }\n    return [\n        { expression: iteratorValue.expression\x2C values: [iteratorValue] }\x2C\n        { expression: invariantValue.expression\x2C values: [invariantValue] }\x2C\n        { expression: controlValue.expression\x2C values: [controlValue] }\x2C\n    ];\n}\n\nfunction matchCompilerGenericForCheck(block) {\n    if (!block || block.transition?.kind !== "branch" || block.transitionIndex !== 1) return null;\n    const statement = block.body[0];\n    if (statement?.type !== "AssignmentStatement" || (statement.init || []).length !== 1) return null;\n    const variables = (statement.variables || []).filter(Boolean);\n    if (variables.length < 1 || variables.length > 2 || variables.some(variable => !isIdentifier(variable))) return null;\n    const call = statement.init[0];\n    if (call?.type !== "CallExpression" || !isIdentifier(call.base) || (call.arguments || []).length !== 2 ||\n        !isIdentifier(call.arguments[0]) || !isIdentifier(call.arguments[1])) return null;\n    const controlReg = variables[0].name;\n    if (block.transition.conditionRegister !== controlReg || call.arguments[1].name !== controlReg) return null;\n    const iteratorReg = call.base.name;\n    const invariantReg = call.arguments[0].name;\n    if (![iteratorReg\x2C invariantReg\x2C controlReg].every(isVmRegisterName)) return null;\n    const secondVarReg = variables[1]?.name || null;\n    if (secondVarReg !== null && (!isVmRegisterName(secondVarReg) || secondVarReg === controlReg)) return null;\n    return {\n        checkId: block.id\x2C\n        decisionId: block.id\x2C\n        bodyId: block.transition.onTrue\x2C\n        exitId: block.transition.onFalse\x2C\n        iteratorReg\x2C\n        invariantReg\x2C\n        controlReg\x2C\n        secondVarReg\x2C\n        checkStatement: statement\x2C\n    };\n}\n\nfunction isAllocUpvalueCall(node) {\n    return node?.type === "CallExpression" && isIdentifier(node.base\x2C "allocUpvalue") && (node.arguments || []).length === 0;\n}\n\nfunction isReleaseUpvalueCallFor(statement\x2C cellReg) {\n    if (!isSingleAssignment(statement\x2C cellReg)) return false;\n    const rhs = statement.init[0];\n    return rhs?.type === "CallExpression" && isIdentifier(rhs.base\x2C "releaseUpvalue") &&\n        (rhs.arguments || []).length === 1 && isIdentifier(rhs.arguments[0]\x2C cellReg);\n}\n\nfunction closureCapturesCell(statement\x2C cellReg) {\n    if (!isSingleAssignment(statement)) return false;\n    const rhs = statement.init[0];\n    if (rhs?.type !== "CallExpression" || !isIdentifier(rhs.base) || !/^createClosure\\d*$/.test(rhs.base.name)) return false;\n    const args = rhs.arguments || [];\n    if (args.length !== 2 || args[1]?.type !== "TableConstructorExpression") return false;\n    return (args[1].fields || []).some(field => field?.type === "TableValue" && isIdentifier(field.value\x2C cellReg));\n}\n\nfunction matchCapturedLoopVariable(graph\x2C loopInfo\x2C body\x2C varReg\x2C returnName = null) {\n    const transitionStatement = body?.body?.[body.transitionIndex];\n    const stateReg = isSingleAssignment(transitionStatement) && isIdentifier(transitionStatement.variables[0])\n        ? transitionStatement.variables[0].name : null;\n    const candidates = [];\n    for (let initIndex = 0; initIndex < body.transitionIndex; initIndex++) {\n        const initStatement = body.body[initIndex];\n        const dest = initStatement?.variables?.[0];\n        if (dest?.type !== "IndexExpression" || !isIdentifier(dest.base\x2C "upvalueValues") || !isIdentifier(dest.index) ||\n            !isIdentifier(initStatement.init?.[0]\x2C varReg)) continue;\n        const allocCellReg = dest.index.name;\n        const compilerCellCarrier = isVmRegisterName(allocCellReg) || allocCellReg === stateReg ||\n            (typeof returnName === "string" && allocCellReg === returnName);\n        if (!compilerCellCarrier || allocCellReg === varReg) continue;\n        const allocDef = nearestDefinition(body.body\x2C initIndex\x2C allocCellReg);\n        if (!allocDef || allocDef.ambiguous || !isAllocUpvalueCall(allocDef.rhs)) continue;\n\n        let handoffStatement = null;\n        let handoffIndex = -1;\n        let invalid = false;\n        for (let i = initIndex + 1; i < body.transitionIndex; i++) {\n            const statement = body.body[i];\n            if (statementWritesName(statement\x2C allocCellReg) && !isSingleAssignment(statement\x2C varReg)) {\n                invalid = true;\n                break;\n            }\n            if (!statementWritesName(statement\x2C varReg)) continue;\n            if (isSingleAssignment(statement\x2C varReg) && isIdentifier(statement.init[0]\x2C allocCellReg) && handoffStatement === null) {\n                handoffStatement = statement;\n                handoffIndex = i;\n                break;\n            }\n            invalid = true;\n            break;\n        }\n        if (invalid || !handoffStatement) continue;\n\n        const bookkeepingStatements = new Set([allocDef.statement\x2C initStatement\x2C handoffStatement]);\n        let captureCount = 0;\n        let releaseCount = 0;\n        for (const id of loopInfo.coreIds) {\n            const blockInfo = graph.blocks.get(id);\n            if (!blockInfo) return null;\n            for (let i = 0; i < blockInfo.body.length; i++) {\n                if (i === blockInfo.transitionIndex) continue;\n                const statement = blockInfo.body[i];\n                if (closureCapturesCell(statement\x2C varReg)) captureCount++;\n                if (isReleaseUpvalueCallFor(statement\x2C varReg)) {\n                    bookkeepingStatements.add(statement);\n                    releaseCount++;\n                }\n            }\n        }\n        if (captureCount < 1 || releaseCount < 1) continue;\n        candidates.push({\n            kind: "captured-cell"\x2C\n            reg: varReg\x2C\n            handleReg: varReg\x2C\n            allocationCellReg: allocCellReg\x2C\n            initStatement\x2C\n            handoffStatement\x2C\n            handoffIndex\x2C\n            bookkeepingStatements\x2C\n        });\n    }\n    return candidates.length === 1 ? candidates[0] : null;\n}\n\nfunction loopValueReadBeforeOverwrite(graph\x2C loopInfo\x2C startBlockId\x2C startIndex\x2C name) {\n    const queue = [{ blockId: startBlockId\x2C index: startIndex + 1 }];\n    const seen = new Set();\n    while (queue.length) {\n        const cursor = queue.shift();\n        const key = cursor.blockId + ":" + cursor.index;\n        if (seen.has(key)) continue;\n        seen.add(key);\n        const block = graph.blocks.get(cursor.blockId);\n        if (!block) return true;\n        let killed = false;\n        for (let i = cursor.index; i < block.body.length; i++) {\n            const statement = block.body[i];\n            if (statementReadsName(statement\x2C name)) return true;\n            if (statementWritesName(statement\x2C name)) { killed = true; break; }\n        }\n        if (killed) continue;\n        for (const next of graph.successors.get(cursor.blockId) || []) {\n            if (!loopInfo.coreIds.has(next)) continue;\n            queue.push({ blockId: next\x2C index: 0 });\n        }\n    }\n    return false;\n}\n\nfunction matchBodyVariables(graph\x2C loopInfo\x2C raw\x2C returnName = null) {\n    const body = graph.blocks.get(raw.bodyId);\n    if (!body) return null;\n    const firstHandoffs = [];\n    for (let i = 0; i < body.body.length; i++) {\n        if (i === body.transitionIndex) continue;\n        const statement = body.body[i];\n        if (!isSingleAssignment(statement) || !isIdentifier(statement.variables[0]) || !isIdentifier(statement.init[0]\x2C raw.controlReg)) continue;\n        const name = statement.variables[0].name;\n        if (!isVmRegisterName(name) || name === raw.controlReg) continue;\n        firstHandoffs.push({ statement\x2C index: i\x2C name });\n    }\n    if (firstHandoffs.length !== 1) return null;\n    const first = firstHandoffs[0];\n    const loopVarRegs = [first.name];\n    if (raw.secondVarReg !== null) loopVarRegs.push(raw.secondVarReg);\n    if (new Set(loopVarRegs).size !== loopVarRegs.length) return null;\n\n    const loopVarBookkeepingStatements = new Set([first.statement]);\n    const loopVarBindings = [];\n    for (const name of loopVarRegs) {\n        const captured = matchCapturedLoopVariable(graph\x2C loopInfo\x2C body\x2C name\x2C returnName);\n        if (captured) {\n            loopVarBindings.push(captured);\n            for (const statement of captured.bookkeepingStatements) loopVarBookkeepingStatements.add(statement);\n            continue;\n        }\n        let cleanupCount = 0;\n        const bookkeepingStatements = new Set();\n        for (const id of loopInfo.coreIds) {\n            const blockInfo = graph.blocks.get(id);\n            if (!blockInfo) return null;\n            for (let i = 0; i < blockInfo.body.length; i++) {\n                if (i === blockInfo.transitionIndex) continue;\n                const statement = blockInfo.body[i];\n                if (isSingleAssignment(statement\x2C name) && statement.init[0]?.type === "NilLiteral") {\n                    cleanupCount++;\n                    bookkeepingStatements.add(statement);\n                }\n                if (isReleaseUpvalueCallFor(statement\x2C name)) return null;\n            }\n        }\n        if (cleanupCount < 1) return null;\n        loopVarBindings.push({ kind: "register"\x2C reg: name\x2C bookkeepingStatements });\n        for (const statement of bookkeepingStatements) loopVarBookkeepingStatements.add(statement);\n    }\n\n    // Prometheus only assigns the first two generic-for variables in the\n    // iterator call. Variables 3+ are injected as semantic nil writes at body\n    // entry\x2C which is indistinguishable from a real source local initialized to\n    // nil. If such a non-loop register nil is observed before overwrite\x2C fail\n    // closed instead of guessing a wider generic-for header or a body local.\n    for (let i = 0; i < body.body.length; i++) {\n        if (i === body.transitionIndex) continue;\n        const statement = body.body[i];\n        if (loopVarBookkeepingStatements.has(statement) || statement === raw.checkStatement) continue;\n        if (!isSingleAssignment(statement) || statement.init[0]?.type !== "NilLiteral" || !isIdentifier(statement.variables[0])) continue;\n        const name = statement.variables[0].name;\n        if (loopVarRegs.includes(name)) continue;\n        if (loopValueReadBeforeOverwrite(graph\x2C loopInfo\x2C raw.bodyId\x2C i\x2C name)) return null;\n    }\n\n    for (const id of loopInfo.coreIds) {\n        const blockInfo = graph.blocks.get(id);\n        if (!blockInfo) return null;\n        for (let i = 0; i < blockInfo.body.length; i++) {\n            if (i === blockInfo.transitionIndex) continue;\n            const statement = blockInfo.body[i];\n            if (loopVarBookkeepingStatements.has(statement) || statement === raw.checkStatement) continue;\n            if (nodeReadsName(statement\x2C raw.iteratorReg) || nodeReadsName(statement\x2C raw.invariantReg) ||\n                (id !== raw.checkId && nodeReadsName(statement\x2C raw.controlReg))) return null;\n        }\n    }\n    return {\n        firstVarReg: first.name\x2C\n        firstHandoffStatement: first.statement\x2C\n        loopVarRegs\x2C\n        loopVarBindings\x2C\n        loopVarBookkeepingStatements\x2C\n    };\n}\n\nfunction matchPreheaderHeader(graph\x2C preheaderId\x2C raw\x2C preBodyTempRegs = new Set()) {\n    const block = graph.blocks.get(preheaderId);\n    if (!block || block.transition?.kind !== "jump" || block.transition.target !== raw.checkId) return null;\n    const cleanupRegs = collectCleanupRegs(graph);\n    cleanupRegs.delete(raw.iteratorReg);\n    cleanupRegs.delete(raw.invariantReg);\n    cleanupRegs.delete(raw.controlReg);\n    const transitionStatement = block.body[block.transitionIndex];\n    const stateReg = isSingleAssignment(transitionStatement) && isIdentifier(transitionStatement.variables[0])\n        ? transitionStatement.variables[0].name : null;\n    const forced = new Set([raw.iteratorReg\x2C raw.invariantReg\x2C raw.controlReg\x2C ...preBodyTempRegs]);\n    if (typeof stateReg === "string") forced.add(stateReg);\n    const tracer = makeTracer(block.body\x2C cleanupRegs\x2C forced);\n    const iteratorValue = tracer.traceReg(raw.iteratorReg\x2C block.transitionIndex);\n    const invariantValue = tracer.traceReg(raw.invariantReg\x2C block.transitionIndex);\n    const controlValue = tracer.traceReg(raw.controlReg\x2C block.transitionIndex);\n    const inferred = inferHeaderExpressions(iteratorValue\x2C invariantValue\x2C controlValue);\n    if (!inferred || inferred.length < 1 || inferred.length > 3) return null;\n\n    const consumed = new Set();\n    for (const item of inferred) for (const value of item.values) for (const index of value.consumed || []) consumed.add(index);\n    if (!consumed.size) return null;\n    const consumedNames = new Set();\n    for (const index of consumed) {\n        if (index < 0 || index >= block.transitionIndex) return null;\n        const statement = block.body[index];\n        if (!isSingleAssignment(statement) || !isIdentifier(statement.variables[0])) return null;\n        consumedNames.add(statement.variables[0].name);\n    }\n    for (let i = 0; i < block.transitionIndex; i++) {\n        if (consumed.has(i)) continue;\n        const statement = block.body[i];\n        for (const name of consumedNames) {\n            if (!statementReadsName(statement\x2C name)) continue;\n            const reaching = nearestDefinition(block.body\x2C i\x2C name);\n            if (reaching && consumed.has(reaching.index)) return null;\n        }\n    }\n\n    const capturePrefix = `__fresh_generic_for_${raw.checkId}`;\n    const captures = inferred.map((item\x2C index) => {\n        const itemConsumed = new Set();\n        for (const value of item.values || []) {\n            for (const statementIndex of value.consumed || []) itemConsumed.add(statementIndex);\n        }\n        if (!itemConsumed.size) return null;\n        let insertionIndex = Math.min(...itemConsumed);\n        // Some registers inside the traced header expression are intentionally\n        // left external because they are proven source storage (or are not safe\n        // to inline). If such a value is defined in this preheader\x2C the synthetic\n        // header capture must stay after that reaching definition. Otherwise loop\n        // collapse can move the expression before its dependency and make an old\n        // physical-register epoch appear live across an earlier branch join.\n        const evaluationEnd = Math.max(...[...itemConsumed\x2C ...(item.values || []).map(value => value.rootIndex ?? -1)]) + 1;\n        for (const name of collectIdentifierReads(item.expression)) {\n            const reaching = nearestDefinition(block.body\x2C evaluationEnd\x2C name);\n            if (!reaching || reaching.ambiguous || itemConsumed.has(reaching.index)) continue;\n            insertionIndex = Math.max(insertionIndex\x2C reaching.index + 1);\n        }\n        return {\n            name: `${capturePrefix}_expr_${index + 1}`\x2C\n            expression: item.expression\x2C\n            insertionIndex\x2C\n        };\n    });\n    if (captures.some(capture => capture === null)) return null;\n    return { consumed\x2C captures };\n}\n\nfunction matchCompilerGenericForNaturalLoop(graph\x2C loopInfo\x2C returnName = null) {\n    if (!graph || !loopInfo?.coreIds?.size || !loopInfo.backedgeSources?.size) return null;\n    const raw = matchCompilerGenericForCheck(graph.blocks.get(loopInfo.headerId));\n    if (!raw) return null;\n    if (!loopInfo.coreIds.has(raw.bodyId) || loopInfo.coreIds.has(raw.exitId) || !graph.blocks.has(raw.exitId)) return null;\n    const outsideHeaderPreds = (graph.predecessors.get(raw.checkId) || []).filter(id => graph.reachable.has(id) && !loopInfo.coreIds.has(id));\n    if (outsideHeaderPreds.length !== 1) return null;\n    const preheaderId = outsideHeaderPreds[0];\n    const variables = matchBodyVariables(graph\x2C loopInfo\x2C raw\x2C returnName);\n    if (!variables) return null;\n    const header = matchPreheaderHeader(graph\x2C preheaderId\x2C raw\x2C new Set(variables.loopVarRegs));\n    if (!header) return null;\n\n    const breakRegionIds = new Set();\n    const breakTerminalIds = new Set();\n    const terminalReturnRegionIds = new Set();\n    for (const id of loopInfo.coreIds) {\n        const block = graph.blocks.get(id);\n        if (!block) return null;\n        for (const target of transitionTargets(block.transition)) {\n            if (loopInfo.coreIds.has(target)) continue;\n            if (id === raw.checkId && target === raw.exitId) continue;\n            const breakRegion = collectBreakRegion(graph\x2C target\x2C loopInfo.coreIds\x2C raw.exitId);\n            if (breakRegion) {\n                for (const member of breakRegion.ids) breakRegionIds.add(member);\n                for (const terminal of breakRegion.terminalIds) breakTerminalIds.add(terminal);\n                continue;\n            }\n            const returnRegion = collectTerminalReturnRegion(graph\x2C target\x2C loopInfo.coreIds\x2C returnName\x2C raw.exitId);\n            if (returnRegion) {\n                for (const member of returnRegion.ids) terminalReturnRegionIds.add(member);\n                continue;\n            }\n            const mixed = collectMixedAbruptRegion(graph\x2C target\x2C loopInfo.coreIds\x2C raw.exitId\x2C returnName);\n            if (!mixed) return null;\n            for (const member of mixed.ids) breakRegionIds.add(member);\n            for (const terminal of mixed.breakTerminalIds) breakTerminalIds.add(terminal);\n            for (const terminal of mixed.returnTerminalIds) terminalReturnRegionIds.add(terminal);\n        }\n    }\n\n    return {\n        ...raw\x2C\n        ...header\x2C\n        ...variables\x2C\n        coreIds: loopInfo.coreIds\x2C\n        preheaderId\x2C\n        headerId: raw.checkId\x2C\n        backedgeSources: new Set(loopInfo.backedgeSources)\x2C\n        continueIds: new Set(loopInfo.backedgeSources)\x2C\n        breakRegionIds\x2C\n        breakTerminalIds\x2C\n        terminalReturnRegionIds\x2C\n    };\n}\n\nfunction rewriteJumpTarget(leaves\x2C graph\x2C blockId\x2C targetId) {\n    const block = graph.blocks.get(blockId);\n    const body = leaves.get(blockId);\n    if (!block || !body || block.transition?.kind !== "jump" || block.transitionIndex < 0 || block.transitionIndex >= body.length) return false;\n    const original = body[block.transitionIndex];\n    if (!isSingleAssignment(original) || !isIdentifier(original.variables[0])) return false;\n    const next = [...body];\n    next[block.transitionIndex] = syntheticJump(original.variables[0].name\x2C targetId);\n    leaves.set(blockId\x2C next);\n    return true;\n}\n\nfunction applyCompilerGenericForMatch(transformed\x2C graph\x2C match\x2C stateName\x2C bodyJoinId\x2C metadata) {\n    if (!(transformed instanceof Map) || !graph || !match || !Number.isInteger(bodyJoinId) || !metadata) return false;\n    const {\n        genericForBranchIds\x2C\n        genericForMetaByBranchId\x2C\n        genericForBodyStarts\x2C\n        loopBodyJoinIds\x2C\n        loopBackedgeCountsByJoin\x2C\n        loopControlByBlockId\x2C\n    } = metadata;\n    if (!(genericForBranchIds instanceof Set) || !(genericForMetaByBranchId instanceof Map) ||\n        !(genericForBodyStarts instanceof Map) || !(loopBodyJoinIds instanceof Set) ||\n        !(loopBackedgeCountsByJoin instanceof Map) || !(loopControlByBlockId instanceof Map)) return false;\n\n    const preheaderBody = transformed.get(match.preheaderId);\n    if (!Array.isArray(preheaderBody)) return false;\n    const capturesByInsertion = new Map();\n    for (const capture of match.captures) {\n        if (!Number.isInteger(capture.insertionIndex) || capture.insertionIndex < 0 || capture.insertionIndex >= preheaderBody.length) return false;\n        if (!capturesByInsertion.has(capture.insertionIndex)) capturesByInsertion.set(capture.insertionIndex\x2C []);\n        capturesByInsertion.get(capture.insertionIndex).push(capture);\n    }\n    const nextPreheader = [];\n    for (let i = 0; i < preheaderBody.length; i++) {\n        for (const capture of capturesByInsertion.get(i) || []) {\n            nextPreheader.push(syntheticAssignment(capture.name\x2C {\n                type: "FreshGenericForExpression"\x2C\n                expression: capture.expression\x2C\n            }));\n        }\n        if (match.consumed.has(i)) continue;\n        nextPreheader.push(preheaderBody[i]);\n    }\n    transformed.set(match.preheaderId\x2C nextPreheader);\n\n    // Rewrite original backedges before mutating body/check arrays because the\n    // graph transition indexes refer to those original arrays.\n    for (const source of match.backedgeSources) {\n        if (!rewriteJumpTarget(transformed\x2C graph\x2C source\x2C bodyJoinId)) return false;\n        loopControlByBlockId.set(source\x2C "continue");\n    }\n    for (const source of match.breakTerminalIds || []) {\n        if (!rewriteJumpTarget(transformed\x2C graph\x2C source\x2C bodyJoinId)) return false;\n        loopControlByBlockId.set(source\x2C "break");\n    }\n\n    const body = transformed.get(match.bodyId);\n    if (!Array.isArray(body) || !body.includes(match.firstHandoffStatement) || !(match.loopVarBookkeepingStatements instanceof Set)) return false;\n    const cleanupBlockIds = new Set([\n        ...match.coreIds\x2C\n        ...(match.breakRegionIds || [])\x2C\n        ...(match.terminalReturnRegionIds || [])\x2C\n    ]);\n    for (const blockId of cleanupBlockIds) {\n        const blockBody = transformed.get(blockId);\n        if (!Array.isArray(blockBody)) continue;\n        transformed.set(blockId\x2C blockBody.filter(statement => !match.loopVarBookkeepingStatements.has(statement)));\n    }\n\n    const conditionName = `__fresh_generic_for_${match.checkId}_condition`;\n    match.conditionName = conditionName;\n    const checkBody = transformed.get(match.checkId);\n    if (!Array.isArray(checkBody) || !checkBody.includes(match.checkStatement)) return false;\n    const transition = checkBody.find(statement => isSingleAssignment(statement\x2C stateName));\n    if (!transition) return false;\n    transformed.set(match.checkId\x2C [\n        syntheticAssignment(conditionName\x2C identifier(match.captures[0].name))\x2C\n        syntheticBranch(stateName\x2C conditionName\x2C match.bodyId\x2C match.exitId)\x2C\n    ]);\n\n    transformed.set(bodyJoinId\x2C [syntheticJump(stateName\x2C match.exitId)]);\n    match.bodyJoinId = bodyJoinId;\n    loopBodyJoinIds.add(bodyJoinId);\n    loopBackedgeCountsByJoin.set(bodyJoinId\x2C match.backedgeSources.size);\n    genericForBranchIds.add(match.decisionId);\n    genericForMetaByBranchId.set(match.decisionId\x2C match);\n    genericForBodyStarts.set(match.bodyId\x2C match);\n    return true;\n}\n\nfunction collapseCompilerGenericForLoops(leaves\x2C entryId\x2C stateName\x2C returnName = null) {\n    if (!(leaves instanceof Map) || !Number.isInteger(entryId) || typeof stateName !== "string") return null;\n    const transformed = cloneLeaves(leaves);\n    const genericForBranchIds = new Set();\n    const genericForMetaByBranchId = new Map();\n    const genericForBodyStarts = new Map();\n    const loopBodyJoinIds = new Set();\n    const loopBackedgeCountsByJoin = new Map();\n    const loopControlByBlockId = new Map();\n    const matches = [];\n    let nextSyntheticId = -1;\n    while (transformed.has(nextSyntheticId)) nextSyntheticId--;\n    let rounds = 0;\n    while (true) {\n        if (rounds++ > leaves.size * 3 + 16) return null;\n        const graph = createStateGraph(transformed\x2C entryId\x2C stateName);\n        if (!graph) return null;\n        const natural = findNaturalLoops(graph);\n        if (!natural || !loopsAreNestedOrDisjoint(natural.loops)) return null;\n        if (!natural.loops.length) break;\n        const ordered = [...natural.loops].sort((a\x2C b) => a.coreIds.size - b.coreIds.size || a.headerId - b.headerId);\n        let applied = false;\n        for (const loopInfo of ordered) {\n            const match = matchCompilerGenericForNaturalLoop(graph\x2C loopInfo\x2C returnName);\n            if (!match) continue;\n            const bodyJoinId = nextSyntheticId--;\n            while (transformed.has(nextSyntheticId)) nextSyntheticId--;\n            if (!applyCompilerGenericForMatch(transformed\x2C graph\x2C match\x2C stateName\x2C bodyJoinId\x2C {\n                genericForBranchIds\x2C\n                genericForMetaByBranchId\x2C\n                genericForBodyStarts\x2C\n                loopBodyJoinIds\x2C\n                loopBackedgeCountsByJoin\x2C\n                loopControlByBlockId\x2C\n            })) return null;\n            matches.push(match);\n            applied = true;\n            break;\n        }\n        if (!applied) return null;\n    }\n    if (!matches.length) return null;\n    return {\n        leaves: transformed\x2C\n        matches\x2C\n        genericForBranchIds\x2C\n        genericForMetaByBranchId\x2C\n        genericForBodyStarts\x2C\n        loopBodyJoinIds\x2C\n        loopBackedgeCountsByJoin\x2C\n        loopControlByBlockId\x2C\n    };\n}\n\nmodule.exports = {\n    applyCompilerGenericForMatch\x2C\n    collapseCompilerGenericForLoops\x2C\n    matchCompilerGenericForCheck\x2C\n    matchCompilerGenericForNaturalLoop\x2C\n};\n
