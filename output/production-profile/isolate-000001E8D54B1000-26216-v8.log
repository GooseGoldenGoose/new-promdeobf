 + ":" + name;\n    if (visiting.has(visitKey)) return false;\n    const block = ctx.blocks.get(blockId);\n    if (!block) return false;\n    const nextVisiting = new Set(visiting);\n    nextVisiting.add(visitKey);\n    const before = statementIndex < 0 ? block.body.length : statementIndex;\n    for (let i = before - 1; i >= 0; i--) {\n        if (i === block.transitionIndex) continue;\n        const statement = block.body[i];\n        if (!isSingleAssignment(statement) || !isIdentifier(statement.variables[0]\x2C name)) continue;\n        return statement.init[0]?.type === "NilLiteral" && isDeadNilCleanup(ctx\x2C blockId\x2C i\x2C name);\n    }\n    const preds = (ctx.predecessors.get(blockId) || []).filter(id => ctx.reachable.has(id));\n    if (preds.length === 0) return false;\n    return preds.every(pred => allReachingDefinitionsAreDeadNilCleanup(ctx\x2C pred\x2C -1\x2C name\x2C nextVisiting));\n}\n\nfunction provenCallArgumentSourceEpoch(ctx\x2C blockId\x2C statementIndex\x2C name) {\n    const def = uniqueReachingDefinitionBefore(ctx\x2C blockId\x2C statementIndex\x2C name);\n    if (!def) return false;\n    const rhs = def.statement.init[0];\n    if (rhs?.type === "NilLiteral") return false;\n    // The normal LocalVariableDeclaration lowering is an expression TEMP ->\n    // cleanup-backed VAR handoff. A copied TEMP is explicit ownership evidence.\n    if (isIdentifier(rhs) && rhs.name !== name) return true;\n    // Prometheus may erase that copy by promoting the expression register itself\n    // to VAR ownership. Fresh CF only proves this direct form when the next write\n    // on every continuation path is the compiler nil cleanup; a later non-nil\n    // write means the current value could still be an ordinary TEMP epoch.\n    return cleanupReachedOnAllPaths(ctx\x2C def.blockId\x2C def.index\x2C name);\n}\n\nfunction analyzePersistentStorage(ctx) {\n    if (ctx.allowConditionalIf && ctx.accumulatorRegs.size) {\n    for (const name of ctx.accumulatorRegs) {\n    const inDefs = new Map([...ctx.reachable].map(id => [id\x2C new Set()]));\n    const outDefs = new Map([...ctx.reachable].map(id => [id\x2C new Set()]));\n    let convergedRead = false;\n    let changed = true;\n    let rounds = 0;\n    while (changed && rounds++ <= ctx.reachable.size + 1) {\n    changed = false;\n    for (const id of ctx.reachable) {\n    const incomingDefs = new Set();\n    for (const pred of ctx.predecessors.get(id) || []) {\n    if (!ctx.reachable.has(pred)) continue;\n    for (const def of outDefs.get(pred) || []) incomingDefs.add(def);\n    }\n    const oldIn = inDefs.get(id);\n    if (oldIn.size !== incomingDefs.size || [...oldIn].some(def => !incomingDefs.has(def))) {\n    inDefs.set(id\x2C incomingDefs);\n    changed = true;\n    }\n    let current = new Set(incomingDefs);\n    const block = ctx.blocks.get(id);\n    for (let i = 0; i < block.body.length; i++) {\n    if (i === block.transitionIndex) continue;\n    const statement = block.body[i];\n    if (!isSingleAssignment(statement)) continue;\n    const dest = statement.variables[0];\n    const rhs = statement.init[0];\n    // A compiler POS save/restore (temp = state ... state = temp) is\n    // dispatcher transport\x2C not a source read of persistent storage.  Counting\n    // the restore here can merge an earlier TEMP epoch with a much later\n    // cleanup-backed VAR lifetime on the same physical register.\n    const compilerPosRestore = isIdentifier(dest\x2C ctx.stateName) && isIdentifier(rhs\x2C name);\n    const ordinaryRead = !compilerPosRestore && (nodeReadsIdentifier(ctx\x2C rhs\x2C name) ||\n        (dest?.type === "IndexExpression" && nodeReadsIdentifier(ctx\x2C dest\x2C name)));\n    if (ordinaryRead && current.size >= 2) convergedRead = true;\n    if (isIdentifier(dest\x2C name)) {\n    if (rhs?.type === "NilLiteral" && isDeadNilCleanup(ctx\x2C id\x2C i\x2C name)) current = new Set();\n    else current = new Set([id + ":" + i]);\n    }\n    }\n    const oldOut = outDefs.get(id);\n    if (oldOut.size !== current.size || [...oldOut].some(def => !current.has(def))) {\n    outDefs.set(id\x2C current);\n    changed = true;\n    }\n    }\n    }\n    if (convergedRead && eventualCleanupOnAllPaths(ctx\x2C ctx.entryId\x2C -1\x2C name)) ctx.persistentStorageRegs.add(name);\n    }\n    }\n}\n\nmodule.exports = { nodeReadsIdentifier\x2C nodeUsesAsCallBaseMulti\x2C terminalStableUsedEpoch\x2C transportSourceKind\x2C valueMayBeReadFrom\x2C eventualCleanupOnAllPaths\x2C valueMayBeReadAfter\x2C hasFutureNonNilWrite\x2C cleanupReachedOnAllPaths\x2C isDeadNilCleanup\x2C allReachingDefinitionsAreDeadNilCleanup\x2C conditionalUpdatedStorageEpoch\x2C provenCallArgumentSourceEpoch\x2C provenSingleUseCallResultAt\x2C valueMayBeIndexWriteBaseAfter\x2C analyzePersistentStorage };\n
