g\x2C env\x2C true\x2C singleCallPacks);\x0d\n            if (typeof value !== "string") return null;\x0d\n            args.push(value);\x0d\n        }\x0d\n        return `${receiver}:${rhs.member}(${args.join("\x2C ")})`;\x0d\n    }\x0d\n    if (isPrimitiveLiteral(rhs) || isEmptyTable(rhs)) return sourceOf(ctx.source\x2C rhs);\x0d\n    if (rhs?.type === "TableConstructorExpression") return renderTableFields(rhs.fields || []\x2C node => render(ctx\x2C node\x2C env\x2C provenRecursive\x2C singleCallPacks));\x0d\n    if (isIdentifier(rhs)) return resolveRenderableId(ctx\x2C rhs.name\x2C env);\x0d\n    const capturedSlot = capturedSlotName(ctx\x2C rhs);\x0d\n    if (typeof capturedSlot === "string") return capturedSlot;\x0d\n    if (ctx.renderAsFunction && rhs?.type === "IndexExpression" && isIdentifier(rhs.base\x2C "args") && rhs.index?.type === "NumericLiteral") {\x0d\n        return parameterName(ctx\x2C Number(rhs.index.value));\x0d\n    }\x0d\n    if (rhs?.type === "IndexExpression" && isIdentifier(rhs.base\x2C "upvalueValues") && isIdentifier(rhs.index)) {\x0d\n        return upvalueCellBinding(ctx\x2C rhs.index.name\x2C env);\x0d\n    }\x0d\n    if (provenRecursive && rhs?.type === "IndexExpression" && !isIdentifier(rhs.base)) {\x0d\n        const base = render(ctx\x2C rhs.base\x2C env\x2C true\x2C singleCallPacks);\x0d\n        const key = isIdentifier(rhs.index) ? resolveRenderableId(ctx\x2C rhs.index.name\x2C env)\x0d\n            : (isPrimitiveLiteral(rhs.index) ? sourceOf(ctx.source\x2C rhs.index) : render(ctx\x2C rhs.index\x2C env\x2C true\x2C singleCallPacks));\x0d\n        if (typeof base !== "string" || typeof key !== "string" || structuredPackId(ctx\x2C base) || structuredPackSlot(ctx\x2C base) || base === ctx.varargPackMarker) return null;\x0d\n        return renderIndexAccess(base\x2C key);\x0d\n    }\x0d\n    if (rhs?.type === "IndexExpression" && isIdentifier(rhs.base)) {\x0d\n        // Proven recursive expressions may use an arbitrary computed key even\x0d\n        // when the base itself is a register. This occurs after logical/loop\x0d\n        // reduction folds compiler TEMP chains into one expression.\x0d\n        const key = isIdentifier(rhs.index) ? resolveRenderableId(ctx\x2C rhs.index.name\x2C env)\x0d\n            : (isPrimitiveLiteral(rhs.index) ? sourceOf(ctx.source\x2C rhs.index)\x0d\n                : (provenRecursive ? render(ctx\x2C rhs.index\x2C env\x2C true\x2C singleCallPacks) : null));\x0d\n        if (key == null) return null;\x0d\n        if (rhs.base.name === "_env") {\x0d\n            return renderEnvironmentRead(key);\x0d\n        }\x0d\n        const base = resolveRenderableId(ctx\x2C rhs.base.name\x2C env);\x0d\n        if (base == null) return null;\x0d\n        return renderIndexAccess(base\x2C key);\x0d\n    }\x0d\n    if (rhs?.type === "UnaryExpression") {\x0d\n        const argument = provenRecursive ? render(ctx\x2C rhs.argument\x2C env\x2C true\x2C singleCallPacks)\x0d\n            : (isIdentifier(rhs.argument) ? resolveRenderableId(ctx\x2C rhs.argument.name\x2C env) : (isPrimitiveLiteral(rhs.argument) ? sourceOf(ctx.source\x2C rhs.argument) : null));\x0d\n        return renderUnary(rhs.operator\x2C argument);\x0d\n    }\x0d\n    if ((provenRecursive || (rhs?.type === "LogicalExpression" && rhs.freshCompilerLogical === true)) &&\x0d\n        (rhs?.type === "BinaryExpression" || rhs?.type === "LogicalExpression") && rhs.operator) {\x0d\n        const left = render(ctx\x2C rhs.left\x2C env\x2C true\x2C singleCallPacks);\x0d\n        const right = render(ctx\x2C rhs.right\x2C env\x2C true\x2C singleCallPacks);\x0d\n        if (left == null || right == null) return null;\x0d\n        return renderInfix(left\x2C rhs.operator\x2C right);\x0d\n    }\x0d\n    if ((rhs?.type === "BinaryExpression" || rhs?.type === "LogicalExpression") && rhs.operator) {\x0d\n        const left = isIdentifier(rhs.left) ? resolveRenderableId(ctx\x2C rhs.left.name\x2C env) : (isPrimitiveLiteral(rhs.left) ? sourceOf(ctx.source\x2C rhs.left) : null);\x0d\n        const right = isIdentifier(rhs.right) ? resolveRenderableId(ctx\x2C rhs.right.name\x2C env) : (isPrimitiveLiteral(rhs.right) ? sourceOf(ctx.source\x2C rhs.right) : null);\x0d\n        if (left == null || right == null) return null;\x0d\n        return renderInfix(left\x2C rhs.operator\x2C right);\x0d\n    }\x0d\n    if (rhs?.type === "CallExpression") {\x0d\n        // Logical/loop reduction may inline a proven compiler RETURN_ALL pack\x0d\n        // directly into unpack()\x2C producing unpack({ call(...) }). In recursive\x0d\n        // proven expressions that table is compiler transport\x2C not source table\x0d\n        // identity\x2C so preserve the original multi-return call directly.\x0d\n        if (provenRecursive && isIdentifier(rhs.base\x2C "unpack") && (rhs.arguments || []).length === 1) {\x0d\n            const inlinePack = rhs.arguments[0];\x0d\n            const fields = inlinePack?.type === "TableConstructorExpression" ? (inlinePack.fields || []) : [];\x0d\n            if (fields.length === 1 && fields[0]?.type === "TableValue" && fields[0].value?.type === "CallExpression") {\x0d\n                const packedCall = render(ctx\x2C fields[0].value\x2C env\x2C true\x2C singleCallPacks);\x0d\n                if (typeof packedCall === "string") return packedCall;\x0d\n            }\x0d\n        }\x0d\n        if (isIdentifier(rhs.base\x2C "unpack") && (rhs.arguments || []).length === 1 && isIdentifier(rhs.arguments[0]) && singleCallPacks instanceof Map) {\x0d\n            const packed = singleCallPacks.get(rhs.arguments[0].name);\x0d\n            if (typeof packed === "string") return packed;\x0d\n        }\x0d\n        if (ctx.renderAsFunction && isVarargUnpack(ctx\x2C rhs\x2C env)) {\x0d\n            ctx.sawVarargs = true;\x0d\n            return "...";\x0d\n        }\x0d\n        if (isCompilerVarargSelect(ctx\x2C rhs)) {\x0d\n            ctx.sawVarargs = true;\x0d\n            return "...";\x0d\n        }\x0d\n        if (ctx.renderAsFunction && isIdentifier(rhs.base\x2C "unpack") && (rhs.arguments || []).length === 1 && isIdentifier(rhs.arguments[0]\x2C "args")) {\x0d\n            ctx.sawVarargs = true;\x0d\n            return "...";\x0d\n        }\x0d\n        if (isIdentifier(rhs.base) && /^createClosure\\d*$/.test(rhs.base.name) && typeof ctx.options.renderCapturedCall === "function") {\x0d\n            const args = rhs.arguments || [];\x0d\n            const fields = args[1]?.type === "TableConstructorExpression" ? (args[1].fields || []) : [];\x0d\n            if (fields.length > 0) {\x0d\n                const childCaptureNames = new Map();\x0d\n                for (let i = 0; i < fields.length; i++) {\x0d\n                    const field = fields[i];\x0d\n                    if (field?.type !== "TableValue") return null;\x0d\n                    let captureName = null;\x0d\n                    if (isIdentifier(field.value)) captureName = upvalueCellBinding(ctx\x2C field.value.name\x2C env);\x0d\n                    else captureName = forwardedCaptureName(ctx\x2C field.value);\x0d\n                    if (typeof captureName !== "string") return null;\x0d\n                    childCaptureNames.set(i + 1\x2C captureName);\x0d\n                }\x0d\n                const captured = ctx.options.renderCapturedCall(rhs\x2C childCaptureNames);\x0d\n                if (typeof captured === "string") return captured;\x0d\n                return null;\x0d\n            }\x0d\n        }\x0d\n        if (typeof ctx.options.renderSpecialCall === "function") {\x0d\n            const special = ctx.options.renderSpecialCall(rhs);\x0d\n            if (typeof special === "string") return special;\x0d\n        }\x0d\n        const base = isIdentifier(rhs.base) ? resolveRenderableId(ctx\x2C rhs.base.name\x2C env)\x0d\n            : (provenRecursive ? render(ctx\x2C rhs.base\x2C env\x2C true\x2C singleCallPacks) : null);\x0d\n        if (base == null) return null;\x0