ptureNames.set(i + 1\x2C name);\x0d\n    }\x0d\n    return ctx.options.renderCapturedCall(value.call\x2C captureNames);\x0d\n}\x0d\n\x0d\nfunction allocateValueDisplay(ctx) {\x0d\n    let display;\x0d\n    do display = `v${ctx.nextValueSuffix++}`; while (ctx.reservedBindingNames.has(display));\x0d\n    ctx.reservedBindingNames.add(display);\x0d\n    ctx.valueCount++;\x0d\n    return display;\x0d\n}\x0d\n\x0d\nfunction allocateTableDisplay(ctx) {\x0d\n    let display;\x0d\n    do display = `t${ctx.nextTableSuffix++}`; while (ctx.reservedBindingNames.has(display));\x0d\n    ctx.reservedBindingNames.add(display);\x0d\n    ctx.tableCount++;\x0d\n    return display;\x0d\n}\x0d\n\x0d\nfunction parameterName(ctx\x2C index) {\x0d\n    if (!ctx.renderAsFunction || !Number.isInteger(index) || index < 1) return null;\x0d\n    while (ctx.parameterNames.length < index) {\x0d\n        let display;\x0d\n        do display = `v${ctx.nextValueSuffix++}`; while (ctx.reservedBindingNames.has(display));\x0d\n        ctx.reservedBindingNames.add(display);\x0d\n        ctx.parameterNames.push(display);\x0d\n    }\x0d\n    return ctx.parameterNames[index - 1];\x0d\n}\x0d\n\x0d\nfunction capturedSlotName(ctx\x2C node) {\x0d\n    if (!ctx.captureNames || node?.type !== "IndexExpression" || !isIdentifier(node.base\x2C "upvalueValues")) return null;\x0d\n    const slotExpr = node.index;\x0d\n    if (slotExpr?.type !== "IndexExpression" || !isIdentifier(slotExpr.base\x2C "upvalues") || slotExpr.index?.type !== "NumericLiteral") return null;\x0d\n    const slot = Number(slotExpr.index.value);\x0d\n    if (!Number.isInteger(slot) || slot < 1) return null;\x0d\n    return ctx.captureNames.get(slot) ?? null;\x0d\n}\x0d\n\x0d\nfunction forwardedCaptureName(ctx\x2C node) {\x0d\n    if (!ctx.captureNames || node?.type !== "IndexExpression" || !isIdentifier(node.base\x2C "upvalues") || node.index?.type !== "NumericLiteral") return null;\x0d\n    const slot = Number(node.index.value);\x0d\n    if (!Number.isInteger(slot) || slot < 1) return null;\x0d\n    return ctx.captureNames.get(slot) ?? null;\x0d\n}\x0d\n\x0d\nfunction displayLocal(ctx\x2C reg) { return ctx.localNames.get(reg) || reg; }\x0d\n\x0d\nfunction activeLocalDisplay(ctx\x2C name\x2C env) {\x0d\n    const value = env.get(name);\x0d\n    if (isPendingDeferredLocalValue(value)) {\x0d\n        const owned = value.pathScoped\x0d\n            ? env.get(pathLocalOwnerKey(ctx\x2C name)) === value\x0d\n            : ctx.locals.has(name);\x0d\n        return owned ? "\\0freshPendingDeferredLocal" : null;\x0d\n    }\x0d\n    if (typeof value === "string" && ctx.pathLocalBindingNames.has(value) &&\x0d\n        env.get(pathLocalOwnerKey(ctx\x2C name)) === value) return value;\x0d\n    if (ctx.locals.has(name)) {\x0d\n        const display = displayLocal(ctx\x2C name);\x0d\n        if (value === display) return display;\x0d\n    }\x0d\n    return null;\x0d\n}\x0d\n\x0d\nfunction hasActiveLocal(ctx\x2C name\x2C env) { return activeLocalDisplay(ctx\x2C name\x2C env) !== null; }\x0d\n\x0d\nfunction resolveId(ctx\x2C name\x2C env) {\x0d\n    const raw = env.get(name);\x0d\n    if (isPendingDeferredLocalValue(raw)) return raw;\x0d\n    const active = activeLocalDisplay(ctx\x2C name\x2C env);\x0d\n    if (active !== null) return active;\x0d\n    return raw ?? null;\x0d\n}\x0d\n\x0d\nfunction resolveRenderableId(ctx\x2C name\x2C env) {\x0d\n    const value = resolveId(ctx\x2C name\x2C env);\x0d\n    if (isPendingDeferredLocalValue(value)) return null;\x0d\n    if (isDeferredClosureValue(value)) return renderDeferredClosureValue(ctx\x2C value\x2C env);\x0d\n    if (structuredPackId(ctx\x2C value) || structuredPackSlot(ctx\x2C value) || value === ctx.varargPackMarker) return null;\x0d\n    return typeof value === "string" ? value : null;\x0d\n}\x0d\n\x0d\nmodule.exports = { hasLinearRootContinuation\x2C recordRootConditional\x2C upvalueAliasKey\x2C pathLocalOwnerKey\x2C deadJoinTempKey\x2C pathUpvalueCellKey\x2C hasPathUp