script-source,106,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\linear\\render.js,"use strict";\n\nconst { isIdentifier\x2C isSingleAssignment\x2C isPrimitiveLiteral\x2C isEmptyTable\x2C isVmRegisterName\x2C sourceOf\x2C renderTableFields\x2C renderUnary } = require("../ast");\nconst { localName } = require("./bindings");\x0d\nconst { staticMemberNameFromRenderedKey\x2C renderEnvironmentRead\x2C renderIndexAccess\x2C renderInfix\x2C renderCallable } = require("../expression-semantics");\nfunction memberMeta(ctx\x2C rhs) {\n    if (rhs?.type !== "IndexExpression" || !isIdentifier(rhs.base) || !isIdentifier(rhs.index) || rhs.base.name === "_env") return null;\n    const key = ctx.expr.get(rhs.index.name) ?? (ctx.locals.has(rhs.index.name) ? localName(ctx\x2C rhs.index.name) : null);\n    const base = ctx.expr.get(rhs.base.name) ?? (ctx.locals.has(rhs.base.name) ? localName(ctx\x2C rhs.base.name) : null);\n    if (typeof key !== "string" || typeof base !== "string") return null;\x0d\n    const member = staticMemberNameFromRenderedKey(key);\x0d\n    return member ? { kind: "member"\x2C base\x2C member } : null;\n}\n\nfunction renderCallArg(ctx\x2C arg) {\n    if (isPrimitiveLiteral(arg) || isEmptyTable(arg)) return sourceOf(ctx.source\x2C arg);\n    if (isIdentifier(arg)) return ctx.expr.get(arg.name) ?? (ctx.locals.has(arg.name) ? localName(ctx\x2C arg.name) : null);\n    if (arg?.type === "CallExpression" && isIdentifier(arg.base\x2C "unpack") && (arg.arguments || []).length === 1 && isIdentifier(arg.arguments[0])) {\n        const packReg = arg.arguments[0].name;\n        if (ctx.exprKinds.get(packReg) === "return-pack") return ctx.expr.get(packReg) ?? null;\n    }\n    return renderRhs(ctx\x2C arg);\n}\n\nfunction isSourcePackedTableConstructor(ctx\x2C rhs) {\n    if (rhs?.type !== "TableConstructorExpression") return false;\n    const fields = rhs.fields || [];\n    if (fields.length !== 1 || fields[0]?.type !== "TableValue"