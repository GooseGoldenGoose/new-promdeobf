script-source,118,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\structured\\lifetime.js,"use strict";\n\nconst { isEmptyTable\x2C isIdentifier\x2C isLuaIdentifier\x2C isPrimitiveLiteral\x2C isSingleAssignment\x2C isVmRegisterName\x2C renderTableFields\x2C renderUnary\x2C sourceOf } = require("../ast");\nfunction nodeReadsIdentifier(ctx\x2C node\x2C name) {\n    if (!node || typeof node !== "object") return false;\n    if (isIdentifier(node\x2C name)) return true;\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) {\n            if (value.some(item => nodeReadsIdentifier(ctx\x2C item\x2C name))) return true;\n        } else if (value && typeof value === "object" && nodeReadsIdentifier(ctx\x2C value\x2C name)) return true;\n    }\n    return false;\n}\n\nfunction nodeUsesAsCallBaseMulti(ctx\x2C node\x2C name) {\n    if (!node || typeof node !== "object") return false;\n    if (node.type === "CallExpression" && isIdentifier(node.base\x2C name)) return true;\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) {\n            if (value.some(item => nodeUsesAsCallBaseMulti(ctx\x2C item\x2C name))) return true;\n        } else if (value && typeof value === "object" && nodeUsesAsCallBaseMulti(ctx\x2C value\x2C name)) return true;\n    }\n    return false;\n}\n\nfunction terminalStableUsedEpoch(ctx\x2C startBlockId\x2C startIndex\x2C name) {\n    const uses = new Map();\n    const seen = new Set();\n    const stack = [{ blockId: startBlockId\x2C index: startIndex + 1 }];\n    let invalid = false;\n    while (stack.length && !invalid) {\n        const cursor = stack.pop();\n        const visitKey = `${cursor.blockId}:${cursor.index}`;\n        if (seen.has(visitKey)) continue;\n        seen.add(visitKey);\n        const block = ctx.blocks.get(cursor.blockId);\n        if (!block) return false;\n        for (let i = cursor.index; i < block.body.length; i++) {\n            if (i === block.transitionIndex) continue;\n            const statement = block.body[i];\n            if (!isSingleAssignment(statement)) return false;\n            const dest = statement.variables[0];\n            const rhs = statement.init[0];\n            if (isIdentifier(dest\x2C name)) { invalid = true; break; }\n            if (isIdentifier(dest\x2C ctx.stateName) && isIdentifier(rhs\x2C name)) { invalid = true; break; }\n            const ordinaryUse = nodeReadsIdentifier(ctx\x2C rhs\x2C name) ||\n                (dest?.type === "IndexExpression" && nodeReadsIdentifier(ctx\x2C dest\x2C name));\n            if (ordinaryUse) {\n                uses.set(`${cursor.blockId}:${i}`\x2C {\n                    delayed: cursor.blockId !== startBlockId || i > startIndex + 1\x2C\n                    callBase: nodeUsesAsCallBaseMulti(ctx\x2C rhs\x2C name)\x2C\n                    logical: rhs?.type === "LogicalExpression" && nodeReadsIdentifier(ctx\x2C rhs\x2C name)\x2C\n                });\n            }\n        }\n        if (invalid) break;\n        if (block.transition.kind === "branch" && block.transition.conditionRegister === name) {\n            uses.set(`${cursor.blockId}:branch`\x2C { delayed: cursor.blockId !== startBlockId\x2C callBase: false\x2C logical: true });\n        }\n        for (const next of ctx.successors.get(cursor.blockId) || []) stack.push({ blockId: next\x2C index: 0 });\n    }\n    if (invalid || uses.size === 0) return false;\n    if (uses.size > 1) return true;\n    const only = [...uses.values()][0];\n    return only.delayed && !only.callBase && !only.logical;\n}\n\nfunction transportSourceKind(ctx\x2C block\x2C statementIndex\x2C transportName) {\n    for (let i = statementIndex - 1; i >= 0; i--) {\n        if (i === block.transitionIndex) continue;\n        const statement = block.body[i];\n        if (!isSingleAssignment(statement\x2C transportName)) continue;\n        const rhs = statement.init[0];\n        if (rhs?.type === "TableConstructorExpression") return "table";\n        if (rhs?.type === "CallExpression" && isIdentifier(rhs.base) && /^createClosure\\d*$/.test(rhs.base.name)) return "closure";\n        return "value";\n    }\n    return "value";\n}\n\nfunction assignmentValueFlow(ctx\x2C statement\x2C name) {\n    if (statement?.type === "CompoundAssignmentStatement") {\n        // Luau compound assignment evaluates the destination address\x2C reads the\n        // destination's current value\x2C evaluates the RHS\x2C then writes back. It\n        // only makes the queried VM value live when that value actually appears\n        // in the destination expression or RHS. An unrelated compound write must\n        // not conservatively make every register live across a CFG join/loop.\n        return nodeReadsIdentifier(ctx\x2C statement.variable\x2C name) ||\n            nodeReadsIdentifier(ctx\x2C statement.value\x2C name) ? "read" : "pass";\n    }\n    if (statement?.type !== "AssignmentStatement") return "unknown";\n    const variables = statement.variables || [];\n    const init = statement.init || [];\n    // Lua evaluates every RHS before applying any LHS write. A parallel\n    // assignment can therefore read the old value even when one destination\n    // overwrites the same register; test all RHS/index-address reads first.\n    if (nodeReadsIdentifier(ctx\x2C init\x2C name)) return "read";\n    for (const dest of variables) {\n        if (dest?.type === "IndexExpression" && nodeReadsIdentifier(ctx\x2C dest\x2C name)) return "read";\n    }\n    if (variables.some(dest => isIdentifier(dest\x2C name))) return "kill";\n    return "pass";\n}\n\nfunction implicitLoopBodyEntryDefines(ctx\x2C blockId\x2C name) {\n    const genericStarts = ctx.options?.genericForBodyStarts;\n    const generic = genericStarts instanceof Map ? genericStarts.get(blockId) : null;\n    if (generic && Array.isArray(generic.loopVarRegs) && generic.loopVarRegs.includes(name)) return true;\n\n    const numericStarts = ctx.options?.numericForBodyStarts;\n    const numeric = numericStarts instanceof Map ? numericStarts.get(blockId) : null;\n    if (numeric && numeric.loopVarReg === name) return true;\n\n    return false;\n}\n\nfunction valueMayBeReadFrom(ctx\x2C blockId\x2C name\x2C visiting = new Set()) {\n    // Proven compiler loop headers assign source iteration variables before the\n    // first body statement. An incoming pre-loop TEMP epoch is therefore killed\n    // at body entry even though that assignment was removed during loop collapse.\n    if (implicitLoopBodyEntryDefines(ctx\x2C blockId\x2C name)) return false;\n    // This query asks whether any CFG path can READ the current value before\n    // an overwrite. Revisiting a block on the current DFS stack is not a read;\n    // it only closes a cycle. Any real read reachable through an exit from that\n    // cycle is explored through the other successor edges\x2C so treating the\n    // back-edge itself as live creates false liveness at loop joins.\n    if (visiting.has(blockId)) return false;\n    const block = ctx.blocks.get(blockId);\n    if (!block) return true;\n    const nextVisiting = new Set(visiting);\n    nextVisiting.add(blockId);\n    for (let i = 0; i < block.body.length; i++) {\n        if (i === block.transitionIndex) continue;\n        const statement = block.body[i];\n        const flow = assignmentValueFlow(ctx\x2C statement\x2C name);\n        if (flow === "unknown" || flow === "read") return true;\n        if (flow === "kill") return false;\n    }\n    if (block.transition.kind === "branch" && block.transition.conditionRegister === name) return true;\n    for (const next of ctx.successors.get(blockId) || []) {\n        if (valueMayBeReadFrom(ctx\x2C next\x2C name\x2C nextVisiting)) return true;\n    }\n    return false;\n}\n\nfunction isDeadNilCleanup(ctx\x2C blockId\x2C statementIndex\x2C name) {\n    const block = ctx.blocks.get(blockId);\n    const statement = block?.body?.[statementIndex];\n    if (!isSingleAssignment(statement) || !isIdentifier(statement.variables[0]\x2C name) || statement.init[0]?.type !== "NilLiteral") return false;\n    // A compiler lifetime cleanup produces nil that is never observed. If this\n    // exact nil definition is read before the next overwrite/terminal\x2C it is\n    // semantic source data and belongs to a new value/storage epoch instead.\n    return !valueMayBeReadAfter(ctx\x2C blockId\x2C statementIndex\x2C name);\n}\nfunction eventualCleanupOnAllPaths(ctx\x2C blockId\x2C statementIndex\x2C name\x2C visiting = new Set()) {\n    const cacheKey = blockId + ":" + statementIndex + ":" + name;\n    if (ctx.eventualCleanupCache.has(cacheKey)) return ctx.eventualCleanupCache.get(cacheKey);\n    const visitKey = blockId + ":" + statementIndex + ":" + name;\n    if (visiting.has(visitKey)) return false;\n    const block = ctx.blocks.get(blockId);\n    if (!block) return false;\n    const nextVisiting = new Set(visiting);\n    nextVisiting.add(visitKey);\n    for (let i = statementIndex + 1; i < block.body.length; i++) {\n        if (i === block.transitionIndex) continue;\n        const statement = block.body[i];\n        if (!isSingleAssignment(statement)) continue;\n        const dest = statement.variables[0];\n        if (!isIdentifier(dest\x2C name)) continue;\n        if (statement.init[0]?.type === "NilLiteral" && isDeadNilCleanup(ctx\x2C blockId\x2C i\x2C name)) {\n            ctx.eventualCleanupCache.set(cacheKey\x2C true);\n            return true;\n        }\n        // A non-nil write\x2C or a semantic nil write whose value is observed\x2C\n        // may be another source assignment to the same persistent binding;\n        // keep following this path to its real cleanup.\n    }\n    const next = ctx.successors.get(blockId) || [];\n    if (next.length === 0) {\n        ctx.eventualCleanupCache.set(cacheKey\x2C false);\n        return false;\n    }\n    const result = next.every(target => eventualCleanupOnAllPaths(ctx\x2C target\x2C -1\x2C name\x2C nextVisiting));\n    ctx.eventualCleanupCache.set(cacheKey\x2C result);\n    return result;\n}\n\nfunction valueMayBeReadAfter(ctx\x2C blockId\x2C statementIndex\x2C name\x2C visiting = new Set()) {\n    if (statementIndex < 0 && implicitLoopBodyEntryDefines(ctx\x2C blockId\x2C name)) return false;\n    const visitKey = `${blockId}:${statementIndex}`;\n    if (visiting.has(visitKey)) return true;\n    const cacheKey = `${blockId}:${statementIndex}:${name}`;\n    if (ctx.valueReadAfterCache.has(cacheKey)) return ctx.valueReadAfterCache.get(cacheKey);\n    const block = ctx.blocks.get(blockId);\n    if (!block) return true;\n    const nextVisiting = new Set(visiting);\n    nextVisiting.add(visitKey);\n    for (let i = statementIndex + 1; i < block.body.length; i++) {\n        if (i === block.transitionIndex) continue;\n        const statement = block.body[i];\n        const flow = assignmentValueFlow(ctx\x2C statement\x2C name);\n        if (flow === "unknown" || flow === "read") {\n            ctx.valueReadAfterCache.set(cacheKey\x2C true);\n            return true;\n        }\n        if (flow === "kill") {\n            ctx.valueReadAfterCache.set(cacheKey\x2C false);\n            return false;\n        }\n    }\n    if (block.transition.kind === "branch" && block.transition.conditionRegister === name) {\n        ctx.valueReadAfterCache.set(cacheKey\x2C true);\n        return true;\n    }\n    for (const next of ctx.successors.get(blockId) || []) {\n        if (valueMayBeReadAfter(ctx\x2C next\x2C -1\x2C name\x2C nextVisiting)) {\n            ctx.valueReadAfterCache.set(cacheKey\x2C true);\n            return true;\n        }\n    }\n    ctx.valueReadAfterCache.set(cacheKey\x2C false);\n    return false;\n}\n\nfunction hasFutureNonNilWrite(ctx\x2C blockId\x2C statementIndex\x2C name\x2C visiting = new Set()) {\n    const cacheKey = blockId + ":" + statementIndex + ":" + name;\n    if (ctx.futureNonNilWriteCache.has(cacheKey)) return ctx.futureNonNilWriteCache.get(cacheKey);\n    const visitKey = blockId + ":" + statementIndex;\n    if (visiting.has(visitKey)) return true;\n    const block = ctx.blocks.get(blockId);\n    if (!block) return true;\n    const nextVisiting = new Set(visiting);\n    nextVisiting.add(visitKey);\n    for (let i = statementIndex + 1; i < block.body.length; i++) {\n        if (i === block.transitionIndex) continue;\n        const statement = block.body[i];\n        if (!isSingleAssignment(statement)) continue;\n        const dest = statement.variables[0];\n        const rhs = statement.init[0];\n        if (!isIdentifier(dest\x2C name)) continue;\n        const result = rhs?.type !== "NilLiteral";\n        ctx.futureNonNilWriteCache.set(cacheKey\x2C result);\n        return result;\n    }\n    for (const next of ctx.successors.get(blockId) || []) {\n        if (hasFutureNonNilWrite(ctx\x2C next\x2C -1\x2C name\x2C nextVisiting)) {\n            ctx.futureNonNilWriteCache.set(cacheKey\x2C true);\n            return true;\n        }\n    }\n    ctx.futureNonNilWriteCache.set(cacheKey\x2C false);\n    return false;\n}\n\nfunction cleanupReachedOnAllPaths(ctx\x2C blockId\x2C statementIndex\x2C name\x2C visiting = new Set()) {\n    const cacheKey = blockId + ":" + statementIndex + ":" + name;\n    if (ctx.cleanupPathCache.has(cacheKey)) return ctx.cleanupPathCache.get(cacheKey);\n    const visitKey = blockId + ":" + statementIndex + ":" + name;\n    if (visiting.has(visitKey)) return false;\n    const block = ctx.blocks.get(blockId);\n    if (!block) return false;\n    const nextVisiting = new Set(visiting);\n    nextVisiting.add(visitKey);\n    for (let i = statementIndex + 1; i < block.body.length; i++) {\n        if (i === block.transitionIndex) continue;\n        const statement = block.body[i];\n        if (!isSingleAssignment(statement)) continue;\n        const dest = statement.variables[0];\n        if (!isIdentifier(dest\x2C name)) continue;\n        const result = statement.init[0]?.type === "NilLiteral" && isDeadNilCleanup(ctx\x2C blockId\x2C i\x2C name);\n        ctx.cleanupPathCache.set(cacheKey\x2C result);\n        return result;\n    }\n    const next = ctx.successors.get(blockId) || [];\n    if (next.length === 0) {\n        ctx.cleanupPathCache.set(cacheKey\x2C false);\n        return false;\n    }\n    const result = next.every(target => cleanupReachedOnAllPaths(ctx\x2C target\x2C -1\x2C name\x2C nextVisiting));\n    ctx.cleanupPathCache.set(cacheKey\x2C result);\n    return result;\n}\n\nfunction uniqueReachingDefinitionBefore(ctx\x2C blockId\x2C statementIndex\x2C name\x2C visiting = new Set()) {\n    const visitKey = blockId + ":" + statementIndex + ":" + name;\n    if (visiting.has(visitKey)) return null;\n    const block = ctx.blocks.get(blockId);\n    if (!block) return null;\n    const nextVisiting = new Set(visiting);\n    nextVisiting.add(visitKey);\n    const before = statementIndex < 0 ? block.body.length : statementIndex;\n    for (let i = before - 1; i >= 0; i--) {\n        if (i === block.transitionIndex) continue;\n        const statement = block.body[i];\n        if (!isSingleAssignment(statement)) continue;\n        const dest = statement.variables[0];\n        if (!isIdentifier(dest\x2C name)) continue;\n        return { blockId\x2C index: i\x2C statement };\n    }\n    const preds = (ctx.predecessors.get(blockId) || []).filter(id => ctx.reachable.has(id));\n    if (preds.length !== 1) return null;\n    return uniqueReachingDefinitionBefore(ctx\x2C preds[0]\x2C -1\x2C name\x2C nextVisiting);\n}\n\nfunction countIdentifierReads(node\x2C name) {\n    if (!node || typeof node !== "object") return 0;\n    if (isIdentifier(node\x2C name)) return 1;\n    let count = 0;\n    for (const [key\x2C value] of Object.entries(node)) {\n      