script-source,117,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\structured\\packs.js,"use strict";\n\nconst { isEmptyTable\x2C isIdentifier\x2C isLuaIdentifier\x2C isPrimitiveLiteral\x2C isSingleAssignment\x2C isVmRegisterName\x2C renderTableFields\x2C renderUnary\x2C sourceOf } = require("../ast");\nconst { hasLinearRootContinuation\x2C recordRootConditional\x2C upvalueAliasKey\x2C pathLocalOwnerKey\x2C allocateValueDisplay\x2C allocateTableDisplay\x2C parameterName\x2C capturedSlotName\x2C forwardedCaptureName\x2C displayLocal\x2C activeLocalDisplay\x2C hasActiveLocal\x2C resolveId\x2C resolveRenderableId } = require("./bindings");\nconst { structuredPackId\x2C structuredPackSlot\x2C structuredPackSlotToken } = require("./tokens");\nconst { nodeReadsIdentifier\x2C nodeUsesAsCallBaseMulti\x2C terminalStableUsedEpoch\x2C transportSourceKind\x2C valueMayBeReadFrom\x2C eventualCleanupOnAllPaths\x2C valueMayBeReadAfter\x2C hasFutureNonNilWrite\x2C cleanupReachedOnAllPaths\x2C isDeadNilCleanup\x2C analyzePersistentStorage } = require("./lifetime");\nconst { compilerVarargPackIndex\x2C compilerVarargSelectIndex } = require("../varargs");\nfunction isCompilerVarargPack(ctx\x2C node) {\n    return ctx?.renderAsFunction === true && Number.isInteger(ctx.varargFirstIndex) &&\n        compilerVarargPackIndex(node) === ctx.varargFirstIndex;\n}\n\nfunction isCompilerVarargSelect(ctx\x2C node) {\n    return ctx?.renderAsFunction === true && Number.isInteger(ctx.varargFirstIndex) &&\n        compilerVarargSelectIndex(node) === ctx.varargFirstIndex;\n}\n\nfunction isVarargUnpack(ctx\x2C node\x2C env) {\n    return node?.type === "CallExpression" && isIdentifier(node.base\x2C "unpack") &&\n        (node.arguments || []).length === 1 && isIdentifier(node.arguments[0]) &&\n        resolveId(ctx\x2C node.arguments[0].name\x2C env) === ctx.varargPackMarker;\n}\n\nfunction expectedPackSlotsInBlock(ctx\x2C block\x2C creationIndex\x2C packReg) {\n    const slots = new Set();\n    for (let cursor = creationIndex + 1; cursor < block.body.length; cursor++) {\n        if (cursor === block.transitionIndex) continue;\n        const statement = block.body[cursor];\n        if (!isSingleAssignment(statement)) return null;\n        const dest = statement.variables[0];\n        const rhs = statement.init[0];\n        if (isIdentifier(dest\x2C packReg)) break;\n        if (rhs?.type === "IndexExpression" && isIdentifier(rhs.base\x2C packReg) && rhs.index?.type === "NumericLiteral") {\n            const slot = Number(rhs.index.value);\n            if (!Number.isInteger(slot) || slot < 1 || slots.has(slot)) return null;\n            slots.add(slot);\n        }\n    }\n    if (!slots.size) return null;\n    const ordered = [...slots].sort((a\x2Cb) => a-b);\n    for (let i = 0; i < ordered.length; i++) if (ordered[i] !== i + 1) return null;\n    return ordered;\n}\n\n\nfunction countIdentifierReads(node\x2C name) {\n    if (!node || typeof node !== "object") return 0;\n    if (isIdentifier(node\x2C name)) return 1;\n    let count = 0;\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) {\n            for (const item of value) count += countIdentifierReads(item\x2C name);\n        } else if (value && typeof value === "object") {\n            count += countIdentifierReads(value\x2C name);\n        }\n    }\n    return count;\n}\n\nfunction countFinalForwardUnpacks(node\x2C packReg) {\n    if (!node || typeof node !== "object") return 0;\n    let count = 0;\n    if (node.type === "CallExpression") {\n        const args = node.arguments || [];\n        const last = args[args.length - 1];\n        if (last?.type === "CallExpression" && isIdentifier(last.base\x2C "unpack") &&\n            (last.arguments || []).length === 1 && isIdentifier(last.arguments[0]\x2C packReg) &&\n            !isIdentifier(node.base\x2C "unpack")) {\n            count++;\n        }\n    }\n    for (const [key\x2C value] of Object.entries(node)) {\n        if (key === "range" || key === "loc" || key === "variables") continue;\n        if (Array.isArray(value)) {\n            for (const item of value) count += countFinalForwardUnpacks(item\x2C packReg);\n        } else if (value && typeof value === "object") {\n            count += countFinalForwardUnpacks(value\x2C packReg);\n        }\n    }\n    return count;\n}\n\nfunction isForwardOnlyPackUseInBlock(ctx\x2C block\x2C creationIndex\x2C packReg) {\n    if (!block || !isVmRegisterName(packReg)) return false;\n    let sawUse = false;\n    let sawInterveningStatement = false;\n    for (let cursor = creationIndex + 1; cursor < block.body.length; cursor++) {\n        if (cursor === block.transitionIndex) continue;\n        const statement = block.body[cursor];\n        if (!statement || typeof statement !== "object") return false;\n\n        const directWrite = statement.type === "AssignmentStatement" &&\n            (statement.variables || []).some(dest => isIdentifier(dest\x2C packReg));\n        const reads = statement.type === "AssignmentStatement"\n            ? (statement.init || []).reduce((sum\x2C node) => sum + countIdentifierReads(node\x2C packReg)\x2C 0) +\n              (statement.variables || []).reduce((sum\x2C dest) => sum + (dest?.type === "IndexExpression" ? countIdentifierReads(dest\x2C packReg) : 0)\x2C 0)\n            : countIdentifierReads(statement\x2C packReg);\n\n        if (reads > 0) {\n            if (sawUse || sawInterveningStatement || directWrite) return false;\n            const forwards = statement.type === "AssignmentStatement"\n                ? (statement.init || []).reduce((sum\x2C node) => sum + countFinalForwardUnpacks(node\x2C packReg)\x2C 0) +\n                  (statement.variables || []).reduce((sum\x2C dest) => sum + (dest?.type === "IndexExpression" ? countFinalForwardUnpacks(dest\x2C packReg) : 0)\x2C 0)\n                : countFinalForwardUnpacks(statement\x2C packReg);\n            if (reads !== 1 || forwards !== 1) return false;\n            sawUse = true;\n            continue;\n        }\n\n        if (directWrite) return sawUse;\n        if (!sawUse) sawInterveningStatement = true;\n    }\n    return sawUse;\n}\n\nfunction cleanupOrTerminalEpoch(ctx\x2C blockId\x2C statementIndex\x2C name\x2C visiting = new Set()) {\n    const visitKey = blockId + ":" + statementIndex + ":" + name;\n    if (visiting.has(visitKey)) return { valid: false\x2C sawCleanup: false };\n    const block = ctx.blocks.get(blockId);\n    if (!block) return { valid: false\x2C sawCleanup: false };\n    const nextVisiting = new Set(visiting);\n    nextVisiting.add(visitKey);\n    for (let i = statementIndex + 1; i < block.body.length; i++) {\n        if (i === block.transitionIndex) continue;\n        const statement = block.body[i];\n        if (!isSingleAssignment(statement)) return { valid: false\x2C sawCleanup: false };\n        const dest = statement.variables[0];\n        if (!isIdentifier(dest\x2C name)) continue;\n        if (statement.init[0]?.type === "NilLiteral" && isDeadNilCleanup(ctx\x2C blockId\x2C i\x2C name)) return { valid: true\x2C sawCleanup: true };\n        if (statement.init[0]?.type === "NilLiteral") return { valid: false\x2C sawCleanup: false };\n        return { valid: false\x2C sawCleanup: false };\n    }\n    const next = ctx.successors.get(blockId) || [];\n    if (next.length === 0) return { valid: block.transition.kind === "stop"\x2C sawCleanup: false };\n    let sawCleanup = false;\n    for (const target of next) {\n        const child = cleanupOrTerminalEpoch(ctx\x2C target\x2C -1\x2C name\x2C nextVisiting);\n        if (!child.valid) return { valid: false\x2C sawCleanup: false };\n        sawCleanup = sawCleanup || child.sawCleanup;\n    }\n    return { valid: true\x2C sawCleanup };\n}\n\nfunction maybeOwnStructuredPackSlot(ctx\x2C pack\x2C slot\x2C reg\x2C blockId\x2C statementIndex) {\n    if (!pack || !Number.isInteger(slot) || !isVmRegisterName(reg) || reg === ctx.stateName || reg === ctx.returnName) return;\n    const epochEnd = cleanupOrTerminalEpoch(ctx\x2C blockId\x2C statementIndex\x2C reg);\n    if (!epochEnd.valid || !valueMayBeReadAfter(ctx\x2C blockId\x2C statementIndex\x2C reg)) return;\n    const terminalOwned = terminalStableUsedEpoch(ctx\x2C blockId\x2C statementIndex\x2C reg);\n    const mixedCleanupOwned = epochEnd.sawCleanup;\n    if (!mixedCleanupOwned && !terminalOwned) return;\n    const info = pack.slots.get(slot);\n    if (!info) return;\n    if (info.ownerReg && info.ownerReg !== reg) { info.ambiguous = true; return; }\n    info.ownerReg = reg;\n    info.terminalLive = terminalOwned && !epochEnd.sawCleanup;\n}\n\nfunction preclaimFutureStructuredPackOwner(ctx\x2C pack\x2C slot\x2C carrierReg\x2C blockId\x2C statementIndex) {\n    const info = pack?.slots.get(slot);\n    const block = ctx.blocks.get(blockId);\n    if (!info || info.ownerReg || info.ownerCaptured || info.ownerTemporary || info.ambiguous || !block ||\n        !(isVmRegisterName(carrierReg) || carrierReg === ctx.stateName || carrierReg === ctx.returnName)) return;\n    const carriers = new Set([carrierReg]);\n    for (let i = statementIndex + 1; i < block.body.length; i++) {\n        const statement = block.body[i];\n        if (!isSingleAssignment(statement)) return;\n        const dest = statement.variables[0];\n        const rhs = statement.init[0];\n        if (i === block.transitionIndex) {\n            // The dispatcher transition is still an ordinary sequential assignment\n            // inside the current leaf. If it reads this extracted pack slot before\n            // overwriting the carrier\x2C that read proves the slot is a compiler TEMP\n            // feeding control flow. Do not ignore the read merely because the same\n            // statement is also the block transition.\n            const transitionRead = [...carriers].some(name => nodeReadsIdentifier(ctx\x2C rhs\x2C name) ||\n                (dest?.type === "IndexExpression" && nodeReadsIdentifier(ctx\x2C dest\x2C name)));\n            if (transitionRead) {\n                info.ownerTemporary = true;\n                return;\n            }\n            if (isIdentifier(dest) && carriers.has(dest.name)) carriers.delete(dest.name);\n            if (carriers.size === 0) return;\n            continue;\n        }\n        const copiedCarrier = isIdentifier(rhs) && carriers.has(rhs.name);\n        const capturedOwner = copiedCarrier ? capturedSlotName(ctx\x2C dest) : null;\n        if (typeof capturedOwner === "string") {\n            if (info.ownerReg || (info.ownerCaptured && info.ownerCaptured !== capturedOwner)) { info.ambiguous = true; return; }\n            info.ownerCaptured = capturedOwner;\n            ctx.structuredPackFutureCaptureOwners.set(blockId + ":" + i\x2C {\n                packId: pack.id\x2C\n                slot\x2C\n                capturedDestination: capturedOwner\x2C\n                carrierReg: rhs.name\x2C\n            });\n            return;\n        }\n        if (copiedCarrier && isIdentifier(dest)) {\n            maybeOwnStructuredPackSlot(ctx\x2C pack\x2C slot\x2C dest.name\x2C blockId\x2C i);\n            if (info.ambiguous) return;\n            carriers.add(dest.name);\n            if (info.ownerReg === dest.name) {\n                info.ownerDeferred = true;\n                ctx.structuredPackFutureOwnerCopies.set(blockId + ":" + i\x2C {\n                    packId: pack.id\x2C\n                    slot\x2C\n                    ownerReg: dest.name\x2C\n                    carrierReg: rhs.name\x2C\n                });\n                return;\n            }\n        }\n        if (!copiedCarrier) {\n            const carrierRead = [...carriers].some(name => nodeReadsIdentifier(ctx\x2C rhs\x2C name) ||\n                (dest?.type === "IndexExpression" && nodeReadsIdentifier(ctx\x2C dest\x2C name)));\n            if (carrierRead) {\n                info.ownerTemporary = true;\n                return;\n            }\n        }\n        if (isIdentifier(dest) && carriers.has(dest.name) && !copiedCarrier) carriers.delete(dest.name);\n        if (carriers.size === 0) return;\n    }\n}\n\nfunction preclaimFutureStructuredPackSlots(ctx\x2C pack\x2C blockId\x2C creationIndex) {\n    const block = ctx.blocks.get(blockId);\n    if (!pack || !block) return false;\n    const seen = new Set();\n    for (let i = creationIndex + 1; i < block.body.length; i++) {\n        if (i === block.transitionIndex) continue;\n        const statement = block.body[i];\n        if (!isSingleAssignment(statement)) return false;\n        const dest = statement.variables[0];\n        const rhs = statement.init[0];\n        if (isIdentifier(dest\x2C pack.packReg)) break;\n        if (rhs?.type !== "IndexExpression" || !isIdentifier(rhs.base\x2C pack.packReg) || rhs.index?.type !== "NumericLiteral") continue;\n        const slot = Number(rhs.index.value);\n        if (!pack.slots.has(slot) || seen.has(slot) || !isIdentifier(dest)) return false;\n        seen.add(slot);\n        const info = pack.slots.get(slot);\n        info.tempRegs.add(dest.name);\n        ctx.structuredPackFutureExtractions.set(blockId + ":" + i\x2C {\n            packId: pack.id\x2C\n            slot\x2C\n            carrierReg: dest.name\x2C\n            packReg: pack.packReg\x2C\n        });\n        maybeOwnStructuredPackSlot(ctx\x2C pack\x2C slot\x2C dest.name\x2C blockId\x2C i);\n        if (info.ambiguous) return false;\n        if (info.ownerReg === dest.name) info.ownerDeferred = true;\n        if (!info.ownerReg && !info.ownerCaptured && !info.ownerTemporary) preclaimFutureStructuredPackOwner(ctx\x2C pack\x2C slot\x2C dest.name\x2C blockId\x2C i);\n        if (info.ambiguous) return false;\n    }\n    return pack.expectedSlots.every(slot => seen.has(slot));\n}\n\nfunction flushStructuredPack(ctx\x2C packId\x2C env\x2C markers\x2C effects) {\n    const pack = ctx.structuredPacks.get(packId);\n    if (!pack || pack.emitted) return effects;\n    const slots = pack.expectedSlots.map(slot => pack.slots.get(slot));\n    if (slots.some(info => !info || info.ambiguous || (!info.ownerReg && !info.ownerCaptured && !info.ownerTemporary))) return null;\n    const ownerKeys = slots.map(info => info.ownerCaptured ? `capture:${info.ownerCaptured}` : (info.ownerReg ? `reg:${info.ownerReg}` : `temp:${info.slot}`));\n    if (new Set(ownerKeys).size !== ownerKeys.length) return null;\n\n    const allLocalOwners = slots.every(info => !!info.ownerReg || info.ownerTemporary === true);\n    const allCapturedOwners = slots.every(info => typeof info.ownerCaptured === "string");\n    const names = [];\n    for (const info of slots) {\n        if (info.ownerCaptured) {\n            info.display = info.ownerCaptured;\n        } else if (info.ownerReg) {\n            let display = info.ownerDeferred ? null : activeLocalDisplay(ctx\x2C info.ownerReg\x2C env);\n            if (display === null) display = allocateValueDisplay(ctx);\n            info.display = display;\n        } else {\n            info.display = allocateValueDisplay(ctx);\n        }\n        names.push(info.display);\n    }\n\n    if (allLocalOwners) {\n        const line = `local ${names.join("\x2C ")} = ${pack.call}`;\n        if (markers.length !== 0) {\n            for (const info of slots) {\n                if (!info.ownerReg) continue;\n                ctx.pathLocalBindingNames.add(info.display);\n                env.set(pathLocalOwnerKey(ctx\x2C info.ownerReg)\x2C info.display);\n            }\n            effects = [...effects\x2C line];\n        } else {\n            ctx.out.push(line);\n            for (const info of slots) {\n                if (!info.ownerReg) continue;\n                ctx.localNames.set(info.ownerReg\x2C info.display);\n                ctx.locals.add(info.ownerReg);\n                if (info.terminalLive) ctx.terminalLiveLocals.add(info.ownerReg);\n            }\n        }\n    } else if (allCapturedOwners) {\n        const line = `${names.join("\x2C ")} = ${pack.call}`;\n        if (markers.length !== 0) effects = [...effects\x2C line];\n        else ctx.out.push(line);\n    } else {\n        const localInfos = slots.filter(info => !!info.ownerReg || info.ownerTemporary === true);\n        const declaration = `local ${localInfos.map(info => info.display).join("\x2C ")}`;\n        const assignment = `${names.join("\x2C ")} = ${pack.call}`;\n        if (markers.length !== 0) {\n            for (const info of localInfos) {\n                if (!info.ownerReg) continue;\n                ctx.pathLocalBindingNames.add(info.display);\n                env.set(pathLocalOwnerKey(ctx\x2C info.ownerReg)\x2C info.display);\n            }\n            effects = [...effects\x2C declaration\x2C assignment];\n        } else {\n            ctx.out.push(declaration);\n            for (const info of localInfos) {\n                if (!info.ownerReg) continue;\n                ctx.localNames.set(info.ownerReg\x2C info.display);\n                ctx.locals.add(info.ownerReg);\n                if (info.terminalLive) ctx.terminalLiveLocals.add(info.ownerReg);\n            }\n            ctx.out.push(assignment);\n        }\n    }\n\n    for (const [reg\x2C value] of [...env.entries()]) {\n        if (structuredPackId(ctx\x2C value) === packId) {\n            env.delete(reg);\n            continue;\n        }\n        const meta = structuredPackSlot(ctx\x2C value);\n        if (!meta || meta.packId !== packId) continue;\n        const info = pack.slots.get(meta.slot);\n        if (!info?.display) return null;\n        env.set(reg\x2C info.display);\n    }\n    for (const info of slots) {\n        if (!info.ownerReg) continue;\n        const current = structuredPackSlot(ctx\x2C env.get(info.ownerReg));\n        if (current?.packId === packId && current.slot === info.slot) env.set(info.ownerReg\x2C info.display);\n    }\n    pack.emitted = true;\n    return effects;\n}\n\nfunction flushReadyStructuredPacks(ctx\x2C env\x2C markers\x2C effects\x2C requireAll = false) {\n    for (const [packId\x2C pack] of ctx.structuredPacks) {\n        if (pack.emitted) continue;\n        const present = [...env.values()].some(value => structuredPackId(ctx\x2C value) === packId || structuredPackSlot(ctx\x2C value)?.packId === packId);\n        if (!present) continue;\n        const ready = pack.expectedSlots.every(slot => {\n            const info = pack.slots.get(slot);\n            return info && !info.ambiguous && !!(info.ownerReg || info.ownerCaptured || info.ownerTemporary);\n        });\n        if (!ready) { if (requireAll) return null; continue; }\n        effects = flushStructuredPack(ctx\x2C packId\x2C env\x2C markers\x2C effects);\n        if (effects === null) return null;\n    }\n    return effects;\n}\n\nmodule.exports = { isCompilerVarargPack\x2C isCompilerVarargSelect\x2C isVarargUnpack\x2C expectedPackSlotsInBlock\x2C isForwardOnlyPackUseInBlock\x2C cleanupOrTerminalEpoch\x2C maybeOwnStructuredPackSlot\x2C preclaimFutureStructuredPackOwner\x2C preclaimFutureStructuredPackSlots\x2C flushStructuredPack\x2C flushReadyStructuredPacks };\n
