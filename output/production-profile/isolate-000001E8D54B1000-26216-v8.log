script-source,94,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\text-edits.js,function editReplacement(edit) {\n    if (Object.prototype.hasOwnProperty.call(edit\x2C "replacement")) return String(edit.replacement);\n    if (Object.prototype.hasOwnProperty.call(edit\x2C "text")) return String(edit.text);\n    return "";\n}\n\nfunction applyTextEdits(source\x2C edits\x2C baseOffset = 0) {\n    if (!edits || edits.length === 0) return source;\n    const endOffset = baseOffset + source.length;\n    const ordered = [];\n    for (const edit of edits) {\n        if (!Number.isInteger(edit?.start) || !Number.isInteger(edit?.end)) continue;\n        if (edit.start < baseOffset || edit.end > endOffset || edit.end < edit.start) continue;\n        ordered.push(edit);\n    }\n    if (ordered.length === 0) return source;\n    ordered.sort((a\x2C b) => a.start - b.start || a.end - b.end);\n\n    const chunks = [];\n    let cursor = 0;\n    for (const edit of ordered) {\n        const start = edit.start - baseOffset;\n        const end = edit.end - baseOffset;\n        if (start < cursor) throw new Error("Overlapping source edits are not safe to apply");\n        chunks.push(source.slice(cursor\x2C start)\x2C editReplacement(edit));\n        cursor = end;\n    }\n    chunks.push(source.slice(cursor));\n    return chunks.join("");\n}\n\nmodule.exports = {\n    applyTextEdits\x2C\n};
