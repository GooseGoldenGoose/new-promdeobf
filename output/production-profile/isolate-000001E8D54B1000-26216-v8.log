script-source,95,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\vm-register-names.js,\ufeffconst { findVmFunction } = require("./vm-state");\x0d\nconst { applyTextEdits } = require("./text-edits");\x0d\n\x0d\nfunction isNode(value) {\x0d\n    return value && typeof value === "object" && typeof value.type === "string";\x0d\n}\x0d\n\x0d\nfunction isIdentifier(node\x2C name = null) {\x0d\n    return node?.type === "Identifier" && (name === null || node.name === name);\x0d\n}\x0d\n\x0d\nfunction findVmReturnRegister(vmFunction) {\x0d\n    const body = vmFunction?.body || [];\x0d\n    if (body.length === 0) return null;\x0d\n    const statement = body[body.length - 1];\x0d\n    if (statement?.type !== "ReturnStatement") return null;\x0d\n    const values = statement.arguments || [];\x0d\n    if (values.length !== 1 || values[0]?.type !== "CallExpression") return null;\x0d\n    const call = values[0];\x0d\n    const args = call.arguments || [];\x0d\n    if (!isIdentifier(call.base\x2C "unpack") || args.length !== 1 || !isIdentifier(args[0])) return null;\x0d\n    return { statement\x2C call\x2C identifier: args[0]\x2C name: args[0].name };\x0d\n}\x0d\n\x0d\nfunction findRegisterDeclaration(vmFunction\x2C returnName) {\x0d\n    const matches = [];\x0d\n    const body = vmFunction?.body || [];\x0d\n    for (let index = 0; index < body.length; index++) {\x0d\n        const statement = body[index];\x0d\n        if (statement?.type !== "LocalStatement") continue;\x0d\n        if ((statement.init || []).length !== 0) continue;\x0d\n        const variables = statement.variables || [];\x0d\n        if (!variables.length || !variables.every(variable => isIdentifier(variable))) continue;\x0d\n        if (!variables.some(variable => variable.name === returnName)) continue;\x0d\n        matches.push({ statement\x2C index\x2C variables });\x0d\n    }\x0d\n    return matches.length === 1 ? matches[0] : null;\x0d\n}\x0d\n\x0d\nfunction numericValue(node) {\x0d\n    if (node?.type !== "NumericLiteral") return null;\x0d\n    const value = typeof node.value === "number" ? node.value : Number(node.raw);\x0d\n    return Number.isInteger(value) ? value : null;\x0d\n}\x0d\n\x0d\nfunction isEmptyTable(node) {\x0d\n    return node?.type === "TableConstructorExpression" && (node.fields || []).length === 0;\x0d\n}\x0d\n\x0d\nfunction findRegisterOverflowBinding(vmFunction) {\x0d\n    const returnRegister = findVmReturnRegister(vmFunction);\x0d\n    if (!returnRegister) return null;\x0d\n    const scalarDeclaration = findRegisterDeclaration(vmFunction\x2C returnRegister.name);\x0d\n    if (!scalarDeclaration) return null;\x0d\n\x0d\n    const body = vmFunction?.body || [];\x0d\n    const candidates = [];\x0d\n    for (let index = 0; index < scalarDeclaration.index; index++) {\x0d\n        const statement = body[index];\x0d\n        if (statement?.type !== "LocalStatement") continue;\x0d\n        if ((statement.variables || []).length !== 1 || !isIdentifier(statement.variables[0])) continue;\x0d\n        if ((statement.init || []).length !== 1 || !isEmptyTable(statement.init[0])) continue;\x0d\n        candidates.push({ statement\x2C identifier: statement.variables[0]\x2C index });\x0d\n    }\x0d\n    if (candidates.length !== 1) return null;\x0d\n\x0d\n    const candidate = candidates[0];\x0d\n    const name = candidate.identifier.name;\x0d\n    const candidateNames = new Set([name]);\x0d\n    if (hasShadowingDeclaration(vmFunction\x2C candidateNames\x2C candidate.statement)) return null;\x0d\n\x0d\n    const indices = new Set();\x0d\n    let valid = true;\x0d\n    let referenceCount = 0;\x0d\n    function walk(node\x2C parent = null\x2C parentKey = null) {\x0d\n        if (!isNode(node) || !valid) return;\x0d\n        if (node.type === "Identifier" && node.name === name && node !== candidate.identifier) {\x0d\n            referenceCount++;\x0d\n            if (parent?.type !== "IndexExpression" || parentKey !== "base" || parent.base !== node) {\x0d\n                valid = false;\x0d\n                return;\x0d\n            }\x0d\n            const index = numericValue(parent.index);\x0d\n            if (index === null || index < 1) {\x0d\n                valid = false;\x0d\n                return;\x0d\n            }\x0d\n            indices.add(index);\x0d\n            return;\x0d\n        }\x0d\n        for (const key of Object.keys(node)) {\x0d\n            const value = node[key];\x0d\n            if (key === "loc" || key === "range") continue;\x0d\n            if (Array.isArray(value)) {\x0d\n                for (const child of value) walk(child\x2C node\x2C key);\x0d\n            } else if (isNode(value)) {\x0d\n                walk(value\x2C node\x2C key);\x0d\n            }\x0d\n        }\x0d\n    }\x0d\n    for (let index = candidate.index + 1; index < body.length; index++) walk(body[index]);\x0d\n    if (!valid || referenceCount === 0 || indices.size === 0) return null;\x0d\n\x0d\n    return {\x0d\n        name\x2C\x0d\n        declaration: candidate.statement\x2C\x0d\n        identifier: candidate.identifier\x2C\x0d\n        scalarDeclaration\x2C\x0d\n        indices\x2C\x0d\n        maxIndex: Math.max(...indices)\x2C\x0d\n        referenceCount\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nfunction hasShadowingDeclaration(node\x2C candidateNames\x2C candidateDeclaration) {\x0d\n    if (!isNode(node)) return false;\x0d\n    if (node !== candidateDeclaration) {\x0d\n        if (node.type === "LocalStatement") {\x0d\n            for (const variable of node.variables || []) {\x0d\n                if (isIdentifier(variable) && candidateNames.has(variable.name)) return true;\x0d\n            }\x0d\n        }\x0d\n        if (node.type === "FunctionDeclaration") {\x0d\n            for (const parameter of node.parameters || []) {\x0d\n                if (isIdentifier(parameter) && candidateNames.has(parameter.name)) return true;\x0d\n            }\x0d\n            if (node.isLocal && isIdentifier(node.identifier) && candidateNames.has(node.identifier.name)) return true;\x0d\n        }\x0d\n        if (node.type === "ForNumericStatement" && isIdentifier(node.variable) && candidateNames.has(node.variable.name)) return true;\x0d\n        if (node.type === "ForGenericStatement") {\x0d\n            for (const variable of node.variables || []) {\x0d\n                if (isIdentifier(variable) && candidateNames.has(variable.name)) return true;\x0d\n            }\x0d\n        }\x0d\n    }\x0d\n    for (const key of Object.keys(node)) {\x0d\n        const value = node[key];\x0d\n        if (key === "loc" || key === "range") continue;\x0d\n        if (Array.isArray(value)) {\x0d\n            for (const child of value) if (hasShadowingDeclaration(child\x2C candidateNames\x2C candidateDeclaration)) return true;\x0d\n        } else if (isNode(value) && hasShadowingDeclaration(value\x2C candidateNames\x2C candidateDeclaration)) {\x0d\n            return true;\x0d\n        }\x0d\n    }\x0d\n    return false;\x0d\n}\x0d\n\x0d\nfunction analyzeRegisterNamingScope(node\x2C candidateNames\x2C candidateDeclaration\x2C shadows = []\x2C reservedNames = new Set()\x2C parent = null\x2C parentKey = null) {\x0d\n    if (!isNode(node)) return { shadows\x2C reservedNames };\x0d\n\x0d\n    if (node.type === "Identifier") {\x0d\n        const isProperty =\x0d\n            (parent?.type === "MemberExpression" && parentKey === "identifier") ||\x0d\n            (parent?.type === "TableKeyString" && parentKey === "key");\x0d\n        if (!isProperty && !candidateNames.has(node.name)) reservedNames.add(node.name);\x0d\n        return { shadows\x2C reservedNames };\x0d\n    }\x0d\n\x0d\n    if (node !== candidateDeclaration) {\x0d\n        if (node.type === "LocalStatement") {\x0d\n            for (const variable of node.variables || []) {\x0d\n                if (isIdentifier(variable) && candidateNames.has(variable.name)) shadows.push({ kind: "local"\x2C name: variable.name\x2C node: variable });\x0d\n            }\x0d\n        }\x0d\n        if (node.type === "FunctionDeclaration") {\x0d\n            for (const parameter of node.parameters || []) {\x0d\n                if (isIdentifier(parameter) && candidateNames.has(parameter.name)) shadows.push({ kind: "parameter"\x2C name: parameter.name\x2C node: parameter });\x0d\n            }\x0d\n            if (node.isLocal && isIdentifier(node.identifier) && candidateNames.has(node.identifier.name)) {\x0d\n                shadows.push({ kind: "local-function"\x2C name: node.identifier.name\x2C node: node.identifier });\x0d\n            }\x0d\n        }\x0d\n        if (node.type === "ForNumericStatement" && isIdentifier(node.variable) && candidateNames.has(node.variable.name)) {\x0d\n            shadows.push({ kind: "for"\x2C name: node.variable.name\x2C node: node.variable });\x0d\n        }\x0d\n        if (node.type === "ForGenericStatement") {\x0d\n            for (const variable of node.variables || []) {\x0d\n                if (isIdentifier(variable) && candidateNames.has(variable.name)) shadows.push({ kind: "for"\x2C name: variable.name\x2C node: variable });\x0d\n            }\x0d\n        }\x0d\n    }\x0d\n\x0d\n    for (const key of Object.keys(node)) {\x0d\n        const value = node[key];\x0d\n        if (key === "loc" || key === "range") continue;\x0d\n        if (Array.isArray(value)) {\x0d\n            for (const child of value) analyzeRegisterNamingScope(child\x2C candidateNames\x2C candidateDeclaration\x2C shadows\x2C reservedNames\x2C node\x2C key);\x0d\n        } else if (isNode(value)) {\x0d\n            analyzeRegisterNamingScope(value\x2C candidateNames\x2C candidateDeclaration\x2C shadows\x2C reservedNames\x2C node\x2C key);\x0d\n        }\x0d\n    }\x0d\n    return { shadows\x2C reservedNames };\x0d\n}\x0d\n\x0d\nfunction collectRenameEdits(node\x2C mapping\x2C minOffset\x2C out = []\x2C parent = null\x2C parentKey = null) {\x0d\n    if (!isNode(node)) return out;\x0d\n    if (node.type === "Identifier") {\x0d\n        if (!Array.isArray(node.range) || node.range[0] < minOffset) return out;\x0d\n        const isProperty =\x0d\n            (parent?.type === "MemberExpression" && parentKey === "identifier") ||\x0d\n            (parent?.type === "TableKeyString" && parentKey === "key");\x0d\n        if (!isProperty && mapping.has(node.name)) {\x0d\n            out.push({\x0d\n                start: node.range[0]\x2C\x0d\n                end: node.range[1]\x2C\x0d\n                replacement: mapping.get(node.name)\x2C\x0d\n                oldName: node.name\x2C\x0d\n            });\x0d\n        }\x0d\n        return out;\x0d\n    }\x0d\n\x0d\n    for (const key of Object.keys(node)) {\x0d\n        const value = node[key];\x0d\n        if (key === "loc" || key === "range") continue;\x0d\n        if (Array.isArray(value)) {\x0d\n            for (const child of value) collectRenameEdits(child\x2C mapping\x2C minOffset\x2C out\x2C node\x2C key);\x0d\n        } else if (isNode(value)) {\x0d\n            collectRenameEdits(value\x2C mapping\x2C minOffset\x2C out\x2C node\x2C key);\x0d\n        }\x0d\n    }\x0d\n    return out;\x0d\n}\x0d\n\x0d\nfunction renameVmRegisterBindings(source\x2C ast) {\x0d\n    const vm = findVmFunction(ast);\x0d\n    if (!vm) {\x0d\n        return { source\x2C found: false\x2C applied: false\x2C reason: "No semantically named vm function was found"\x2C mapping: [] };\x0d\n    }\x0d\n\x0d\n    const vmFunction = vm.functionNode;\x0d\n    const returnRegister = findVmReturnRegister(vmFunction);\x0d\n    if (!returnRegister) {\x0d\n        return { source\x2C found: true\x2C applied: false\x2C reason: "VM does not end with return unpack(<register>)"\x2C mapping: [] };\x0d\n    }\x0d\n\x0d\n    const declaration = findRegisterDeclaration(vmFunction\x2C returnRegister.name);\x0d\n    if (!declaration) {\x0d\n        return { source\x2C found: true\x2C applied: false\x2C reason: "Could not uniquely identify the scalar VM register declaration"\x2C mapping: [] };\x0d\n    }\x0d\n\x0d\n    const candidateNames = new Set(declaration.variables.map(variable => variable.name));\x0d\n    if (candidateNames.size !== declaration.variables.length) {\x0d\n        return { source\x2C found: true\x2C applied: false\x2C reason: "VM register declaration contains duplicate names"\x2C mapping: [] };\x0d\n    }\x0d\n\x0d\n    const namingScope = analyzeRegisterNamingScope(vmFunction\x2C candidateNames\x2C declaration.statement);\x0d\n    const shadows = namingScope.shadows;\x0d\n    if (shadows.length > 0) {\x0d\n        return {\x0d\n            source\x2C\x0d\n            found: true\x2C\x0d\n            applied: false\x2C\x0d\n            reason: `VM register binding ${shadows[0].name} is shadowed by a nested ${shadows[0].kind} declaration`\x2C\x0d\n            mapping: []\x2C\x0d\n        };\x0d\n    }\x0d\n\x0d\n    const reservedNames = namingScope.reservedNames;\x0d\n    if (reservedNames.has("ReturnVal") && returnRegister.name !== "ReturnVal") {\x0d\n        return { source\x2C found: true\x2C applied: false\x2C reason: "ReturnVal collides with another VM-scope identifier"\x2C mapping: [] };\x0d\n    }\x0d\n    if (candidateNames.has("ReturnVal") && returnRegister.name !== "ReturnVal") {\x0d\n        return { source\x2C found: true\x2C applied: false\x2C reason: "ReturnVal is already used by a different VM register"\x2C mapping: [] };\x0d\n    }\x0d\n\x0d\n    const mapping = new Map();\x0d\n    mapping.set(returnRegister.name\x2C "ReturnVal");\x0d\n\x0d\n    let nextRegisterNumber = 1;\x0d\n    for (const variable of declaration.variables) {\x0d\n        if (variable.name === returnRegister.name) continue;\x0d\n        let replacement;\x0d\n        do {\x0d\n            replacement = `r${nextRegisterNumber++}`;\x0d\n        } while (reservedNames.has(replacement) || (candidateNames.has(replacement) && replacement !== variable.name));\x0d\n        mapping.set(variable.name\x2C replacement);\x0d\n    }\x0d\n\x0d\n    const edits = collectRenameEdits(vmFunction\x2C mapping\x2C declaration.statement.range[0]\x2C []);\x0d\n    if (edits.length === 0) {\x0d\n        return { source\x2C found: true\x2C applied: false\x2C reason: "No VM register rename edits were produced"\x2C mapping: [] };\x0d\n    }\x0d\n\x0d\n    const counts = new Map();\x0d\n    for (const edit of edits) counts.set(edit.oldName\x2C (counts.get(edit.oldName) || 0) + 1);\x0d\n    for (const oldName of mapping.keys()) {\x0d\n        if (!counts.has(oldName)) {\x0d\n            return { source\x2C found: true\x2C applied: false\x2C reason: `VM register ${oldName} had no renameable occurrences`\x2C mapping: [] };\x0d\n        }\x0d\n    }\x0d\n\x0d\n    const output = applyTextEdits(source\x2C edits);\x0d\n    const mappingList = declaration.variables.map(variable => ({\x0d\n        oldName: variable.name\x2C\x0d\n        newName: mapping.get(variable.name)\x2C\x0d\n        kind: variable.name === returnRegister.name ? "return" : "register"\x2C\x0d\n        referencesRenamed: counts.get(variable.name) || 0\x2C\x0d\n    }));\x0d\n\x0d\n    return {\x0d\n        source: output\x2C\x0d\n        found: true\x2C\x0d\n        applied: output !== source\x2C\x0d\n        returnRegisterOldName: returnRegister.name\x2C\x0d\n        returnRegisterName: "ReturnVal"\x2C\x0d\n        registerCount: declaration.variables.length\x2C\x0d\n        temporaryRegisterCount: declaration.variables.length - 1\x2C\x0d\n        mapping: mappingList\x2C\x0d\n        edits\x2C\x0d\n    };\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n    findVmReturnRegister\x2C\x0d\n    findRegisterDeclaration\x2C\x0d\n    findRegisterOverflowBinding\x2C\x0d\n    renameVmRegisterBindings\x2C\x0d\n};\x0d\n
