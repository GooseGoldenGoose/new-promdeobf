script-source,99,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\logical.js,"use strict";\n\nconst { isIdentifier\x2C isPrimitiveLiteral\x2C isSingleAssignment } = require("./ast");\nconst { decodeLogicalStateTransition } = require("./normalize");\nconst { canReach: graphCanReach\x2C createStateGraph\x2C reachableFrom\x2C transitionOfBody } = require("./cfg");\n\nfunction statementWritesIdentifier(statement\x2C name) {\n    if (!statement || typeof statement !== "object") return false;\n    if (Array.isArray(statement.variables) && statement.variables.some(variable => isIdentifier(variable\x2C name))) return true;\n    return isIdentifier(statement.variable\x2C name);\n}\n\nfunction hasInterveningWrite(body\x2C fromIndex\x2C toIndex\x2C name) {\n    for (let i = fromIndex + 1; i < toIndex; i++) {\n        if (statementWritesIdentifier(body[i]\x2C name)) return true;\n    }\n    return false;\n}\n\nfunction compilerSingleCallPackDefinitionBefore(body\x2C beforeIndex\x2C packReg) {\n    for (let i = beforeIndex - 1; i >= 0; i--) {\n        if (!isSingleAssignment(body[i])) continue;\n        const dest = body[i].variables[0];\n        if (!isIdentifier(dest\x2C packReg)) continue;\n        const rhs = body[i].init[0];\n        const fields = rhs?.type === "TableConstructorExpression" ? (rhs.fields || []) : [];\n        return fields.length === 1 && fields[0]?.type === "TableValue" &&\n            fields[0].value?.type === "CallExpression" &&\n            !hasInterveningWrite(body\x2C i\x2C beforeIndex\x2C packReg);\n    }\n    return false;\n}\n\nfunction findPrimaryLogicalResultAssignment(body\x2C transition\x2C stateName\x2C returnName) {\n    for (let i = body.length - 1; i >= 0; i--) {\n        if (i === transition.index || !isSingleAssignment(body[i])) continue;\n        const dest = body[i].variables[0];\n        const rhs = body[i].init[0];\n        if (!isIdentifier(dest) || dest.name === stateName) continue;\n\n        if (isIdentifier(rhs\x2C transition.conditionRegister) &&\n            !hasInterveningWrite(body\x2C i\x2C transition.index\x2C transition.conditionRegister)) {\n            return { index: i\x2C resultReg: dest.name };\n        }\n\n        // A compiler multi-return pack may feed the branch condition directly\n        // from slot 1\x2C with later slots scheduled after the state transition.\n        // Accept only a proven single-call pack definition so arbitrary source\n        // table indexing cannot be mistaken for TESTSET/logical transport.\n        if (i < transition.index && dest.name === transition.conditionRegister &&\n            rhs?.type === "IndexExpression" && isIdentifier(rhs.base) &&\n            rhs.index?.type === "NumericLiteral" && Number(rhs.index.value) === 1 &&\n            compilerSingleCallPackDefinitionBefore(body\x2C i\x2C rhs.base.name) &&\n            !hasInterveningWrite(body\x2C i\x2C transition.index\x2C dest.name)) {\n            return { index: i\x2C resultReg: dest.name };\n        }\n\n        if (dest.name !== transition.conditionRegister || !isIdentifier(rhs) ||\n            (rhs.name !== stateName && rhs.name !== returnName) ||\n            hasInterveningWrite(body\x2C i\x2C transition.index\x2C dest.name)) continue;\n\n        let specialDefinitionIndex = -1;\n        for (let probe = i - 1; probe >= 0; probe--) {\n            if (!isSingleAssignment(body[probe])) continue;\n            const priorDest = body[probe].variables[0];\n            if (!isIdentifier(priorDest\x2C rhs.name)) continue;\n            specialDefinitionIndex = probe;\n            break;\n        }\n        if (specialDefinitionIndex < 0 || hasInterveningWrite(body\x2C specialDefinitionIndex\x2C i\x2C rhs.name)) continue;\n        return { index: i\x2C resultReg: dest.name };\n    }\n    return null;\n}\nfunction canReachWithoutReentering(graph\x2C start\x2C target\x2C blockedId) {\n    if (!graph?.successors || start === blockedId) return false;\n    const seen = new Set([start]);\n    const work = [start];\n    while (work.length) {\n        const id = work.pop();\n        for (const next of graph.successors.get(id) || []) {\n            if (next === target) return true;\n            if (next === blockedId || seen.has(next)) continue;\n            seen.add(next);\n            work.push(next);\n        }\n    }\n    return false;\n}\n\nfunction flattenLogicalRootLeaf(leaves\x2C entryId\x2C stateName\x2C returnName\x2C diagnostics = null\x2C options = {}) {\n    const graph = createStateGraph(leaves\x2C entryId\x2C stateName\x2C {\n        strictTargets: false\x2C\n        reachableOnly: options.reachableOnly === true\x2C\n    });\n    if (!graph) return null;\n    let currentForDiagnostics = entryId;\n    function fail(reason\x2C state = currentForDiagnostics) {\n        if (diagnostics && !diagnostics.reason) { diagnostics.reason = reason; diagnostics.state = state; }\n        return null;\n    }\n    const consumed = new Set();\n    const out = [];\n\n    function findTransition(body) {\n        return transitionOfBody(body\x2C stateName);\n    }\n\n    function successorsOf(id) {\n        return graph.successors.get(id) || [];\n    }\n\n    function canReach(start\x2C target) {\n        return graphCanReach(graph\x2C start\x2C target);\n    }\n\n    function mergeDeps(into\x2C from) {\n        for (const dep of from || []) into.add(dep);\n    }\n\n    function resolvePathNode(node\x2C env) {\n        if (!node || typeof node !== "object") return null;\n        if (isIdentifier(node)) {\n            const known = env.get(node.name);\n            return known ? { node: known.node\x2C deps: new Set(known.deps) } : { node\x2C deps: new Set() };\n        }\n        if (isPrimitiveLiteral(node)) return { node\x2C deps: new Set() };\n        if (node.type === "UnaryExpression") {\n            const argument = resolvePathNode(node.argument\x2C env);\n            if (!argument) return null;\n            return { node: { ...node\x2C argument: argument.node }\x2C deps: argument.deps };\n        }\n        if (node.type === "BinaryExpression" || node.type === "LogicalExpression") {\n            const left = resolvePathNode(node.left\x2C env);\n            const right = resolvePathNode(node.right\x2C env);\n            if (!left || !right) return null;\n            const deps = new Set(left.deps); mergeDeps(deps\x2C right.deps);\n            return { node: { ...node\x2C left: left.node\x2C right: right.node }\x2C deps };\n        }\n        if (node.type === "IndexExpression") {\n            const base = resolvePathNode(node.base\x2C env);\n            const index = resolvePathNode(node.index\x2C env);\n            if (!base || !index) return null;\n            const deps = new Set(base.deps); mergeDeps(deps\x2C index.deps);\n            return { node: { ...node\x2C base: base.node\x2C index: index.node }\x2C deps };\n        }\n        if (node.type === "CallExpression") {\n            const base = resolvePathNode(node.base\x2C env);\n            if (!base) return null;\n            const args = [];\n            const deps = new Set(base.deps);\n            for (const arg of node.arguments || []) {\n                const resolved = resolvePathNode(arg\x2C env);\n                if (!resolved) return null;\n                args.push(resolved.node);\n                mergeDeps(deps\x2C resolved.deps);\n            }\n            return { node: { ...node\x2C base: base.node\x2C arguments: args }\x2C deps };\n        }\n        if (node.type === "TableConstructorExpression") {\n            const fields = [];\n            const deps = new Set();\n            for (const field of node.fields || []) {\n                if (field?.type === "TableValue") {\n                    const value = resolvePathNode(field.value\x2C env);\n                    if (!value) return null;\n                    fields.push({ ...field\x2C value: value.node }); mergeDeps(deps\x2C value.deps); continue;\n                }\n                if (field?.type === "TableKey") {\n                    const key = resolvePathNode(field.key\x2C env);\n                    const value = resolvePathNode(field.value\x2C env);\n                    if (!key || !value) return null;\n                    fields.push({ ...field\x2C key: key.node\x2C value: value.node });\n                    mergeDeps(deps\x2C key.deps); mergeDeps(deps\x2C value.deps); continue;\n                }\n                if (field?.type === "TableKeyString") {\n                    const value = resolvePathNode(field.value\x2C env);\n                    if (!value) return null;\n                    fields.push({ ...field\x2C value: value.node }); mergeDeps(deps\x2C value.deps); continue;\n                }\n                return null;\n            }\n            return { node: { ...node\x2C fields }\x2C deps };\n        }\n        return null;\n    }\n\n    function resolvePathResult(statements\x2C resultReg) {\n        const env = new Map();\n        const defs = [];\n        for (let i = 0; i < statements.length; i++) {\n            const statement = statements[i];\n            if (!isSingleAssignment(statement)) return null;\n            const dest = statement.variables[0];\n            const rhs = statement.init[0];\n            if (!isIdentifier(dest)) return null;\n            const resolved = resolvePathNode(rhs\x2C env);\n            if (!resolved) return null;\n            const deps = new Set(resolved.deps);\n            deps.add(i);\n            env.set(dest.name\x2C { node: resolved.node\x2C deps });\n            defs.push({ index: i\x2C dest: dest.name\x2C rhs });\n        }\n        const result = env.get(resultReg);\n        if (!result) return null;\n        for (const def of defs) {\n            if (result.deps.has(def.index)) continue;\n            if (def.dest === stateName || isIdentifier(def.rhs\x2C stateName)) continue;\n            return null;\n        }\n        return result.node;\n    }\n\n    function nodeReadsName(node\x2C name) {\n        if (!node || typeof node !== "object") return false;\n        if (isIdentifier(node\x2C name)) return true;\n        for (const [key\x2C value] of Object.entries(node)) {\n            if (key === "range" || key === "loc" || key === "variables") continue;\n            if (Array.isArray(value)) {\n                if (value.some(item => nodeReadsName(item\x2C name))) return true;\n            } else if (value && typeof value === "object" && nodeReadsName(value\x2C name)) return true;\n        }\n        return false;\n    }\n\n    function valueReadBeforeOverwriteInBody(body\x2C name) {\n        for (const statement of body || []) {\n            if (!isSingleAssignment(statement)) return true;\n            const dest = statement.variables[0];\n            const rhs = statement.init[0];\n            if (nodeReadsName(rhs\x2C name) || (dest?.type === "IndexExpression" && nodeReadsName(dest\x2C name))) return true;\n            if (isIdentifier(dest\x2C name)) return false;\n        }\n        return false;\n    }\n    function flattenPath(startId\x2C stopId\x2C targetOut) {\n        let current = startId;\n        while (stopId == null || current !== stopId) {\n            currentForDiagnostics = current;\n            if (consumed.has(current)) return fail("root revisits an already-consumed state"\x2C current);\n            const body = leaves.get(current);\n            if (!body) return fail("root references a missing state leaf"\x2C current);\n            const transition = findTransition(body);\n            if (!transition) return fail("root state has no recognized terminal state transition"\x2C current);\n\n            if (transition.kind === "branch") {\n                const primary = findPrimaryLogicalResultAssignment(body\x2C transition\x2C stateName\x2C returnName);\n                if (!primary) return fail("logical branch has no compiler result copy"\x2C current);\n                const trueReachesFalse = canReachWithoutReentering(graph\x2C transition.onTrue\x2C transition.onFalse\x2C current);\n                const falseReachesTrue = canReachWithoutReentering(graph\x2C transition.onFalse\x2C transition.onTrue\x2C current);\n                if (trueReachesFalse === falseReachesTrue) return fail("logical branch successors do not form a proven lazy-RHS/join pair"\x2C current);\n\n                const operator = trueReachesFalse ? "and" : "or";\n                const rhsStart = trueReachesFalse ? transition.onTrue : transition.onFalse;\n                const joinId = trueReachesFalse ? transition.onFalse : transition.onTrue;\n                if (stopId != null && joinId !== stopId && !canReach(joinId\x2C stopId)) {\n                    return fail("nested logical join escapes its enclosing lazy path"\x2C current);\n                }\n\n                const rhsStatements = [];\n                if (!flattenPath(rhsStart\x2C joinId\x2C rhsStatements)) return null;\n                const fallback = resolvePathResult(rhsStatements\x2C primary.resultReg);\n                if (!fallback) return fail("logical lazy RHS does not reduce to the compiler result register"\x2C current);\n                const joinBody = leaves.get(joinId);\n                const rhsWritten = new Set();\n                for (const statement of rhsStatements) {\n                    if (!isSingleAssignment(statement)) return fail("logical lazy RHS contains a non-assignment statement"\x2C current);\n                    const dest = statement.variables[0];\n                    if (isIdentifier(dest)) rhsWritten.add(dest.name);\n                }\n                for (const name of rhsWritten) {\n                    if (name === primary.resultReg || name === stateName) continue;\n                    if (valueReadBeforeOverwriteInBody(joinBody\x2C name)) {\n                        return fail("logical lazy RHS leaves a path-dependent temporary live at the join"\x2C current);\n                    }\n             