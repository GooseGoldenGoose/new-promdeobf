script-source,129,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\diagnostics.js,"use strict";\n\nfunction failure(reason) {\n    return { applied: false\x2C reason\x2C mode: "fresh" };\n}\n\nfunction unsupported(name) {\n    return function () {\n        return { applied: false\x2C reason: `Fresh beta CF solver: ${name} is not implemented yet` };\n    };\n}\n\nfunction unsupportedMultiState(count\x2C diagnostics = {}) {\n    const detail = diagnostics.reason ? `; closure recovery: ${diagnostics.reason}` : "";\n    const stateDetail = diagnostics.state != null ? ` at state ${diagnostics.state}` : "";\n    const statementDetail = diagnostics.statementIndex != null\n        ? `; root statement ${diagnostics.statementIndex}: ${String(diagnostics.statement || "unknown").replace(/\\s+/g\x2C " ").slice(0\x2C 180)}`\n        : "";\n    const unconsumed = Array.isArray(diagnostics.unconsumed) && diagnostics.unconsumed.length\n        ? `; unconsumed states: ${diagnostics.unconsumed.join("\x2C")}`\n        : "";\n    return failure(`Fresh beta CF: unsupported multi-state control flow (${count} normalized states)${detail}${stateDetail}${statementDetail}${unconsumed}`);\n}\n\nmodule.exports = { failure\x2C unsupported\x2C unsupportedMultiState };\n
