script-source,112,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\passes\\beta-cf\\structured\\solver.js,"use strict";\x0d\n\x0d\nconst { createStructuredContext } = require("./context");\x0d\nconst { isEmptyTable\x2C isIdentifier\x2C isPrimitiveLiteral\x2C isSingleAssignment\x2C isVmRegisterName\x2C renderTableFields\x2C renderUnary\x2C sourceOf } = require("../ast");\x0d\nconst { hasLinearRootContinuation\x2C recordRootConditional\x2C upvalueAliasKey\x2C pathLocalOwnerKey\x2C deadJoinTempKey\x2C pathUpvalueCellKey\x2C hasPathUpvalueCell\x2C allocateUpvalueCellIdentity\x2C upvalueCellIdentity\x2C bindUpvalueCellIdentity\x2C upvalueCellBinding\x2C deferredClosureValue\x2C isDeferredClosureValue\x2C pendingDeferredLocalValue\x2C isPendingDeferredLocalValue\x2C renderDeferredClosureValue\x2C allocateValueDisplay\x2C allocateTableDisplay\x2C parameterName\x2C capturedSlotName\x2C forwardedCaptureName\x2C displayLocal\x2C activeLocalDisplay\x2C hasActiveLocal\x2C resolveId\x2C resolveRenderableId } = require("./bindings");\x0d\nconst { structuredPackId\x2C structuredPackSlot\x2C structuredPackSlotToken } = require("./tokens");\x0d\nconst { isCompilerVarargPack\x2C isVarargUnpack\x2C expectedPackSlotsInBlock\x2C isForwardOnlyPackUseInBlock\x2C cleanupOrTerminalEpoch\x2C maybeOwnStructuredPackSlot\x2C preclaimFutureStructuredPackOwner\x2C preclaimFutureStructuredPackSlots\x2C flushStructuredPack\x2C flushReadyStructuredPacks } = require("./packs");\x0d\nconst { nodeReadsIdentifier\x2C nodeUsesAsCallBaseMulti\x2C terminalStableUsedEpoch\x2C transportSourceKind\x2C valueMayBeReadFrom\x2C eventualCleanupOnAllPaths\x2C valueMayBeReadAfter\x2C hasFutureNonNilWrite\x2C allReachingDefinitionsAreDeadNilCleanup\x2C conditionalUpdatedStorageEpoch\x2C provenCallArgumentSourceEpoch\x2C provenSingleUseCallResultAt\x2C valueMayBeIndexWriteBaseAfter\x2C analyzePersistentStorage } = require("./lifetime");\x0d\nconst { render } = require("./render");\x0d\nconst { renderFunction\x2C renderProgram } = require("../render");\x0d\nconst { decodeVmStatement\x2C callKind } = require("../statement-ir");\x0d\nconst { renderOrdinaryIndexWrite\x2C renderOrdinaryIndexCompoundWrite\x2C matchCompilerGlobalAssignmentBatch } = require("../statement-semantics");\x0d\nconst { mergeElseIfCandidates\x2C indentConditionalEffect\x2C mergeCandidates } = require("./branches");\x0d\nconst { markersSharePrefix\x2C terminalSiblingMatch\x2C guardLine\x2C foldTerminalRepeatScopes\x2C collapseTerminalCandidates\x2C foldTerminalGuards } = require("./terminal");\x0d\n\x0d\n\x0d\nfunction mutationBaseOwnerKey(name) { return "\\0freshMutationBaseOwner:" + name; }\x0d\n\x0d\nfunction sourcePackedTablePackReg(rhs\x2C singleCallPacks) {\x0d\n    if (rhs?.type !== "TableConstructorExpression" || !(singleCallPacks instanceof Map)) return null;\x0d\n    const fields = rhs.fields || [];\x0d\n    if (fields.length !== 1 || fields[0]?.type !== "TableValue") return null;\x0d\n    const call = fields[0].value;\x0d\n    if (call?.type !== "CallExpression" || !isIdentifier(call.base\x2C "unpack") || (call.arguments || []).length !== 1 || !isIdentifier(call.arguments[0])) return null;\x0d\n    return singleCallPacks.has(call.arguments[0].name) ? call.arguments[0].name : null;\x0d\n}\x0d\n\x0d\nfunction isRedundantReleasedUpvalueCleanup(ctx\x2C block\x2C index\x2C name) {\x0d\n    for (let probe = index - 1; probe >= 0; probe--) {\x0d\n        if (probe === block.transitionIndex) continue;\x0d\n        const statement = block.body[probe];\x0d\n        if (!isSingleAssignment(statement)) {\x0d\n            if (nodeReadsIdentifier(ctx\x2C statement\x2C name)) return false;\x0d\n            continue;\x0d\n        }\x0d\n        const dest = statement.variables[0];\x0d\n        const value = statement.init[0];\x0d\n        if (isIdentifier(dest\x2C name)) {\x0d\n            return value?.type === "CallExpression" && isIdentifier(value.base\x2C "releaseUpvalue") &&\x0d\n                (value.arguments || []).length === 1 && isIdentifier(value.arguments[0]\x2C name);\x0d\n        }\x0d\n        if (nodeReadsIdentifier(ctx\x2C value\x2C name) || (dest?.type === "IndexExpression" && nodeReadsIdentifier(ctx\x2C dest\x2C name))) return false;\x0d\n    }\x0d\n    return false;\x0d\n}\x0d\nfunction deferredClosureFromRhs(ctx\x2C rhs\x2C env\x2C rhsCallKind) {\x0d\n    if (rhsCallKind === "closure") return deferredClosureValue(ctx\x2C rhs\x2C env);\x0d\n    if (!isIdentifier(rhs)) return null;\x0d\n    const carried = resolveId(ctx\x2C rhs.name\x2C env);\x0d\n    return isDeferredClosureValue(carried) ? carried : null;\x0d\n}\x0d\n\x0d\nfunction sourceStorageStartsHere(ctx\x2C id\x2C index\x2C name\x2C markers) {\x0d\n    const epochEnd = cleanupOrTerminalEpoch(ctx\x2C id\x2C index\x2C name);\x0d\n    const cleanupBacked = ctx.allowConditionalIf && ctx.cleanupRegs.has(name) && !ctx.locals.has(name) &&\x0d\n        epochEnd.valid && epochEnd.sawCleanup;\x0d\n    const forcedStarts = ctx.options?.forcedPersistentStorageStarts;\x0d\n    const forcedRegs = ctx.options?.forcedPersistentStorageRegs;\x0d\n    const provenLoopPreheaderStart = forcedStarts instanceof Map && forcedStarts.get(name) instanceof Set &&\x0d\n        forcedStarts.get(name).has(id + ":" + index);\x0d\n    const isForcedLoopStorage = forcedRegs instanceof Set && forcedRegs.has(name);\x0d\n    const persistent = ctx.persistentStorageRegs.has(name) &&\x0d\n        (provenLoopPreheaderStart || (!isForcedLoopStorage && markers.length === 0));\x0d\n    return cleanupBacked || persistent;\x0d\n}\x0d\n\x0d\nfunction installPendingDeferredLocal(ctx\x2C env\x2C markers\x2C effects\x2C name\x2C initializer\x2C terminalLive = false) {\x0d\n    if (!isDeferredClosureValue(initializer) || hasActiveLocal(ctx\x2C name\x2C env)) return null;\x0d\n    const pathScoped = markers.length !== 0;\x0d\n    if (pathScoped && !ctx.allowConditionalIf) return null;\x0d\n    const pending = pendingDeferredLocalValue(initializer\x2C pathScoped);\x0d\n    if (!pending) return null;\x0d\n    if (pathScoped) {\x0d\n        env.set(pathLocalOwnerKey(ctx\x2C name)\x2C pending);\x0d\n    } else {\x0d\n        ctx.locals.add(name);\x0d\n        if (terminalLive) ctx.terminalLiveLocals.add(name);\x0d\n    }\x0d\n    env.set(name\x2C pending);\x0d\n    return effects;\x0d\n}\x0d\n\x0d\nfunction flushReadyPendingDeferredLocals(ctx\x2C env\x2C markers\x2C effects) {\x0d\n    let nextEffects = effects;\x0d\n    for (const [name\x2C pending] of [...env.entries()]) {\x0d\n        if (!isPendingDeferredLocalValue(pending)) continue;\x0d\n        const owned = pending.pathScoped\x0d\n            ? env.get(pathLocalOwnerKey(ctx\x2C name)) === pending\x0d\n            : ctx.locals.has(name);\x0d\n        if (!owned) continue;\x0d\n        const initializer = renderDeferredClosureValue(ctx\x2C pending.initializer\x2C env);\x0d\n        if (typeof initializer !== "string") continue;\x0d\n        const display = allocateValueDisplay(ctx);\x0d\n        const declaration = `local ${display} = ${initializer}`;\x0d\n        if (pending.pathScoped) {\x0d\n            ctx.pathLocalBindingNames.add(display);\x0d\n            env.set(pathLocalOwnerKey(ctx\x2C name)\x2C display);\x0d\n            nextEffects = [...nextEffects\x2C declaration];\x0d\n        } else {\x0d\n            ctx.localNames.set(name\x2C display);\x0d\n            ctx.out.push(declaration);\x0d\n        }\x0d\n        env.set(name\x2C display);\x0d\n    }\x0d\n    return nextEffects;\x0d\n}\x0d\n\x0d\nfunction collectClosedTerminalRegion(ctx\x2C startId\x2C forbiddenIds\x2C entryPredId = null) {\x0d\n    const region = new Set();\x0d\n    const visiting = new Set();\x0d\n    function visit(id) {\x0d\n        if (forbiddenIds.has(id) || !ctx.blocks.has(id)) return false;\x0d\n        if (region.has(id)) return true;\x0d\n        if (visiting.has(id)) return false;\x0d\n        visiting.add(id);\x0d\n        const block = ctx.blocks.get(id);\x0d\n        const tr = block?.transition;\x0d\n        let ok = tr?.kind === "stop";\x0d\n        if (!ok) {\x0d\n            const nextIds = ctx.successors.get(id) || [];\x0d\n            ok = nextIds.length > 0 && nextIds.every(visit);\x0d\n        }\x0d\n        visiting.delete(id);\x0d\n        if (!ok) return false;\x0d\n        region.add(id);\x0d\n        return true;\x0d\n    }\x0d\n    if (!visit(startId)) return null;\x0d\n    for (const id of region) {\x0d\n        for (const pred of ctx.predecessors.get(id) || []) {\x0d\n            if (region.has(pred) || (id === startId && (entryPredId === null || pred === entryPredId))) continue;\x0d\n            return null;\x0d\n        }\x0d\n    }\x0d\n    return region;\x0d\n}\x0d\n\x0d\nfunction loopTerminalSiblingRegion(ctx\x2C candidate\x2C currentId\x2C requireCurrentRegion = false) {\x0d\n    const bodyJoins = ctx.options?.loopBodyJoinIds;\x0d\n    const loopBranchIds = ctx.options?.loopBranchIds;\x0d\n    const markers = candidate?.markers || [];\x0d\n    if (!(bodyJoins instanceof Set) || !(loopBranchIds instanceof Set) || markers.length < 2) return null;\x0d\n    let loopMarker = null;\x0d\n    for (let i = markers.length - 1; i >= 0; i--) {\x0d\n        if (loopBranchIds.has(markers[i].branchId)) { loopMarker = markers[i]; break; }\x0d\n    }\x0d\n    if (!loopMarker || loopMarker.truth !== true) return null;\x0d\n    const loopBlock = ctx.blocks.get(loopMarker.branchId);\x0d\n    if (loopBlock?.transition?.kind !== "branch") return null;\x0d\n    const forbidden = new Set(bodyJoins);\x0d\n    forbidden.add(loopBlock.transition.onFalse);\x0d\n    if (requireCurrentRegion) return collectClosedTerminalRegion(ctx\x2C currentId\x2C forbidden);\x0d\n    for (let i = markers.length - 1; i >= 0; i--) {\x0d\n        const marker = markers[i];\x0d\n        if (loopBranchIds.has(marker.branchId)) break;\x0d\n        const branch = ctx.blocks.get(marker.branchId);\x0d\n        if (branch?.transition?.kind !== "branch") continue;\x0d\n        const siblingStart = marker.truth ? branch.transition.onFalse : branch.transition.onTrue;\x0d\n        const region = collectClosedTerminalRegion(ctx\x2C siblingStart\x2C forbidden\x2C marker.branchId);\x0d\n        if (region) return region;\x0d\n    }\x0d\n    return null;\x0d\n}\x0d\n\x0d\nfunction isClosedTerminalLoopSibling(ctx\x2C candidate\x2C currentId) {\x0d\n    return loopTerminalSiblingRegion(ctx\x2C candidate\x2C currentId\x2C true) instanceof Set;\x0d\n}\x0d\n\x0d\nfunction hasControlOnlyJumpPath(ctx\x2C startId\x2C targetId) {\x0d\n    if (!Number.isInteger(startId) || !Number.isInteger(targetId) || startId === targetId) return false;\x0d\n    const seen = new Set();\x0d\n    let id = startId;\x0d\n    while (id !== targetId) {\x0d\n        if (seen.has(id)) return false;\x0d\n        seen.add(id);\x0d\n        const block = ctx.blocks.get(id);\x0d\n        if (!block || block.transition?.kind !== "jump" || !Number.isInteger(block.transitionIndex)) return false;\x0d\n        for (let i = 0; i < block.body.length; i++) {\x0d\n            if (i !== block.transitionIndex) return false;\x0d\n        }\x0d\n        id = block.transition.target;\x0d\n    }\x0d\n    return true;\x0d\n}\x0d\n\x0d\nfunction ordinaryTerminalSiblingRegion(ctx\x2C candidate\x2C currentId) {\x0d\n    const markers = candidate?.markers || [];\x0d\n    const effects = candidate?.effects || [];\x0d\n    if (!markers.length || !Number.isInteger(currentId)) return null;\x0d\n    for (let i = markers.length - 1; i >= 0; i--) {\x0d\n        const marker = markers[i];\x0d\n        if (!marker || marker.kind != null || !Number.isInteger(marker.branchId) || marker.effectCount !== effects.length) continue;\x0d\n        const branch = ctx.blocks.get(marker.branchId);\x0d\n        if (branch?.transition?.kind !== "branch") continue;\x0d\n        const ownStart = marker.truth ? branch.transition.onTrue : branch.transition.onFalse;\x0d\n        if (!hasControlOnlyJumpPath(ctx\x2C ownStart\x2C currentId)) continue;\x0d\n        const siblingStart = marker.truth ? branch.transition.onFalse : branch.transition.onTrue;\x0d\n        const region = collectClosedTerminalRegion(ctx\x2C siblingStart\x2C new Set([currentId])\x2C marker.branchId);\x0d\n        if (region) return region;\x0d\n    }\x0d\n    return null;\x0d\n}\x0d\nfunction isLoopAbruptCandidate(candidate) {\x0d\n    const effects = candidate?.effects || [];\x0d\n    const tail = effects[effects.length - 1];\x0d\n    return tail === "break" || tail === "continue";\x0d\n}\x0d\n\x0d\nfunction collapseLoopAbruptPool(ctx\x2C pool) {\x0d\n    if (!Array.isArray(pool) || pool.length < 2) return true;\x0d\n    let changed = true;\x0d\n    while (changed) {\x0d\n        changed = false;\x0d\n        outer: for (let i = 0; i < pool.length; i++) {\x0d\n            if (!isLoopAbruptCandidate(pool[i])) continue;\x0d\n            for (let j = i + 1; j < pool.length; j++) {\x0d\n                if (!isLoopAbruptCandidate(pool[j])) continue;\x0d\n                const a = pool[i]\x2C b = pool[j];\x0d\n                const match = terminalSiblingMatch(ctx\x2C a\x2C b);\x0d\n                if (!match) continue;\x0d\n                const trueCandidate = match.al.truth ? a : b;\x0d\n                const falseCandidate = match.al.truth ? b : a;\x0d\n                const guard = guardLine(ctx\x2C match.al.condition\x2C true\x2C (trueCandidate.effects || []).slice(match.effectPrefix));\x0d\n                if (!guard) return false;\x0d\n                const merged = {\x0d\n                    env: new Map(falseCandidate.env)\x2C\x0d\n                    markers: (falseCandidate.markers || []).slice(0\x2C -1)\x2C\x0d\n                    effects: [\x0d\n                        ...(falseCandidate.effects || []).slice(0\x2C match.effectPrefix)\x2C\x0d\n                        guard\x2C\x0d\n                        ...(falseCandidate.effects || []).slice(match.effectPrefix)\x2C\x0d\n                    ]\x2C\x0d\n                };\x0d\n                pool.splice(j\x2C 1);\x0d\n                pool.splice(i\x2C 1\x2C merged);\x0d\n                changed = true;\x0d\n                break outer;\x0d\n            }\x0d\n        }\x0d\n    }\x0d\n    return true;\x0d\n}\x0d\n\x0d\nfunction foldLoopAbruptGuards(ctx\x2C candidate\x2C currentId) {\x0d\n    const joinIds = ctx.options?.loopBodyJoinIds;\x0d\n    if (!(joinIds instanceof Set) || joinIds.size === 0 || !candidate) return candidate;\x0d\n    let current = {\x0d\n        env: new Map(candidate.env)\x2C\x0d\n        markers: [...(candidate.markers || [])]\x2C\x0d\n        effects: [...(candidate.effects || [])]\x2C\x0d\n    };\x0d\n    while (current.markers.length > 0) {\x0d\n        let folded = false;\x0d\n        for (const joinId of joinIds) {\x0d\n            // Never mutate the candidate list currently being iterated. The\x0d\n            // body join itself can use the ordinary candidate merger.\x0d\n            if (joinId === currentId) continue;\x0d\n            const pool = ctx.incoming.get(joinId);\x0d\n            if (!Array.isArray(pool) || pool.length === 0) continue;\x0d\n            // A proven break candidate can reach the synthetic loop join before its\x0d\n            // opposite terminal-return sibling is processed. Once that terminal\x0d\n            // sibling is proven\x2C fold it into the queued break path before\x0d\n            // matching the abrupt subtree against an outer branch.\x0d\n            // The terminal guard is safe because its body exits the function;\x0d\n            // the abrupt tail remains the only continuation of that candidate.\x0d\n            for (let poolIndex = 0; poolIndex < pool.length; poolIndex++) {\x0d\n                const tail = pool[poolIndex]?.effects?.[pool[poolIndex].effects.length - 1];\x0d\n                if (tail !== "break") continue;\x0d\n                const terminalFoldedAbrupt = foldTerminalGuards(ctx\x2C pool[poolIndex]);\x0d\n                if (!terminalFoldedAbrupt) return null;\x0d\n                pool[poolIndex] = terminalFoldedAbrupt;\x0d\n            }\x0d\n            if (!collapseLoopAbruptPool(ctx\x2C pool)) return null;\x0d\n            for (let i = 0; i < pool.length; i++) {\x0d\n                const abrupt = pool[i];\x0d\n                if (!isLoopAbruptCandidate(abrupt)) continue;\x0d\n                const match = terminalSiblingMatch(ctx\x2C current\x2C abrupt);\x0d\n                if (!match) continue;\x0d\n                const backedgeCounts = ctx.options?.loopBackedgeCountsByJoin;\x0d\n                if (backedgeCounts instanceof Map && backedgeCounts.get(joinId) === 1 &&\x0d\n                    isClosedTerminalLoopSibling(ctx\x2C current\x2C currentId)) continue;\x0d\n                const marker = abrupt.markers[abrupt.markers.length - 1];\x0d\n                // The dedicated while merger owns the proven loop decision.\x0d\n                // Folding an abrupt body path across that marker would turn\x0d\n                // the loop itself into an if-guard before while rendering.\x0d\n                const loopBranchIds = ctx.options?.loopBranchIds;\x0d\n                if (loopBranchIds instanceof Set && loopBranchIds.has(marker.branchId)) continue;\x0d\n                const numericForBranchIds = ctx.options?.numericForBranchIds;\x0d\n                if (numericForBranchIds instanceof Set && numericForBranchIds.has(marker.branchId)) continue;\x0d\n                const genericForBranchIds = ctx.options?.genericForBranchIds;\x0d\n                if (genericForBranchIds instanceof Set && genericForBranchIds.has(marker.branchId)) continue;\x0d\n                const guard = guardLine(ctx\x2C marker.condition\x2C marker.truth\x2C (abrupt.effects || []).slice(match.effectPrefix));\x0d\n                if (!guard) return null;\x0d\n                const prefix = current.effects.slice(0\x2C match.effectPrefix);\x0d\n                current = {\x0d\n   