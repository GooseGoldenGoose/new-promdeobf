script-source,89,C:\\Users\\reala\\Desktop\\!workspaces\\promdeobf ova\\new promdeobf\\tools\\beta-control-flow.js,const fs = require("fs");\x0d\nconst path = require("path");\x0d\nconst luaparse = require("../parser/luaparse");\x0d\nconst { solveBetaControlFlow } = require("../passes/beta-control-flow");\x0d\n\x0d\nfunction parseLuaStructural(source\x2C filename = "<input>") {\n    try {\n        return luaparse.parse(source\x2C { luaVersion: "luau"\x2C comments: false\x2C scope: false\x2C locations: false\x2C ranges: true });\n    } catch (error) {\x0d\n        error.message = `${filename}: ${error.message}`;\x0d\n        throw error;\x0d\n    }\x0d\n}\x0d\n\x0d\nfunction defaultOutputPath(inputPath) {\x0d\n    const parsed = path.parse(path.resolve(inputPath));\x0d\n    return path.join(parsed.dir\x2C `${parsed.name}.beta.cf${parsed.ext || ".lua"}`);\x0d\n}\x0d\n\x0d\nfunction generateBetaControlFlowFromSource(source\x2C ast\x2C outputPath) {\x0d\n    const resolvedOutput = path.resolve(outputPath);\x0d\n    const controlFlow = solveBetaControlFlow(source\x2C ast);\x0d\n    if (!controlFlow.applied) throw new Error(controlFlow.reason || "Fresh beta control-flow solving did not apply");\x0d\n    parseLuaStructural(controlFlow.source\x2C `${resolvedOutput} <fresh beta control flow>`);\x0d\n    fs.mkdirSync(path.dirname(resolvedOutput)\x2C { recursive: true });\x0d\n    fs.writeFileSync(resolvedOutput\x2C controlFlow.source\x2C "utf8");\x0d\n    return { controlFlow\x2C outputPath: resolvedOutput };\x0d\n}\x0d\n\x0d\nfunction generateBetaControlFlow(inputPath\x2C outputPath = null) {\x0d\n    const resolvedInput = path.resolve(inputPath);\x0d\n    const resolvedOutput = path.resolve(outputPath || defaultOutputPath(resolvedInput));\x0d\n    const source = fs.readFileSync(resolvedInput\x2C "utf8");\x0d\n    const ast = parseLuaStructural(source\x2C resolvedInput);\x0d\n    return generateBetaControlFlowFromSource(source\x2C ast\x2C resolvedOutput);\x0d\n}\x0d\n\x0d\nfunction main() {\x0d\n    const inputArg = process.argv[2];\x0d\n    if (!inputArg) throw new Error("Usage: node tools/beta-control-flow.js <normal-output.lua> [output.beta.cf.lua]");\x0d\n    const generated = generateBetaControlFlow(inputArg\x2C process.argv[3] || null);\x0d\n    console.log(`Mode: ${generated.controlFlow.mode}`);\x0d\n    console.log(`States: ${generated.controlFlow.stateCount}`);\x0d\n    console.log(`Statements: ${generated.controlFlow.statementCount}`);\x0d\n    console.log(`Global: ${generated.controlFlow.globalName}`);\x0d\n    console.log(`Arguments: ${generated.controlFlow.argumentCount}`);\x0d\n    console.log(`Output: ${generated.outputPath}`);\x0d\n}\x0d\n\x0d\nif (require.main === module) main();\x0d\n\x0d\nmodule.exports = { defaultOutputPath\x2C generateBetaControlFlowFromSource\x2C generateBetaControlFlow };\x0d\n
