isPlainTableNamecallLoad ||\x0d\n            isDeferredLiveTable ||\x0d\n            isDeferredLiveTableCopy ||\x0d\n            isDeadRegisterCopy ||\x0d\n            isDeferredStorageCopy ||\x0d\n            isDeferredTerminalClosureCopy ||\x0d\n            isDeferredTerminalUnusedCopy;\x0d\n        if (ctx.pendingPacks.size && !isPackIndex && !isPackSlotCopy && !isReturnPackCreation && !isPendingNeutralBookkeeping && !flushPendingPacks(ctx)) return null;\x0d\n\x0d\n        if (ctx.directPromotionStartIndices.has(index) && !ctx.locals.has(name) && !isPackIndex) {\x0d\n            const value = renderRhs(ctx\x2C rhs);\x0d\n            if (typeof value !== "string") return null;\x0d\n            const kind = rhs?.type === "TableConstructorExpression" ? "table" : "value";\x0d\n            const displayName = allocateLocal(ctx\x2C name\x2C kind);\x0d\n            ctx.out.push(`local ${displayName} = ${value}`);\x0d\n            if (kind === "table") ctx.plainTableLocals.add(name);\x0d\n            continue;\x0d\n        }\x0d\n\x0d\n        if (isUnusedPlainTableReadLocal) {\x0d\n            const value = renderRhs(ctx\x2C rhs);\x0d\n            if (typeof value !== "string") return null;\x0d\n            const displayName = allocateLocal(ctx\x2C name\x2C "value");\x0d\n            emitSourceLine(ctx\x2C `local ${displayName} = ${value}`\x2C [rhs.base.name]);\x0d\n            ctx.terminalUnusedLocals.add(name);\x0d\n            continue;\x0d\n        }\x0d\n\x0d\n        if (isDeadPlainTableRead) {\x0d\n            ctx.expr.delete(name); ctx.exprKinds.delete(name); ctx.exprMeta.delete(name);\x0d\n            continue;\x0d\n        }\x0d\n\x0d\n        if (isDeferredLiveTableCopy) {\x0d\n            ctx.deferredLiveTableCopies.delete(rhs.name);\x0d\n            ctx.expr.set(name\x2C localName(ctx\x2C name));\x0d\n            ctx.exprKinds.set(name\x2C "table");\x0d\n            continue;\x0d\n        }\x0d\n\x0d\n        if (isDeferredStorageCopy || isDeferredTerminalClosureCopy || isDeferredTerminalUnusedCopy) {\x0d\n            if (isDeferredStorageCopy) ctx.deferredStorageCopies.delete(name);\x0d\n            else if (isDeferredTerminalClosureCopy) ctx.deferredTerminalClosureCopies.delete(name);\x0d\n            else ctx.deferredTerminalUnusedCopies.delete(name);\x0d\n            if (!ctx.locals.has(name)) return null;\x0d\n            let displayName = localName(ctx\x2C name);\x0d\n            if (isDeferredStorageCopy && isPackSlotCopy) {\x0d\n                const meta = ctx.exprMeta.get(rhs.name);\x0d\n                const pendingPack = meta ? ctx.pendingPacks.get(meta.packReg) : null;\x0d\n                if (pendingPack && meta) {\x0d\n                    const slotInfo = pendingPack.slots.get(meta.slot);\x0d\n                    if (!slotInfo || slotInfo.localReg !== name) return null;\x0d\n                    if (meta.slot === 1) {\x0d\n                        displayName = reservePendingPackDisplayNamesThrough(ctx\x2C pendingPack\x2C meta.slot);\x0d\n                        if (typeof displayName !== "string") return null;\x0d\n                        ctx.localNames.set(name\x2C displayName);\x0d\n                    }\x0d\n                }\x0d\n            }\x0d\n            ctx.expr.set(name\x2C displayName);\x0d\n            ctx.exprKinds.set(name\x2C "value");\x0d\n            continue;\x0d\n        }\x0d\n\x0d\n        if (rhsCallKind === "alloc-upvalue" && (rhs.arguments || []).length === 0) {\x0d\n            if (name === ctx.stateName || name === ctx.returnName || ctx.upvalueCells.has(name)) return null;\x0d\n            ctx.upvalueCells.set(name\x2C null);\x0d\n            continue;\x0d\n        }\x0d\n        if (rhsCallKind === "release-upvalue") {\x0d\n            const args = rhs.arguments || [];\x0d\n            if (args.length !== 1 || !isIdentifier(args[0]) || args[0].name !== name || !ctx.upvalueCells.has(name)) return null;\x0d\n            ctx.upvalueCells.delete(name);\x0d\n            continue;\