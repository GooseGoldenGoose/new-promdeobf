digraph BetaRegisterFlow {
  rankdir=LR;
  graph [fontname="Consolas", nodesep=0.5, ranksep=0.9];
  node [shape=record, fontname="Consolas", fontsize=10];
  edge [fontname="Consolas", fontsize=9];
  entry [shape=oval, label="ENTRY"];
  stop [shape=oval, label="STOP"];
  s1 [label="State 1 [entry] | #1 version-define: local r_v1_1 = true | #2 epoch-start: local r_v2_1 = r_v1_1 \| reads r_v1_1 | #3 version-define: local r_v3_1 = false | #4 epoch-start: local r_v4_1 = \"ok\" | #5 version-define: local r_v1_2 = \{ r_v3_1, r_v4_1 \} \| reads r_v3_1,r_v4_1 | #6 epoch-mutate: r_v4_1 = r_v1_2 \| reads r_v1_2 | #7 version-define: local r_v1_3 = \"ok\" | #8 epoch-start: local r_v5_1 = r_v1_3 \| reads r_v1_3 | #9 epoch-start: local r_v6_1 = 2 | #10 epoch-start: local r_v7_1 = r_v6_1 \| reads r_v6_1 | #11 epoch-start: local r_v6_2 = 1 | #12 epoch-start: local r_v8_1 = r_v6_2 \| reads r_v6_2 | #13 epoch-start: local r_v6_3 = 0 | #14 epoch-start: local r_v9_1 = r_v8_1 \< r_v6_3 \| reads r_v8_1,r_v6_3 | #15 version-define: local r_v3_2 = 1 | #16 epoch-mutate: r_v6_2 = r_v3_2 - r_v8_1 \| reads r_v3_2,r_v8_1 | #17 epoch-start: local r_v10_1 = args | #18 state-transition: state = 2"];
  s2 [label="State 2 | #1 epoch-start: local r_v11_1 = not r_v9_1 \| reads r_v9_1 | #2 epoch-mutate: r_v6_2 = r_v6_2 + r_v8_1 \| reads r_v6_2,r_v8_1 | #3 version-define: local r_v3_3 = r_v6_2 \<= r_v7_1 \| reads r_v6_2,r_v7_1 | #4 version-define: local r_v3_4 = r_v11_1 and r_v3_3 \| reads r_v11_1,r_v3_3 | #5 epoch-start: local r_v11_2 = r_v6_2 \>= r_v7_1 \| reads r_v6_2,r_v7_1 | #6 epoch-mutate: r_v11_2 = r_v9_1 and r_v11_2 \| reads r_v9_1,r_v11_2 | #7 version-define: local r_v3_5 = r_v11_2 or r_v3_4 \| reads r_v11_2,r_v3_4 | #8 epoch-start: local r_v11_3 = 3 | #9 version-define: local r_v1_4 = r_v3_5 and r_v11_3 \| reads r_v3_5,r_v11_3 | #10 version-define: local r_v3_6 = 4 | #11 state-transition: state = r_v1_4 or r_v3_6 \| reads r_v1_4,r_v3_6"];
  s3 [label="State 3 | #1 state-transition: state = r_v2_1 and 5 or 6 \| reads r_v2_1 | #2 version-define: local r_v3_7 = r_v2_1 \| reads r_v2_1 | #3 epoch-start: local r_v11_4 = r_v6_2 \| reads r_v6_2"];
  s4 [label="State 4 | #1 epoch-start: local r_v6_4 = \"print\" | #2 version-define: local r_v1_5 = _env[r_v6_4] \| reads r_v6_4 | #3 epoch-start: local r_v7_2 = \"chain\" | #4 epoch-mutate: r_v6_4 = r_v1_5(r_v7_2, r_v2_1) \| reads r_v1_5,r_v7_2,r_v2_1 | #5 epoch-kill: r_v5_1 = nil | #6 epoch-kill: r_v4_1 = nil | #7 epoch-kill: r_v2_1 = nil | #8 return-payload: ReturnVal = \{\} | #9 state-transition: state = nil"];
  s5 [label="State 5 | #1 epoch-start: local r_v12_1 = 1 | #2 epoch-start: local r_v13_1 = r_v4_1[r_v12_1] \| reads r_v4_1,r_v12_1 | #3 epoch-start: local r_v12_2 = false | #4 epoch-start: local r_v14_1 = r_v13_1 == r_v12_2 \| reads r_v13_1,r_v12_2 | #5 epoch-start: local r_v15_1 = state | #6 state-transition: state = r_v14_1 and 7 or 8 \| reads r_v14_1 | #7 epoch-start: local r_v16_1 = r_v14_1 \| reads r_v14_1"];
  s6 [label="State 6 | #1 epoch-start: local r_v16_2 = \"print\" | #2 version-define: local r_v1_6 = _env[r_v16_2] \| reads r_v16_2 | #3 epoch-start: local r_v15_2 = \"i\" | #4 epoch-mutate: r_v16_2 = r_v1_6(r_v15_2, r_v11_4) \| reads r_v1_6,r_v15_2,r_v11_4 | #5 epoch-mutate: r_v2_1 = ReturnVal | #6 epoch-kill: r_v11_4 = nil | #7 state-transition: state = 2"];
  s7 [label="State 7 | #1 epoch-start: local r_v12_3 = 2 | #2 epoch-start: local r_v13_2 = r_v4_1[r_v12_3] \| reads r_v4_1,r_v12_3 | #3 epoch-start: local r_v14_2 = r_v13_2 == r_v5_1 \| reads r_v13_2,r_v5_1 | #4 epoch-mutate: r_v16_1 = r_v14_2 \| reads r_v14_2 | #5 state-transition: state = 8"];
  s8 [label="State 8 | #1 version-define: local r_v1_7 = r_v15_1 \| reads r_v15_1 | #2 version-define: local r_v3_8 = r_v16_1 \| reads r_v16_1 | #3 state-transition: state = 6"];
  entry -> s1;
  s1 -> s2;
  s2 -> s3 [label="true"];
  s2 -> s4 [label="false"];
  s3 -> s5 [label="true"];
  s3 -> s6 [label="false"];
  s4 -> stop;
  s5 -> s7 [label="true"];
  s5 -> s8 [label="false"];
  s6 -> s2;
  s7 -> s8;
  s8 -> s6;
  subgraph cluster_epochs {
    label="Proven register epochs";
    style=dashed;
    life0 [shape=ellipse, label="r3 =\> r_v2_1"];
    life0 -> s1 [style=dashed, label="start"];
    life0 -> s3 [style=dashed, label="read/read"];
    life0 -> s4 [style=dashed, label="read/kill"];
    life0 -> s6 [style=dashed, label="mutate"];
    life1 [shape=ellipse, label="r14 =\> r_v4_1"];
    life1 -> s1 [style=dashed, label="start/read/mutate"];
    life1 -> s4 [style=dashed, label="kill"];
    life1 -> s5 [style=dashed, label="read"];
    life1 -> s7 [style=dashed, label="read"];
    life2 [shape=ellipse, label="r10 =\> r_v5_1"];
    life2 -> s1 [style=dashed, label="start"];
    life2 -> s4 [style=dashed, label="kill"];
    life2 -> s7 [style=dashed, label="read"];
    life3 [shape=ellipse, label="r2 =\> r_v6_1"];
    life3 -> s1 [style=dashed, label="start/read"];
    life4 [shape=ellipse, label="r2 =\> r_v6_2"];
    life4 -> s1 [style=dashed, label="start/read/mutate"];
    life4 -> s2 [style=dashed, label="read/mutate/read/read"];
    life4 -> s3 [style=dashed, label="read"];
    life5 [shape=ellipse, label="r2 =\> r_v6_3"];
    life5 -> s1 [style=dashed, label="start/read"];
    life6 [shape=ellipse, label="r2 =\> r_v6_4"];
    life6 -> s4 [style=dashed, label="start/read/mutate"];
    life7 [shape=ellipse, label="r9 =\> r_v7_1"];
    life7 -> s1 [style=dashed, label="start"];
    life7 -> s2 [style=dashed, label="read/read"];
    life8 [shape=ellipse, label="r9 =\> r_v7_2"];
    life8 -> s4 [style=dashed, label="start/read"];
    life9 [shape=ellipse, label="r5 =\> r_v8_1"];
    life9 -> s1 [style=dashed, label="start/read/read"];
    life9 -> s2 [style=dashed, label="read"];
    life10 [shape=ellipse, label="r7 =\> r_v9_1"];
    life10 -> s1 [style=dashed, label="start"];
    life10 -> s2 [style=dashed, label="read/read"];
    life11 [shape=ellipse, label="r12 =\> r_v10_1"];
    life11 -> s1 [style=dashed, label="start"];
    life12 [shape=ellipse, label="r6 =\> r_v11_1"];
    life12 -> s2 [style=dashed, label="start/read"];
    life13 [shape=ellipse, label="r6 =\> r_v11_2"];
    life13 -> s2 [style=dashed, label="start/read/mutate/read"];
    life14 [shape=ellipse, label="r6 =\> r_v11_3"];
    life14 -> s2 [style=dashed, label="start/read"];
    life15 [shape=ellipse, label="r6 =\> r_v11_4"];
    life15 -> s3 [style=dashed, label="start"];
    life15 -> s6 [style=dashed, label="read/kill"];
    life16 [shape=ellipse, label="r4 =\> r_v12_1"];
    life16 -> s5 [style=dashed, label="start/read"];
    life17 [shape=ellipse, label="r4 =\> r_v12_2"];
    life17 -> s5 [style=dashed, label="start/read"];
    life18 [shape=ellipse, label="r4 =\> r_v12_3"];
    life18 -> s7 [style=dashed, label="start/read"];
    life19 [shape=ellipse, label="r8 =\> r_v13_1"];
    life19 -> s5 [style=dashed, label="start/read"];
    life20 [shape=ellipse, label="r8 =\> r_v13_2"];
    life20 -> s7 [style=dashed, label="start/read"];
    life21 [shape=ellipse, label="r11 =\> r_v14_1"];
    life21 -> s5 [style=dashed, label="start/read/read"];
    life22 [shape=ellipse, label="r11 =\> r_v14_2"];
    life22 -> s7 [style=dashed, label="start/read"];
    life23 [shape=ellipse, label="r13 =\> r_v15_1"];
    life23 -> s5 [style=dashed, label="start"];
    life23 -> s8 [style=dashed, label="read"];
    life24 [shape=ellipse, label="r13 =\> r_v15_2"];
    life24 -> s6 [style=dashed, label="start/read"];
    life25 [shape=ellipse, label="r1 =\> r_v16_1"];
    life25 -> s5 [style=dashed, label="start"];
    life25 -> s7 [style=dashed, label="mutate"];
    life25 -> s8 [style=dashed, label="read"];
    life26 [shape=ellipse, label="r1 =\> r_v16_2"];
    life26 -> s6 [style=dashed, label="start/read/mutate"];
  }
}