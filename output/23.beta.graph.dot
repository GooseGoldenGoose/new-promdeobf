    life3 -> s5 [style=dashed, label="start/read"];
    life4 [shape=ellipse, label="r7 =\> r_v4_1"];
    life4 -> s1 [style=dashed, label="start/read/read/read/kill"];
    life5 [shape=ellipse, label="r7 =\> r_v4_2"];
    life5 -> s2 [style=dashed, label="start/read/mutate/read"];
    life6 [shape=ellipse, label="r7 =\> r_v4_3"];
    life6 -> s4 [style=dashed, label="start/read/mutate/read"];
    life7 [shape=ellipse, label="r5 =\> r_v5_1"];
