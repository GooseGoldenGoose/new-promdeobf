    life12 [shape=ellipse, label="r5 =\> r_v5_6"];
    life12 -> s2 [style=dashed, label="start/read"];
    life13 [shape=ellipse, label="r5 =\> r_v5_7"];
    life13 -> s4 [style=dashed, label="start/read"];
    life14 [shape=ellipse, label="r9 =\> r_v6_1"];
    life14 -> s1 [style=dashed, label="start/read"];
    life15 [shape=ellipse, label="r9 =\> r_v6_3"];
