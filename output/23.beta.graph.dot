digraph BetaRegisterFlow {
  rankdir=LR;
  graph [fontname="Consolas", nodesep=0.5, ranksep=0.9];
  node [shape=record, fontname="Consolas", fontsize=10];
  edge [fontname="Consolas", fontsize=9];
  entry [shape=oval, label="ENTRY"];
  stop [shape=oval, label="STOP"];
  s1 [label="State 1 [entry] | #1 version-define: local r_v1_1 = \"print\" | #2 version-define: local r_v2_1 = _env[r_v1_1] \| reads r_v1_1 | #3 epoch-start: local r_v3_1 = \"testing language/library basics\" | #4 version-define: local r_v1_2 = r_v2_1(r_v3_1) \| reads r_v2_1,r_v3_1 | #5 version-define: local r_v1_3 = \"getfenv\" | #6 version-define: local r_v2_2 = _env[r_v1_3] \| reads r_v1_3 | #7 version-define: local r_v1_4 = r_v2_2() \| reads r_v2_2 | #8 epoch-start: local r_v3_2 = r_v1_4 \| reads r_v1_4 | #9 version-define: local r_v2_3 = createClosure(2, \{\}) | #10 version-define: local r_v1_5 = \"concat\" | #11 effect-write: _env[r_v1_5] = r_v2_3 \| reads r_v1_5,r_v2_3 | #12 version-define: local r_v1_6 = createClosure3(5, \{\}) | #13 epoch-start: local r_v4_1 = r_v1_6 \| reads r_v1_6 | #14 epoch-start: local r_v5_1 = \"assert\" | #15 version-define: local r_v1_7 = _env[r_v5_1] \| reads r_v5_1 | #16 epoch-start: local r_v6_1 = 1 | #17 epoch-start: local r_v7_1 = r_v4_1(r_v6_1) \| reads r_v4_1,r_v6_1 | #18 version-define: local r_v6_2 = nil | #19 epoch-start: local r_v8_1 = r_v7_1 == r_v6_2 \| reads r_v7_1,r_v6_2 | #20 epoch-mutate: r_v5_1 = r_v1_7(r_v8_1) \| reads r_v1_7,r_v8_1 | #21 epoch-start: local r_v5_2 = \"assert\" | #22 version-define: local r_v1_8 = _env[r_v5_2] \| reads r_v5_2 | #23 epoch-start: local r_v9_1 = 2 | #24 epoch-start: local r_v6_3 = 1 | #25 epoch-start: local r_v7_2 = r_v4_1(r_v6_3, r_v9_1) \| reads r_v4_1,r_v6_3,r_v9_1 | #26 epoch-start: local r_v6_4 = 2 | #27 epoch-start: local r_v8_2 = r_v7_2 == r_v6_4 \| reads r_v7_2,r_v6_4 | #28 epoch-mutate: r_v5_2 = r_v1_8(r_v8_2) \| reads r_v1_8,r_v8_2 | #29 epoch-start: local r_v5_3 = \"assert\" | #30 version-define: local r_v1_9 = _env[r_v5_3] \| reads r_v5_3 | #31 epoch-start: local r_v10_1 = 3 | #32 epoch-start: local r_v9_2 = 2 | #33 epoch-start: local r_v6_5 = 1 | #34 epoch-start: local r_v7_3 = r_v4_1(r_v6_5, r_v9_2, r_v10_1) \| reads r_v4_1,r_v6_5,r_v9_2,r_v10_1 | #35 epoch-start: local r_v6_6 = 2 | #36 epoch-start: local r_v8_3 = r_v7_3 == r_v6_6 \| reads r_v7_3,r_v6_6 | #37 epoch-mutate: r_v5_3 = r_v1_9(r_v8_3) \| reads r_v1_9,r_v8_3 | #38 epoch-start: local r_v7_4 = createClosure1(6, \{\}) | #39 epoch-start: local r_v5_4 = \"assert\" | #40 version-define: local r_v1_10 = _env[r_v5_4] \| reads r_v5_4 | #41 epoch-start: local r_v6_7 = r_v7_4() \| reads r_v7_4 | #42 epoch-start: local r_v7_5 = 2 | #43 epoch-start: local r_v8_4 = r_v6_7 == r_v7_5 \| reads r_v6_7,r_v7_5 | #44 epoch-mutate: r_v5_4 = r_v1_10(r_v8_4) \| reads r_v1_10,r_v8_4 | #45 epoch-start: local r_v7_6 = createClosure3(9, \{\}) | #46 epoch-start: local r_v5_5 = \"assert\" | #47 version-define: local r_v1_11 = _env[r_v5_5] \| reads r_v5_5 | #48 epoch-start: local r_v6_8 = r_v7_6() \| reads r_v7_6 | #49 version-define: local r_v7_7 = nil | #50 epoch-start: local r_v8_5 = r_v6_8 == r_v7_7 \| reads r_v6_8,r_v7_7 | #51 epoch-mutate: r_v5_5 = r_v1_11(r_v8_5) \| reads r_v1_11,r_v8_5 | #52 epoch-start: local r_v11_1 = args | #53 version-define: local r_v3_3 = nil | #54 epoch-kill: r_v4_1 = nil | #55 return-payload: ReturnVal = \{\} | #56 state-transition: state = nil"];
  s2 [label="State 2 [entry] | #1 epoch-start: local r_v11_2 = args[1] | #2 epoch-start: local r_v4_2 = \"select\" | #3 version-define: local r_v1_12 = _env[r_v4_2] \| reads r_v4_2 | #4 epoch-start: local r_v3_4 = \{ select(2, unpack(args)) \} | #5 epoch-start: local r_v5_6 = \"#\" | #6 epoch-mutate: r_v4_2 = r_v1_12(r_v5_6, unpack(r_v3_4)) \| reads r_v1_12,r_v5_6,r_v3_4 | #7 version-define: local r_v1_13 = 0 | #8 version-define: local r_v2_4 = r_v4_2 == r_v1_13 \| reads r_v4_2,r_v1_13 | #9 state-transition: state = r_v2_4 and 3 or 4 \| reads r_v2_4"];
  s3 [label="State 3 | #1 version-define: local r_v1_14 = \"tostring\" | #2 version-define: local r_v2_5 = _env[r_v1_14] \| reads r_v1_14 | #3 version-define: local r_v1_15 = \{ r_v2_5(r_v11_2) \} \| reads r_v2_5,r_v11_2 | #4 return-payload: ReturnVal = \{ unpack(r_v1_15) \} \| reads r_v1_15 | #5 state-transition: state = nil"];
  s4 [label="State 4 | #1 epoch-start: local r_v4_3 = \"tostring\" | #2 version-define: local r_v1_16 = _env[r_v4_3] \| reads r_v4_3 | #3 epoch-mutate: r_v4_3 = r_v1_16(r_v11_2) \| reads r_v1_16,r_v11_2 | #4 epoch-start: local r_v7_8 = \"concat\" | #5 epoch-start: local r_v8_6 = _env[r_v7_8] \| reads r_v7_8 | #6 epoch-mutate: r_v7_8 = r_v8_6(unpack(r_v3_4)) \| reads r_v8_6,r_v3_4 | #7 epoch-start: local r_v5_7 = \",\" | #8 version-define: local r_v1_17 = r_v5_7 .. r_v7_8 \| reads r_v5_7,r_v7_8 | #9 version-define: local r_v2_6 = r_v4_3 .. r_v1_17 \| reads r_v4_3,r_v1_17 | #10 return-payload: ReturnVal = \{ r_v2_6 \} \| reads r_v2_6 | #11 state-transition: state = nil"];
  s5 [label="State 5 [entry] | #1 epoch-start: local r_v11_3 = args[1] | #2 epoch-start: local r_v3_5 = args[2] | #3 return-payload: ReturnVal = \{ r_v3_5 \} \| reads r_v3_5 | #4 state-transition: state = nil"];
  s6 [label="State 6 [entry] | #1 version-define: local r_v2_7 = 1 | #2 epoch-start: local r_v11_4 = r_v2_7 \| reads r_v2_7 | #3 state-transition: state = r_v11_4 and 7 or 8 \| reads r_v11_4"];
  s7 [label="State 7 | #1 version-define: local r_v2_8 = 2 | #2 epoch-mutate: r_v11_4 = r_v2_8 \| reads r_v2_8 | #3 state-transition: state = 8"];
  s8 [label="State 8 | #1 return-payload: ReturnVal = \{ r_v11_4 \} \| reads r_v11_4 | #2 state-transition: state = nil"];
  s9 [label="State 9 [entry] | #1 version-define: local r_v2_9 = nil | #2 epoch-start: local r_v11_5 = r_v2_9 \| reads r_v2_9 | #3 state-transition: state = r_v11_5 and 10 or 11 \| reads r_v11_5"];
  s10 [label="State 10 | #1 version-define: local r_v2_10 = 2 | #2 epoch-mutate: r_v11_5 = r_v2_10 \| reads r_v2_10 | #3 state-transition: state = 11"];
  s11 [label="State 11 | #1 return-payload: ReturnVal = \{ r_v11_5 \} \| reads r_v11_5 | #2 state-transition: state = nil"];
  entry -> s1;
  entry -> s2;
  entry -> s5;
  entry -> s6;
  entry -> s9;
  s1 -> stop;
  s2 -> s3 [label="true"];
  s2 -> s4 [label="false"];
  s3 -> stop;
  s4 -> stop;
  s5 -> stop;
  s6 -> s7 [label="true"];
  s6 -> s8 [label="false"];
  s7 -> s8;
  s8 -> stop;
  s9 -> s10 [label="true"];
  s9 -> s11 [label="false"];
  s10 -> s11;
  s11 -> stop;
  subgraph cluster_epochs {
    label="Proven register epochs";
    style=dashed;
    life0 [shape=ellipse, label="r8 =\> r_v3_1"];
    life0 -> s1 [style=dashed, label="start/read"];
    life1 [shape=ellipse, label="r8 =\> r_v3_2"];
    life1 -> s1 [style=dashed, label="start"];
    life2 [shape=ellipse, label="r8 =\> r_v3_4"];
    life2 -> s2 [style=dashed, label="start/read"];
    life2 -> s4 [style=dashed, label="read"];
