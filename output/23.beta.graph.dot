    life27 [shape=ellipse, label="r2 =\> r_v7_8"];
    life27 -> s4 [style=dashed, label="start/read/mutate/read"];
    life28 [shape=ellipse, label="r1 =\> r_v8_1"];
    life28 -> s1 [style=dashed, label="start/read"];
    life29 [shape=ellipse, label="r1 =\> r_v8_2"];
