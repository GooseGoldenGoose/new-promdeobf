    life20 [shape=ellipse, label="r9 =\> r_v6_8"];
    life20 -> s1 [style=dashed, label="start/read"];
    life21 [shape=ellipse, label="r2 =\> r_v7_1"];
    life21 -> s1 [style=dashed, label="start/read"];
    life22 [shape=ellipse, label="r2 =\> r_v7_2"];
    life22 -> s1 [style=dashed, label="start/read"];
    life23 [shape=ellipse, label="r2 =\> r_v7_3"];
