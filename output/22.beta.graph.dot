digraph BetaRegisterFlow {
  rankdir=LR;
  graph [fontname="Consolas", nodesep=0.5, ranksep=0.9];
  node [shape=record, fontname="Consolas", fontsize=10];
  edge [fontname="Consolas", fontsize=9];
  entry [shape=oval, label="ENTRY"];
  stop [shape=oval, label="STOP"];
  s1 [label="State 1 [entry] | #1 version-define: local r_v1_1 = createClosure4(2, \{\}) | #2 epoch-start: local r_v2_1 = r_v1_1 \| reads r_v1_1 | #3 version-define: local r_v1_2 = \{\} | #4 epoch-start: local r_v3_1 = r_v1_2 \| reads r_v1_2 | #5 version-define: local r_v1_3 = createClosure5(3, \{\}) | #6 version-define: local r_v4_1 = \"hee\" | #7 effect-write: r_v3_1[r_v4_1] = r_v1_3 \| reads r_v3_1,r_v4_1,r_v1_3 | #8 version-define: local r_v4_2 = createClosure3(4, \{\}) | #9 version-define: local r_v1_4 = \"yai\" | #10 effect-write: r_v3_1[r_v1_4] = r_v4_2 \| reads r_v3_1,r_v1_4,r_v4_2 | #11 version-define: local r_v1_5 = \"yai\" | #12 version-define: local r_v1_6 = r_v3_1[r_v1_5] \| reads r_v3_1,r_v1_5 | #13 version-define: local r_v1_7 = r_v1_6(r_v3_1) \| reads r_v1_6,r_v3_1 | #14 version-define: local r_v1_8 = \"hee\" | #15 version-define: local r_v1_9 = r_v3_1[r_v1_8] \| reads r_v3_1,r_v1_8 | #16 version-define: local r_v1_10 = r_v1_9(r_v3_1) \| reads r_v1_9,r_v3_1 | #17 epoch-start: local r_v5_1 = args | #18 version-define: local r_v2_2 = nil | #19 epoch-kill: r_v3_1 = nil | #20 return-payload: ReturnVal = \{\} | #21 state-transition: state = nil"];
  s2 [label="State 2 [entry] | #1 version-define: local r_v4_3 = \"print\" | #2 version-define: local r_v1_11 = _env[r_v4_3] \| reads r_v4_3 | #3 epoch-start: local r_v5_2 = \"g\" | #4 version-define: local r_v4_4 = r_v1_11(r_v5_2) \| reads r_v1_11,r_v5_2 | #5 return-payload: ReturnVal = \{\} | #6 state-transition: state = nil"];
  s3 [label="State 3 [entry] | #1 epoch-start: local r_v5_3 = args[1] | #2 version-define: local r_v4_5 = \"print\" | #3 version-define: local r_v1_12 = _env[r_v4_5] \| reads r_v4_5 | #4 epoch-start: local r_v2_3 = \"hee\" | #5 version-define: local r_v4_6 = r_v1_12(r_v2_3, r_v5_3) \| reads r_v1_12,r_v2_3,r_v5_3 | #6 epoch-kill: r_v5_3 = nil | #7 return-payload: ReturnVal = \{\} | #8 state-transition: state = nil"];
  s4 [label="State 4 [entry] | #1 epoch-start: local r_v5_4 = args[1] | #2 version-define: local r_v4_7 = \"print\" | #3 version-define: local r_v1_13 = _env[r_v4_7] \| reads r_v4_7 | #4 epoch-start: local r_v2_4 = \"yai\" | #5 version-define: local r_v4_8 = r_v1_13(r_v2_4, r_v5_4) \| reads r_v1_13,r_v2_4,r_v5_4 | #6 epoch-kill: r_v5_4 = nil | #7 return-payload: ReturnVal = \{\} | #8 state-transition: state = nil"];
  entry -> s1;
  entry -> s2;
  entry -> s3;
  entry -> s4;
  s1 -> stop;
  s2 -> stop;
  s3 -> stop;
  s4 -> stop;
  subgraph cluster_epochs {
    label="Proven register epochs";
    style=dashed;
    life0 [shape=ellipse, label="r2 =\> r_v2_1"];
    life0 -> s1 [style=dashed, label="start"];
    life1 [shape=ellipse, label="r2 =\> r_v2_3"];
    life1 -> s3 [style=dashed, label="start/read"];
    life2 [shape=ellipse, label="r2 =\> r_v2_4"];
    life2 -> s4 [style=dashed, label="start/read"];
    life3 [shape=ellipse, label="r3 =\> r_v3_1"];
    life3 -> s1 [style=dashed, label="start/read/read/read/read/read/read/kill"];
    life4 [shape=ellipse, label="r1 =\> r_v5_1"];
    life4 -> s1 [style=dashed, label="start"];
    life5 [shape=ellipse, label="r1 =\> r_v5_2"];
    life5 -> s2 [style=dashed, label="start/read"];
    life6 [shape=ellipse, label="r1 =\> r_v5_3"];
    life6 -> s3 [style=dashed, label="start/read/kill"];
    life7 [shape=ellipse, label="r1 =\> r_v5_4"];
    life7 -> s4 [style=dashed, label="start/read/kill"];
  }
}